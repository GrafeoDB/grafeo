CREATE (:AI {key: 'anton', name: 'Anton', description: 'Gilfoyle\'s home-built server, which ran Pied Piper\'s early infrastructure and which he treats as a colleague.', form: 'server rack'})
CREATE (:Company {key: 'aviato', name: 'Aviato', description: 'Erlich Bachman\'s first startup, a flight-data company whose sale paid for his house.'})
CREATE (:Company {key: 'bachmanity', name: 'Bachmanity', description: 'An investment company Erlich Bachman and Big Head started in 2016 with Big Head\'s Hooli severance.', founded: date('2016-04-01'), founded_precision: 'month'})
CREATE (:Event {key: 'bachmanity-insanity', name: 'Bachmanity Insanity', description: 'A lavish party Erlich Bachman and Big Head threw for Bachmanity, paid for with much of its money.'})
CREATE (:Person {key: 'bertram-gilfoyle', name: 'Bertram Gilfoyle', description: 'Pied Piper\'s systems architect: dry, unhurried and sure of himself, he trusts the server he built more than most people.', title: 'Systems architect'})
CREATE (:Product {key: 'bitcoin-alert', name: 'Gilfoyle\'s Bitcoin alert', description: 'A script on Gilfoyle\'s computer that plays a death metal song whenever the price of Bitcoin crosses a set level.', trigger: 'Bitcoin price crosses a set level'})
CREATE (:Technology {key: 'blockchain', name: 'Blockchain', description: 'A shared ledger kept in step by many computers, so that no single owner controls the record.'})
CREATE (:Company {key: 'bream-hall', name: 'Bream-Hall', description: 'The venture firm Laurie Bream and Monica Hall founded in 2018 after leaving Raviga Capital.', founded: date('2018-03-01'), founded_precision: 'month'})
CREATE (:Person {key: 'carla-walton', name: 'Carla Walton', description: 'A senior engineer who joined Pied Piper in 2016 and says plainly what she thinks of everyone\'s code.'})
CREATE (:Event {key: 'condor-stream', name: 'The condor egg live stream', description: 'A live video of a condor egg in a remote nest, which Pied Piper streamed to show its platform could carry a large audience.'})
CREATE (:City {key: 'cupertino', name: 'Cupertino', description: 'A city in Silicon Valley where Endframe has its office.'})
CREATE (:Person {key: 'denpok', name: 'Denpok', description: 'Gavin Belson\'s spiritual advisor, paid to keep the head of Hooli calm and on message.'})
CREATE (:Person {key: 'dinesh-chugtai', name: 'Dinesh Chugtai', description: 'A Pied Piper engineer who is good at his job and keen to be seen as better than Gilfoyle, which rarely works out.', jewellery: 'gold chain', title: 'Engineer'})
CREATE (:Person {key: 'ed-chen', name: 'Ed Chen', description: 'An associate at Raviga Capital who works on the firm\'s deals under Laurie Bream.'})
CREATE (:Company {key: 'endframe', name: 'Endframe', description: 'A rival startup that tried to win Pied Piper\'s market with its own version of the technology.'})
CREATE (:Person {key: 'erlich-bachman', name: 'Erlich Bachman', description: 'The owner of the hacker hostel and self-appointed mentor to its residents, still living off the sale of Aviato.', catchphrase: 'Aviato', title: 'Head of Incubation'})
CREATE (:Place {key: 'erlichs-palapa', name: 'Erlich\'s palapa', description: 'A thatched shade hut beside the hacker hostel\'s pool, Erlich\'s pride and one of his larger expenses.', roof: 'thatched'})
CREATE (:AI {key: 'fiona', name: 'Fiona', description: 'A humanoid robot with an emotional AI, built by a robotics startup to hold a natural conversation.'})
CREATE (:Person {key: 'gavin-belson', name: 'Gavin Belson', description: 'The founder and CEO of Hooli, who wants to be seen as a visionary and takes every loss to Pied Piper personally.', pledge: 'Tethics'})
CREATE (:Place {key: 'hacker-hostel', name: 'Hacker Hostel', description: 'Erlich Bachman\'s house in Palo Alto, run as a startup incubator: residents get a room, and he gets ten percent of their companies.', terms: 'a room for ten percent of the company'})
CREATE (:Company {key: 'hooli', name: 'Hooli', description: 'A large technology company led by Gavin Belson, with a campus in Mountain View and a product for nearly everything.', motto: 'Making the world a better place'})
CREATE (:Place {key: 'hooli-campus', name: 'Hooli campus', description: 'Hooli\'s headquarters in Mountain View: glass buildings, company bikes and free food.'})
CREATE (:Event {key: 'hooli-con', name: 'Hooli-Con', description: 'Hooli\'s own conference, where Gavin Belson presents new products from a very large stage.'})
CREATE (:Product {key: 'hooli-phone', name: 'Hooli Phone', description: 'Hooli\'s smartphone, sold with Hooli\'s own apps already on it.'})
CREATE (:Place {key: 'hooli-rooftop', name: 'Hooli rooftop', description: 'A roof on the Hooli campus where employees Hooli would rather not lose are paid to wait for their stock to vest.', activity: 'rest and vest'})
CREATE (:Company {key: 'hooli-xyz', name: 'Hooli XYZ', description: 'Hooli\'s moonshot division, which Big Head was put in charge of by mistake.'})
CREATE (:Person {key: 'hoover', name: 'Hoover', description: 'Hooli\'s head of security, loyal to Gavin Belson and very hard to surprise.'})
CREATE (:Person {key: 'jack-barker', name: 'Jack Barker', description: 'A veteran executive brought in as Pied Piper\'s CEO, who has a management diagram for every situation.', management_theory: 'Conjoined Triangles of Success', nickname: 'Action Jack'})
CREATE (:Person {key: 'jared-dunn', name: 'Jared Dunn', description: 'Pied Piper\'s head of business development, who left Hooli to join Richard and is loyal beyond reason. He was renamed Jared at Hooli, and the name stuck.', born_as: 'Donald Dunn'})
CREATE (:Person {key: 'jian-yang', name: 'Jian-Yang', description: 'An app developer who lives at the hacker hostel, ignores Erlich\'s house rules and outlasts most of the other residents.'})
CREATE (:AI {key: 'jian-yangs-fridge', name: 'Jian-Yang\'s fridge', description: 'A smart fridge with a screen and a voice, owned by Jian-Yang and connected to more of the house network than it needs.', talks: true})
CREATE (:Person {key: 'keenan-feldspar', name: 'Keenan Feldspar', description: 'A virtual reality founder whose headset demos win investors over with ease.'})
CREATE (:Person {key: 'laurie-bream', name: 'Laurie Bream', description: 'Raviga Capital\'s managing partner after Peter Gregory, who decides by the numbers and keeps small talk to a minimum.'})
CREATE (:City {key: 'los-altos', name: 'Los Altos', description: 'A quiet, wealthy town in Silicon Valley, home to Russ Hanneman and Ed Chen.'})
CREATE (:City {key: 'menlo-park', name: 'Menlo Park', description: 'A city on the Peninsula where venture firms line Sand Hill Road.'})
CREATE (:Technology {key: 'middle-out', name: 'Middle-out compression', description: 'A lossless compression algorithm that works on data from the middle outwards. It holds the record Weissman score of 5.2.', inventor: 'Richard Hendricks', weissman_score: 5.2e0})
CREATE (:Person {key: 'monica-hall', name: 'Monica Hall', description: 'An investor who championed Pied Piper inside Raviga Capital and later co-founded Bream-Hall with Laurie Bream.'})
CREATE (:City {key: 'mountain-view', name: 'Mountain View', description: 'A city in Silicon Valley, home to the Hooli campus and, from September 2014, Pied Piper\'s office.'})
CREATE (:Person {key: 'nelson-bighetti', name: 'Nelson "Big Head" Bighetti', description: 'Richard\'s oldest friend, whose career keeps rising with very little effort on his part.', nickname: 'Big Head', severance_usd: 20000000})
CREATE (:Product {key: 'not-hotdog', name: 'Not Hotdog', description: 'An app that recognises hot dogs in photos and labels everything else as not hot dog.', classes: 2})
CREATE (:Product {key: 'nucleus', name: 'Nucleus', description: 'Hooli\'s rival to Pied Piper\'s platform, built in a hurry by a very large team. It never caught up on the Weissman scale.', weissman_score: 2.89e0})
CREATE (:City {key: 'palo-alto', name: 'Palo Alto', description: 'A city on the San Francisco Peninsula and home to Erlich Bachman\'s hacker hostel.'})
CREATE (:Person {key: 'peter-gregory', name: 'Peter Gregory', description: 'The founder of Raviga Capital and Pied Piper\'s first investor, who reads markets through patterns nobody else notices.'})
CREATE (:Company {key: 'pied-piper', name: 'Pied Piper', description: 'Richard Hendricks\'s startup, founded in March 2014 to turn middle-out into a business.', founded: date('2014-03-01'), founded_precision: 'month', name_bought_from: 'a sprinkler company in Gilroy', rejected_offer_usd: 10000000})
CREATE (:Product {key: 'pied-piper-app', name: 'Pied Piper platform', description: 'Pied Piper\'s platform for storing and streaming files at a fraction of their original size.'})
CREATE (:Product {key: 'pied-piper-music', name: 'Pied Piper music app', description: 'Richard\'s first product: a website that checks a songwriter\'s melody against existing music for copyright matches.'})
CREATE (:Place {key: 'pied-piper-office', name: 'Pied Piper office', description: 'Pied Piper\'s own office in Mountain View, its base since it left the incubator in September 2014.'})
CREATE (:Product {key: 'piper-chat', name: 'PiperChat', description: 'A video chat app Pied Piper launched in 2017 that grew fast, including among users too young to sign up.', potential_fines_usd: 21000000000})
CREATE (:Product {key: 'pipercoin', name: 'PiperCoin', description: 'Pied Piper\'s own cryptocurrency, created to raise money for PiperNet.'})
CREATE (:Product {key: 'pipernet', name: 'PiperNet', description: 'Pied Piper\'s decentralised internet, run on the phones of its users instead of on central servers.'})
CREATE (:Company {key: 'raviga', name: 'Raviga Capital', description: 'The venture capital firm Peter Gregory founded, with a long and uneasy stake in Pied Piper.'})
CREATE (:Person {key: 'richard-hendricks', name: 'Richard Hendricks', description: 'A gifted and anxious programmer who left Hooli to found Pied Piper on the strength of middle-out.', hometown: 'Tulsa', indentation: 'tabs'})
CREATE (:Person {key: 'ron-laflamme', name: 'Ron LaFlamme', description: 'Pied Piper\'s lawyer, who handles its contracts, its name and its frequent legal scares.'})
CREATE (:Product {key: 'russ-car', name: 'Russ Hanneman\'s car', description: 'A sports car chosen so that nobody in the car park misses Russ Hanneman\'s arrival.', doors: 'open upwards'})
CREATE (:Person {key: 'russ-hanneman', name: 'Russ Hanneman', description: 'A billionaire investor who made his fortune by putting radio on the internet, and who makes sure everyone knows it.', net_worth_commas: 3, roi_stands_for: 'Radio on internet'})
CREATE (:City {key: 'san-francisco', name: 'San Francisco', description: 'The city at the north end of the Peninsula, where Bachmanity keeps its office and TechCrunch Disrupt is held.'})
CREATE (:Place {key: 'sand-hill-road', name: 'Sand Hill Road', description: 'The road in Menlo Park where venture firms keep their offices, Raviga Capital and Bream-Hall among them.'})
CREATE (:Product {key: 'seefood', name: 'SeeFood', description: 'An app meant to identify any food from a photo. Its only working model can tell whether a photo shows a hot dog.', working_models: 1})
CREATE (:AI {key: 'son-of-anton', name: 'Son of Anton', description: 'An AI that Gilfoyle trained on Anton\'s code to write and fix software. It reaches every goal by the shortest route, whether or not anyone wanted that route.', bug_fix_strategy: 'delete the code', meat_ordered_for_lunch_lb: 4000})
CREATE (:Event {key: 'techcrunch-disrupt', name: 'TechCrunch Disrupt', description: 'A startup competition in San Francisco where Pied Piper beat Hooli\'s Nucleus on stage in 2014.', prize_usd: 50000})
CREATE (:Product {key: 'the-box', name: 'The Box (Signature Edition)', description: 'A server appliance for companies that want their data in a box they can see. The Signature Edition carries Gavin Belson\'s signature.', first_pitched_at: 'Pied Piper', signed_by: 'Gavin Belson'})
CREATE (:Company {key: 'tres-commas', name: 'Tres Commas', description: 'Russ Hanneman\'s brand, named for the three commas in a billion dollars.'})
CREATE (:Product {key: 'tres-commas-tequila', name: 'Tres Commas tequila', description: 'A tequila sold under Russ Hanneman\'s Tres Commas brand, with a label as loud as its owner.'})
CREATE (:Person {key: 'winnie', name: 'Winnie', description: 'A developer Richard dated until it emerged that she indents her code with spaces.', indentation: 'spaces'})
