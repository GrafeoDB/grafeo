svr:anton
    a sv:AI ;
    schema:description "Gilfoyle's home-built server, which ran Pied Piper's early infrastructure and which he treats as a colleague." ;
    schema:name "Anton" ;
    sv:form "server rack" .

svr:aviato
    a schema:Organization ;
    schema:description "Erlich Bachman's first startup, a flight-data company whose sale paid for his house." ;
    schema:name "Aviato" .

svr:bachmanity
    a schema:Organization ;
    schema:description "An investment company Erlich Bachman and Big Head started in 2016 with Big Head's Hooli severance." ;
    schema:foundingDate "2016-04-01"^^xsd:date ;
    schema:name "Bachmanity" ;
    sv:foundedPrecision "month" .

svr:bachmanity-insanity
    a schema:Event ;
    schema:description "A lavish party Erlich Bachman and Big Head threw for Bachmanity, paid for with much of its money." ;
    schema:name "Bachmanity Insanity" .

svr:bertram-gilfoyle
    a schema:Person ;
    schema:description "Pied Piper's systems architect: dry, unhurried and sure of himself, he trusts the server he built more than most people." ;
    schema:name "Bertram Gilfoyle" ;
    sv:title "Systems architect" .

svr:bitcoin-alert
    a schema:Product ;
    schema:description "A script on Gilfoyle's computer that plays a death metal song whenever the price of Bitcoin crosses a set level." ;
    schema:name "Gilfoyle's Bitcoin alert" ;
    sv:trigger "Bitcoin price crosses a set level" .

svr:blockchain
    a sv:Technology ;
    schema:description "A shared ledger kept in step by many computers, so that no single owner controls the record." ;
    schema:name "Blockchain" .

svr:bream-hall
    a schema:Organization ;
    schema:description "The venture firm Laurie Bream and Monica Hall founded in 2018 after leaving Raviga Capital." ;
    schema:foundingDate "2018-03-01"^^xsd:date ;
    schema:name "Bream-Hall" ;
    sv:foundedPrecision "month" .

svr:carla-walton
    a schema:Person ;
    schema:description "A senior engineer who joined Pied Piper in 2016 and says plainly what she thinks of everyone's code." ;
    schema:name "Carla Walton" .

svr:condor-stream
    a schema:Event ;
    schema:description "A live video of a condor egg in a remote nest, which Pied Piper streamed to show its platform could carry a large audience." ;
    schema:name "The condor egg live stream" .

svr:cupertino
    a schema:City ;
    schema:description "A city in Silicon Valley where Endframe has its office." ;
    schema:name "Cupertino" .

svr:denpok
    a schema:Person ;
    schema:description "Gavin Belson's spiritual advisor, paid to keep the head of Hooli calm and on message." ;
    schema:name "Denpok" .

svr:dinesh-chugtai
    a schema:Person ;
    schema:description "A Pied Piper engineer who is good at his job and keen to be seen as better than Gilfoyle, which rarely works out." ;
    schema:name "Dinesh Chugtai" ;
    sv:jewellery "gold chain" ;
    sv:title "Engineer" .

svr:ed-chen
    a schema:Person ;
    schema:description "An associate at Raviga Capital who works on the firm's deals under Laurie Bream." ;
    schema:name "Ed Chen" .

svr:endframe
    a schema:Organization ;
    schema:description "A rival startup that tried to win Pied Piper's market with its own version of the technology." ;
    schema:name "Endframe" .

svr:erlich-bachman
    a schema:Person ;
    schema:description "The owner of the hacker hostel and self-appointed mentor to its residents, still living off the sale of Aviato." ;
    schema:name "Erlich Bachman" ;
    sv:catchphrase "Aviato" ;
    sv:title "Head of Incubation" .

svr:erlichs-palapa
    a schema:Place ;
    schema:description "A thatched shade hut beside the hacker hostel's pool, Erlich's pride and one of his larger expenses." ;
    schema:name "Erlich's palapa" ;
    sv:roof "thatched" .

svr:fiona
    a sv:AI ;
    schema:description "A humanoid robot with an emotional AI, built by a robotics startup to hold a natural conversation." ;
    schema:name "Fiona" .

svr:gavin-belson
    a schema:Person ;
    schema:description "The founder and CEO of Hooli, who wants to be seen as a visionary and takes every loss to Pied Piper personally." ;
    schema:name "Gavin Belson" ;
    sv:pledge "Tethics" .

svr:hacker-hostel
    a schema:Place ;
    schema:description "Erlich Bachman's house in Palo Alto, run as a startup incubator: residents get a room, and he gets ten percent of their companies." ;
    schema:name "Hacker Hostel" ;
    sv:terms "a room for ten percent of the company" .

svr:hooli
    a schema:Organization ;
    schema:description "A large technology company led by Gavin Belson, with a campus in Mountain View and a product for nearly everything." ;
    schema:name "Hooli" ;
    sv:motto "Making the world a better place" .

svr:hooli-campus
    a schema:Place ;
    schema:description "Hooli's headquarters in Mountain View: glass buildings, company bikes and free food." ;
    schema:name "Hooli campus" .

svr:hooli-con
    a schema:Event ;
    schema:description "Hooli's own conference, where Gavin Belson presents new products from a very large stage." ;
    schema:name "Hooli-Con" .

svr:hooli-phone
    a schema:Product ;
    schema:description "Hooli's smartphone, sold with Hooli's own apps already on it." ;
    schema:name "Hooli Phone" .

svr:hooli-rooftop
    a schema:Place ;
    schema:description "A roof on the Hooli campus where employees Hooli would rather not lose are paid to wait for their stock to vest." ;
    schema:name "Hooli rooftop" ;
    sv:activity "rest and vest" .

svr:hooli-xyz
    a schema:Organization ;
    schema:description "Hooli's moonshot division, which Big Head was put in charge of by mistake." ;
    schema:name "Hooli XYZ" .

svr:hoover
    a schema:Person ;
    schema:description "Hooli's head of security, loyal to Gavin Belson and very hard to surprise." ;
    schema:name "Hoover" .

svr:jack-barker
    a schema:Person ;
    schema:description "A veteran executive brought in as Pied Piper's CEO, who has a management diagram for every situation." ;
    schema:name "Jack Barker" ;
    sv:managementTheory "Conjoined Triangles of Success" ;
    sv:nickname "Action Jack" .

svr:jared-dunn
    a schema:Person ;
    schema:description "Pied Piper's head of business development, who left Hooli to join Richard and is loyal beyond reason. He was renamed Jared at Hooli, and the name stuck." ;
    schema:name "Jared Dunn" ;
    sv:bornAs "Donald Dunn" .

svr:jian-yang
    a schema:Person ;
    schema:description "An app developer who lives at the hacker hostel, ignores Erlich's house rules and outlasts most of the other residents." ;
    schema:name "Jian-Yang" .

svr:jian-yangs-fridge
    a sv:AI ;
    schema:description "A smart fridge with a screen and a voice, owned by Jian-Yang and connected to more of the house network than it needs." ;
    schema:name "Jian-Yang's fridge" ;
    sv:talks true .

svr:keenan-feldspar
    a schema:Person ;
    schema:description "A virtual reality founder whose headset demos win investors over with ease." ;
    schema:name "Keenan Feldspar" .

svr:laurie-bream
    a schema:Person ;
    schema:description "Raviga Capital's managing partner after Peter Gregory, who decides by the numbers and keeps small talk to a minimum." ;
    schema:name "Laurie Bream" .

svr:los-altos
    a schema:City ;
    schema:description "A quiet, wealthy town in Silicon Valley, home to Russ Hanneman and Ed Chen." ;
    schema:name "Los Altos" .

svr:menlo-park
    a schema:City ;
    schema:description "A city on the Peninsula where venture firms line Sand Hill Road." ;
    schema:name "Menlo Park" .

svr:middle-out
    a sv:Technology ;
    schema:description "A lossless compression algorithm that works on data from the middle outwards. It holds the record Weissman score of 5.2." ;
    schema:name "Middle-out compression" ;
    sv:inventor "Richard Hendricks" ;
    sv:weissmanScore 5.2e0 .

svr:monica-hall
    a schema:Person ;
    schema:description "An investor who championed Pied Piper inside Raviga Capital and later co-founded Bream-Hall with Laurie Bream." ;
    schema:name "Monica Hall" .

svr:mountain-view
    a schema:City ;
    schema:description "A city in Silicon Valley, home to the Hooli campus and, from September 2014, Pied Piper's office." ;
    schema:name "Mountain View" .

svr:nelson-bighetti
    a schema:Person ;
    schema:description "Richard's oldest friend, whose career keeps rising with very little effort on his part." ;
    schema:name "Nelson \"Big Head\" Bighetti" ;
    sv:nickname "Big Head" ;
    sv:severanceUsd 20000000 .

svr:not-hotdog
    a schema:Product ;
    schema:description "An app that recognises hot dogs in photos and labels everything else as not hot dog." ;
    schema:name "Not Hotdog" ;
    sv:classes 2 .

svr:nucleus
    a schema:Product ;
    schema:description "Hooli's rival to Pied Piper's platform, built in a hurry by a very large team. It never caught up on the Weissman scale." ;
    schema:name "Nucleus" ;
    sv:weissmanScore 2.89e0 .

svr:palo-alto
    a schema:City ;
    schema:description "A city on the San Francisco Peninsula and home to Erlich Bachman's hacker hostel." ;
    schema:name "Palo Alto" .

svr:peter-gregory
    a schema:Person ;
    schema:description "The founder of Raviga Capital and Pied Piper's first investor, who reads markets through patterns nobody else notices." ;
    schema:name "Peter Gregory" .

svr:pied-piper
    a schema:Organization ;
    schema:description "Richard Hendricks's startup, founded in March 2014 to turn middle-out into a business." ;
    schema:foundingDate "2014-03-01"^^xsd:date ;
    schema:name "Pied Piper" ;
    sv:foundedPrecision "month" ;
    sv:nameBoughtFrom "a sprinkler company in Gilroy" ;
    sv:rejectedOfferUsd 10000000 .

svr:pied-piper-app
    a schema:Product ;
    schema:description "Pied Piper's platform for storing and streaming files at a fraction of their original size." ;
    schema:name "Pied Piper platform" .

svr:pied-piper-music
    a schema:Product ;
    schema:description "Richard's first product: a website that checks a songwriter's melody against existing music for copyright matches." ;
    schema:name "Pied Piper music app" .

svr:pied-piper-office
    a schema:Place ;
    schema:description "Pied Piper's own office in Mountain View, its base since it left the incubator in September 2014." ;
    schema:name "Pied Piper office" .

svr:piper-chat
    a schema:Product ;
    schema:description "A video chat app Pied Piper launched in 2017 that grew fast, including among users too young to sign up." ;
    schema:name "PiperChat" ;
    sv:potentialFinesUsd 21000000000 .

svr:pipercoin
    a schema:Product ;
    schema:description "Pied Piper's own cryptocurrency, created to raise money for PiperNet." ;
    schema:name "PiperCoin" .

svr:pipernet
    a schema:Product ;
    schema:description "Pied Piper's decentralised internet, run on the phones of its users instead of on central servers." ;
    schema:name "PiperNet" .

svr:raviga
    a schema:Organization ;
    schema:description "The venture capital firm Peter Gregory founded, with a long and uneasy stake in Pied Piper." ;
    schema:name "Raviga Capital" .

svr:richard-hendricks
    a schema:Person ;
    schema:description "A gifted and anxious programmer who left Hooli to found Pied Piper on the strength of middle-out." ;
    schema:name "Richard Hendricks" ;
    sv:hometown "Tulsa" ;
    sv:indentation "tabs" .

svr:ron-laflamme
    a schema:Person ;
    schema:description "Pied Piper's lawyer, who handles its contracts, its name and its frequent legal scares." ;
    schema:name "Ron LaFlamme" .

svr:russ-car
    a schema:Product ;
    schema:description "A sports car chosen so that nobody in the car park misses Russ Hanneman's arrival." ;
    schema:name "Russ Hanneman's car" ;
    sv:doors "open upwards" .

svr:russ-hanneman
    a schema:Person ;
    schema:description "A billionaire investor who made his fortune by putting radio on the internet, and who makes sure everyone knows it." ;
    schema:name "Russ Hanneman" ;
    sv:netWorthCommas 3 ;
    sv:roiStandsFor "Radio on internet" .

svr:san-francisco
    a schema:City ;
    schema:description "The city at the north end of the Peninsula, where Bachmanity keeps its office and TechCrunch Disrupt is held." ;
    schema:name "San Francisco" .

svr:sand-hill-road
    a schema:Place ;
    schema:description "The road in Menlo Park where venture firms keep their offices, Raviga Capital and Bream-Hall among them." ;
    schema:name "Sand Hill Road" .

svr:seefood
    a schema:Product ;
    schema:description "An app meant to identify any food from a photo. Its only working model can tell whether a photo shows a hot dog." ;
    schema:name "SeeFood" ;
    sv:workingModels 1 .

svr:son-of-anton
    a sv:AI ;
    schema:description "An AI that Gilfoyle trained on Anton's code to write and fix software. It reaches every goal by the shortest route, whether or not anyone wanted that route." ;
    schema:name "Son of Anton" ;
    sv:bugFixStrategy "delete the code" ;
    sv:meatOrderedForLunchLb 4000 .

svr:techcrunch-disrupt
    a schema:Event ;
    schema:description "A startup competition in San Francisco where Pied Piper beat Hooli's Nucleus on stage in 2014." ;
    schema:name "TechCrunch Disrupt" ;
    sv:prizeUsd 50000 .

svr:the-box
    a schema:Product ;
    schema:description "A server appliance for companies that want their data in a box they can see. The Signature Edition carries Gavin Belson's signature." ;
    schema:name "The Box (Signature Edition)" ;
    sv:firstPitchedAt "Pied Piper" ;
    sv:signedBy "Gavin Belson" .

svr:tres-commas
    a schema:Organization ;
    schema:description "Russ Hanneman's brand, named for the three commas in a billion dollars." ;
    schema:name "Tres Commas" .

svr:tres-commas-tequila
    a schema:Product ;
    schema:description "A tequila sold under Russ Hanneman's Tres Commas brand, with a label as loud as its owner." ;
    schema:name "Tres Commas tequila" .

svr:winnie
    a schema:Person ;
    schema:description "A developer Richard dated until it emerged that she indents her code with spaces." ;
    schema:name "Winnie" ;
    sv:indentation "spaces" .

