# Common Error Handling and Edge Cases
#
# Covers: syntax errors, semantic errors, invalid operations,
# constraint violations, type errors across query execution.
# Uses GQL as the primary language for error scenario testing.

meta:
  language: gql
  model: lpg
  section: errors
  title: Error handling
  dataset: empty

tests:

  # ---------------------------------------------------------------------------
  # Syntax errors
  # ---------------------------------------------------------------------------

  - name: unclosed_parenthesis
    query: "MATCH (n:Person RETURN n.name"
    expect:
      error: "syntax"

  - name: missing_return_clause
    query: "MATCH (n:Person)"
    expect:
      error: ""

  - name: unknown_clause
    query: "FROBNICATE (n:Person) RETURN n.name"
    expect:
      error: "syntax"

  - name: empty_query
    query: ""
    expect:
      error: ""

  # ---------------------------------------------------------------------------
  # Invalid pattern syntax
  # ---------------------------------------------------------------------------

  - name: edge_without_nodes
    query: "MATCH -[:KNOWS]-> RETURN count(*)"
    expect:
      error: "syntax"

  # `-->` is Cypher's spelling; ISO GQL writes `->`. GQL rejects `-->` from
  # 0.7.0 (deprecated in 0.6.x, user decision 2026-10-30); Cypher keeps it.
  - name: double_arrow
    skip: "`-->` in GQL is accepted until 0.7.0, deprecated in 0.6.x"
    query: "MATCH (a)-->(b) RETURN a"
    expect:
      error: "syntax"

  - name: double_arrow_in_cypher
    language: cypher
    requires: [cypher]
    setup:
      - "INSERT (:P {k: 1})-[:R]->(:P {k: 2})"
    query: "MATCH (a)-->(b) RETURN a.k AS a, b.k AS b"
    expect:
      rows:
        - [1, 2]

  # ---------------------------------------------------------------------------
  # Semantic errors: operations on wrong types
  # ---------------------------------------------------------------------------

  # ISO GQL has no `+` on strings (it concatenates with `||`): a string plus
  # a number is an error, in either order (user decision 2026-10-30).
  # openCypher concatenates them, in either order.
  - name: add_string_and_integer
    skip: "GQL concatenates a string and a number with + instead of failing"
    setup:
      - "INSERT (:N {name: 'hello', age: 30})"
    query: "MATCH (n:N) RETURN n.name + n.age AS result"
    expect:
      error: ""

  - name: add_integer_and_string
    skip: "GQL gives null for a number plus a string instead of failing"
    query: "RETURN 30 + 'hello' AS result"
    expect:
      error: ""

  - name: add_string_and_number_in_cypher
    skip: "Cypher gives null for a number plus a string instead of concatenating"
    language: cypher
    requires: [cypher]
    query: "RETURN 'hello' + 30 AS a, 30 + 'hello' AS b, 'v' + 1.5 AS c"
    expect:
      rows:
        - [hello30, 30hello, v1.5]

  - name: negate_string
    setup:
      - "INSERT (:N {name: 'hello'})"
    query: "MATCH (n:N) RETURN -n.name AS result"
    expect:
      error: "unary - takes a number or a duration"
      gql_status: "22G03"

  # ---------------------------------------------------------------------------
  # Delete with dependencies
  # ---------------------------------------------------------------------------

  - name: delete_node_with_edges_no_detach
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    query: "MATCH (p:Person {name: 'Alix'}) DELETE p"
    expect:
      error: ""

  - name: detach_delete_works
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    query: |
      MATCH (p:Person {name: 'Alix'}) DETACH DELETE p
      RETURN count(*) AS cnt
    expect:
      count: 1

  # ---------------------------------------------------------------------------
  # Invalid aggregation
  # ---------------------------------------------------------------------------

  - name: non_aggregated_column_without_group_by
    setup:
      - "INSERT (:Person {name: 'Alix', age: 30})"
      - "INSERT (:Person {name: 'Gus', age: 25})"
    query: "MATCH (p:Person) RETURN p.name, sum(p.age)"
    expect:
      count: 2

  # ---------------------------------------------------------------------------
  # Division and modulo edge cases
  # ---------------------------------------------------------------------------

  - name: integer_division_by_zero_error
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN 10 / 0"
    expect:
      error: "division"

  - name: float_division_by_zero_infinity
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN 10.0e0 / 0.0e0"
    expect:
      rows:
        - [Infinity]

  - name: zero_divided_by_zero_float
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN 0.0e0 / 0.0e0"
    expect:
      rows:
        - [NaN]

  # ---------------------------------------------------------------------------
  # Invalid function calls
  # ---------------------------------------------------------------------------

  # A call of an unknown function, or with a number of arguments the
  # function does not take, fails while the query is planned (#570); it
  # returned null.
  - name: unknown_function
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN nonexistent_function(n.v)"
    expect:
      error: "Unknown function 'nonexistent_function'"

  - name: wrong_argument_count
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN abs(1, 2)"
    expect:
      error: "Function 'abs' takes 1 argument, got 2"

  # ---------------------------------------------------------------------------
  # Insert/Delete edge cases
  # ---------------------------------------------------------------------------

  - name: insert_edge_nonexistent_source
    query: |
      MATCH (a:Person {name: 'Ghost'}), (b:Person {name: 'Nobody'})
      INSERT (a)-[:KNOWS]->(b)
      RETURN count(*) AS cnt
    expect:
      rows:
        - [0]

  - name: set_property_on_empty_match
    query: "MATCH (n:NonExistent) SET n.x = 42 RETURN count(*) AS cnt"
    expect:
      rows:
        - [0]

  - name: delete_from_empty_match
    query: "MATCH (n:NonExistent) DELETE n RETURN count(*) AS cnt"
    expect:
      rows:
        - [0]
