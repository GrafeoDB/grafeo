# Procedure arguments: their errors and how a value arrives
#
# ISO/IEC 39075 GQLSTATUS for a call's arguments: a value of another type than
# the argument takes is 22G03 (invalid value type), a parameter the statement
# does not give and a parameter a stored procedure's body names but does not
# declare are 42002 (invalid reference), and a call with another number of
# arguments is 42000. A float argument of a stored procedure arrives as a
# float (it arrived as a decimal while arguments were pasted into the body).

meta:
  language: gql
  model: lpg
  section: "25.1"
  title: Procedure argument statuses
  dataset: empty
  requires: [algos, cypher]

tests:

  # ---------------------------------------------------------------------------
  # Built-in procedures
  # ---------------------------------------------------------------------------

  - name: an_argument_of_another_type_is_22g03
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    params:
      d: "high"
    variants:
      gql: "CALL grafeo.pagerank($d) YIELD score RETURN score"
      cypher: "CALL grafeo.pagerank($d) YIELD score RETURN score"
    expect:
      error: "Argument 'damping' of grafeo.pagerank"
      gql_status: "22G03"

  - name: a_missing_parameter_is_42002
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    variants:
      gql: "CALL grafeo.bfs($start) YIELD node_id RETURN node_id"
      cypher: "CALL grafeo.bfs($start) YIELD node_id RETURN node_id"
    expect:
      error: "Missing parameter: $start"
      gql_status: "42002"

  - name: an_unknown_procedure_is_42002
    variants:
      gql: "CALL grafeo.nowhere() YIELD x RETURN x"
      cypher: "CALL grafeo.nowhere() YIELD x RETURN x"
    expect:
      error: "unknown procedure 'grafeo.nowhere'"
      gql_status: "42002"

  # ---------------------------------------------------------------------------
  # Stored procedures
  # ---------------------------------------------------------------------------

  - name: a_float_argument_arrives_as_a_float
    setup:
      - "CREATE PROCEDURE halve(x FLOAT64) RETURNS (v FLOAT64) AS { RETURN $x / 2 AS v }"
    query: "CALL halve(1.5e0) YIELD v RETURN v"
    expect:
      rows:
        - [0.75]

  - name: a_float_argument_is_typed_float64
    setup:
      - "CREATE PROCEDURE kind(x FLOAT64) RETURNS (f BOOLEAN) AS { RETURN $x IS TYPED FLOAT64 AS f }"
    query: "CALL kind(1.5e0) YIELD f RETURN f"
    expect:
      rows:
        - [true]

  - name: a_parameter_the_procedure_does_not_declare_is_named
    setup:
      - "CREATE PROCEDURE stray(a INT64) RETURNS (v INT64) AS { RETURN $z AS v }"
    query: "CALL stray(1) YIELD v RETURN v"
    expect:
      error: "procedure 'stray': Missing parameter: $z"
      gql_status: "42002"

  - name: a_call_with_another_number_of_arguments_is_42000
    setup:
      - "CREATE PROCEDURE pair(a INT64, b INT64) RETURNS (s INT64) AS { RETURN $a + $b AS s }"
    query: "CALL pair(1) YIELD s RETURN s"
    expect:
      error: "procedure 'pair' takes 2 arguments, the call gives 1"
      gql_status: "42000"

  - name: arguments_from_parameters_reach_the_body
    setup:
      - "CREATE PROCEDURE pair(a INT64, b INT64) RETURNS (s INT64) AS { RETURN $a + $b AS s }"
    query: "CALL pair($x, $y) YIELD s RETURN s"
    params:
      x: 2
      y: 40
    expect:
      rows:
        - [42]
