# Cypher administrative commands: CREATE INDEX, DROP INDEX, SHOW INDEXES, EXPLAIN, PROFILE
#
# Based on the openCypher specification and Neo4j Cypher administrative commands.

meta:
  language: cypher
  model: lpg
  section: "7"
  title: Administrative Commands
  dataset: empty

tests:

  # ---------------------------------------------------------------------------
  # CREATE INDEX
  # ---------------------------------------------------------------------------

  - name: create_index_on_label_property
    statements:
      - "CREATE INDEX idx_person_name FOR (n:Person) ON (n.name)"
      - "CREATE (:Person {name: 'Alix'})"
      - "MATCH (n:Person {name: 'Alix'}) RETURN n.name"
    expect:
      rows:
        - [Alix]

  - name: create_index_and_query
    statements:
      - "CREATE INDEX idx_city_pop FOR (c:City) ON (c.population)"
      - "CREATE (:City {name: 'Amsterdam', population: 900000})"
      - "CREATE (:City {name: 'Berlin', population: 3600000})"
      - "MATCH (c:City) WHERE c.population > 1000000 RETURN c.name"
    expect:
      rows:
        - [Berlin]

  # ---------------------------------------------------------------------------
  # DROP INDEX
  # ---------------------------------------------------------------------------

  - name: drop_index
    statements:
      - "CREATE INDEX idx_person_name FOR (n:Person) ON (n.name)"
      - "DROP INDEX idx_person_name"
      - "CREATE (:Person {name: 'Alix'})"
      - "MATCH (n:Person {name: 'Alix'}) RETURN n.name"
    expect:
      rows:
        - [Alix]

  # ---------------------------------------------------------------------------
  # SHOW INDEXES
  # ---------------------------------------------------------------------------

  - name: show_indexes_empty
    query: SHOW INDEXES
    expect:
      empty: true

  - name: show_indexes_after_create
    statements:
      - "CREATE INDEX idx_person_name FOR (n:Person) ON (n.name)"
      - "SHOW INDEXES"
    expect:
      count: 1

  # #344: an unnamed index gets the name label_properties_index.
  - name: show_indexes_after_create_unnamed
    statements:
      - "CREATE INDEX FOR (n:Person) ON (n.name)"
      - "SHOW INDEXES"
    expect:
      rows:
        - [Person_name_index, Hash, Person, name]

  - name: unnamed_index_drops_by_its_default_name
    statements:
      - "CREATE INDEX FOR (n:Person) ON (n.name)"
      - "DROP INDEX Person_name_index"
      - "SHOW INDEXES"
    expect:
      empty: true

  - name: unnamed_index_if_not_exists_is_created_once
    statements:
      - "CREATE INDEX IF NOT EXISTS FOR (n:Person) ON (n.name)"
      - "CREATE INDEX IF NOT EXISTS FOR (n:Person) ON (n.name)"
      - "SHOW INDEXES"
    expect:
      rows:
        - [Person_name_index, Hash, Person, name]

  # USING TEXT|VECTOR|BTREE [{options}] picks the index kind, as in GQL
  # (#344). text_match is false for every row without a text index, so a
  # matching row shows the index is one.
  - name: create_index_using_text
    requires: [text-index]
    setup:
      - "CREATE (:Article {title: 'A1', body: 'rust database internals'}), (:Article {title: 'A2', body: 'attention mechanisms'})"
    statements:
      - "CREATE INDEX FOR (n:Article) ON (n.body) USING TEXT"
      - "MATCH (n:Article) WHERE text_match(n.body, 'rust database') RETURN n.title AS title"
    expect:
      rows:
        - [A1]

  - name: create_index_using_text_with_options
    requires: [text-index]
    setup:
      - "CREATE (:Article {title: 'A1', body: 'rust and database internals'}), (:Article {title: 'A2', body: 'attention mechanisms'})"
    statements:
      - "CREATE INDEX article_body FOR (n:Article) ON (n.body) USING TEXT {k1: 1.2, b: 0.75, stop_words: ['and']}"
      - "MATCH (n:Article) WHERE text_match(n.body, 'database') RETURN n.title AS title"
    expect:
      rows:
        - [A1]

  - name: create_index_using_text_with_an_unknown_option_is_an_error
    requires: [text-index]
    query: "CREATE INDEX FOR (n:Article) ON (n.body) USING TEXT {analyzer: 'standard'}"
    expect:
      error: "Unknown text index option 'analyzer'"

  - name: create_index_using_text_with_a_mistyped_option_is_an_error
    requires: [text-index]
    query: "CREATE INDEX FOR (n:Article) ON (n.body) USING TEXT {k1: 'high'}"
    expect:
      error: "Expected a number for k1"

  - name: create_index_using_vector_with_options
    requires: [vector-index]
    setup:
      - "CREATE (:Doc {name: 'Amsterdam', emb: vector([1.0, 0.0])}), (:Doc {name: 'Berlin', emb: vector([0.0, 1.0])}), (:Doc {name: 'Paris', emb: vector([0.8, 0.6])})"
    statements:
      - "CREATE INDEX FOR (d:Doc) ON (d.emb) USING VECTOR {dimensions: 2, metric: 'cosine'}"
      - "CALL grafeo.search.vector('Doc', 'emb', [1.0, 0.0], 2) YIELD node_id RETURN node_id ORDER BY node_id"
    expect:
      ordered: true
      rows:
        - [0]
        - [2]

  - name: create_index_using_vector_with_a_mistyped_dimension_is_an_error
    requires: [vector-index]
    query: "CREATE INDEX FOR (d:Doc) ON (d.emb) USING VECTOR {dimensions: 'two'}"
    expect:
      error: "Expected integer for dimensions"

  - name: create_index_using_btree
    statements:
      - "CREATE INDEX FOR (p:Person) ON (p.age) USING BTREE"
      - "SHOW INDEXES"
    expect:
      rows:
        - [Person_age_index, BTree, Person, age]

  - name: create_index_using_an_unknown_kind_is_an_error
    query: "CREATE INDEX FOR (p:Person) ON (p.age) USING HASH"
    expect:
      error: "Unknown index type 'HASH'"

  # ---------------------------------------------------------------------------
  # EXPLAIN
  # ---------------------------------------------------------------------------

  - name: explain_match
    setup:
      - "CREATE (:Person {name: 'Alix'})"
    query: "EXPLAIN MATCH (n:Person) RETURN n.name"
    expect:
      count: 1

  # ---------------------------------------------------------------------------
  # PROFILE
  # ---------------------------------------------------------------------------

  - name: profile_match
    setup:
      - "CREATE (:Person {name: 'Alix'})"
    query: "PROFILE MATCH (n:Person) RETURN n.name"
    expect:
      count: 1
