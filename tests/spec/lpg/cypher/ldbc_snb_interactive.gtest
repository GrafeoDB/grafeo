  # IU4. Add forum: Album 2 of John Kumar, from the LDBC update stream (tag list inline).
  - name: iu4_add_forum
    params:
      moderatorPersonId: 41
      forumId: 343597384372
      forumTitle: "Album 2 of John Kumar"
      creationDate: 1291170270978
    statements:
      - |
        MATCH (p:Person {id: $moderatorPersonId})
        CREATE (f:Forum {id: $forumId, title: $forumTitle, creationDate: $creationDate})-[:HAS_MODERATOR]->(p)
        WITH f
        UNWIND [1410] AS tagId
          MATCH (t:Tag {id: tagId})
          CREATE (f)-[:HAS_TAG]->(t)
