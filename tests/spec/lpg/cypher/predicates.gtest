# Cypher predicates: regular expressions and patterns in WHERE
#
# `s =~ pattern` is true when the pattern matches the whole string (inline
# flags such as `(?i)` still apply). A pattern with a relationship in WHERE,
# `(d)-[:T]->()`, is true when it has a match, like EXISTS { MATCH ... };
# `NOT (d)-[:T]->()` keeps the rows without one.

meta:
  language: cypher
  model: lpg
  dataset: empty
  requires: [cypher]

tests:

  # ---------------------------------------------------------------------------
  # =~ matches the whole string
  # ---------------------------------------------------------------------------

  - name: regex_suffix_pattern_matches_the_whole_string
    setup:
      - "CREATE (:T {name: 'AlphaServiceImpl'}), (:T {name: 'AlphaService'})"
    query: "MATCH (n:T) WHERE n.name =~ '.*Service' RETURN n.name"
    expect:
      rows:
        - [AlphaService]

  - name: regex_prefix_alone_does_not_match
    setup:
      - "CREATE (:T {name: 'AlphaServiceImpl'}), (:T {name: 'AlphaService'})"
    query: "MATCH (n:T) WHERE n.name =~ 'Alpha' RETURN n.name"
    expect:
      empty: true

  - name: regex_inline_flag_matches_the_whole_string
    setup:
      - "CREATE (:T {name: 'AlphaServiceImpl'}), (:T {name: 'AlphaService'})"
    query: "MATCH (n:T) WHERE n.name =~ '(?i)alphaservice' RETURN n.name"
    expect:
      rows:
        - [AlphaService]

  - name: regex_anchors_still_work
    setup:
      - "CREATE (:T {name: 'AlphaServiceImpl'}), (:T {name: 'AlphaService'})"
    query: "MATCH (n:T) WHERE n.name =~ '^.*Service$' RETURN n.name"
    expect:
      rows:
        - [AlphaService]

  - name: regex_alternation_covers_the_whole_string
    setup:
      - "CREATE (:T {name: 'route'}), (:T {name: 'api'}), (:T {name: 'router'})"
    query: "MATCH (n:T) WHERE n.name =~ 'route|api' RETURN n.name ORDER BY n.name"
    expect:
      rows:
        - [api]
        - [route]

  # ---------------------------------------------------------------------------
  # Pattern predicates
  # ---------------------------------------------------------------------------

  - name: pattern_predicate_keeps_rows_with_a_match
    setup:
      - "CREATE (:Dir {id: 'a'})-[:CONTAINS]->(:File {id: 'f'})"
      - "CREATE (:Dir {id: 'empty'})"
    query: "MATCH (d:Dir) WHERE (d)-[:CONTAINS]->() RETURN d.id"
    expect:
      rows:
        - [a]

  - name: negated_pattern_predicate_keeps_rows_without_a_match
    setup:
      - "CREATE (:Dir {id: 'a'})-[:CONTAINS]->(:File {id: 'f'})"
      - "CREATE (:Dir {id: 'empty'})"
    query: "MATCH (d:Dir) WHERE NOT (d)-[:CONTAINS]->() RETURN d.id"
    expect:
      rows:
        - [empty]

  - name: untyped_pattern_predicate
    setup:
      - "CREATE (:Dir {id: 'a'})-[:CONTAINS]->(:File {id: 'f'})"
      - "CREATE (:Dir {id: 'empty'})"
    query: "MATCH (d:Dir) WHERE (d)-->() RETURN d.id"
    expect:
      rows:
        - [a]

  - name: pattern_predicate_with_a_backquoted_type
    setup:
      - "CREATE (:Graph:Dir {id: 'a'})-[:`Graph:CONTAINS`]->(:Graph:File {id: 'f'})"
      - "CREATE (:Graph:Dir {id: 'empty'})"
    query: "MATCH (d:Graph:Dir) WHERE (d)-[:`Graph:CONTAINS`]->() RETURN d.id"
    expect:
      rows:
        - [a]

  - name: pattern_predicate_combined_with_other_conditions
    setup:
      - "CREATE (:Dir {id: 'a'})-[:CONTAINS]->(:File {id: 'f'})"
      - "CREATE (:Dir {id: 'b'})-[:CONTAINS]->(:File {id: 'g'})"
      - "CREATE (:Dir {id: 'empty'})"
    query: "MATCH (d:Dir) WHERE d.id <> 'b' AND (d)-[:CONTAINS]->(:File) RETURN d.id"
    expect:
      rows:
        - [a]

  - name: parenthesized_expressions_still_parse
    setup:
      - "CREATE (:Dir {id: 'a', n: 2})"
    query: "MATCH (d:Dir) WHERE (d.n + 1) * 2 = 6 AND (d.id = 'a') RETURN (d.n)"
    expect:
      rows:
        - [2]

  # ---------------------------------------------------------------------------
  # exists() of a pattern (openCypher 9 predicate function exists()): true
  # when the pattern has a match for the row, like the pattern predicate.
  # It used to be true for every row: exists() read the pattern as a value,
  # which is never null.
  # ---------------------------------------------------------------------------

  - name: exists_of_a_pattern_in_a_projection
    setup:
      - "CREATE (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    query: "MATCH (p:Person) RETURN p.name AS name, exists((p)-[:KNOWS]->()) AS knows ORDER BY name"
    expect:
      ordered: true
      rows:
        - [Alix, true]
        - [Gus, false]
        - [Vincent, false]

  - name: exists_of_an_incoming_pattern_in_a_projection
    setup:
      - "CREATE (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    query: "MATCH (p:Person) RETURN p.name AS name, exists((p)<-[:KNOWS]-()) AS known ORDER BY name"
    expect:
      ordered: true
      rows:
        - [Alix, false]
        - [Gus, true]
        - [Vincent, false]

  - name: exists_of_a_pattern_between_two_bound_nodes
    setup:
      - "CREATE (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    query: |
      MATCH (a:Person), (b:Person) WHERE a.name < b.name
      RETURN a.name, b.name, exists((a)-[:KNOWS]-(b)) AS linked ORDER BY a.name, b.name
    expect:
      ordered: true
      rows:
        - [Alix, Gus, true]
        - [Alix, Vincent, false]
        - [Gus, Vincent, false]

  - name: negated_exists_of_a_pattern_in_a_projection
    setup:
      - "CREATE (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    query: "MATCH (p:Person) RETURN p.name AS name, NOT exists((p)-[:KNOWS]->(:Person {name: 'Gus'})) AS e ORDER BY name"
    expect:
      ordered: true
      rows:
        - [Alix, false]
        - [Gus, true]
        - [Vincent, true]

  - name: exists_of_a_pattern_in_where
    setup:
      - "CREATE (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    query: "MATCH (p:Person) WHERE exists((p)-[:KNOWS]->()) RETURN p.name"
    expect:
      rows:
        - [Alix]

  - name: negated_exists_of_a_pattern_in_where
    setup:
      - "CREATE (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    query: "MATCH (p:Person) WHERE NOT exists((p)-[:KNOWS]->()) RETURN p.name"
    expect:
      rows:
        - [Gus]
        - [Vincent]

  - name: exists_of_a_pattern_in_case
    setup:
      - "CREATE (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    query: |
      MATCH (p:Person)
      RETURN p.name AS name, CASE WHEN exists((p)-[:KNOWS]->()) THEN 'out' ELSE 'none' END AS e
      ORDER BY name
    expect:
      ordered: true
      rows:
        - [Alix, out]
        - [Gus, none]
        - [Vincent, none]

  - name: exists_of_a_property_is_still_a_null_check
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88})-[:KNOWS]->(:Person {name: 'Gus'})"
    query: "MATCH (p:Person) RETURN p.name AS name, exists(p.age) AS e ORDER BY name"
    expect:
      ordered: true
      rows:
        - [Alix, true]
        - [Gus, false]
