# Cypher return and ordering: RETURN, ORDER BY, SKIP, LIMIT
#
# Converted from Python spec tests (test_02_return_ordering.py).

meta:
  language: cypher
  model: lpg
  section: "2"
  title: Return and Ordering
  dataset: empty

tests:

  # ---------------------------------------------------------------------------
  # RETURN
  # ---------------------------------------------------------------------------

  - name: return_expression
    setup:
      - "CREATE (:Person {name: 'Alix', age: 30})"
    query: MATCH (n:Person) RETURN n.name, n.age
    expect:
      rows:
        - [Alix, 30]

  - name: return_alias
    setup:
      - "CREATE (:Person {name: 'Alix'})"
    query: MATCH (n:Person) RETURN n.name AS person_name
    expect:
      rows:
        - [Alix]

  # openCypher orders null as the largest value: last ascending, first
  # descending (GQL puts it last both ways, #571)
  - name: order_by_desc_puts_nulls_first
    setup:
      - "CREATE (:Item {name: 'A', rank: 1})"
      - "CREATE (:Item {name: 'B'})"
      - "CREATE (:Item {name: 'C', rank: 3})"
    query: MATCH (n:Item) RETURN n.name, n.rank ORDER BY n.rank DESC
    expect:
      ordered: true
      rows:
        - [B, null]
        - [C, 3]
        - [A, 1]

  - name: return_distinct
    setup:
      - "CREATE (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "CREATE (:Person {name: 'Gus', city: 'Amsterdam'})"
    query: MATCH (n:Person) RETURN DISTINCT n.city
    expect:
      rows:
        - [Amsterdam]

  - name: return_star
    setup:
      - "CREATE (:Person {name: 'Alix'})"
    query: MATCH (n:Person) RETURN *
    expect:
      count: 1

  - name: return_count_star
    setup:
      - "CREATE (:Person {name: 'Alix'})"
      - "CREATE (:Person {name: 'Gus'})"
    query: MATCH (n:Person) RETURN count(*) AS cnt
    expect:
      rows:
        - [2]

  - name: return_arithmetic
    setup:
      - "CREATE (:N {v: 10})"
    query: MATCH (n:N) RETURN n.v + 5 AS r
    expect:
      rows:
        - [15]

  - name: return_boolean_expression
    setup:
      - "CREATE (:N {v: 10})"
    query: MATCH (n:N) RETURN n.v > 5 AS r
    expect:
      rows:
        - [true]

  # ---------------------------------------------------------------------------
  # ORDER BY
  # ---------------------------------------------------------------------------

  - name: order_by_asc
    setup:
      - "CREATE (:Person {name: 'Gus', age: 25})"
      - "CREATE (:Person {name: 'Alix', age: 30})"
    query: MATCH (n:Person) RETURN n.name ORDER BY n.age ASC
    expect:
      ordered: true
      rows:
        - [Gus]
        - [Alix]

  - name: order_by_desc
    setup:
      - "CREATE (:Person {name: 'Gus', age: 25})"
      - "CREATE (:Person {name: 'Alix', age: 30})"
    query: MATCH (n:Person) RETURN n.name ORDER BY n.age DESC
    expect:
      ordered: true
      rows:
        - [Alix]
        - [Gus]

  - name: order_by_multiple_keys
    setup:
      - "CREATE (:Person {name: 'Alix', city: 'Amsterdam', age: 30})"
      - "CREATE (:Person {name: 'Gus', city: 'Amsterdam', age: 25})"
      - "CREATE (:Person {name: 'Vincent', city: 'Berlin', age: 35})"
    query: "MATCH (n:Person) RETURN n.name ORDER BY n.city ASC, n.age DESC"
    expect:
      ordered: true
      rows:
        - [Alix]
        - [Gus]
        - [Vincent]

  # ---------------------------------------------------------------------------
  # SKIP / LIMIT
  # ---------------------------------------------------------------------------

  - name: limit
    setup:
      - "CREATE (:Item {val: 0})"
      - "CREATE (:Item {val: 1})"
      - "CREATE (:Item {val: 2})"
      - "CREATE (:Item {val: 3})"
      - "CREATE (:Item {val: 4})"
    query: MATCH (n:Item) RETURN n.val LIMIT 3
    expect:
      count: 3

  - name: skip
    setup:
      - "CREATE (:Item {val: 0})"
      - "CREATE (:Item {val: 1})"
      - "CREATE (:Item {val: 2})"
      - "CREATE (:Item {val: 3})"
      - "CREATE (:Item {val: 4})"
    query: MATCH (n:Item) RETURN n.val ORDER BY n.val SKIP 3
    expect:
      count: 2

  - name: skip_and_limit
    setup:
      - "CREATE (:Item {val: 0})"
      - "CREATE (:Item {val: 1})"
      - "CREATE (:Item {val: 2})"
      - "CREATE (:Item {val: 3})"
      - "CREATE (:Item {val: 4})"
    query: MATCH (n:Item) RETURN n.val ORDER BY n.val SKIP 1 LIMIT 2
    expect:
      ordered: true
      rows:
        - [1]
        - [2]

  # ---------------------------------------------------------------------------
  # Aggregates: columns are named and ordered as written
  # ---------------------------------------------------------------------------

  - name: unaliased_aggregate_after_aliased_key
    setup:
      - "CREATE (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "CREATE (:Person {name: 'Gus', city: 'Amsterdam'})"
      - "CREATE (:Person {name: 'Vincent', city: 'Berlin'})"
    query: "MATCH (p:Person) RETURN p.city AS city, count(p)"
    expect:
      columns: [city, count(p)]
      rows:
        - [Amsterdam, 2]
        - [Berlin, 1]

  - name: unaliased_aggregate_before_key_keeps_column_order
    setup:
      - "CREATE (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "CREATE (:Person {name: 'Gus', city: 'Amsterdam'})"
      - "CREATE (:Person {name: 'Vincent', city: 'Berlin'})"
    query: "MATCH (p:Person) RETURN count(p), p.city"
    expect:
      columns: [count(p), p.city]
      rows:
        - [1, Berlin]
        - [2, Amsterdam]

  - name: unaliased_aggregate_with_wrapped_aggregate
    setup:
      - "CREATE (:N {v: 1})"
      - "CREATE (:N {v: 2})"
    query: "MATCH (n:N) RETURN count(n), sum(n.v) + 1"
    expect:
      columns: [count(n), sum(n.v) + 1]
      rows:
        - [2, 4]

  - name: with_aliased_key_and_aggregate
    setup:
      - "CREATE (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "CREATE (:Person {name: 'Gus', city: 'Amsterdam'})"
      - "CREATE (:Person {name: 'Vincent', city: 'Berlin'})"
    query: "MATCH (p:Person) WITH p.city AS city, count(p) AS n RETURN n, city"
    expect:
      columns: [n, city]
      rows:
        - [1, Berlin]
        - [2, Amsterdam]

  # ---------------------------------------------------------------------------
  # ORDER BY reads the variables of the clause's input (openCypher 9 TCK
  # WithOrderBy4 [8]): after a WITH or RETURN that neither aggregates nor is
  # DISTINCT, a variable the projection drops can still be sorted on.
  # After a WITH this used to fail with "Undefined variable".
  # ---------------------------------------------------------------------------

  - name: with_order_by_a_dropped_variable
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Gus', age: 3}), (:Person {name: 'Vincent', age: 19})"
    query: "MATCH (a:Person) WITH a.name AS name ORDER BY a.age RETURN name"
    expect:
      ordered: true
      rows:
        - [Gus]
        - [Vincent]
        - [Alix]

  - name: with_order_by_a_dropped_variable_then_skip_and_limit
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Gus', age: 3}), (:Person {name: 'Vincent', age: 19})"
    query: "MATCH (a:Person) WITH a.name AS name ORDER BY a.age DESC SKIP 1 LIMIT 1 RETURN name"
    expect:
      rows:
        - [Vincent]

  - name: with_order_by_a_dropped_and_a_projected_variable
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88, score: 19}), (:Person {name: 'Gus', age: 3, score: 3}), (:Person {name: 'Vincent', age: 19, score: 88})"
    query: "MATCH (a:Person) WITH a.name AS name, a.age AS age ORDER BY a.score - age RETURN name, age"
    expect:
      ordered: true
      columns: [name, age]
      rows:
        - [Alix, 88]
        - [Gus, 3]
        - [Vincent, 19]

  - name: with_order_by_a_variable_dropped_by_an_earlier_with_fails
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88})"
    query: "MATCH (a:Person) WITH a.age AS age WITH age AS years ORDER BY a.age RETURN years"
    expect:
      error: "Undefined variable 'a'"

  - name: with_alias_shadowing_a_dropped_variable_sorts_by_the_alias
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Gus', age: 3}), (:Person {name: 'Vincent', age: 19})"
    query: "MATCH (a:Person) WITH a.age AS a ORDER BY a DESC RETURN a"
    expect:
      ordered: true
      rows:
        - [88]
        - [19]
        - [3]

  - name: return_order_by_a_dropped_variable_then_skip_and_limit
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Gus', age: 3}), (:Person {name: 'Vincent', age: 19})"
    query: "MATCH (a:Person) RETURN a.name AS name ORDER BY a.age SKIP 1 LIMIT 1"
    expect:
      rows:
        - [Vincent]

  # After an aggregation or a DISTINCT WITH only what the projection returns
  # is in scope (openCypher 9 TCK WithOrderBy4 [13]). An aggregating RETURN
  # used to fail with an internal error.
  - name: with_distinct_order_by_a_dropped_variable_fails
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88})"
    query: "MATCH (a:Person) WITH DISTINCT a.name AS name ORDER BY a.age RETURN name"
    expect:
      error: "Undefined variable 'a'"

  - name: with_distinct_order_by_a_repeated_expression
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Alix', age: 3}), (:Person {name: 'Gus', age: 19})"
    query: "MATCH (a:Person) WITH DISTINCT a.name AS name ORDER BY a.name DESC RETURN name"
    expect:
      ordered: true
      rows:
        - [Gus]
        - [Alix]

  - name: with_aggregate_order_by_a_dropped_variable_fails
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88})"
    query: "MATCH (a:Person) WITH count(*) AS c ORDER BY a.age RETURN c"
    expect:
      error: "Undefined variable 'a'"

  - name: return_aggregate_order_by_a_dropped_variable_fails
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88})"
    query: "MATCH (a:Person) RETURN count(*) AS c ORDER BY a.age"
    expect:
      error: "Undefined variable 'a'"

  - name: return_distinct_order_by_a_returned_variable
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Alix', age: 3}), (:Person {name: 'Gus', age: 19})"
    query: "MATCH (a:Person) RETURN DISTINCT a.name AS name ORDER BY name DESC"
    expect:
      ordered: true
      rows:
        - [Gus]
        - [Alix]

  - name: return_distinct_order_by_a_returned_expression
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Alix', age: 3}), (:Person {name: 'Gus', age: 19})"
    query: "MATCH (a:Person) RETURN DISTINCT a.name ORDER BY a.name DESC"
    expect:
      ordered: true
      rows:
        - [Gus]
        - [Alix]

  - name: with_distinct_node_order_by_its_property
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Gus', age: 3}), (:Person {name: 'Vincent', age: 19})"
    query: "MATCH (a:Person) WITH DISTINCT a ORDER BY a.age RETURN a.name"
    expect:
      ordered: true
      rows:
        - [Gus]
        - [Vincent]
        - [Alix]

  # A key that repeats a returned expression sorts by its column (openCypher
  # 9 TCK ReturnOrderBy2 [3], WithOrderBy4 [11]): `max(a.age)` used to sort
  # as if it were not there, and an aliased `a.name` failed with "Variable
  # 'a.name' not found for ORDER BY".
  - name: return_grouped_order_by_a_returned_key_and_an_aggregate
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Alix', age: 3}), (:Person {name: 'Gus', age: 19})"
    query: "MATCH (a:Person) RETURN a.name, max(a.age) ORDER BY max(a.age), a.name"
    expect:
      ordered: true
      rows:
        - [Gus, 19]
        - [Alix, 88]

  - name: return_grouped_order_by_the_expression_of_an_aliased_key
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Alix', age: 3}), (:Person {name: 'Gus', age: 19})"
    query: "MATCH (a:Person) RETURN a.name AS name, count(*) AS c ORDER BY a.name DESC"
    expect:
      ordered: true
      rows:
        - [Gus, 1]
        - [Alix, 2]

  - name: with_grouped_order_by_an_aliased_aggregate_expression
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Alix', age: 3}), (:Person {name: 'Gus', age: 19})"
    query: "MATCH (a:Person) WITH a.name AS name, max(a.age) AS oldest ORDER BY max(a.age) DESC LIMIT 1 RETURN name, oldest"
    expect:
      rows:
        - [Alix, 88]

  - name: with_grouped_order_by_an_aggregate_inside_an_expression
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88}), (:Person {name: 'Alix', age: 3}), (:Person {name: 'Gus', age: 19})"
    query: "MATCH (a:Person) WITH a.name AS name, min(a.age) AS youngest ORDER BY 0 - min(a.age) RETURN name"
    expect:
      ordered: true
      rows:
        - [Gus]
        - [Alix]

  # An aggregate the projection does not return has no groups to sort
  # (openCypher 9 TCK WithOrderBy4 [14]).
  - name: return_grouped_order_by_an_aggregate_it_does_not_return_fails
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88})"
    query: "MATCH (a:Person) RETURN a.name AS name, count(*) AS c ORDER BY max(a.age)"
    expect:
      error: "aggregating function in ORDER BY"

  # ---------------------------------------------------------------------------
  # An aggregate in the ORDER BY of a projection that does not aggregate is
  # an error (openCypher 9 TCK ReturnOrderBy2 [14], WithOrderBy2 [25]). It
  # used to fail with "Empty plan", or sort as if it were not there.
  # ---------------------------------------------------------------------------

  - name: return_order_by_an_aggregate_without_a_match_fails
    query: "RETURN 3 AS x ORDER BY count(*)"
    expect:
      error: "aggregating function in ORDER BY"

  - name: return_order_by_an_aggregate_fails
    query: "UNWIND [3, 19] AS x RETURN x ORDER BY count(*)"
    expect:
      error: "aggregating function in ORDER BY"

  - name: with_order_by_an_aggregate_fails
    setup:
      - "CREATE (:Person {name: 'Alix', age: 88})"
    query: "MATCH (n:Person) WITH n.name AS name ORDER BY n.name, max(n.age) RETURN name"
    expect:
      error: "aggregating function in ORDER BY"
