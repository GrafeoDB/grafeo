# Cypher: where a query ends
#
# A query string holds one query. Its clauses all run (CREATE after CREATE),
# a trailing semicolon is allowed, and anything after the end, another
# statement after a semicolon or stray words, is an error instead of being
# dropped silently, as the GQL quickstart's second and third INSERT were
# (#380, see gql/15.1_insert.gtest). openCypher 9 allows RETURN only as the
# last clause of a query part.

meta:
  language: cypher
  model: lpg
  section: "3"
  title: Statement boundaries
  dataset: empty

tests:

  - name: create_clauses_in_one_query_all_run
    statements:
      - |
        CREATE (:Person {name: 'Alix', age: 30})
        CREATE (:Person {name: 'Gus', age: 25})
        CREATE (:Person {name: 'Harm', age: 35})
      - "MATCH (p:Person) RETURN p.name ORDER BY p.name"
    expect:
      ordered: true
      rows:
        - [Alix]
        - [Gus]
        - [Harm]

  - name: a_trailing_semicolon_is_accepted
    statements:
      - "CREATE (:Marker);"
      - "MATCH (m:Marker) RETURN count(m) AS c"
    expect:
      rows:
        - [1]

  - name: statements_separated_by_semicolon_are_rejected
    query: "CREATE (:A); CREATE (:B)"
    expect:
      error: "multiple statements separated by ';'"

  - name: trailing_words_after_a_create_are_rejected
    query: "CREATE (:A) garbage"
    expect:
      error: "Expected end of query"

  - name: trailing_words_after_a_return_are_rejected
    setup:
      - "CREATE (:Person {name: 'Alix'})"
    query: "MATCH (p:Person) RETURN p.name garbage"
    expect:
      error: "Expected end of query"

  - name: a_clause_after_return_is_rejected
    query: "RETURN 1 AS a RETURN 2 AS b"
    expect:
      error: "RETURN after RETURN: RETURN must be the last clause of a query"
      gql_status: "42001"

  - name: a_match_after_return_is_rejected
    setup:
      - "CREATE (:Person {name: 'Alix'})"
    query: "MATCH (n:Person) RETURN n.name MATCH (m) RETURN m"
    expect:
      error: "MATCH after RETURN"
      gql_status: "42001"

  - name: a_create_after_return_is_rejected
    query: "RETURN 1 AS a CREATE (:Person {name: 'Alix'})"
    expect:
      error: "CREATE after RETURN"
      gql_status: "42001"

  - name: a_with_after_return_is_rejected
    query: "RETURN 1 AS x WITH x RETURN x"
    expect:
      error: "WITH after RETURN"
      gql_status: "42001"

  - name: a_where_after_return_is_rejected
    setup:
      - "CREATE (:Person {name: 'Alix'})"
    query: "MATCH (n:Person) RETURN n.name WHERE n.name = 'Alix'"
    expect:
      error: "WHERE after RETURN"
      gql_status: "42001"

  - name: a_clause_after_return_in_a_subquery_is_rejected
    query: "CALL { RETURN 1 AS a RETURN 2 AS b } RETURN b"
    expect:
      error: "RETURN after RETURN"
      gql_status: "42001"

  - name: order_by_skip_and_limit_after_return_belong_to_it
    query: "UNWIND [3, 1, 2, 5] AS x RETURN x ORDER BY x SKIP 1 LIMIT 2"
    expect:
      ordered: true
      rows:
        - [2]
        - [3]

  - name: union_after_return_starts_the_next_query
    query: "RETURN 1 AS x UNION ALL RETURN 2 AS x"
    expect:
      rows:
        - [1]
        - [2]

  - name: with_passes_rows_on_to_a_later_return
    query: "UNWIND [1, 2] AS x WITH x * 10 AS y RETURN y"
    expect:
      rows:
        - [10]
        - [20]
