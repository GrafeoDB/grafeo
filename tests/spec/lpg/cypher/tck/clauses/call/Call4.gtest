meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Call4"
  title: "Call4 - Null Arguments"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Standalone call to procedure with null argument
  - name: s1_standalone_call_to_procedure_with_null_argument
    xfail:
      spec: "openCypher TCK 2024.3 Call4: [1] Standalone call to procedure with null argument"
      issue: fix in 0.6.4
    setup_gql:
      - "CREATE PROCEDURE `test.my.proc`(in INT64) RETURNS (out STRING) AS { UNWIND [{p0: null, p1: 'nix'}] AS r FILTER r.p0 = $in RETURN r.p1 AS out }"
    query: |
      CALL test.my.proc(null)
    expect:
      ordered: true
      values: |
        | out |
        | 'nix' |
      side_effects: {}

  # [2] In-query call to procedure with null argument
  - name: s2_in_query_call_to_procedure_with_null_argument
    xfail:
      spec: "openCypher TCK 2024.3 Call4: [2] In-query call to procedure with null argument"
      issue: fix in 0.6.4
    setup_gql:
      - "CREATE PROCEDURE `test.my.proc`(in INT64) RETURNS (out STRING) AS { UNWIND [{p0: null, p1: 'nix'}] AS r FILTER r.p0 = $in RETURN r.p1 AS out }"
    query: |
      CALL test.my.proc(null) YIELD out
      RETURN out
    expect:
      ordered: true
      values: |
        | out |
        | 'nix' |
      side_effects: {}
