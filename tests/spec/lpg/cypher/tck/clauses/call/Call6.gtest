meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Call6"
  title: "Call6 - Call clause interoperation with other clauses"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Calling the same STRING procedure twice using the same outputs in each call
  - name: s1_calling_the_same_string_procedure_twice_using_the_same_outputs_in_each_call
    xfail:
      spec: "openCypher TCK 2024.3 Call6: [1] Calling the same STRING procedure twice using the same outputs in each call"
      issue: fix in 0.6.4
    setup_gql:
      - "CREATE PROCEDURE `test.labels`() RETURNS (label STRING) AS { UNWIND [{p0: 'A'}, {p0: 'B'}, {p0: 'C'}] AS r RETURN r.p0 AS label }"
    query: |
      CALL test.labels() YIELD label
      WITH count(*) AS c
      CALL test.labels() YIELD label
      RETURN *
    expect:
      ordered: true
      values: |
        | c | label |
        | 3 | 'A' |
        | 3 | 'B' |
        | 3 | 'C' |
      side_effects: {}

  # [2] Project procedure results between query scopes with WITH clause
  - name: s2_project_procedure_results_between_query_scopes_with_with_clause
    xfail:
      spec: "openCypher TCK 2024.3 Call6: [2] Project procedure results between query scopes with WITH clause"
      issue: fix in 0.6.4
    setup_gql:
      - "CREATE PROCEDURE `test.my.proc`(in INT64) RETURNS (out STRING) AS { UNWIND [{p0: null, p1: 'nix'}] AS r FILTER r.p0 = $in RETURN r.p1 AS out }"
    query: |
      CALL test.my.proc(null) YIELD out
      WITH out RETURN out
    expect:
      ordered: true
      values: |
        | out |
        | 'nix' |
      side_effects: {}

  # [3] Project procedure results between query scopes with WITH clause and rename the projection
  - name: s3_project_procedure_results_between_query_scopes_with_with_clause_and_rename_the_projection
    xfail:
      spec: "openCypher TCK 2024.3 Call6: [3] Project procedure results between query scopes with WITH clause and rename the projection"
      issue: fix in 0.6.4
    setup_gql:
      - "CREATE PROCEDURE `test.my.proc`(in INT64) RETURNS (out STRING) AS { UNWIND [{p0: null, p1: 'nix'}] AS r FILTER r.p0 = $in RETURN r.p1 AS out }"
    query: |
      CALL test.my.proc(null) YIELD out
      WITH out AS a RETURN a
    expect:
      ordered: true
      values: |
        | a |
        | 'nix' |
      side_effects: {}
