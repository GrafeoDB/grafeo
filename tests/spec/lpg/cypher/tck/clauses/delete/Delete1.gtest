#
# Converted from the openCypher TCK, tck/features/clauses/delete/Delete1.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Delete1"
  title: "Delete1 - Deleting nodes"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Delete nodes
  - name: s1_delete_nodes
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      DELETE n
    expect:
      empty: true
      side_effects:
        -nodes: 1

  # [2] Detach delete node
  - name: s2_detach_delete_node
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      DETACH DELETE n
    expect:
      empty: true
      side_effects:
        -nodes: 1

  # [3] Detach deleting connected nodes and relationships
  - name: s3_detach_deleting_connected_nodes_and_relationships
    setup:
      - |
        CREATE (x:X)
        CREATE (x)-[:R]->()
        CREATE (x)-[:R]->()
        CREATE (x)-[:R]->()
    query: |
      MATCH (n:X)
      DETACH DELETE n
    expect:
      empty: true
      side_effects:
        -nodes: 1
        -relationships: 3
        -labels: 1

  # [4] Delete on null node
  - name: s4_delete_on_null_node
    query: |
      OPTIONAL MATCH (n)
      DELETE n
    expect:
      empty: true
      side_effects: {}

  # [5] Ignore null when deleting node
  - name: s5_ignore_null_when_deleting_node
    query: |
      OPTIONAL MATCH (a:DoesNotExist)
      DELETE a
      RETURN a
    expect:
      values: |
        | a |
        | null |
      side_effects: {}

  # [6] Detach delete on null node
  - name: s6_detach_delete_on_null_node
    query: |
      OPTIONAL MATCH (n)
      DETACH DELETE n
    expect:
      empty: true
      side_effects: {}

  # [7] Failing when deleting connected nodes
  # TCK: ConstraintVerificationFailed at runtime: DeleteConnectedNode
  - name: s7_failing_when_deleting_connected_nodes
    setup:
      - |
        CREATE (x:X)
        CREATE (x)-[:R]->()
        CREATE (x)-[:R]->()
        CREATE (x)-[:R]->()
    query: |
      MATCH (n:X)
      DELETE n
    expect:
      gql_status: "G1"
      side_effects: {}

  # [8] Failing when deleting a label
  # TCK: SyntaxError at compile time: InvalidDelete
  - name: s8_failing_when_deleting_a_label
    query: |
      MATCH (n)
      DELETE n:Person
    expect:
      gql_status: "42"
      side_effects: {}
