meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Delete2"
  title: "Delete2 - Deleting relationships"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Delete relationships
  - name: s1_delete_relationships
    setup:
      - |
        UNWIND range(0, 2) AS i
        CREATE ()-[:R]->()
    query: |
      MATCH ()-[r]-()
      DELETE r
    expect:
      empty: true
      side_effects:
        -relationships: 3

  # [2] Delete optionally matched relationship
  - name: s2_delete_optionally_matched_relationship
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      OPTIONAL MATCH (n)-[r]-()
      DELETE n, r
    expect:
      empty: true
      side_effects:
        -nodes: 1

  # [3] Delete relationship with bidirectional matching
  - name: s3_delete_relationship_with_bidirectional_matching
    setup:
      - |
        CREATE ()-[:T {id: 42}]->()
    query: |
      MATCH p = ()-[r:T]-()
      WHERE r.id = 42
      DELETE r
    expect:
      empty: true
      side_effects:
        -relationships: 1
        -properties: 1

  # [4] Ignore null when deleting relationship
  - name: s4_ignore_null_when_deleting_relationship
    query: |
      OPTIONAL MATCH ()-[r:DoesNotExist]-()
      DELETE r
      RETURN r
    expect:
      values: |
        | r |
        | null |
      side_effects: {}

  # [5] Failing when deleting a relationship type
  # TCK: SyntaxError at compile time: InvalidDelete
  - name: s5_failing_when_deleting_a_relationship_type
    setup:
      - |
        CREATE ()-[:T {id: 42}]->()
    query: |
      MATCH ()-[r:T]-()
      DELETE r:T
    expect:
      gql_status: "42"
      side_effects: {}
