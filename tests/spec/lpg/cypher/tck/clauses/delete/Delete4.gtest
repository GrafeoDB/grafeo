meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Delete4"
  title: "Delete4 - Delete clause interoperation with other clauses"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Undirected expand followed by delete and count
  - name: s1_undirected_expand_followed_by_delete_and_count
    setup:
      - |
        CREATE ()-[:R]->()
    query: |
      MATCH (a)-[r]-(b)
      DELETE r, a, b
      RETURN count(*) AS c
    expect:
      values: |
        | c |
        | 2 |
      side_effects:
        -nodes: 2
        -relationships: 1

  # [2] Undirected variable length expand followed by delete and count
  - name: s2_undirected_variable_length_expand_followed_by_delete_and_count
    setup:
      - |
        CREATE (n1), (n2), (n3)
        CREATE (n1)-[:R]->(n2)
        CREATE (n2)-[:R]->(n3)
    query: |
      MATCH (a)-[*]-(b)
      DETACH DELETE a, b
      RETURN count(*) AS c
    expect:
      values: |
        | c |
        | 6 |
      side_effects:
        -nodes: 3
        -relationships: 2

  # [3] Create and delete in same query
  - name: s3_create_and_delete_in_same_query
    setup:
      - |
        CREATE ()
    query: |
      MATCH ()
      CREATE (n)
      DELETE n
    expect:
      empty: true
      side_effects: {}
