meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Delete6"
  title: "Delete6 - Persistence of delete clause side effects"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Limiting to zero results after deleting nodes affects the result set but not the side effects
  - name: s1_limiting_to_zero_results_after_deleting_nodes_affects_the_result_set_but_not_the_side_effects
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      DELETE n
      RETURN 42 AS num
      LIMIT 0
    expect:
      values: |
        | num |
      side_effects:
        -nodes: 1
        -labels: 1
        -properties: 1

  # [2] Skipping all results after deleting nodes affects the result set but not the side effects
  - name: s2_skipping_all_results_after_deleting_nodes_affects_the_result_set_but_not_the_side_effects
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      DELETE n
      RETURN 42 AS num
      SKIP 1
    expect:
      values: |
        | num |
      side_effects:
        -nodes: 1
        -labels: 1
        -properties: 1

  # [3] Skipping and limiting to a few results after deleting nodes affects the result set but not the side effects
  - name: s3_skipping_and_limiting_to_a_few_results_after_deleting_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      DELETE n
      RETURN 42 AS num
      SKIP 2 LIMIT 2
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
      side_effects:
        -nodes: 5
        -labels: 1
        -properties: 5

  # [4] Skipping zero results and limiting to all results after deleting nodes does not affect the result set nor the side effects
  - name: s4_skipping_zero_results_and_limiting_to_all_results_after_deleting_nodes_does_not_affect_the_result_set_nor_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      DELETE n
      RETURN 42 AS num
      SKIP 0 LIMIT 5
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
      side_effects:
        -nodes: 5
        -labels: 1
        -properties: 5

  # [5] Filtering after deleting nodes affects the result set but not the side effects
  - name: s5_filtering_after_deleting_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      WITH n, n.num AS num
      DELETE n
      WITH num
      WHERE num % 2 = 0
      RETURN num
    expect:
      values: |
        | num |
        | 2 |
        | 4 |
      side_effects:
        -nodes: 5
        -labels: 1
        -properties: 5

  # [6] Aggregating in `RETURN` after deleting nodes affects the result set but not the side effects
  - name: s6_aggregating_in_return_after_deleting_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      WITH n, n.num AS num
      DELETE n
      RETURN sum(num) AS sum
    expect:
      values: |
        | sum |
        | 15 |
      side_effects:
        -nodes: 5
        -labels: 1
        -properties: 5

  # [7] Aggregating in `WITH` after deleting nodes affects the result set but not the side effects
  - name: s7_aggregating_in_with_after_deleting_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      WITH n, n.num AS num
      DELETE n
      WITH sum(num) AS sum
      RETURN sum
    expect:
      values: |
        | sum |
        | 15 |
      side_effects:
        -nodes: 5
        -labels: 1
        -properties: 5

  # [8] Limiting to zero results after deleting relationships affects the result set but not the side effects
  - name: s8_limiting_to_zero_results_after_deleting_relationships_affects_the_result_set_but_not_the_side_effects
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE ()-[r:R {num: 42}]->()
    query: |
      MATCH ()-[r:R]->()
      DELETE r
      RETURN 42 AS num
      LIMIT 0
    expect:
      values: |
        | num |
      side_effects:
        -relationships: 1
        -properties: 1

  # [9] Skipping all results after deleting relationships affects the result set but not the side effects
  - name: s9_skipping_all_results_after_deleting_relationships_affects_the_result_set_but_not_the_side_effects
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE ()-[r:R {num: 42}]->()
    query: |
      MATCH ()-[r:R]->()
      DELETE r
      RETURN 42 AS num
      SKIP 1
    expect:
      values: |
        | num |
      side_effects:
        -relationships: 1
        -properties: 1

  # [10] Skipping and limiting to a few results after deleting relationships affects the result set but not the side effects
  - name: s10_skipping_and_limiting_to_a_few_results_after_deleting_relationships_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE ()-[:R {num: 1}]->()
        CREATE ()-[:R {num: 2}]->()
        CREATE ()-[:R {num: 3}]->()
        CREATE ()-[:R {num: 4}]->()
        CREATE ()-[:R {num: 5}]->()
    query: |
      MATCH ()-[r:R]->()
      DELETE r
      RETURN 42 AS num
      SKIP 2 LIMIT 2
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
      side_effects:
        -relationships: 5
        -properties: 5

  # [11] Skipping zero result and limiting to all results after deleting relationships does not affect the result set nor the side effects
  - name: s11_skipping_zero_result_and_limiting_to_all_results_after_deleting_relationships_does_not_affect_the_result_set_nor_the_side_effects
    setup:
      - |
        CREATE ()-[:R {num: 1}]->()
        CREATE ()-[:R {num: 2}]->()
        CREATE ()-[:R {num: 3}]->()
        CREATE ()-[:R {num: 4}]->()
        CREATE ()-[:R {num: 5}]->()
    query: |
      MATCH ()-[r:R]->()
      DELETE r
      RETURN 42 AS num
      SKIP 0 LIMIT 5
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
      side_effects:
        -relationships: 5
        -properties: 5

  # [12] Filtering after deleting relationships affects the result set but not the side effects
  - name: s12_filtering_after_deleting_relationships_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE ()-[:R {num: 1}]->()
        CREATE ()-[:R {num: 2}]->()
        CREATE ()-[:R {num: 3}]->()
        CREATE ()-[:R {num: 4}]->()
        CREATE ()-[:R {num: 5}]->()
    query: |
      MATCH ()-[r:R]->()
      WITH r, r.num AS num
      DELETE r
      WITH num
      WHERE num % 2 = 0
      RETURN num
    expect:
      values: |
        | num |
        | 2 |
        | 4 |
      side_effects:
        -relationships: 5
        -properties: 5

  # [13] Aggregating in `RETURN` after deleting relationships affects the result set but not the side effects
  - name: s13_aggregating_in_return_after_deleting_relationships_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE ()-[:R {num: 1}]->()
        CREATE ()-[:R {num: 2}]->()
        CREATE ()-[:R {num: 3}]->()
        CREATE ()-[:R {num: 4}]->()
        CREATE ()-[:R {num: 5}]->()
    query: |
      MATCH ()-[r:R]->()
      WITH r, r.num AS num
      DELETE r
      RETURN sum(num) AS sum
    expect:
      values: |
        | sum |
        | 15 |
      side_effects:
        -relationships: 5
        -properties: 5

  # [14] Aggregating in `WITH` after deleting relationships affects the result set but not the side effects
  - name: s14_aggregating_in_with_after_deleting_relationships_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE ()-[:R {num: 1}]->()
        CREATE ()-[:R {num: 2}]->()
        CREATE ()-[:R {num: 3}]->()
        CREATE ()-[:R {num: 4}]->()
        CREATE ()-[:R {num: 5}]->()
    query: |
      MATCH ()-[r:R]->()
      WITH r, r.num AS num
      DELETE r
      WITH sum(num) AS sum
      RETURN sum
    expect:
      values: |
        | sum |
        | 15 |
      side_effects:
        -relationships: 5
        -properties: 5
