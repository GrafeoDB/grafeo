meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.MatchWhere2"
  title: "MatchWhere2 - Filter multiple variables"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Filter nodes with conjunctive two-part property predicate on multi variables with multiple bindings
  - name: s1_filter_nodes_with_conjunctive_two_part_property_predicate_on_multi_variables_with_multiple_bindings
    setup:
      - |
        CREATE (a:A), (b:B {id: 1}), (c:C {id: 2}), (d:D)
        CREATE (a)-[:T]->(b),
               (a)-[:T]->(c),
               (a)-[:T]->(d),
               (b)-[:T]->(c),
               (b)-[:T]->(d),
               (c)-[:T]->(d)
    query: |
      MATCH (a)--(b)--(c)--(d)--(a), (b)--(d)
      WHERE a.id = 1
        AND c.id = 2
      RETURN d
    expect:
      values: |
        | d |
        | (:A) |
        | (:D) |
      side_effects: {}

  # [2] Filter node with conjunctive multi-part property predicates on multi variables with multiple bindings
  - name: s2_filter_node_with_conjunctive_multi_part_property_predicates_on_multi_variables_with_multiple_bindings
    xfail:
      spec: "openCypher TCK 2024.3 MatchWhere2: [2] Filter node with conjunctive multi-part property predicates on multi variables with multiple bindings"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (advertiser {name: 'advertiser1', id: 0}),
               (thing {name: 'Color', id: 1}),
               (red {name: 'red'}),
               (p1 {name: 'product1'}),
               (p2 {name: 'product4'})
        CREATE (advertiser)-[:ADV_HAS_PRODUCT]->(p1),
               (advertiser)-[:ADV_HAS_PRODUCT]->(p2),
               (thing)-[:AA_HAS_VALUE]->(red),
               (p1)-[:AP_HAS_VALUE]->(red),
               (p2)-[:AP_HAS_VALUE]->(red)
    params:
      1: 0
      2: 1
    query: |
      MATCH (advertiser)-[:ADV_HAS_PRODUCT]->(out)-[:AP_HAS_VALUE]->(red)<-[:AA_HAS_VALUE]-(a)
      WHERE advertiser.id = $1
        AND a.id = $2
        AND red.name = 'red'
        AND out.name = 'product1'
      RETURN out.name
    expect:
      values: |
        | out.name |
        | 'product1' |
      side_effects: {}
