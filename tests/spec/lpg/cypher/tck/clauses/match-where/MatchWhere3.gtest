meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.MatchWhere3"
  title: "MatchWhere3 - Equi-Joins on variables"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Join between node identities
  - name: s1_join_between_node_identities
    setup:
      - |
        CREATE (:A), (:B)
    query: |
      MATCH (a), (b)
      WHERE a = b
      RETURN a, b
    expect:
      values: |
        | a | b |
        | (:A) | (:A) |
        | (:B) | (:B) |
      side_effects: {}

  # [2] Join between node properties of disconnected nodes
  - name: s2_join_between_node_properties_of_disconnected_nodes
    setup:
      - |
        CREATE (:A {id: 1}),
               (:A {id: 2}),
               (:B {id: 2}),
               (:B {id: 3})
    query: |
      MATCH (a:A), (b:B)
      WHERE a.id = b.id
      RETURN a, b
    expect:
      values: |
        | a | b |
        | (:A {id: 2}) | (:B {id: 2}) |
      side_effects: {}

  # [3] Join between node properties of adjacent nodes
  - name: s3_join_between_node_properties_of_adjacent_nodes
    setup:
      - |
        CREATE (a:A {animal: 'monkey'}),
          (b:B {animal: 'cow'}),
          (c:C {animal: 'monkey'}),
          (d:D {animal: 'cow'}),
          (a)-[:KNOWS]->(b),
          (a)-[:KNOWS]->(c),
          (d)-[:KNOWS]->(b),
          (d)-[:KNOWS]->(c)
    query: |
      MATCH (n)-[rel]->(x)
      WHERE n.animal = x.animal
      RETURN n, x
    expect:
      values: |
        | n | x |
        | (:A {animal: 'monkey'}) | (:C {animal: 'monkey'}) |
        | (:D {animal: 'cow'}) | (:B {animal: 'cow'}) |
      side_effects: {}
