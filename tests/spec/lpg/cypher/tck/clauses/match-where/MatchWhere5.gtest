meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.MatchWhere5"
  title: "MatchWhere5 - Filter on predicate resulting in null"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Filter out on null
  - name: s1_filter_out_on_null
    setup:
      - |
        CREATE (root:Root {name: 'x'}),
               (child1:TextNode {var: 'text'}),
               (child2:IntNode {var: 0})
        CREATE (root)-[:T]->(child1),
               (root)-[:T]->(child2)
    query: |
      MATCH (:Root {name: 'x'})-->(i:TextNode)
      WHERE i.var > 'te'
      RETURN i
    expect:
      values: |
        | i |
        | (:TextNode {var: 'text'}) |
      side_effects: {}

  # [2] Filter out on null if the AND'd predicate evaluates to false
  - name: s2_filter_out_on_null_if_the_and_d_predicate_evaluates_to_false
    setup:
      - |
        CREATE (root:Root {name: 'x'}),
               (child1:TextNode {var: 'text'}),
               (child2:IntNode {var: 0})
        CREATE (root)-[:T]->(child1),
               (root)-[:T]->(child2)
    query: |
      MATCH (:Root {name: 'x'})-->(i:TextNode)
      WHERE i.var > 'te' AND i:TextNode
      RETURN i
    expect:
      values: |
        | i |
        | (:TextNode {var: 'text'}) |
      side_effects: {}

  # [3] Filter out on null if the AND'd predicate evaluates to true
  - name: s3_filter_out_on_null_if_the_and_d_predicate_evaluates_to_true
    setup:
      - |
        CREATE (root:Root {name: 'x'}),
               (child1:TextNode {var: 'text'}),
               (child2:IntNode {var: 0})
        CREATE (root)-[:T]->(child1),
               (root)-[:T]->(child2)
    query: |
      MATCH (:Root {name: 'x'})-->(i:TextNode)
      WHERE i.var > 'te' AND i.var IS NOT NULL
      RETURN i
    expect:
      values: |
        | i |
        | (:TextNode {var: 'text'}) |
      side_effects: {}

  # [4] Do not filter out on null if the OR'd predicate evaluates to true
  - name: s4_do_not_filter_out_on_null_if_the_or_d_predicate_evaluates_to_true
    setup:
      - |
        CREATE (root:Root {name: 'x'}),
               (child1:TextNode {var: 'text'}),
               (child2:IntNode {var: 0})
        CREATE (root)-[:T]->(child1),
               (root)-[:T]->(child2)
    query: |
      MATCH (:Root {name: 'x'})-->(i)
      WHERE i.var > 'te' OR i.var IS NOT NULL
      RETURN i
    expect:
      values: |
        | i |
        | (:TextNode {var: 'text'}) |
        | (:IntNode {var: 0}) |
      side_effects: {}
