meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Match1"
  title: "Match1 - Match nodes"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Match non-existent nodes returns empty
  - name: s1_match_non_existent_nodes_returns_empty
    query: |
      MATCH (n)
      RETURN n
    expect:
      values: |
        | n |
      side_effects: {}

  # [2] Matching all nodes
  - name: s2_matching_all_nodes
    setup:
      - |
        CREATE (:A), (:B {name: 'b'}), ({name: 'c'})
    query: |
      MATCH (n)
      RETURN n
    expect:
      values: |
        | n |
        | (:A) |
        | (:B {name: 'b'}) |
        | ({name: 'c'}) |
      side_effects: {}

  # [3] Matching nodes using multiple labels
  - name: s3_matching_nodes_using_multiple_labels
    setup:
      - |
        CREATE (:A:B:C), (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C),
               ({name: ':A:B:C'}), ({abc: 'abc'}), ()
    query: |
      MATCH (a:A:B)
      RETURN a
    expect:
      values: |
        | a |
        | (:A:B) |
        | (:A:B:C) |
      side_effects: {}

  # [4] Simple node inline property predicate
  - name: s4_simple_node_inline_property_predicate
    setup:
      - |
        CREATE ({name: 'bar'}), ({name: 'monkey'}), ({firstname: 'bar'})
    query: |
      MATCH (n {name: 'bar'})
      RETURN n
    expect:
      values: |
        | n |
        | ({name: 'bar'}) |
      side_effects: {}

  # [5] Use multiple MATCH clauses to do a Cartesian product
  - name: s5_use_multiple_match_clauses_to_do_a_cartesian_product
    setup:
      - |
        CREATE ({num: 1}),
          ({num: 2}),
          ({num: 3})
    query: |
      MATCH (n), (m)
      RETURN n.num AS n, m.num AS m
    expect:
      values: |
        | n | m |
        | 1 | 1 |
        | 1 | 2 |
        | 1 | 3 |
        | 2 | 1 |
        | 2 | 2 |
        | 2 | 3 |
        | 3 | 3 |
        | 3 | 1 |
        | 3 | 2 |
      side_effects: {}

  # [6] Fail when using parameter as node predicate in MATCH
  # TCK: SyntaxError at compile time: InvalidParameterUse
  - name: s6_fail_when_using_parameter_as_node_predicate_in_match
    query: |
      MATCH (n $param)
      RETURN n
    expect:
      gql_status: "42"
      side_effects: {}

  # [7] Fail when a relationship has the same variable in a preceding MATCH #1
  # TCK: SyntaxError at compile time: VariableTypeConflict
  - name: s7_fail_when_a_relationship_has_the_same_variable_in_a_preceding_match_1
    query: |
      MATCH ()-[r]-()
      MATCH (r)
      RETURN r
    expect:
      gql_status: "42"
      side_effects: {}

  # [7] Fail when a relationship has the same variable in a preceding MATCH #2
