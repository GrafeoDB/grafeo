meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Match2"
  title: "Match2 - Match relationships"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Match non-existent relationships returns empty
  - name: s1_match_non_existent_relationships_returns_empty
    query: |
      MATCH ()-[r]->()
      RETURN r
    expect:
      values: |
        | r |
      side_effects: {}

  # [2] Matching a relationship pattern using a label predicate on both sides
  - name: s2_matching_a_relationship_pattern_using_a_label_predicate_on_both_sides
    setup:
      - |
        CREATE (:A)-[:T1]->(:B),
               (:B)-[:T2]->(:A),
               (:B)-[:T3]->(:B),
               (:A)-[:T4]->(:A)
    query: |
      MATCH (:A)-[r]->(:B)
      RETURN r
    expect:
      values: |
        | r |
        | [:T1] |
      side_effects: {}

  # [3] Matching a self-loop with an undirected relationship pattern
  - name: s3_matching_a_self_loop_with_an_undirected_relationship_pattern
    setup:
      - |
        CREATE (a)
        CREATE (a)-[:T]->(a)
    query: |
      MATCH ()-[r]-()
      RETURN type(r) AS r
    expect:
      values: |
        | r |
        | 'T' |
      side_effects: {}

  # [4] Matching a self-loop with a directed relationship pattern
  - name: s4_matching_a_self_loop_with_a_directed_relationship_pattern
    setup:
      - |
        CREATE (a)
        CREATE (a)-[:T]->(a)
    query: |
      MATCH ()-[r]->()
      RETURN type(r) AS r
    expect:
      values: |
        | r |
        | 'T' |
      side_effects: {}

  # [5] Match relationship with inline property value
  - name: s5_match_relationship_with_inline_property_value
    setup:
      - |
        CREATE (:A)<-[:KNOWS {name: 'monkey'}]-()-[:KNOWS {name: 'woot'}]->(:B)
    query: |
      MATCH (node)-[r:KNOWS {name: 'monkey'}]->(a)
      RETURN a
    expect:
      values: |
        | a |
        | (:A) |
      side_effects: {}

  # [6] Match relationships with multiple types
  - name: s6_match_relationships_with_multiple_types
    setup:
      - |
        CREATE (a {name: 'A'}),
          (b {name: 'B'}),
          (c {name: 'C'}),
          (a)-[:KNOWS]->(b),
          (a)-[:HATES]->(c),
          (a)-[:WONDERS]->(c)
    query: |
      MATCH (n)-[r:KNOWS|HATES]->(x)
      RETURN r
    expect:
      values: |
        | r |
        | [:KNOWS] |
        | [:HATES] |
      side_effects: {}

  # [7] Matching twice with conflicting relationship types on same relationship
  - name: s7_matching_twice_with_conflicting_relationship_types_on_same_relationship
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH (a1)-[r:T]->()
      WITH r, a1
      MATCH (a1)-[r:Y]->(b2)
      RETURN a1, r, b2
    expect:
      values: |
        | a1 | r | b2 |
      side_effects: {}

  # [8] Fail when using parameter as relationship predicate in MATCH
  # TCK: SyntaxError at compile time: InvalidParameterUse
  - name: s8_fail_when_using_parameter_as_relationship_predicate_in_match
    query: |
      MATCH ()-[r:FOO $param]->()
      RETURN r
    expect:
      gql_status: "42"
      side_effects: {}

  # [9] Fail when a node has the same variable in a preceding MATCH #1
  # TCK: SyntaxError at compile time: VariableTypeConflict
  - name: s9_fail_when_a_node_has_the_same_variable_in_a_preceding_match_1
    query: |
      MATCH (r)
      MATCH ()-[r]-()
      RETURN r
    expect:
      gql_status: "42"
      side_effects: {}

  # [9] Fail when a node has the same variable in a preceding MATCH #2
