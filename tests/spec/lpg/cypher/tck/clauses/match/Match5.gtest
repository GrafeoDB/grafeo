meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Match5"
  title: "Match5 - Match variable length patterns over given graphs scenarios"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Handling unbounded variable length match
  - name: s1_handling_unbounded_variable_length_match
    setup:
      - |
        CREATE (n0:A {name: 'n0'}),
               (n00:B {name: 'n00'}),
               (n01:B {name: 'n01'}),
               (n000:C {name: 'n000'}),
               (n001:C {name: 'n001'}),
               (n010:C {name: 'n010'}),
               (n011:C {name: 'n011'}),
               (n0000:D {name: 'n0000'}),
               (n0001:D {name: 'n0001'}),
               (n0010:D {name: 'n0010'}),
               (n0011:D {name: 'n0011'}),
               (n0100:D {name: 'n0100'}),
               (n0101:D {name: 'n0101'}),
               (n0110:D {name: 'n0110'}),
               (n0111:D {name: 'n0111'})
        CREATE (n0)-[:LIKES]->(n00),
               (n0)-[:LIKES]->(n01),
               (n00)-[:LIKES]->(n000),
               (n00)-[:LIKES]->(n001),
               (n01)-[:LIKES]->(n010),
               (n01)-[:LIKES]->(n011),
               (n000)-[:LIKES]->(n0000),
               (n000)-[:LIKES]->(n0001),
               (n001)-[:LIKES]->(n0010),
               (n001)-[:LIKES]->(n0011),
               (n010)-[:LIKES]->(n0100),
               (n010)-[:LIKES]->(n0101),
               (n011)-[:LIKES]->(n0110),
               (n011)-[:LIKES]->(n0111)
    query: |
      MATCH (a:A)
      MATCH (a)-[:LIKES*]->(c)
      RETURN c.name
    expect:
      values: |
        | c.name |
        | 'n00' |
        | 'n01' |
        | 'n000' |
        | 'n001' |
        | 'n010' |
        | 'n011' |
        | 'n0000' |
        | 'n0001' |
        | 'n0010' |
        | 'n0011' |
        | 'n0100' |
        | 'n0101' |
        | 'n0110' |
        | 'n0111' |
      side_effects: {}

  # [2] Handling explicitly unbounded variable length match
  - name: s2_handling_explicitly_unbounded_variable_length_match
    setup:
      - |
        CREATE (n0:A {name: 'n0'}),
               (n00:B {name: 'n00'}),
               (n01:B {name: 'n01'}),
               (n000:C {name: 'n000'}),
               (n001:C {name: 'n001'}),
               (n010:C {name: 'n010'}),
               (n011:C {name: 'n011'}),
               (n0000:D {name: 'n0000'}),
               (n0001:D {name: 'n0001'}),
               (n0010:D {name: 'n0010'}),
               (n0011:D {name: 'n0011'}),
               (n0100:D {name: 'n0100'}),
               (n0101:D {name: 'n0101'}),
               (n0110:D {name: 'n0110'}),
               (n0111:D {name: 'n0111'})
        CREATE (n0)-[:LIKES]->(n00),
               (n0)-[:LIKES]->(n01),
               (n00)-[:LIKES]->(n000),
               (n00)-[:LIKES]->(n001),
               (n01)-[:LIKES]->(n010),
               (n01)-[:LIKES]->(n011),
               (n000)-[:LIKES]->(n0000),
               (n000)-[:LIKES]->(n0001),
               (n001)-[:LIKES]->(n0010),
               (n001)-[:LIKES]->(n0011),
               (n010)-[:LIKES]->(n0100),
               (n010)-[:LIKES]->(n0101),
               (n011)-[:LIKES]->(n0110),
               (n011)-[:LIKES]->(n0111)
    query: |
      MATCH (a:A)
      MATCH (a)-[:LIKES*..]->(c)
      RETURN c.name
    expect:
      values: |
        | c.name |
        | 'n00' |
        | 'n01' |
        | 'n000' |
        | 'n001' |
        | 'n010' |
        | 'n011' |
        | 'n0000' |
        | 'n0001' |
        | 'n0010' |
        | 'n0011' |
        | 'n0100' |
        | 'n0101' |
        | 'n0110' |
        | 'n0111' |
      side_effects: {}

