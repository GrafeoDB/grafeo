meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Match6"
  title: "Match6 - Match named paths scenarios"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Zero-length named path
  - name: s1_zero_length_named_path
    setup:
      - |
        CREATE ()
    query: |
      MATCH p = (a)
      RETURN p
    expect:
      values: |
        | p |
        | <()> |
      side_effects: {}

  # [2] Return a simple path
  - name: s2_return_a_simple_path
    setup:
      - |
        CREATE (a:A {name: 'A'})-[:KNOWS]->(b:B {name: 'B'})
    query: |
      MATCH p = (a {name: 'A'})-->(b)
      RETURN p
    expect:
      values: |
        | p |
        | <(:A {name: 'A'})-[:KNOWS]->(:B {name: 'B'})> |
      side_effects: {}

  # [3] Return a three node path
  - name: s3_return_a_three_node_path
    setup:
      - |
        CREATE (a:A {name: 'A'})-[:KNOWS]->(b:B {name: 'B'})-[:KNOWS]->(c:C {name: 'C'})
    query: |
      MATCH p = (a {name: 'A'})-[rel1]->(b)-[rel2]->(c)
      RETURN p
    expect:
      values: |
        | p |
        | <(:A {name: 'A'})-[:KNOWS]->(:B {name: 'B'})-[:KNOWS]->(:C {name: 'C'})> |
      side_effects: {}

  # [4] Respecting direction when matching non-existent path
  - name: s4_respecting_direction_when_matching_non_existent_path
    setup:
      - |
        CREATE (a {name: 'a'}), (b {name: 'b'})
        CREATE (a)-[:T]->(b)
    query: |
      MATCH p = ({name: 'a'})<--({name: 'b'})
      RETURN p
    expect:
      values: |
        | p |
      side_effects: {}

  # [5] Path query should return results in written order
  - name: s5_path_query_should_return_results_in_written_order
    setup:
      - |
        CREATE (:Label1)<-[:TYPE]-(:Label2)
    query: |
      MATCH p = (a:Label1)<--(:Label2)
      RETURN p
    expect:
      values: |
        | p |
        | <(:Label1)<-[:TYPE]-(:Label2)> |
      side_effects: {}

  # [6] Handling direction of named paths
  - name: s6_handling_direction_of_named_paths
    setup:
      - |
        CREATE (a:A)-[:T]->(b:B)
    query: |
      MATCH p = (b)<--(a)
      RETURN p
    expect:
      values: |
        | p |
        | <(:B)<-[:T]-(:A)> |
      side_effects: {}

  # [7] Respecting direction when matching existing path
  - name: s7_respecting_direction_when_matching_existing_path
    setup:
      - |
        CREATE (a {name: 'a'}), (b {name: 'b'})
        CREATE (a)-[:T]->(b)
    query: |
      MATCH p = ({name: 'a'})-->({name: 'b'})
      RETURN p
    expect:
      values: |
        | p |
        | <({name: 'a'})-[:T]->({name: 'b'})> |
      side_effects: {}

  # [8] Respecting direction when matching non-existent path with multiple directions
  - name: s8_respecting_direction_when_matching_non_existent_path_with_multiple_directions
    setup:
      - |
        CREATE (a), (b)
        CREATE (a)-[:T]->(b),
               (b)-[:T]->(a)
    query: |
      MATCH p = (n)-->(k)<--(n)
      RETURN p
    expect:
      values: |
        | p |
      side_effects: {}

  # [9] Longer path query should return results in written order
  - name: s9_longer_path_query_should_return_results_in_written_order
    setup:
      - |
        CREATE (:Label1)<-[:T1]-(:Label2)-[:T2]->(:Label3)
    query: |
      MATCH p = (a:Label1)<--(:Label2)--()
      RETURN p
    expect:
      values: |
        | p |
        | <(:Label1)<-[:T1]-(:Label2)-[:T2]->(:Label3)> |
      side_effects: {}

  # [10] Named path with alternating directed/undirected relationships
  - name: s10_named_path_with_alternating_directed_undirected_relationships
    setup:
      - |
        CREATE (a:A), (b:B), (c:C)
        CREATE (b)-[:T]->(a),
               (c)-[:T]->(b)
    query: |
      MATCH p = (n)-->(m)--(o)
      RETURN p
    expect:
      values: |
        | p |
        | <(:C)-[:T]->(:B)-[:T]->(:A)> |
      side_effects: {}

  # [11] Named path with multiple alternating directed/undirected relationships
  - name: s11_named_path_with_multiple_alternating_directed_undirected_relationships
    setup:
      - |
        CREATE (a:A), (b:B), (c:C), (d:D)
        CREATE (b)-[:T]->(a),
               (c)-[:T]->(b),
               (d)-[:T]->(c)
    query: |
      MATCH path = (n)-->(m)--(o)--(p)
      RETURN path
    expect:
      values: |
        | path |
        | <(:D)-[:T]->(:C)-[:T]->(:B)-[:T]->(:A)> |
      side_effects: {}

  # [12] Matching path with multiple bidirectional relationships
  - name: s12_matching_path_with_multiple_bidirectional_relationships
    setup:
      - |
        CREATE (a:A), (b:B)
        CREATE (a)-[:T1]->(b),
               (b)-[:T2]->(a)
    query: |
      MATCH p=(n)<-->(k)<-->(n)
      RETURN p
    expect:
      values: |
        | p |
        | <(:A)<-[:T2]-(:B)<-[:T1]-(:A)> |
        | <(:A)-[:T1]->(:B)-[:T2]->(:A)> |
        | <(:B)<-[:T1]-(:A)<-[:T2]-(:B)> |
        | <(:B)-[:T2]->(:A)-[:T1]->(:B)> |
      side_effects: {}

  # [13] Matching path with both directions should respect other directions
  - name: s13_matching_path_with_both_directions_should_respect_other_directions
    setup:
      - |
        CREATE (a:A), (b:B)
        CREATE (a)-[:T1]->(b),
               (b)-[:T2]->(a)
    query: |
      MATCH p = (n)<-->(k)<--(n)
      RETURN p
    expect:
      values: |
        | p |
        | <(:A)<-[:T2]-(:B)<-[:T1]-(:A)> |
        | <(:B)<-[:T1]-(:A)<-[:T2]-(:B)> |
      side_effects: {}

  # [14] Named path with undirected fixed variable length pattern
  - name: s14_named_path_with_undirected_fixed_variable_length_pattern
    setup:
      - |
        CREATE (db1:Start), (db2:End), (mid), (other)
        CREATE (mid)-[:CONNECTED_TO]->(db1),
               (mid)-[:CONNECTED_TO]->(db2),
               (mid)-[:CONNECTED_TO]->(db2),
               (mid)-[:CONNECTED_TO]->(other),
               (mid)-[:CONNECTED_TO]->(other)
    query: |
      MATCH topRoute = (:Start)<-[:CONNECTED_TO]-()-[:CONNECTED_TO*3..3]-(:End)
      RETURN topRoute
    expect:
      values: |
        | topRoute |
        | <(:Start)<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->()<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->(:End)> |
        | <(:Start)<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->()<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->(:End)> |
        | <(:Start)<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->()<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->(:End)> |
        | <(:Start)<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->()<-[:CONNECTED_TO]-()-[:CONNECTED_TO]->(:End)> |
      side_effects: {}

  # [15] Variable-length named path
  - name: s15_variable_length_named_path
    setup:
      - |
        CREATE ()
    query: |
      MATCH p = ()-[*0..]->()
      RETURN p
    expect:
      values: |
        | p |
        | <()> |
      side_effects: {}

  # [16] Return a var length path
  - name: s16_return_a_var_length_path
    setup:
      - |
        CREATE (a:A {name: 'A'})-[:KNOWS {num: 1}]->(b:B {name: 'B'})-[:KNOWS {num: 2}]->(c:C {name: 'C'})
    query: |
      MATCH p = (n {name: 'A'})-[:KNOWS*1..2]->(x)
      RETURN p
    expect:
      values: |
        | p |
        | <(:A {name: 'A'})-[:KNOWS {num: 1}]->(:B {name: 'B'})> |
        | <(:A {name: 'A'})-[:KNOWS {num: 1}]->(:B {name: 'B'})-[:KNOWS {num: 2}]->(:C {name: 'C'})> |
      side_effects: {}

  # [17] Return a named var length path of length zero
  - name: s17_return_a_named_var_length_path_of_length_zero
    setup:
      - |
        CREATE (a:A {name: 'A'})-[:KNOWS]->(b:B {name: 'B'})-[:FRIEND]->(c:C {name: 'C'})
    query: |
      MATCH p = (a {name: 'A'})-[:KNOWS*0..1]->(b)-[:FRIEND*0..1]->(c)
      RETURN p
    expect:
      values: |
        | p |
        | <(:A {name: 'A'})> |
        | <(:A {name: 'A'})-[:KNOWS]->(:B {name: 'B'})> |
        | <(:A {name: 'A'})-[:KNOWS]->(:B {name: 'B'})-[:FRIEND]->(:C {name: 'C'})> |
      side_effects: {}

  # [18] Undirected named path
  - name: s18_undirected_named_path
    setup:
      - |
        CREATE (a:Movie), (b)
        CREATE (b)-[:T]->(a)
    query: |
      MATCH p = (n:Movie)--(m)
      RETURN p
        LIMIT 1
    expect:
      values: |
        | p |
        | <(:Movie)<-[:T]-()> |
      side_effects: {}

  # [19] Variable length relationship without lower bound
  - name: s19_variable_length_relationship_without_lower_bound
    setup:
      - |
        CREATE (a {name: 'A'}), (b {name: 'B'}),
               (c {name: 'C'})
        CREATE (a)-[:KNOWS]->(b),
               (b)-[:KNOWS]->(c)
    query: |
      MATCH p = ({name: 'A'})-[:KNOWS*..2]->()
      RETURN p
    expect:
      values: |
        | p |
        | <({name: 'A'})-[:KNOWS]->({name: 'B'})> |
        | <({name: 'A'})-[:KNOWS]->({name: 'B'})-[:KNOWS]->({name: 'C'})> |
      side_effects: {}

  # [20] Variable length relationship without bounds
  - name: s20_variable_length_relationship_without_bounds
    setup:
      - |
        CREATE (a {name: 'A'}), (b {name: 'B'}),
               (c {name: 'C'})
        CREATE (a)-[:KNOWS]->(b),
               (b)-[:KNOWS]->(c)
    query: |
      MATCH p = ({name: 'A'})-[:KNOWS*..]->()
      RETURN p
    expect:
      values: |
        | p |
        | <({name: 'A'})-[:KNOWS]->({name: 'B'})> |
        | <({name: 'A'})-[:KNOWS]->({name: 'B'})-[:KNOWS]->({name: 'C'})> |
      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #1
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_1
    xfail:
      spec: "openCypher TCK 2024.3 Match6: [21] Fail when a node has the same variable in a preceding MATCH #1"
      issue: "#795"
    query: |
      MATCH (p)-[]-()
      MATCH p = ()-[]-()
      RETURN p
    expect:
      gql_status: "42"
      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #2
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_2
    xfail:
      spec: "openCypher TCK 2024.3 Match6: [21] Fail when a node has the same variable in a preceding MATCH #2"
      issue: "#795"
    query: |
      MATCH (p)-[]->()
      MATCH p = ()-[]-()
      RETURN p
    expect:
      gql_status: "42"
      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #3
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_3
    xfail:
      spec: "openCypher TCK 2024.3 Match6: [21] Fail when a node has the same variable in a preceding MATCH #3"
      issue: "#795"
    query: |
      MATCH (p)<-[]-()
      MATCH p = ()-[]-()
      RETURN p
    expect:
      gql_status: "42"
      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #4
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_4
    xfail:
      spec: "openCypher TCK 2024.3 Match6: [21] Fail when a node has the same variable in a preceding MATCH #4"
      issue: "#795"
    query: |
      MATCH ()-[]-(p)
      MATCH p = ()-[]-()
      RETURN p
    expect:
      gql_status: "42"
      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #5
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_5
    xfail:
      spec: "openCypher TCK 2024.3 Match6: [21] Fail when a node has the same variable in a preceding MATCH #5"
      issue: "#795"
    query: |
      MATCH ()-[]->(p)
      MATCH p = ()-[]-()
      RETURN p
    expect:
      gql_status: "42"
      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #6
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_6
