      side_effects: {}

  # [22] Fail when a relationship has the same variable in a preceding MATCH #1
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s22_fail_when_a_relationship_has_the_same_variable_in_a_preceding_match_1
