      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #12
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_12
    xfail:
      spec: "openCypher TCK 2024.3 Match6: [21] Fail when a node has the same variable in a preceding MATCH #12"
      issue: "#795"
    query: |
      MATCH (a)-[r]-(p)-[]->(b), (t), (t)-[*]-(b)
      MATCH p = ()-[]-()
      RETURN p
    expect:
      gql_status: "42"
      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #13
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_13
