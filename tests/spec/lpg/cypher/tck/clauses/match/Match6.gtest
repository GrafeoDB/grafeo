      side_effects: {}

  # [21] Fail when a node has the same variable in a preceding MATCH #7
  # TCK: SyntaxError at compile time: VariableAlreadyBound
  - name: s21_fail_when_a_node_has_the_same_variable_in_a_preceding_match_7
