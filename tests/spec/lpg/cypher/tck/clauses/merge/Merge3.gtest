meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Merge3"
  title: "Merge3 - Merge node - on match"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Merge should be able to set labels on match
  - name: s1_merge_should_be_able_to_set_labels_on_match
    setup:
      - |
        CREATE ()
    query: |
      MERGE (a)
        ON MATCH SET a:L
    expect:
      empty: true
      side_effects:
        +labels: 1

  # [2] Merge node with label add label on match when it exists
  - name: s2_merge_node_with_label_add_label_on_match_when_it_exists
    setup:
      - |
        CREATE (:TheLabel)
    query: |
      MERGE (a:TheLabel)
        ON MATCH SET a:Foo
      RETURN labels(a)
    expect:
      unordered_lists: true
      values: |
        | labels(a) |
        | ['TheLabel', 'Foo'] |
      side_effects:
        +labels: 1

  # [3] Merge node and set property on match
  - name: s3_merge_node_and_set_property_on_match
    setup:
      - |
        CREATE (:TheLabel)
    query: |
      MERGE (a:TheLabel)
        ON MATCH SET a.num = 42
      RETURN a.num
    expect:
      values: |
        | a.num |
        | 42 |
      side_effects:
        +properties: 1

  # [4] Merge should be able to use properties of bound node in ON MATCH
  - name: s4_merge_should_be_able_to_use_properties_of_bound_node_in_on_match
    setup:
      - |
        CREATE (:Person {bornIn: 'New York'}),
          (:Person {bornIn: 'Ohio'})
    query: |
      MATCH (person:Person)
      MERGE (city:City)
        ON MATCH SET city.name = person.bornIn
      RETURN person.bornIn
    expect:
      values: |
        | person.bornIn |
        | 'New York' |
        | 'Ohio' |
      side_effects:
        +nodes: 1
        +labels: 1
        +properties: 1

  # [5] Fail when using undefined variable in ON MATCH
  # TCK: SyntaxError at compile time: UndefinedVariable
  - name: s5_fail_when_using_undefined_variable_in_on_match
    query: |
      MERGE (n)
        ON MATCH SET x.num = 1
    expect:
      gql_status: "42"
      side_effects: {}
