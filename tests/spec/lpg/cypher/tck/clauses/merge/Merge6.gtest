#
# Converted from the openCypher TCK, tck/features/clauses/merge/Merge6.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Merge6"
  title: "Merge6 - Merge relationships - on create"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Using ON CREATE on a node
  - name: s1_using_on_create_on_a_node
    setup:
      - |
        CREATE (:A), (:B)
    query: |
      MATCH (a:A), (b:B)
      MERGE (a)-[:KNOWS]->(b)
        ON CREATE SET b.created = 1
    expect:
      empty: true
      side_effects:
        +relationships: 1
        +properties: 1

  # [2] Using ON CREATE on a relationship
  - name: s2_using_on_create_on_a_relationship
    setup:
      - |
        CREATE (:A), (:B)
    query: |
      MATCH (a:A), (b:B)
      MERGE (a)-[r:TYPE]->(b)
        ON CREATE SET r.name = 'Lola'
      RETURN count(r)
    expect:
      values: |
        | count(r) |
        | 1 |
      side_effects:
        +relationships: 1
        +properties: 1

  # [3] Updating one property with ON CREATE
  - name: s3_updating_one_property_with_on_create
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
    query: |
      MATCH (a {name: 'A'}), (b {name: 'B'})
      MERGE (a)-[r:TYPE]->(b)
        ON CREATE SET r.name = 'foo'
    expect:
      empty: true
      side_effects:
        +relationships: 1
        +properties: 1

  # [3] Updating one property with ON CREATE (control query)
  - name: s3_updating_one_property_with_on_create_control
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
      - |
        MATCH (a {name: 'A'}), (b {name: 'B'})
        MERGE (a)-[r:TYPE]->(b)
          ON CREATE SET r.name = 'foo'
    query: |
      MATCH ()-[r:TYPE]->()
      RETURN [key IN keys(r) | key + '->' + r[key]] AS keyValue
    expect:
      values: |
        | keyValue |
        | ['name->foo'] |

  # [4] Null-setting one property with ON CREATE
  - name: s4_null_setting_one_property_with_on_create
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
    query: |
      MATCH (a {name: 'A'}), (b {name: 'B'})
      MERGE (a)-[r:TYPE]->(b)
        ON CREATE SET r.name = null
    expect:
      empty: true
      side_effects:
        +relationships: 1

  # [4] Null-setting one property with ON CREATE (control query)
  - name: s4_null_setting_one_property_with_on_create_control
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
      - |
        MATCH (a {name: 'A'}), (b {name: 'B'})
        MERGE (a)-[r:TYPE]->(b)
          ON CREATE SET r.name = null
    query: |
      MATCH ()-[r:TYPE]->()
      RETURN [key IN keys(r) | key + '->' + r[key]] AS keyValue
    expect:
      values: |
        | keyValue |
        | [] |

  # [6] Copying properties from node with ON CREATE
  - name: s6_copying_properties_from_node_with_on_create
    xfail:
      spec: "openCypher TCK 2024.3 Merge6: [6] Copying properties from node with ON CREATE"
      issue: fix in 0.6.4
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
    query: |
      MATCH (a {name: 'A'}), (b {name: 'B'})
      MERGE (a)-[r:TYPE]->(b)
        ON CREATE SET r = a
    expect:
      empty: true
      side_effects:
        +relationships: 1
        +properties: 1

  # [6] Copying properties from node with ON CREATE (control query)
  - name: s6_copying_properties_from_node_with_on_create_control
    xfail:
      spec: "openCypher TCK 2024.3 Merge6: [6] Copying properties from node with ON CREATE (control query)"
      issue: fix in 0.6.4
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
      - |
        MATCH (a {name: 'A'}), (b {name: 'B'})
        MERGE (a)-[r:TYPE]->(b)
          ON CREATE SET r = a
    query: |
      MATCH ()-[r:TYPE]->()
      RETURN [key IN keys(r) | key + '->' + r[key]] AS keyValue
    expect:
      values: |
        | keyValue |
        | ['name->A'] |

  # [7] Copying properties from literal map with ON CREATE
  - name: s7_copying_properties_from_literal_map_with_on_create
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
    query: |
      MATCH (a {name: 'A'}), (b {name: 'B'})
      MERGE (a)-[r:TYPE]->(b)
      ON CREATE SET r += {name: 'bar', name2: 'baz'}
    expect:
      empty: true
      side_effects:
        +relationships: 1
        +properties: 2

  # [7] Copying properties from literal map with ON CREATE (control query)
  - name: s7_copying_properties_from_literal_map_with_on_create_control
    setup:
      - |
        CREATE (:A {name: 'A'}), (:B {name: 'B'})
      - |
        MATCH (a {name: 'A'}), (b {name: 'B'})
        MERGE (a)-[r:TYPE]->(b)
        ON CREATE SET r += {name: 'bar', name2: 'baz'}
    query: |
      MATCH ()-[r:TYPE]->()
      RETURN [key IN keys(r) | key + '->' + r[key]] AS keyValue
    expect:
      unordered_lists: true
      values: |
        | keyValue |
        | ['name->bar', 'name2->baz'] |
