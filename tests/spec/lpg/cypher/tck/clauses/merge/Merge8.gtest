meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Merge8"
  title: "Merge8 - Merge relationships - on match and on create"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Using ON CREATE and ON MATCH
  - name: s1_using_on_create_and_on_match
    setup:
      - |
        CREATE (a:A {id: 1}), (b:B {id: 2})
        CREATE (a)-[:TYPE]->(b)
        CREATE (:A {id: 3}), (:B {id: 4})
    query: |
      MATCH (a:A), (b:B)
      MERGE (a)-[r:TYPE]->(b)
        ON CREATE SET r.name = 'Lola'
        ON MATCH SET r.name = 'RUN'
      RETURN count(r)
    expect:
      values: |
        | count(r) |
        | 4 |
      side_effects:
        +relationships: 3
        +properties: 4
