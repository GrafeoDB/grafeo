meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Merge9"
  title: "Merge9 - Merge clause interoperation with other clauses"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] UNWIND with one MERGE
  - name: s1_unwind_with_one_merge
    query: |
      UNWIND [1, 2, 3, 4] AS int
      MERGE (n {id: int})
      RETURN count(*)
    expect:
      values: |
        | count(*) |
        | 4 |
      side_effects:
        +nodes: 4
        +properties: 4

  # [2] UNWIND with multiple MERGE
  - name: s2_unwind_with_multiple_merge
    query: |
      UNWIND ['Keanu Reeves', 'Hugo Weaving', 'Carrie-Anne Moss', 'Laurence Fishburne'] AS actor
      MERGE (m:Movie {name: 'The Matrix'})
      MERGE (p:Person {name: actor})
      MERGE (p)-[:ACTED_IN]->(m)
    expect:
      empty: true
      side_effects:
        +nodes: 5
        +relationships: 4
        +labels: 2
        +properties: 5

  # [3] Mixing MERGE with CREATE
  - name: s3_mixing_merge_with_create
    query: |
      CREATE (a:A), (b:B)
      MERGE (a)-[:KNOWS]->(b)
      CREATE (b)-[:KNOWS]->(c:C)
      RETURN count(*)
    expect:
      values: |
        | count(*) |
        | 1 |
      side_effects:
        +nodes: 3
        +relationships: 2
        +labels: 3

  # [4] MERGE after WITH with predicate and WITH with aggregation
  - name: s4_merge_after_with_with_predicate_and_with_with_aggregation
    setup:
      - |
        CREATE (:A {num: 42})
    query: |
      UNWIND [42] AS props
      WITH props WHERE props > 32
      WITH DISTINCT props AS p
      MERGE (a:A {num: p})
      RETURN a.num AS prop
    expect:
      values: |
        | prop |
        | 42 |
      side_effects: {}
