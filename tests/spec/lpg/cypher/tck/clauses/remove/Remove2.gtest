# Converted from the openCypher TCK, tck/features/clauses/remove/Remove2.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Remove2"
  title: "Remove2 - Remove a Label"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Remove a single label from a node with a single label
  - name: s1_remove_a_single_label_from_a_node_with_a_single_label
    setup:
      - |
        CREATE (:L {num: 42})
    query: |
      MATCH (n)
      REMOVE n:L
      RETURN n.num
    expect:
      values: |
        | n.num |
        | 42 |
      side_effects:
        -labels: 1

  # [2] Remove a single label from a node with two labels
  - name: s2_remove_a_single_label_from_a_node_with_two_labels
    setup:
      - |
        CREATE (:Foo:Bar)
    query: |
      MATCH (n)
      REMOVE n:Foo
      RETURN labels(n)
    expect:
      values: |
        | labels(n) |
        | ['Bar'] |
      side_effects:
        -labels: 1

  # [3] Remove two labels from a node with three labels
  - name: s3_remove_two_labels_from_a_node_with_three_labels
    setup:
      - |
        CREATE (:L1:L2:L3 {num: 42})
    query: |
      MATCH (n)
      REMOVE n:L1:L3
      RETURN labels(n)
    expect:
      values: |
        | labels(n) |
        | ['L2'] |
      side_effects:
        -labels: 2

  # [4] Remove a non-existent node label
  - name: s4_remove_a_non_existent_node_label
    setup:
      - |
        CREATE (:Foo)
    query: |
      MATCH (n)
      REMOVE n:Bar
      RETURN labels(n)
    expect:
      values: |
        | labels(n) |
        | ['Foo'] |
      side_effects: {}

  # [5] Ignore null when removing a node label
  - name: s5_ignore_null_when_removing_a_node_label
    xfail:
      spec: "openCypher TCK 2024.3 Remove2: [5] Ignore null when removing a node label"
      issue: fix in 0.6.4
    query: |
      OPTIONAL MATCH (a:DoesNotExist)
      REMOVE a:L
      RETURN a
    expect:
      values: |
        | a |
        | null |
      side_effects: {}
