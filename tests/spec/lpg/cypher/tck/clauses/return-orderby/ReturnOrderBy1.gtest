meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.ReturnOrderBy1"
  title: "ReturnOrderBy1 - Order by a single variable (correct order of values according to their type)"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] ORDER BY should order booleans in the expected order
  - name: s1_order_by_should_order_booleans_in_the_expected_order
    query: |
      UNWIND [true, false] AS bools
      RETURN bools
      ORDER BY bools
    expect:
      ordered: true
      values: |
        | bools |
        | false |
        | true |
      side_effects: {}

  # [2] ORDER BY DESC should order booleans in the expected order
  - name: s2_order_by_desc_should_order_booleans_in_the_expected_order
    query: |
      UNWIND [true, false] AS bools
      RETURN bools
      ORDER BY bools DESC
    expect:
      ordered: true
      values: |
        | bools |
        | true |
        | false |
      side_effects: {}

  # [3] ORDER BY should order strings in the expected order
  - name: s3_order_by_should_order_strings_in_the_expected_order
    query: |
      UNWIND ['.*', '', ' ', 'one'] AS strings
      RETURN strings
      ORDER BY strings
    expect:
      ordered: true
      values: |
        | strings |
        | '' |
        | ' ' |
        | '.*' |
        | 'one' |
      side_effects: {}

  # [4] ORDER BY DESC should order strings in the expected order
  - name: s4_order_by_desc_should_order_strings_in_the_expected_order
    query: |
      UNWIND ['.*', '', ' ', 'one'] AS strings
      RETURN strings
      ORDER BY strings DESC
    expect:
      ordered: true
      values: |
        | strings |
        | 'one' |
        | '.*' |
        | ' ' |
        | '' |
      side_effects: {}

  # [5] ORDER BY should order ints in the expected order
  - name: s5_order_by_should_order_ints_in_the_expected_order
    query: |
      UNWIND [1, 3, 2] AS ints
      RETURN ints
      ORDER BY ints
    expect:
      ordered: true
      values: |
        | ints |
        | 1 |
        | 2 |
        | 3 |
      side_effects: {}

  # [6] ORDER BY DESC should order ints in the expected order
  - name: s6_order_by_desc_should_order_ints_in_the_expected_order
    query: |
      UNWIND [1, 3, 2] AS ints
      RETURN ints
      ORDER BY ints DESC
    expect:
      ordered: true
      values: |
        | ints |
        | 3 |
        | 2 |
        | 1 |
      side_effects: {}

  # [7] ORDER BY should order floats in the expected order
  - name: s7_order_by_should_order_floats_in_the_expected_order
    query: |
      UNWIND [1.5, 1.3, 999.99] AS floats
      RETURN floats
      ORDER BY floats
    expect:
      ordered: true
      values: |
        | floats |
        | 1.3 |
        | 1.5 |
        | 999.99 |
      side_effects: {}

  # [8] ORDER BY DESC should order floats in the expected order
  - name: s8_order_by_desc_should_order_floats_in_the_expected_order
    query: |
      UNWIND [1.5, 1.3, 999.99] AS floats
      RETURN floats
      ORDER BY floats DESC
    expect:
      ordered: true
      values: |
        | floats |
        | 999.99 |
        | 1.5 |
        | 1.3 |
      side_effects: {}

  # [9] ORDER BY should order lists in the expected order
  - name: s9_order_by_should_order_lists_in_the_expected_order
    query: |
      UNWIND [[], ['a'], ['a', 1], [1], [1, 'a'], [1, null], [null, 1], [null, 2]] AS lists
      RETURN lists
      ORDER BY lists
    expect:
      ordered: true
      values: |
        | lists |
        | [] |
        | ['a'] |
        | ['a', 1] |
        | [1] |
        | [1, 'a'] |
        | [1, null] |
        | [null, 1] |
        | [null, 2] |
      side_effects: {}

  # [10] ORDER BY DESC should order lists in the expected order
  - name: s10_order_by_desc_should_order_lists_in_the_expected_order
    query: |
      UNWIND [[], ['a'], ['a', 1], [1], [1, 'a'], [1, null], [null, 1], [null, 2]] AS lists
      RETURN lists
      ORDER BY lists DESC
    expect:
      ordered: true
      values: |
        | lists |
        | [null, 2] |
        | [null, 1] |
        | [1, null] |
        | [1, 'a'] |
        | [1] |
        | ['a', 1] |
        | ['a'] |
        | [] |
      side_effects: {}

  # [11] ORDER BY should order distinct types in the expected order
  - name: s11_order_by_should_order_distinct_types_in_the_expected_order
    xfail:
      spec: "openCypher TCK 2024.3 ReturnOrderBy1: [11] ORDER BY should order distinct types in the expected order"
      issue: fix in 0.6.4
    setup:
      - |
        CREATE (:N)-[:REL]->()
    query: |
      MATCH p = (n:N)-[r:REL]->()
      UNWIND [n, r, p, 1.5, ['list'], 'text', null, false, 0.0 / 0.0, {a: 'map'}] AS types
      RETURN types
      ORDER BY types
    expect:
      ordered: true
      values: |
        | types |
        | {a: 'map'} |
        | (:N) |
        | [:REL] |
        | ['list'] |
        | <(:N)-[:REL]->()> |
        | 'text' |
        | false |
        | 1.5 |
        | NaN |
        | null |
      side_effects: {}

  # [12] ORDER BY DESC should order distinct types in the expected order
  - name: s12_order_by_desc_should_order_distinct_types_in_the_expected_order
    xfail:
      spec: "openCypher TCK 2024.3 ReturnOrderBy1: [12] ORDER BY DESC should order distinct types in the expected order"
      issue: fix in 0.6.4
    setup:
      - |
        CREATE (:N)-[:REL]->()
    query: |
      MATCH p = (n:N)-[r:REL]->()
      UNWIND [n, r, p, 1.5, ['list'], 'text', null, false, 0.0 / 0.0, {a: 'map'}] AS types
      RETURN types
      ORDER BY types DESC
    expect:
      ordered: true
      values: |
        | types |
        | null |
        | NaN |
        | 1.5 |
        | false |
        | 'text' |
        | <(:N)-[:REL]->()> |
        | ['list'] |
        | [:REL] |
        | (:N) |
        | {a: 'map'} |
      side_effects: {}
