# Converted from the openCypher TCK, tck/features/clauses/return-orderby/ReturnOrderBy2.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.ReturnOrderBy2"
  title: "ReturnOrderBy2 - Order by a single expression (order of projection)"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] ORDER BY should return results in ascending order
  - name: s1_order_by_should_return_results_in_ascending_order
    setup:
      - |
        CREATE (n1 {num: 1}),
          (n2 {num: 3}),
          (n3 {num: -5})
    query: |
      MATCH (n)
      RETURN n.num AS prop
      ORDER BY n.num
    expect:
      ordered: true
      values: |
        | prop |
        | -5 |
        | 1 |
        | 3 |
      side_effects: {}

  # [2] ORDER BY DESC should return results in descending order
  - name: s2_order_by_desc_should_return_results_in_descending_order
    setup:
      - |
        CREATE (n1 {num: 1}),
          (n2 {num: 3}),
          (n3 {num: -5})
    query: |
      MATCH (n)
      RETURN n.num AS prop
      ORDER BY n.num DESC
    expect:
      ordered: true
      values: |
        | prop |
        | 3 |
        | 1 |
        | -5 |
      side_effects: {}

  # [3] Sort on aggregated function
  - name: s3_sort_on_aggregated_function
    setup:
      - |
        CREATE ({division: 'A', age: 22}),
          ({division: 'B', age: 33}),
          ({division: 'B', age: 44}),
          ({division: 'C', age: 55})
    query: |
      MATCH (n)
      RETURN n.division, max(n.age)
        ORDER BY max(n.age)
    expect:
      ordered: true
      values: |
        | n.division | max(n.age) |
        | 'A' | 22 |
        | 'B' | 44 |
        | 'C' | 55 |
      side_effects: {}

  # [4] Support sort and distinct
  - name: s4_support_sort_and_distinct
    setup:
      - |
        CREATE ({name: 'A'}),
          ({name: 'B'}),
          ({name: 'C'})
    query: |
      MATCH (a)
      RETURN DISTINCT a
        ORDER BY a.name
    expect:
      ordered: true
      values: |
        | a |
        | ({name: 'A'}) |
        | ({name: 'B'}) |
        | ({name: 'C'}) |
      side_effects: {}

  # [5] Support ordering by a property after being distinct-ified
  - name: s5_support_ordering_by_a_property_after_being_distinct_ified
    setup:
      - |
        CREATE (:A)-[:T]->(:B)
    query: |
      MATCH (a)-->(b)
      RETURN DISTINCT b
        ORDER BY b.name
    expect:
      ordered: true
      values: |
        | b |
        | (:B) |
      side_effects: {}

  # [6] Count star should count everything in scope
  - name: s6_count_star_should_count_everything_in_scope
    setup:
      - |
        CREATE (:L1), (:L2), (:L3)
    query: |
      MATCH (a)
      RETURN a, count(*)
      ORDER BY count(*)
    expect:
      values: |
        | a | count(*) |
        | (:L1) | 1 |
        | (:L2) | 1 |
        | (:L3) | 1 |
      side_effects: {}

  # [7] Ordering with aggregation
  - name: s7_ordering_with_aggregation
    setup:
      - |
        CREATE ({name: 'nisse'})
    query: |
      MATCH (n)
      RETURN n.name, count(*) AS foo
        ORDER BY n.name
    expect:
      ordered: true
      values: |
        | n.name | foo |
        | 'nisse' | 1 |
      side_effects: {}

  # [8] Returning all variables with ordering
  - name: s8_returning_all_variables_with_ordering
    setup:
      - |
        CREATE ({id: 1}), ({id: 10})
    query: |
      MATCH (n)
      RETURN *
        ORDER BY n.id
    expect:
      ordered: true
      values: |
        | n |
        | ({id: 1}) |
        | ({id: 10}) |
      side_effects: {}

  # [9] Using aliased DISTINCT expression in ORDER BY
  - name: s9_using_aliased_distinct_expression_in_order_by
    setup:
      - |
        CREATE ({id: 1}), ({id: 10})
    query: |
      MATCH (n)
      RETURN DISTINCT n.id AS id
        ORDER BY id DESC
    expect:
      ordered: true
      values: |
        | id |
        | 10 |
        | 1 |
      side_effects: {}

  # [10] Returned columns do not change from using ORDER BY
  - name: s10_returned_columns_do_not_change_from_using_order_by
    setup:
      - |
        CREATE ({id: 1}), ({id: 10})
    query: |
      MATCH (n)
      RETURN DISTINCT n
        ORDER BY n.id
    expect:
      ordered: true
      values: |
        | n |
        | ({id: 1}) |
        | ({id: 10}) |
      side_effects: {}

  # [11] Aggregates ordered by arithmetics
  - name: s11_aggregates_ordered_by_arithmetics
    setup:
      - |
        CREATE (:A), (:X), (:X)
    query: |
      MATCH (a:A), (b:X)
      RETURN count(a) * 10 + count(b) * 5 AS x
      ORDER BY x
    expect:
      ordered: true
      values: |
        | x |
        | 30 |
      side_effects: {}

  # [12] Aggregation of named paths
  - name: s12_aggregation_of_named_paths
    setup:
      - |
        CREATE (a:A), (b:B), (c:C), (d:D), (e:E), (f:F)
        CREATE (a)-[:R]->(b)
        CREATE (c)-[:R]->(d)
        CREATE (d)-[:R]->(e)
        CREATE (e)-[:R]->(f)
    query: |
      MATCH p = (a)-[*]->(b)
      RETURN collect(nodes(p)) AS paths, length(p) AS l
      ORDER BY l
    expect:
      ordered: true
      unordered_lists: true
      values: |
        | paths | l |
        | [[(:A), (:B)], [(:C), (:D)], [(:D), (:E)], [(:E), (:F)]] | 1 |
        | [[(:C), (:D), (:E)], [(:D), (:E), (:F)]] | 2 |
        | [[(:C), (:D), (:E), (:F)]] | 3 |
      side_effects: {}

  # [13] Fail when sorting on variable removed by DISTINCT
  # TCK: SyntaxError at compile time: UndefinedVariable
  - name: s13_fail_when_sorting_on_variable_removed_by_distinct
    setup:
      - |
        CREATE ({name: 'A', age: 13}), ({name: 'B', age: 12}), ({name: 'C', age: 11})
    query: |
      MATCH (a)
      RETURN DISTINCT a.name
        ORDER BY a.age
    expect:
      gql_status: "42"
      side_effects: {}

  # [14] Fail on aggregation in ORDER BY after RETURN
  # TCK: SyntaxError at compile time: InvalidAggregation
  - name: s14_fail_on_aggregation_in_order_by_after_return
    query: |
      MATCH (n)
      RETURN n.num1
        ORDER BY max(n.num2)
    expect:
      gql_status: "42"
      side_effects: {}
