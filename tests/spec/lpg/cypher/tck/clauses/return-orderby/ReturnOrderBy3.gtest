meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.ReturnOrderBy3"
  title: "ReturnOrderBy3 - Order by multiple expressions (order obey priority of expressions)"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Sort on aggregate function and normal property
  - name: s1_sort_on_aggregate_function_and_normal_property
    setup:
      - |
        CREATE ({division: 'Sweden'})
        CREATE ({division: 'Germany'})
        CREATE ({division: 'England'})
        CREATE ({division: 'Sweden'})
    query: |
      MATCH (n)
      RETURN n.division, count(*)
      ORDER BY count(*) DESC, n.division ASC
    expect:
      ordered: true
      values: |
        | n.division | count(*) |
        | 'Sweden' | 2 |
        | 'England' | 1 |
        | 'Germany' | 1 |
      side_effects: {}
