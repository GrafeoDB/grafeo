meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.ReturnOrderBy4"
  title: "ReturnOrderBy4 - Order by in combination with projection"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] ORDER BY of a column introduced in RETURN should return salient results in ascending order
  - name: s1_order_by_of_a_column_introduced_in_return_should_return_salient_results_in_ascending_order
    query: |
      WITH [0, 1] AS prows, [[2], [3, 4]] AS qrows
      UNWIND prows AS p
      UNWIND qrows[p] AS q
      WITH p, count(q) AS rng
      RETURN p
      ORDER BY rng
    expect:
      ordered: true
      values: |
        | p |
        | 0 |
        | 1 |
      side_effects: {}

  # [2] Handle projections with ORDER BY
  - name: s2_handle_projections_with_order_by
    setup:
      - |
        CREATE (c1:Crew {name: 'Neo', rank: 1}),
          (c2:Crew {name: 'Neo', rank: 2}),
          (c3:Crew {name: 'Neo', rank: 3}),
          (c4:Crew {name: 'Neo', rank: 4}),
          (c5:Crew {name: 'Neo', rank: 5})
    query: |
      MATCH (c:Crew {name: 'Neo'})
      WITH c, 0 AS relevance
      RETURN c.rank AS rank
      ORDER BY relevance, c.rank
    expect:
      ordered: true
      values: |
        | rank |
        | 1 |
        | 2 |
        | 3 |
        | 4 |
        | 5 |
      side_effects: {}
