# Converted from the openCypher TCK, tck/features/clauses/return-orderby/ReturnOrderBy6.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.ReturnOrderBy6"
  title: "ReturnOrderBy6 - Aggregation expressions in order by"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Handle constants and parameters inside an order by item which contains an aggregation expression
  - name: s1_handle_constants_and_parameters_inside_an_order_by_item_which_contains_an_aggregation_expression
    params:
      age: 38
    query: |
      MATCH (person)
      RETURN avg(person.age) AS avgAge
      ORDER BY $age + avg(person.age) - 1000
    expect:
      values: |
        | avgAge |
        | null |
      side_effects: {}

  # [2] Handle returned aliases inside an order by item which contains an aggregation expression
  - name: s2_handle_returned_aliases_inside_an_order_by_item_which_contains_an_aggregation_expression
    query: |
      MATCH (me: Person)--(you: Person)
      RETURN me.age AS age, count(you.age) AS cnt
      ORDER BY age, age + count(you.age)
    expect:
      values: |
        | age | cnt |
      side_effects: {}

  # [3] Handle returned property accesses inside an order by item which contains an aggregation expression
  - name: s3_handle_returned_property_accesses_inside_an_order_by_item_which_contains_an_aggregation_expression
    query: |
      MATCH (me: Person)--(you: Person)
      RETURN me.age AS age, count(you.age) AS cnt
      ORDER BY me.age + count(you.age)
    expect:
      values: |
        | age | cnt |
      side_effects: {}

  # [4] Fail if not returned variables are used inside an order by item which contains an aggregation expression
  # TCK: SyntaxError at compile time: UndefinedVariable
  - name: s4_fail_if_not_returned_variables_are_used_inside_an_order_by_item_which_contains_an_aggregation_expression
    query: |
      MATCH (me: Person)--(you: Person)
      RETURN count(you.age) AS agg
      ORDER BY me.age + count(you.age)
    expect:
      gql_status: "42"
      side_effects: {}

  # [5] Fail if more complex expressions, even if returned, are used inside an order by item which contains an aggregation expression
  # TCK: SyntaxError at compile time: AmbiguousAggregationExpression
  - name: s5_fail_if_more_complex_expressions_even_if_returned_are_used_inside_an_order_by_item_which_contains_an_aggregation_expression
    xfail:
      spec: "openCypher TCK 2024.3 ReturnOrderBy6: [5] Fail if more complex expressions, even if returned, are used inside an order by item which contains an aggregation expression"
      issue: "#798"
    query: |
      MATCH (me: Person)--(you: Person)
      RETURN me.age + you.age, count(*) AS cnt
      ORDER BY me.age + you.age + count(*)
    expect:
      gql_status: "42"
      side_effects: {}
