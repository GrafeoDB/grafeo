meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Return3"
  title: "Return3 - Return multiple expressions (if column order correct)"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Returning multiple expressions
  - name: s1_returning_multiple_expressions
    setup:
      - |
        CREATE ()
    query: |
      MATCH (a)
      RETURN a.id IS NOT NULL AS a, a IS NOT NULL AS b
    expect:
      values: |
        | a | b |
        | false | true |
      side_effects: {}

  # [2] Returning multiple node property values
  - name: s2_returning_multiple_node_property_values
    setup:
      - |
        CREATE ({name: 'Philip J. Fry', age: 2046, seasons: [1, 2, 3, 4, 5, 6, 7]})
    query: |
      MATCH (a)
      RETURN a.name, a.age, a.seasons
    expect:
      values: |
        | a.name | a.age | a.seasons |
        | 'Philip J. Fry' | 2046 | [1, 2, 3, 4, 5, 6, 7] |
      side_effects: {}

  # [3] Projecting nodes and relationships
  - name: s3_projecting_nodes_and_relationships
    setup:
      - |
        CREATE (a:A), (b:B)
        CREATE (a)-[:T]->(b)
    query: |
      MATCH (a)-[r]->()
      RETURN a AS foo, r AS bar
    expect:
      values: |
        | foo | bar |
        | (:A) | [:T] |
      side_effects: {}
