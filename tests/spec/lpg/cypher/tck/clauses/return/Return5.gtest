meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Return5"
  title: "Return5 - Implicit grouping with distinct"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] DISTINCT inside aggregation should work with lists in maps
  - name: s1_distinct_inside_aggregation_should_work_with_lists_in_maps
    setup:
      - |
        CREATE ({list: ['A', 'B']}), ({list: ['A', 'B']})
    query: |
      MATCH (n)
      RETURN count(DISTINCT {name: n.list}) AS count
    expect:
      values: |
        | count |
        | 1 |
      side_effects: {}

  # [2] DISTINCT on nullable values
  - name: s2_distinct_on_nullable_values
    setup:
      - |
        CREATE ({name: 'Florescu'}), (), ()
    query: |
      MATCH (n)
      RETURN DISTINCT n.name
    expect:
      values: |
        | n.name |
        | 'Florescu' |
        | null |
      side_effects: {}

  # [3] DISTINCT inside aggregation should work with nested lists in maps
  - name: s3_distinct_inside_aggregation_should_work_with_nested_lists_in_maps
    setup:
      - |
        CREATE ({list: ['A', 'B']}), ({list: ['A', 'B']})
    query: |
      MATCH (n)
      RETURN count(DISTINCT {name: [[n.list, n.list], [n.list, n.list]]}) AS count
    expect:
      values: |
        | count |
        | 1 |
      side_effects: {}

  # [4] DISTINCT inside aggregation should work with nested lists of maps in maps
  - name: s4_distinct_inside_aggregation_should_work_with_nested_lists_of_maps_in_maps
    setup:
      - |
        CREATE ({list: ['A', 'B']}), ({list: ['A', 'B']})
    query: |
      MATCH (n)
      RETURN count(DISTINCT {name: [{name2: n.list}, {baz: {apa: n.list}}]}) AS count
    expect:
      values: |
        | count |
        | 1 |
      side_effects: {}

  # [5] Aggregate on list values
  - name: s5_aggregate_on_list_values
    setup:
      - |
        CREATE ({color: ['red']})
        CREATE ({color: ['blue']})
        CREATE ({color: ['red']})
    query: |
      MATCH (a)
      RETURN DISTINCT a.color, count(*)
    expect:
      values: |
        | a.color | count(*) |
        | ['red'] | 2 |
        | ['blue'] | 1 |
      side_effects: {}
