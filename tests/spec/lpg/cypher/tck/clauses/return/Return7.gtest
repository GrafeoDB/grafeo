meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Return7"
  title: "Return7 - Return all variables"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Return all variables
  - name: s1_return_all_variables
    setup:
      - |
        CREATE (:Start)-[:T]->()
    query: |
      MATCH p = (a:Start)-->(b)
      RETURN *
    expect:
      values: |
        | a | b | p |
        | (:Start) | () | <(:Start)-[:T]->()> |
      side_effects: {}

  # [2] Fail when using RETURN * without variables in scope
  # TCK: SyntaxError at compile time: NoVariablesInScope
  - name: s2_fail_when_using_return_without_variables_in_scope
    xfail:
      spec: "openCypher TCK 2024.3 Return7: [2] Fail when using RETURN * without variables in scope"
      issue: "#798"
    query: |
      MATCH ()
      RETURN *
    expect:
      gql_status: "42"
      side_effects: {}
