meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Set2"
  title: "Set2 - Set a Property to Null"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Setting a node property to null removes the existing property
  - name: s1_setting_a_node_property_to_null_removes_the_existing_property
    setup:
      - |
        CREATE (:A {property1: 23, property2: 46})
    query: |
      MATCH (n:A)
      SET n.property1 = null
      RETURN n
    expect:
      values: |
        | n |
        | (:A {property2: 46}) |
      side_effects:
        -properties: 1

  # [2] Setting a node property to null removes the existing property, but not before SET
  - name: s2_setting_a_node_property_to_null_removes_the_existing_property_but_not_before_set
    setup:
      - |
        CREATE (:A {name: 'Michael', age: 35})
    query: |
      MATCH (n)
      WHERE n.name = 'Michael'
      SET n.name = null
      RETURN n
    expect:
      values: |
        | n |
        | (:A {age: 35}) |
      side_effects:
        -properties: 1

  # [3] Setting a relationship property to null removes the existing property
  - name: s3_setting_a_relationship_property_to_null_removes_the_existing_property
    setup:
      - |
        CREATE ()-[:REL {property1: 12, property2: 24}]->()
    query: |
      MATCH ()-[r]->()
      SET r.property1 = null
      RETURN r
    expect:
      values: |
        | r |
        | [:REL {property2: 24}] |
      side_effects:
        -properties: 1
