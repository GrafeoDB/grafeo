meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Set3"
  title: "Set3 - Set a Label"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Add a single label to a node with no label
  - name: s1_add_a_single_label_to_a_node_with_no_label
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      SET n:Foo
      RETURN n
    expect:
      values: |
        | n |
        | (:Foo) |
      side_effects:
        +labels: 1

  # [2] Adding multiple labels to a node with no label
  - name: s2_adding_multiple_labels_to_a_node_with_no_label
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      SET n:Foo:Bar
      RETURN n
    expect:
      values: |
        | n |
        | (:Foo:Bar) |
      side_effects:
        +labels: 2

  # [3] Add a single label to a node with an existing label
  - name: s3_add_a_single_label_to_a_node_with_an_existing_label
    setup:
      - |
        CREATE (:A)
    query: |
      MATCH (n:A)
      SET n:Foo
      RETURN n
    expect:
      values: |
        | n |
        | (:A:Foo) |
      side_effects:
        +labels: 1

  # [4] Adding multiple labels to a node with an existing label
  - name: s4_adding_multiple_labels_to_a_node_with_an_existing_label
    setup:
      - |
        CREATE (:A)
    query: |
      MATCH (n)
      SET n:Foo:Bar
      RETURN n
    expect:
      values: |
        | n |
        | (:A:Foo:Bar) |
      side_effects:
        +labels: 2

  # [5] Ignore whitespace before colon 1
  - name: s5_ignore_whitespace_before_colon_1
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      SET n :Foo
      RETURN labels(n)
    expect:
      values: |
        | labels(n) |
        | ['Foo'] |
      side_effects:
        +labels: 1

  # [6] Ignore whitespace before colon 2
  - name: s6_ignore_whitespace_before_colon_2
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      SET n :Foo :Bar
      RETURN labels(n)
    expect:
      unordered_lists: true
      values: |
        | labels(n) |
        | ['Foo', 'Bar'] |
      side_effects:
        +labels: 2

  # [7] Ignore whitespace before colon 3
  - name: s7_ignore_whitespace_before_colon_3
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      SET n :Foo:Bar
      RETURN labels(n)
    expect:
      unordered_lists: true
      values: |
        | labels(n) |
        | ['Foo', 'Bar'] |
      side_effects:
        +labels: 2

  # [8] Ignore null when setting label
  - name: s8_ignore_null_when_setting_label
    query: |
      OPTIONAL MATCH (a:DoesNotExist)
      SET a:L
      RETURN a
    expect:
      values: |
        | a |
        | null |
      side_effects: {}
