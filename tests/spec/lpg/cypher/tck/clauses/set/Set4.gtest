meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Set4"
  title: "Set4 - Set all properties with a map"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Set multiple properties with a property map
  - name: s1_set_multiple_properties_with_a_property_map
    setup:
      - |
        CREATE (:X)
    query: |
      MATCH (n:X)
      SET n = {name: 'A', name2: 'B', num: 5}
      RETURN n
    expect:
      values: |
        | n |
        | (:X {name: 'A', name2: 'B', num: 5}) |
      side_effects:
        +properties: 3

  # [2] Non-existent values in a property map are removed with SET
  - name: s2_non_existent_values_in_a_property_map_are_removed_with_set
    setup:
      - |
        CREATE (:X {name: 'A', name2: 'B'})
    query: |
      MATCH (n:X {name: 'A'})
      SET n = {name: 'B', baz: 'C'}
      RETURN n
    expect:
      values: |
        | n |
        | (:X {name: 'B', baz: 'C'}) |
      side_effects:
        +properties: 2
        -properties: 2

  # [3] Null values in a property map are removed with SET
  - name: s3_null_values_in_a_property_map_are_removed_with_set
    setup:
      - |
        CREATE (:X {name: 'A', name2: 'B'})
    query: |
      MATCH (n:X {name: 'A'})
      SET n = {name: 'B', name2: null, baz: 'C'}
      RETURN n
    expect:
      values: |
        | n |
        | (:X {name: 'B', baz: 'C'}) |
      side_effects:
        +properties: 2
        -properties: 2

  # [4] All properties are removed if node is set to empty property map
  - name: s4_all_properties_are_removed_if_node_is_set_to_empty_property_map
    setup:
      - |
        CREATE (:X {name: 'A', name2: 'B'})
    query: |
      MATCH (n:X {name: 'A'})
      SET n = { }
      RETURN n
    expect:
      values: |
        | n |
        | (:X) |
      side_effects:
        -properties: 2

  # [5] Ignore null when setting properties using an overriding map
  - name: s5_ignore_null_when_setting_properties_using_an_overriding_map
    query: |
      OPTIONAL MATCH (a:DoesNotExist)
      SET a = {num: 42}
      RETURN a
    expect:
      values: |
        | a |
        | null |
      side_effects: {}
