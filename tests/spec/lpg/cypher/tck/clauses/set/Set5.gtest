meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Set5"
  title: "Set5 - Set multiple properties with a map"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Ignore null when setting properties using an appending map
  - name: s1_ignore_null_when_setting_properties_using_an_appending_map
    xfail:
      spec: "openCypher TCK 2024.3 Set5: [1] Ignore null when setting properties using an appending map"
      issue: fix in 0.6.4
    query: |
      OPTIONAL MATCH (a:DoesNotExist)
      SET a += {num: 42}
      RETURN a
    expect:
      values: |
        | a |
        | null |
      side_effects: {}

  # [2] Overwrite values when using +=
  - name: s2_overwrite_values_when_using
    setup:
      - |
        CREATE (:X {name: 'A', name2: 'B'})
    query: |
      MATCH (n:X {name: 'A'})
      SET n += {name2: 'C'}
      RETURN n
    expect:
      values: |
        | n |
        | (:X {name: 'A', name2: 'C'}) |
      side_effects:
        +properties: 1
        -properties: 1

  # [3] Retain old values when using +=
  - name: s3_retain_old_values_when_using
    setup:
      - |
        CREATE (:X {name: 'A'})
    query: |
      MATCH (n:X {name: 'A'})
      SET n += {name2: 'B'}
      RETURN n
    expect:
      values: |
        | n |
        | (:X {name: 'A', name2: 'B'}) |
      side_effects:
        +properties: 1

  # [4] Explicit null values in a map remove old values
  - name: s4_explicit_null_values_in_a_map_remove_old_values
    setup:
      - |
        CREATE (:X {name: 'A', name2: 'B'})
    query: |
      MATCH (n:X {name: 'A'})
      SET n += {name: null}
      RETURN n
    expect:
      values: |
        | n |
        | (:X {name2: 'B'}) |
      side_effects:
        -properties: 1

  # [5] Set an empty map when using += has no effect
  - name: s5_set_an_empty_map_when_using_has_no_effect
    setup:
      - |
        CREATE (:X {name: 'A', name2: 'B'})
    query: |
      MATCH (n:X {name: 'A'})
      SET n += { }
      RETURN n
    expect:
      values: |
        | n |
        | (:X {name: 'A', name2: 'B'}) |
      side_effects: {}
