meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Set6"
  title: "Set6 - Persistence of set clause side effects"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Limiting to zero results after setting a property on nodes affects the result set but not the side effects
  - name: s1_limiting_to_zero_results_after_setting_a_property_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      SET n.num = 43
      RETURN n
      LIMIT 0
    expect:
      values: |
        | n |
      side_effects:
        +properties: 1
        -properties: 1

  # [2] Skipping all results after setting a property on nodes affects the result set but not the side effects
  - name: s2_skipping_all_results_after_setting_a_property_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      SET n.num = 43
      RETURN n
      SKIP 1
    expect:
      values: |
        | n |
      side_effects:
        +properties: 1
        -properties: 1

  # [3] Skipping and limiting to a few results after setting a property on nodes affects the result set but not the side effects
  - name: s3_skipping_and_limiting_to_a_few_results_after_setting_a_property_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n.num = 42
      RETURN n.num AS num
      SKIP 2 LIMIT 2
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
      side_effects:
        +properties: 5
        -properties: 5

  # [4] Skipping zero results and limiting to all results after setting a property on nodes does not affect the result set nor the side effects
  - name: s4_skipping_zero_results_and_limiting_to_all_results_after_setting_a_property_on_nodes_does_not_affect_the_result_set_nor_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n.num = 42
      RETURN n.num AS num
      SKIP 0 LIMIT 5
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
      side_effects:
        +properties: 5
        -properties: 5

  # [5] Filtering after setting a property on nodes affects the result set but not the side effects
  - name: s5_filtering_after_setting_a_property_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n.num = n.num + 1
      WITH n
      WHERE n.num % 2 = 0
      RETURN n.num AS num
    expect:
      values: |
        | num |
        | 2 |
        | 4 |
        | 6 |
      side_effects:
        +properties: 5
        -properties: 5

  # [6] Aggregating in `RETURN` after setting a property on nodes affects the result set but not the side effects
  - name: s6_aggregating_in_return_after_setting_a_property_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n.num = n.num + 1
      RETURN sum(n.num) AS sum
    expect:
      values: |
        | sum |
        | 20 |
      side_effects:
        +properties: 5
        -properties: 5

  # [7] Aggregating in `WITH` after setting a property on nodes affects the result set but not the side effects
  - name: s7_aggregating_in_with_after_setting_a_property_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n.num = n.num + 1
      WITH sum(n.num) AS sum
      RETURN sum
    expect:
      values: |
        | sum |
        | 20 |
      side_effects:
        +properties: 5
        -properties: 5

  # [8] Limiting to zero results after adding a label on nodes affects the result set but not the side effects
  - name: s8_limiting_to_zero_results_after_adding_a_label_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      SET n:Foo
      RETURN n
      LIMIT 0
    expect:
      values: |
        | n |
      side_effects:
        +labels: 1

  # [9] Skipping all results after adding a label on nodes affects the result set but not the side effects
  - name: s9_skipping_all_results_after_adding_a_label_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      SET n:Foo
      RETURN n
      SKIP 1
    expect:
      values: |
        | n |
      side_effects:
        +labels: 1

  # [10] Skipping and limiting to a few results after adding a label on nodes affects the result set but not the side effects
  - name: s10_skipping_and_limiting_to_a_few_results_after_adding_a_label_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      SET n:Foo
      RETURN n.num AS num
      SKIP 2 LIMIT 2
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
      side_effects:
        +labels: 1

  # [11] Skipping zero result and limiting to all results after adding a label on nodes does not affect the result set nor the side effects
  - name: s11_skipping_zero_result_and_limiting_to_all_results_after_adding_a_label_on_nodes_does_not_affect_the_result_set_nor_the_side_effects
    setup:
      - |
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
        CREATE (:N {num: 42})
    query: |
      MATCH (n:N)
      SET n:Foo
      RETURN n.num AS num
      SKIP 0 LIMIT 5
    expect:
      values: |
        | num |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
        | 42 |
      side_effects:
        +labels: 1

  # [12] Filtering after adding a label on nodes affects the result set but not the side effects
  - name: s12_filtering_after_adding_a_label_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n:Foo
      WITH n
      WHERE n.num % 2 = 0
      RETURN n.num AS num
    expect:
      values: |
        | num |
        | 2 |
        | 4 |
      side_effects:
        +labels: 1

  # [13] Aggregating in `RETURN` after adding a label on nodes affects the result set but not the side effects
  - name: s13_aggregating_in_return_after_adding_a_label_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n:Foo
      RETURN sum(n.num) AS sum
    expect:
      values: |
        | sum |
        | 15 |
      side_effects:
        +labels: 1

  # [14] Aggregating in `WITH` after adding a label on nodes affects the result set but not the side effects
  - name: s14_aggregating_in_with_after_adding_a_label_on_nodes_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE (:N {num: 1})
        CREATE (:N {num: 2})
        CREATE (:N {num: 3})
        CREATE (:N {num: 4})
        CREATE (:N {num: 5})
    query: |
      MATCH (n:N)
      SET n:Foo
      WITH sum(n.num) AS sum
      RETURN sum
    expect:
      values: |
        | sum |
        | 15 |
      side_effects:
        +labels: 1

  # [15] Limiting to zero results after setting a property on relationships affects the result set but not the side effects
  - name: s15_limiting_to_zero_results_after_setting_a_property_on_relationships_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE ()-[r:R {num: 42}]->()
    query: |
      MATCH ()-[r:R]->()
      SET r.num = 43
      RETURN r
      LIMIT 0
    expect:
      values: |
        | r |
      side_effects:
        +properties: 1
        -properties: 1

  # [16] Skipping all results after setting a property on relationships affects the result set but not the side effects
  - name: s16_skipping_all_results_after_setting_a_property_on_relationships_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE ()-[r:R {num: 42}]->()
    query: |
      MATCH ()-[r:R]->()
      SET r.num = 43
      RETURN r
      SKIP 1
    expect:
      values: |
        | r |
      side_effects:
        +properties: 1
        -properties: 1

  # [17] Skipping and limiting to a few results after setting a property on relationships affects the result set but not the side effects
  - name: s17_skipping_and_limiting_to_a_few_results_after_setting_a_property_on_relationships_affects_the_result_set_but_not_the_side_effects
    setup:
      - |
        CREATE ()-[:R {num: 1}]->()
        CREATE ()-[:R {num: 2}]->()
        CREATE ()-[:R {num: 3}]->()
        CREATE ()-[:R {num: 4}]->()
        CREATE ()-[:R {num: 5}]->()
    query: |
      MATCH ()-[r:R]->()
      SET r.num = 42
      RETURN r.num AS num
