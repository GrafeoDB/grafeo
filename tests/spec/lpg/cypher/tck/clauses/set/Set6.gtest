        CREATE ()-[:R {num: 2}]->()
        CREATE ()-[:R {num: 3}]->()
        CREATE ()-[:R {num: 4}]->()
        CREATE ()-[:R {num: 5}]->()
    query: |
      MATCH ()-[r:R]->()
