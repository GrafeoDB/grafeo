        -properties: 5

  # [18] Skipping zero result and limiting to all results after setting a property on relationships does not affect the result set nor the side effects
  - name: s18_skipping_zero_result_and_limiting_to_all_results_after_setting_a_property_on_relationships_does_not_affect_the_result_set_nor_the_side_effects
    setup:
