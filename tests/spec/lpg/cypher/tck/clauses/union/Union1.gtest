# Converted from the openCypher TCK, tck/features/clauses/union/Union1.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Union1"
  title: "Union1 - Union"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Two elements, both unique, distinct
  - name: s1_two_elements_both_unique_distinct
    query: |
      RETURN 1 AS x
      UNION
      RETURN 2 AS x
    expect:
      values: |
        | x |
        | 1 |
        | 2 |
      side_effects: {}

  # [2] Three elements, two unique, distinct
  - name: s2_three_elements_two_unique_distinct
    query: |
      RETURN 2 AS x
      UNION
      RETURN 1 AS x
      UNION
      RETURN 2 AS x
    expect:
      values: |
        | x |
        | 2 |
        | 1 |
      side_effects: {}

  # [3] Two single-column inputs, one with duplicates, distinct
  - name: s3_two_single_column_inputs_one_with_duplicates_distinct
    query: |
      UNWIND [2, 1, 2, 3] AS x
      RETURN x
      UNION
      UNWIND [3, 4] AS x
      RETURN x
    expect:
      values: |
        | x |
        | 2 |
        | 1 |
        | 3 |
        | 4 |
      side_effects: {}

  # [4] Should be able to create text output from union queries
  - name: s4_should_be_able_to_create_text_output_from_union_queries
    setup:
      - |
        CREATE (:A), (:B)
    query: |
      MATCH (a:A)
      RETURN a AS a
      UNION
      MATCH (b:B)
      RETURN b AS a
    expect:
      values: |
        | a |
        | (:A) |
        | (:B) |
      side_effects: {}

  # [5] Failing when UNION has different columns
  # TCK: SyntaxError at compile time: DifferentColumnsInUnion
  - name: s5_failing_when_union_has_different_columns
    query: |
      RETURN 1 AS a
      UNION
      RETURN 2 AS b
    expect:
      gql_status: "42"
      side_effects: {}
