  # [43] Sort by a variable that is only partially orderable on a non-distinct binding table #1
  - name: s43_sort_by_a_variable_that_is_only_partially_orderable_on_a_non_distinct_binding_table_1
    query: |
      UNWIND [0, 2, 1, 2, 0, 1] AS x
      WITH x
