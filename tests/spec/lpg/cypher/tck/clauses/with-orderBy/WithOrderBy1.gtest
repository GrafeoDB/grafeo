meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithOrderBy1"
  title: "WithOrderBy1 - Order by a single variable"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Sort booleans in ascending order
  - name: s1_sort_booleans_in_ascending_order
    query: |
      UNWIND [true, false] AS bools
      WITH bools
        ORDER BY bools
        LIMIT 1
      RETURN bools
    expect:
      ordered: true
      values: |
        | bools |
        | false |
      side_effects: {}

  # [2] Sort booleans in descending order
  - name: s2_sort_booleans_in_descending_order
    query: |
      UNWIND [true, false] AS bools
      WITH bools
        ORDER BY bools DESC
        LIMIT 1
      RETURN bools
    expect:
      ordered: true
      values: |
        | bools |
        | true |
      side_effects: {}

  # [3] Sort integers in ascending order
  - name: s3_sort_integers_in_ascending_order
    query: |
      UNWIND [1, 3, 2] AS ints
      WITH ints
        ORDER BY ints
        LIMIT 2
      RETURN ints
    expect:
      ordered: true
      values: |
        | ints |
        | 1 |
        | 2 |
      side_effects: {}

  # [4] Sort integers in descending order
  - name: s4_sort_integers_in_descending_order
    query: |
      UNWIND [1, 3, 2] AS ints
      WITH ints
        ORDER BY ints DESC
        LIMIT 2
      RETURN ints
    expect:
      ordered: true
      values: |
        | ints |
        | 3 |
        | 2 |
      side_effects: {}

  # [5] Sort floats in ascending order
  - name: s5_sort_floats_in_ascending_order
    query: |
      UNWIND [1.5, 1.3, 999.99] AS floats
      WITH floats
        ORDER BY floats
        LIMIT 2
      RETURN floats
    expect:
      ordered: true
      values: |
        | floats |
        | 1.3 |
        | 1.5 |
      side_effects: {}

  # [6] Sort floats in descending order
  - name: s6_sort_floats_in_descending_order
    query: |
      UNWIND [1.5, 1.3, 999.99] AS floats
      WITH floats
        ORDER BY floats DESC
        LIMIT 2
      RETURN floats
    expect:
      ordered: true
      values: |
        | floats |
        | 999.99 |
        | 1.5 |
      side_effects: {}

  # [7] Sort strings in ascending order
  - name: s7_sort_strings_in_ascending_order
    query: |
      UNWIND ['.*', '', ' ', 'one'] AS strings
      WITH strings
        ORDER BY strings
        LIMIT 2
      RETURN strings
    expect:
      ordered: true
      values: |
        | strings |
        | '' |
        | ' ' |
      side_effects: {}

  # [8] Sort strings in descending order
  - name: s8_sort_strings_in_descending_order
    query: |
      UNWIND ['.*', '', ' ', 'one'] AS strings
      WITH strings
        ORDER BY strings DESC
        LIMIT 2
      RETURN strings
    expect:
      ordered: true
      values: |
        | strings |
        | 'one' |
        | '.*' |
      side_effects: {}

  # [9] Sort lists in ascending order
  - name: s9_sort_lists_in_ascending_order
    query: |
      UNWIND [[], ['a'], ['a', 1], [1], [1, 'a'], [1, null], [null, 1], [null, 2]] AS lists
      WITH lists
        ORDER BY lists
        LIMIT 4
      RETURN lists
    expect:
      ordered: true
      values: |
        | lists |
        | [] |
        | ['a'] |
        | ['a', 1] |
        | [1] |
      side_effects: {}

  # [10] Sort lists in descending order
  - name: s10_sort_lists_in_descending_order
    query: |
      UNWIND [[], ['a'], ['a', 1], [1], [1, 'a'], [1, null], [null, 1], [null, 2]] AS lists
      WITH lists
        ORDER BY lists DESC
        LIMIT 4
      RETURN lists
    expect:
      ordered: true
      values: |
        | lists |
        | [null, 2] |
        | [null, 1] |
        | [1, null] |
        | [1, 'a'] |
      side_effects: {}

  # [11] Sort dates in ascending order
  - name: s11_sort_dates_in_ascending_order
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [date({year: 1910, month: 5, day: 6}),
              date({year: 1980, month: 12, day: 24}),
              date({year: 1984, month: 10, day: 12}),
              date({year: 1985, month: 5, day: 6}),
              date({year: 1980, month: 10, day: 24}),
              date({year: 1984, month: 10, day: 11})] AS dates
      WITH dates
        ORDER BY dates
        LIMIT 2
      RETURN dates
    expect:
      ordered: true
      values: |
        | dates |
        | '1910-05-06' |
        | '1980-10-24' |
      side_effects: {}

  # [12] Sort dates in descending order
  - name: s12_sort_dates_in_descending_order
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [date({year: 1910, month: 5, day: 6}),
              date({year: 1980, month: 12, day: 24}),
              date({year: 1984, month: 10, day: 12}),
              date({year: 1985, month: 5, day: 6}),
              date({year: 1980, month: 10, day: 24}),
              date({year: 1984, month: 10, day: 11})] AS dates
      WITH dates
        ORDER BY dates DESC
        LIMIT 2
      RETURN dates
    expect:
      ordered: true
      values: |
        | dates |
        | '1985-05-06' |
        | '1984-10-12' |
      side_effects: {}

  # [13] Sort local times in ascending order
  - name: s13_sort_local_times_in_ascending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [13] Sort local times in ascending order"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [localtime({hour: 10, minute: 35}),
              localtime({hour: 12, minute: 31, second: 14, nanosecond: 645876123}),
              localtime({hour: 12, minute: 31, second: 14, nanosecond: 645876124}),
              localtime({hour: 12, minute: 35, second: 13}),
              localtime({hour: 12, minute: 30, second: 14, nanosecond: 645876123})] AS localtimes
      WITH localtimes
        ORDER BY localtimes
        LIMIT 3
      RETURN localtimes
    expect:
      ordered: true
      values: |
        | localtimes |
        | '10:35' |
        | '12:30:14.645876123' |
        | '12:31:14.645876123' |
      side_effects: {}

  # [14] Sort local times in descending order
  - name: s14_sort_local_times_in_descending_order
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [localtime({hour: 10, minute: 35}),
              localtime({hour: 12, minute: 31, second: 14, nanosecond: 645876123}),
              localtime({hour: 12, minute: 31, second: 14, nanosecond: 645876124}),
              localtime({hour: 12, minute: 35, second: 13}),
              localtime({hour: 12, minute: 30, second: 14, nanosecond: 645876123})] AS localtimes
      WITH localtimes
        ORDER BY localtimes DESC
        LIMIT 3
      RETURN localtimes
    expect:
      ordered: true
      values: |
        | localtimes |
        | '12:35:13' |
        | '12:31:14.645876124' |
        | '12:31:14.645876123' |
      side_effects: {}

  # [15] Sort times in ascending order
  - name: s15_sort_times_in_ascending_order
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [time({hour: 10, minute: 35, timezone: '-08:00'}),
              time({hour: 12, minute: 31, second: 14, nanosecond: 645876123, timezone: '+01:00'}),
              time({hour: 12, minute: 31, second: 14, nanosecond: 645876124, timezone: '+01:00'}),
              time({hour: 12, minute: 35, second: 15, timezone: '+05:00'}),
              time({hour: 12, minute: 30, second: 14, nanosecond: 645876123, timezone: '+01:01'})] AS times
      WITH times
        ORDER BY times
        LIMIT 3
      RETURN times
    expect:
      ordered: true
      values: |
        | times |
        | '12:35:15+05:00' |
        | '12:30:14.645876123+01:01' |
        | '12:31:14.645876123+01:00' |
      side_effects: {}

  # [16] Sort times in descending order
  - name: s16_sort_times_in_descending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [16] Sort times in descending order"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [time({hour: 10, minute: 35, timezone: '-08:00'}),
              time({hour: 12, minute: 31, second: 14, nanosecond: 645876123, timezone: '+01:00'}),
              time({hour: 12, minute: 31, second: 14, nanosecond: 645876124, timezone: '+01:00'}),
              time({hour: 12, minute: 35, second: 15, timezone: '+05:00'}),
              time({hour: 12, minute: 30, second: 14, nanosecond: 645876123, timezone: '+01:01'})] AS times
      WITH times
        ORDER BY times DESC
        LIMIT 3
      RETURN times
    expect:
      ordered: true
      values: |
        | times |
        | '10:35-08:00' |
        | '12:31:14.645876124+01:00' |
        | '12:31:14.645876123+01:00' |
      side_effects: {}

  # [17] Sort local date times in ascending order
  - name: s17_sort_local_date_times_in_ascending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [17] Sort local date times in ascending order"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [localdatetime({year: 1984, month: 10, day: 11, hour: 12, minute: 30, second: 14, nanosecond: 12}),
              localdatetime({year: 1984, month: 10, day: 11, hour: 12, minute: 31, second: 14, nanosecond: 645876123}),
              localdatetime({year: 1, month: 1, day: 1, hour: 1, minute: 1, second: 1, nanosecond: 1}),
              localdatetime({year: 9999, month: 9, day: 9, hour: 9, minute: 59, second: 59, nanosecond: 999999999}),
              localdatetime({year: 1980, month: 12, day: 11, hour: 12, minute: 31, second: 14})] AS localdatetimes
      WITH localdatetimes
        ORDER BY localdatetimes
        LIMIT 3
      RETURN localdatetimes
    expect:
      ordered: true
      values: |
        | localdatetimes |
        | '0001-01-01T01:01:01.000000001' |
        | '1980-12-11T12:31:14' |
        | '1984-10-11T12:30:14.000000012' |
      side_effects: {}

  # [18] Sort local date times in descending order
  - name: s18_sort_local_date_times_in_descending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [18] Sort local date times in descending order"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [localdatetime({year: 1984, month: 10, day: 11, hour: 12, minute: 30, second: 14, nanosecond: 12}),
              localdatetime({year: 1984, month: 10, day: 11, hour: 12, minute: 31, second: 14, nanosecond: 645876123}),
              localdatetime({year: 1, month: 1, day: 1, hour: 1, minute: 1, second: 1, nanosecond: 1}),
              localdatetime({year: 9999, month: 9, day: 9, hour: 9, minute: 59, second: 59, nanosecond: 999999999}),
              localdatetime({year: 1980, month: 12, day: 11, hour: 12, minute: 31, second: 14})] AS localdatetimes
      WITH localdatetimes
        ORDER BY localdatetimes DESC
        LIMIT 3
      RETURN localdatetimes
    expect:
      ordered: true
      values: |
        | localdatetimes |
        | '9999-09-09T09:59:59.999999999' |
        | '1984-10-11T12:31:14.645876123' |
        | '1984-10-11T12:30:14.000000012' |
      side_effects: {}

  # [19] Sort date times in ascending order
  - name: s19_sort_date_times_in_ascending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [19] Sort date times in ascending order"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [datetime({year: 1984, month: 10, day: 11, hour: 12, minute: 30, second: 14, nanosecond: 12, timezone: '+00:15'}),
              datetime({year: 1984, month: 10, day: 11, hour: 12, minute: 31, second: 14, nanosecond: 645876123, timezone: '+00:17'}),
              datetime({year: 1, month: 1, day: 1, hour: 1, minute: 1, second: 1, nanosecond: 1, timezone: '-11:59'}),
              datetime({year: 9999, month: 9, day: 9, hour: 9, minute: 59, second: 59, nanosecond: 999999999, timezone: '+11:59'}),
              datetime({year: 1980, month: 12, day: 11, hour: 12, minute: 31, second: 14, timezone: '-11:59'})] AS datetimes
      WITH datetimes
        ORDER BY datetimes
        LIMIT 3
      RETURN datetimes
    expect:
      ordered: true
      values: |
        | datetimes |
        | '0001-01-01T01:01:01.000000001-11:59' |
        | '1980-12-11T12:31:14-11:59' |
        | '1984-10-11T12:31:14.645876123+00:17' |
      side_effects: {}

  # [20] Sort date times in descending order
  - name: s20_sort_date_times_in_descending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [20] Sort date times in descending order"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      UNWIND [datetime({year: 1984, month: 10, day: 11, hour: 12, minute: 30, second: 14, nanosecond: 12, timezone: '+00:15'}),
              datetime({year: 1984, month: 10, day: 11, hour: 12, minute: 31, second: 14, nanosecond: 645876123, timezone: '+00:17'}),
              datetime({year: 1, month: 1, day: 1, hour: 1, minute: 1, second: 1, nanosecond: 1, timezone: '-11:59'}),
              datetime({year: 9999, month: 9, day: 9, hour: 9, minute: 59, second: 59, nanosecond: 999999999, timezone: '+11:59'}),
              datetime({year: 1980, month: 12, day: 11, hour: 12, minute: 31, second: 14, timezone: '-11:59'})] AS datetimes
      WITH datetimes
        ORDER BY datetimes DESC
        LIMIT 3
      RETURN datetimes
    expect:
      ordered: true
      values: |
        | datetimes |
        | '9999-09-09T09:59:59.999999999+11:59' |
        | '1984-10-11T12:30:14.000000012+00:15' |
        | '1984-10-11T12:31:14.645876123+00:17' |
      side_effects: {}

  # [21] Sort distinct types in ascending order
  - name: s21_sort_distinct_types_in_ascending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [21] Sort distinct types in ascending order"
      issue: fix in 0.6.4
    setup:
      - |
        CREATE (:N)-[:REL]->()
    query: |
      MATCH p = (n:N)-[r:REL]->()
      UNWIND [n, r, p, 1.5, ['list'], 'text', null, false, 0.0 / 0.0, {a: 'map'}] AS types
      WITH types
        ORDER BY types
        LIMIT 5
      RETURN types
    expect:
      values: |
        | types |
        | {a: 'map'} |
        | (:N) |
        | [:REL] |
        | ['list'] |
        | <(:N)-[:REL]->()> |
      side_effects: {}

  # [22] Sort distinct types in descending order
  - name: s22_sort_distinct_types_in_descending_order
    xfail:
      spec: "openCypher TCK 2024.3 WithOrderBy1: [22] Sort distinct types in descending order"
      issue: fix in 0.6.4
    setup:
      - |
        CREATE (:N)-[:REL]->()
    query: |
      MATCH p = (n:N)-[r:REL]->()
      UNWIND [n, r, p, 1.5, ['list'], 'text', null, false, 0.0 / 0.0, {a: 'map'}] AS types
      WITH types
        ORDER BY types DESC
        LIMIT 5
      RETURN types
    expect:
      values: |
        | types |
        | null |
        | NaN |
        | 1.5 |
        | false |
        | 'text' |
      side_effects: {}

  # [23] Sort by a boolean variable projected from a node property in ascending order #1
  - name: s23_sort_by_a_boolean_variable_projected_from_a_node_property_in_ascending_order_1
    setup:
      - |
        CREATE (:A {bool: true}),
               (:B {bool: false}),
               (:C {bool: false}),
               (:D {bool: true}),
               (:E {bool: false})
    query: |
      MATCH (a)
      WITH a, a.bool AS bool
      WITH a, bool
        ORDER BY bool
        LIMIT 3
      RETURN a, bool
    expect:
      values: |
        | a | bool |
        | (:B {bool: false}) | false |
        | (:C {bool: false}) | false |
        | (:E {bool: false}) | false |
      side_effects: {}

  # [23] Sort by a boolean variable projected from a node property in ascending order #2
  - name: s23_sort_by_a_boolean_variable_projected_from_a_node_property_in_ascending_order_2
    setup:
      - |
        CREATE (:A {bool: true}),
               (:B {bool: false}),
               (:C {bool: false}),
               (:D {bool: true}),
               (:E {bool: false})
    query: |
      MATCH (a)
      WITH a, a.bool AS bool
      WITH a, bool
        ORDER BY bool ASC
        LIMIT 3
      RETURN a, bool
    expect:
      values: |
        | a | bool |
        | (:B {bool: false}) | false |
        | (:C {bool: false}) | false |
        | (:E {bool: false}) | false |
      side_effects: {}

  # [23] Sort by a boolean variable projected from a node property in ascending order #3
  - name: s23_sort_by_a_boolean_variable_projected_from_a_node_property_in_ascending_order_3
    setup:
      - |
        CREATE (:A {bool: true}),
               (:B {bool: false}),
               (:C {bool: false}),
               (:D {bool: true}),
               (:E {bool: false})
    query: |
      MATCH (a)
      WITH a, a.bool AS bool
      WITH a, bool
        ORDER BY bool ASCENDING
        LIMIT 3
      RETURN a, bool
    expect:
      values: |
        | a | bool |
        | (:B {bool: false}) | false |
        | (:C {bool: false}) | false |
        | (:E {bool: false}) | false |
      side_effects: {}

  # [24] Sort by a boolean variable projected from a node property in descending order #1
  - name: s24_sort_by_a_boolean_variable_projected_from_a_node_property_in_descending_order_1
    setup:
      - |
        CREATE (:A {bool: true}),
               (:B {bool: false}),
               (:C {bool: false}),
               (:D {bool: true}),
               (:E {bool: false})
    query: |
      MATCH (a)
      WITH a, a.bool AS bool
      WITH a, bool
        ORDER BY bool DESC
        LIMIT 2
      RETURN a, bool
    expect:
      values: |
        | a | bool |
        | (:A {bool: true}) | true |
        | (:D {bool: true}) | true |
      side_effects: {}

  # [24] Sort by a boolean variable projected from a node property in descending order #2
  - name: s24_sort_by_a_boolean_variable_projected_from_a_node_property_in_descending_order_2
    setup:
      - |
        CREATE (:A {bool: true}),
               (:B {bool: false}),
               (:C {bool: false}),
               (:D {bool: true}),
               (:E {bool: false})
    query: |
      MATCH (a)
      WITH a, a.bool AS bool
      WITH a, bool
        ORDER BY bool DESCENDING
        LIMIT 2
      RETURN a, bool
    expect:
      values: |
        | a | bool |
        | (:A {bool: true}) | true |
        | (:D {bool: true}) | true |
      side_effects: {}

  # [25] Sort by an integer variable projected from a node property in ascending order #1
  - name: s25_sort_by_an_integer_variable_projected_from_a_node_property_in_ascending_order_1
    setup:
      - |
        CREATE (:A {num: 9}),
               (:B {num: 5}),
               (:C {num: 30}),
               (:D {num: -11}),
               (:E {num: 7054})
    query: |
      MATCH (a)
      WITH a, a.num AS num
      WITH a, num
        ORDER BY num
        LIMIT 3
      RETURN a, num
    expect:
      values: |
        | a | num |
        | (:D {num: -11}) | -11 |
        | (:B {num: 5}) | 5 |
        | (:A {num: 9}) | 9 |
      side_effects: {}

  # [25] Sort by an integer variable projected from a node property in ascending order #2
  - name: s25_sort_by_an_integer_variable_projected_from_a_node_property_in_ascending_order_2
    setup:
      - |
        CREATE (:A {num: 9}),
               (:B {num: 5}),
               (:C {num: 30}),
               (:D {num: -11}),
               (:E {num: 7054})
    query: |
      MATCH (a)
      WITH a, a.num AS num
      WITH a, num
        ORDER BY num ASC
        LIMIT 3
      RETURN a, num
    expect:
      values: |
        | a | num |
        | (:D {num: -11}) | -11 |
        | (:B {num: 5}) | 5 |
        | (:A {num: 9}) | 9 |
      side_effects: {}

  # [25] Sort by an integer variable projected from a node property in ascending order #3
  - name: s25_sort_by_an_integer_variable_projected_from_a_node_property_in_ascending_order_3
    setup:
      - |
        CREATE (:A {num: 9}),
               (:B {num: 5}),
               (:C {num: 30}),
               (:D {num: -11}),
               (:E {num: 7054})
    query: |
      MATCH (a)
      WITH a, a.num AS num
      WITH a, num
        ORDER BY num ASCENDING
        LIMIT 3
      RETURN a, num
    expect:
      values: |
