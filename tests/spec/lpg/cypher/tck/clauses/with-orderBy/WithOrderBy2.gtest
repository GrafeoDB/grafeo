        | (:C {name: 'dolor', title: 'prof.'}) |
        | (:E {name: 'amet', title: 'prof.'}) |
        | (:D {name: 'sit', title: 'dr.'}) |
      side_effects: {}

  # [8] Sort by a string expression in descending order #2
  - name: s8_sort_by_a_string_expression_in_descending_order_2
    setup:
      - |
        CREATE (:A {name: 'lorem', title: 'dr.'}),
               (:B {name: 'ipsum', title: 'dr.'}),
               (:C {name: 'dolor', title: 'prof.'}),
               (:D {name: 'sit', title: 'dr.'}),
               (:E {name: 'amet', title: 'prof.'})
    query: |
