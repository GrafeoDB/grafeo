      side_effects: {}

  # [25] Fail on sorting by an aggregation #25
  # TCK: SyntaxError at compile time: InvalidAggregation
  - name: s25_fail_on_sorting_by_an_aggregation_25
    query: |
      MATCH (n)
      WITH n.num1 AS foo
        ORDER BY n, count(n.num1), max(n.num2), n.num1
      RETURN foo AS foo
    expect:
      gql_status: "42"
      side_effects: {}
