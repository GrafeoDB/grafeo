  # [7] Sort by a string expression in ascending order #1
  - name: s7_sort_by_a_string_expression_in_ascending_order_1
    setup:
      - |
        CREATE (:A {name: 'lorem', title: 'dr.'}),
               (:B {name: 'ipsum', title: 'dr.'}),
               (:C {name: 'dolor', title: 'prof.'}),
               (:D {name: 'sit', title: 'dr.'}),
               (:E {name: 'amet', title: 'prof.'})
    query: |
      MATCH (a)
      WITH a
        ORDER BY a.title + ' ' + a.name
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:A {name: 'lorem', title: 'dr.'}) |
        | (:B {name: 'ipsum', title: 'dr.'}) |
        | (:D {name: 'sit', title: 'dr.'}) |
      side_effects: {}

  # [7] Sort by a string expression in ascending order #2
  - name: s7_sort_by_a_string_expression_in_ascending_order_2
    setup:
