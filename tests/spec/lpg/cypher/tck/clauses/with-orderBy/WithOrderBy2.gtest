        | (:E {list: [2, -2, 100], list2: [5, -2]}) |
        | (:D {list: [1, -20], list2: [4, -2]}) |
        | (:A {list: [2, -2], list2: [3, -2]}) |
      side_effects: {}

  # [11] Sort by a date expression in ascending order #1
  - name: s11_sort_by_a_date_expression_in_ascending_order_1
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    setup:
      - |
        CREATE (:A {date: date({year: 1910, month: 5, day: 6})}),
               (:B {date: date({year: 1980, month: 12, day: 24})}),
               (:C {date: date({year: 1984, month: 10, day: 12})}),
               (:D {date: date({year: 1985, month: 5, day: 6})}),
               (:E {date: date({year: 1980, month: 10, day: 24})}),
               (:F {date: date({year: 1984, month: 10, day: 11})})
    query: |
      MATCH (a)
      WITH a
        ORDER BY a.date + duration({months: 1, days: 2})
        LIMIT 2
      RETURN a
    expect:
      values: |
        | a |
        | (:A {date: '1910-05-06'}) |
        | (:E {date: '1980-10-24'}) |
      side_effects: {}

  # [11] Sort by a date expression in ascending order #2
  - name: s11_sort_by_a_date_expression_in_ascending_order_2
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    setup:
      - |
