  # [21] Sort by an expression that is only partially orderable on a non-distinct binding table #1
  - name: s21_sort_by_an_expression_that_is_only_partially_orderable_on_a_non_distinct_binding_table_1
    setup:
      - |
        CREATE ({name: 'A'}),
               ({name: 'A'}),
               ({name: 'B'}),
               ({name: 'C'}),
               ({name: 'C'})
    query: |
      MATCH (a)
      WITH a.name AS name
        ORDER BY a.name + 'C' ASC
        LIMIT 2
      RETURN name
    expect:
      values: |
        | name |
        | 'A' |
        | 'A' |
      side_effects: {}

