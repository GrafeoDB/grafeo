  # [10] Sort by a list expression in descending order #1
  - name: s10_sort_by_a_list_expression_in_descending_order_1
    setup:
      - |
        CREATE (:A {list: [2, -2], list2: [3, -2]}),
               (:B {list: [1, 2], list2: [2, -2]}),
               (:C {list: [300, 0], list2: [1, -2]}),
               (:D {list: [1, -20], list2: [4, -2]}),
