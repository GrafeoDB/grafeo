meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithOrderBy2"
  title: "WithOrderBy2 - Order by a single expression"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Sort by a boolean expression in ascending order #1
  - name: s1_sort_by_a_boolean_expression_in_ascending_order_1
    setup:
      - |
        CREATE (:A {bool: true, bool2: true}),
               (:B {bool: false, bool2: false}),
               (:C {bool: false, bool2: true}),
               (:D {bool: true, bool2: true}),
               (:E {bool: true, bool2: false})
    query: |
      MATCH (a)
      WITH a
        ORDER BY NOT (a.bool AND a.bool2)
        LIMIT 2
      RETURN a
    expect:
      values: |
        | a |
        | (:A {bool: true, bool2: true}) |
        | (:D {bool: true, bool2: true}) |
      side_effects: {}

  # [1] Sort by a boolean expression in ascending order #2
  - name: s1_sort_by_a_boolean_expression_in_ascending_order_2
    setup:
      - |
        CREATE (:A {bool: true, bool2: true}),
               (:B {bool: false, bool2: false}),
               (:C {bool: false, bool2: true}),
               (:D {bool: true, bool2: true}),
               (:E {bool: true, bool2: false})
    query: |
      MATCH (a)
      WITH a
        ORDER BY NOT (a.bool AND a.bool2) ASC
        LIMIT 2
      RETURN a
    expect:
      values: |
        | a |
        | (:A {bool: true, bool2: true}) |
        | (:D {bool: true, bool2: true}) |
      side_effects: {}

  # [1] Sort by a boolean expression in ascending order #3
  - name: s1_sort_by_a_boolean_expression_in_ascending_order_3
    setup:
      - |
        CREATE (:A {bool: true, bool2: true}),
               (:B {bool: false, bool2: false}),
               (:C {bool: false, bool2: true}),
               (:D {bool: true, bool2: true}),
               (:E {bool: true, bool2: false})
    query: |
      MATCH (a)
      WITH a
        ORDER BY NOT (a.bool AND a.bool2) ASCENDING
        LIMIT 2
      RETURN a
    expect:
      values: |
        | a |
        | (:A {bool: true, bool2: true}) |
        | (:D {bool: true, bool2: true}) |
      side_effects: {}

  # [2] Sort by a boolean expression in descending order #1
  - name: s2_sort_by_a_boolean_expression_in_descending_order_1
    setup:
      - |
        CREATE (:A {bool: true, bool2: true}),
               (:B {bool: false, bool2: false}),
               (:C {bool: false, bool2: true}),
               (:D {bool: true, bool2: true}),
               (:E {bool: true, bool2: false})
    query: |
      MATCH (a)
      WITH a
        ORDER BY NOT (a.bool AND a.bool2) DESC
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:B {bool: false, bool2: false}) |
        | (:C {bool: false, bool2: true}) |
        | (:E {bool: true, bool2: false}) |
      side_effects: {}

  # [2] Sort by a boolean expression in descending order #2
  - name: s2_sort_by_a_boolean_expression_in_descending_order_2
    setup:
      - |
        CREATE (:A {bool: true, bool2: true}),
               (:B {bool: false, bool2: false}),
               (:C {bool: false, bool2: true}),
               (:D {bool: true, bool2: true}),
               (:E {bool: true, bool2: false})
    query: |
      MATCH (a)
      WITH a
        ORDER BY NOT (a.bool AND a.bool2) DESCENDING
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:B {bool: false, bool2: false}) |
        | (:C {bool: false, bool2: true}) |
        | (:E {bool: true, bool2: false}) |
      side_effects: {}

  # [3] Sort by an integer expression in ascending order #1
  - name: s3_sort_by_an_integer_expression_in_ascending_order_1
    setup:
      - |
        CREATE (:A {num: 9, num2: 5}),
               (:B {num: 5, num2: 4}),
               (:C {num: 30, num2: 3}),
               (:D {num: -11, num2: 2}),
               (:E {num: 7054, num2: 1})
    query: |
      MATCH (a)
      WITH a
        ORDER BY (a.num2 + (a.num * 2)) * -1
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:E {num: 7054, num2: 1}) |
        | (:C {num: 30, num2: 3}) |
        | (:A {num: 9, num2: 5}) |
      side_effects: {}

  # [3] Sort by an integer expression in ascending order #2
  - name: s3_sort_by_an_integer_expression_in_ascending_order_2
    setup:
      - |
        CREATE (:A {num: 9, num2: 5}),
               (:B {num: 5, num2: 4}),
               (:C {num: 30, num2: 3}),
               (:D {num: -11, num2: 2}),
               (:E {num: 7054, num2: 1})
    query: |
      MATCH (a)
      WITH a
        ORDER BY (a.num2 + (a.num * 2)) * -1 ASC
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:E {num: 7054, num2: 1}) |
        | (:C {num: 30, num2: 3}) |
        | (:A {num: 9, num2: 5}) |
      side_effects: {}

  # [3] Sort by an integer expression in ascending order #3
  - name: s3_sort_by_an_integer_expression_in_ascending_order_3
    setup:
      - |
        CREATE (:A {num: 9, num2: 5}),
               (:B {num: 5, num2: 4}),
               (:C {num: 30, num2: 3}),
               (:D {num: -11, num2: 2}),
               (:E {num: 7054, num2: 1})
    query: |
      MATCH (a)
      WITH a
        ORDER BY (a.num2 + (a.num * 2)) * -1 ASCENDING
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:E {num: 7054, num2: 1}) |
        | (:C {num: 30, num2: 3}) |
        | (:A {num: 9, num2: 5}) |
