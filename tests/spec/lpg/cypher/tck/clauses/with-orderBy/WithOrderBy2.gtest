        | a |
        | (:E {list: [2, -2, 100], list2: [5, -2]}) |
        | (:D {list: [1, -20], list2: [4, -2]}) |
        | (:A {list: [2, -2], list2: [3, -2]}) |
      side_effects: {}

  # [10] Sort by a list expression in descending order #2
  - name: s10_sort_by_a_list_expression_in_descending_order_2
    setup:
      - |
        CREATE (:A {list: [2, -2], list2: [3, -2]}),
               (:B {list: [1, 2], list2: [2, -2]}),
               (:C {list: [300, 0], list2: [1, -2]}),
               (:D {list: [1, -20], list2: [4, -2]}),
               (:E {list: [2, -2, 100], list2: [5, -2]})
    query: |
      MATCH (a)
      WITH a
        ORDER BY [a.list2[1], a.list2[0], a.list[1]] + a.list + a.list2 DESCENDING
        LIMIT 3
      RETURN a
    expect:
      values: |
