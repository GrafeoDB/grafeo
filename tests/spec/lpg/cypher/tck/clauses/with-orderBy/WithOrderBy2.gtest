        CREATE ({name: 'A'}),
               ({name: 'A'}),
               ({name: 'B'}),
               ({name: 'C'}),
               ({name: 'C'})
    query: |
      MATCH (a)
      WITH a.name AS name, count(*) AS cnt
        ORDER BY a.name ASC
        LIMIT 1
      RETURN name, cnt
    expect:
      values: |
        | name | cnt |
        | 'A' | 2 |
      side_effects: {}

