  # [6] Sort by a float expression in descending order #1
  - name: s6_sort_by_a_float_expression_in_descending_order_1
    setup:
      - |
        CREATE (:A {num: 5.025648, num2: 1.96357}),
               (:B {num: 30.94857, num2: 0.00002}),
               (:C {num: 30.94856, num2: 0.00002}),
