      RETURN a
    expect:
      values: |
        | a |
        | (:D {num: -11, num2: 2}) |
        | (:B {num: 5, num2: 4}) |
        | (:A {num: 9, num2: 5}) |
      side_effects: {}

  # [5] Sort by a float expression in ascending order #1
  - name: s5_sort_by_a_float_expression_in_ascending_order_1
    setup:
      - |
        CREATE (:A {num: 5.025648, num2: 1.96357}),
               (:B {num: 30.94857, num2: 0.00002}),
               (:C {num: 30.94856, num2: 0.00002}),
               (:D {num: -11.2943, num2: -8.5007}),
               (:E {num: 7054.008, num2: 948.841})
    query: |
      MATCH (a)
      WITH a
        ORDER BY (a.num + a.num2 * 2) * -1.01
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:E {num: 7054.008, num2: 948.841}) |
        | (:B {num: 30.94857, num2: 0.00002}) |
        | (:C {num: 30.94856, num2: 0.00002}) |
      side_effects: {}

  # [5] Sort by a float expression in ascending order #2
  - name: s5_sort_by_a_float_expression_in_ascending_order_2
    setup:
      - |
        CREATE (:A {num: 5.025648, num2: 1.96357}),
               (:B {num: 30.94857, num2: 0.00002}),
               (:C {num: 30.94856, num2: 0.00002}),
               (:D {num: -11.2943, num2: -8.5007}),
               (:E {num: 7054.008, num2: 948.841})
    query: |
      MATCH (a)
      WITH a
        ORDER BY (a.num + a.num2 * 2) * -1.01 ASC
        LIMIT 3
      RETURN a
    expect:
      values: |
        | a |
        | (:E {num: 7054.008, num2: 948.841}) |
        | (:B {num: 30.94857, num2: 0.00002}) |
        | (:C {num: 30.94856, num2: 0.00002}) |
      side_effects: {}

  # [5] Sort by a float expression in ascending order #3
  - name: s5_sort_by_a_float_expression_in_ascending_order_3
    setup:
      - |
        CREATE (:A {num: 5.025648, num2: 1.96357}),
               (:B {num: 30.94857, num2: 0.00002}),
               (:C {num: 30.94856, num2: 0.00002}),
