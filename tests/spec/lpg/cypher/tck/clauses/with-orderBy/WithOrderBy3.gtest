meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithOrderBy3"
  title: "WithOrderBy3 - Order by multiple expressions"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Sort by two expressions, both in ascending order #1
  - name: s1_sort_by_two_expressions_both_in_ascending_order_1
    setup:
      - |
        CREATE (:A {num: 9, bool: true}),
               (:B {num: 5, bool: false}),
               (:C {num: -30, bool: false}),
               (:D {num: -41, bool: true}),
               (:E {num: 7054, bool: false})
    query: |
      MATCH (a)
      WITH a
        ORDER BY a.bool, a.num
        LIMIT 4
      RETURN a
    expect:
      values: |
        | a |
        | (:C {num: -30, bool: false}) |
        | (:B {num: 5, bool: false}) |
        | (:E {num: 7054, bool: false}) |
        | (:D {num: -41, bool: true}) |
      side_effects: {}

  # [1] Sort by two expressions, both in ascending order #2
  - name: s1_sort_by_two_expressions_both_in_ascending_order_2
    setup:
      - |
        CREATE (:A {num: 9, bool: true}),
               (:B {num: 5, bool: false}),
               (:C {num: -30, bool: false}),
               (:D {num: -41, bool: true}),
               (:E {num: 7054, bool: false})
    query: |
      MATCH (a)
      WITH a
        ORDER BY a.bool, a.num ASC
        LIMIT 4
      RETURN a
    expect:
      values: |
        | a |
        | (:C {num: -30, bool: false}) |
        | (:B {num: 5, bool: false}) |
        | (:E {num: 7054, bool: false}) |
        | (:D {num: -41, bool: true}) |
      side_effects: {}

  # [1] Sort by two expressions, both in ascending order #3
  - name: s1_sort_by_two_expressions_both_in_ascending_order_3
