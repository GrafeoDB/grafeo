  # [5] An expression without explicit sort direction is sorted in ascending order #1
  - name: s5_an_expression_without_explicit_sort_direction_is_sorted_in_ascending_order_1
    setup:
      - |
        CREATE ({num: 3, text: 'a'}),
               ({num: 3, text: 'b'}),
               ({num: 1, text: 'a'}),
               ({num: 1, text: 'b'}),
               ({num: 2, text: 'a'}),
               ({num: 2, text: 'b'}),
               ({num: 4, text: 'a'}),
               ({num: 4, text: 'b'})
    query: |
      MATCH (a)
      WITH a
        ORDER BY a.num % 2 ASC, a.num, a.text ASC
        LIMIT 1
      RETURN a
    expect:
      values: |
        | a |
        | ({num: 2, text: 'a'}) |
      side_effects: {}

  # [5] An expression without explicit sort direction is sorted in ascending order #2
  - name: s5_an_expression_without_explicit_sort_direction_is_sorted_in_ascending_order_2
