meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithSkipLimit1"
  title: "WithSkipLimit1 - Skip"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Handle dependencies across WITH with SKIP
  - name: s1_handle_dependencies_across_with_with_skip
    setup:
      - |
        CREATE (a {name: 'A', num: 0, id: 0}),
               ({name: 'B', num: a.id, id: 1}),
               ({name: 'C', num: 0, id: 2})
    query: |
      MATCH (a)
      WITH a.name AS property, a.num AS idToUse
        ORDER BY property
        SKIP 1
      MATCH (b)
      WHERE b.id = idToUse
      RETURN DISTINCT b
    expect:
      values: |
        | b |
        | ({name: 'A', num: 0, id: 0}) |
      side_effects: {}

  # [2] Ordering and skipping on aggregate
  - name: s2_ordering_and_skipping_on_aggregate
    setup:
      - |
        CREATE ()-[:T1 {num: 3}]->(x:X),
               ()-[:T2 {num: 2}]->(x),
               ()-[:T3 {num: 1}]->(:Y)
    query: |
      MATCH ()-[r1]->(x)
      WITH x, sum(r1.num) AS c
        ORDER BY c SKIP 1
      RETURN x, c
    expect:
      values: |
        | x | c |
        | (:X) | 5 |
      side_effects: {}
