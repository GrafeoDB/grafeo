meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithSkipLimit3"
  title: "WithSkipLimit3 - Skip and limit"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Get rows in the middle
  - name: s1_get_rows_in_the_middle
    setup:
      - |
        CREATE ({name: 'A'}),
          ({name: 'B'}),
          ({name: 'C'}),
          ({name: 'D'}),
          ({name: 'E'})
    query: |
      MATCH (n)
      WITH n
      ORDER BY n.name ASC
      SKIP 2
      LIMIT 2
      RETURN n
    expect:
      ordered: true
      values: |
        | n |
        | ({name: 'C'}) |
        | ({name: 'D'}) |
      side_effects: {}

  # [2] Get rows in the middle by param
  - name: s2_get_rows_in_the_middle_by_param
    setup:
      - |
        CREATE ({name: 'A'}),
          ({name: 'B'}),
          ({name: 'C'}),
          ({name: 'D'}),
          ({name: 'E'})
    params:
      s: 2
      l: 2
    query: |
      MATCH (n)
      WITH n
      ORDER BY n.name ASC
      SKIP $s
      LIMIT $l
      RETURN n
    expect:
      ordered: true
      values: |
        | n |
        | ({name: 'C'}) |
        | ({name: 'D'}) |
      side_effects: {}

  # [3] Limiting amount of rows when there are fewer left than the LIMIT argument
  - name: s3_limiting_amount_of_rows_when_there_are_fewer_left_than_the_limit_argument
    setup:
      - |
        UNWIND range(0, 15) AS i
        CREATE ({count: i})
    query: |
      MATCH (a)
      WITH a.count AS count
        ORDER BY a.count
        SKIP 10
        LIMIT 10
      RETURN count
    expect:
      ordered: true
      values: |
        | count |
        | 10 |
        | 11 |
        | 12 |
        | 13 |
        | 14 |
        | 15 |
      side_effects: {}
