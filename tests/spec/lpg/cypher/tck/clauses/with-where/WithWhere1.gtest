meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithWhere1"
  title: "WithWhere1 - Filter single variable"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Filter node with property predicate on a single variable with multiple bindings
  - name: s1_filter_node_with_property_predicate_on_a_single_variable_with_multiple_bindings
    setup:
      - |
        CREATE ({name: 'A'}),
               ({name: 'B'}),
               ({name: 'C'})
    query: |
      MATCH (a)
      WITH a
      WHERE a.name = 'B'
      RETURN a
    expect:
      values: |
        | a |
        | ({name: 'B'}) |
      side_effects: {}

  # [2] Filter node with property predicate on a single variable with multiple distinct bindings
  - name: s2_filter_node_with_property_predicate_on_a_single_variable_with_multiple_distinct_bindings
    setup:
      - |
        CREATE ({name2: 'A'}),
               ({name2: 'A'}),
               ({name2: 'B'})
    query: |
      MATCH (a)
      WITH DISTINCT a.name2 AS name
      WHERE a.name2 = 'B'
      RETURN *
    expect:
      values: |
        | name |
        | 'B' |
      side_effects: {}

  # [3] Filter for an unbound relationship variable
  - name: s3_filter_for_an_unbound_relationship_variable
    setup:
      - |
        CREATE (a:A), (b:B {id: 1}), (:B {id: 2})
        CREATE (a)-[:T]->(b)
    query: |
      MATCH (a:A), (other:B)
      OPTIONAL MATCH (a)-[r]->(other)
      WITH other WHERE r IS NULL
      RETURN other
    expect:
      values: |
        | other |
        | (:B {id: 2}) |
      side_effects: {}

  # [4] Filter for an unbound node variable
  - name: s4_filter_for_an_unbound_node_variable
    setup:
      - |
        CREATE (a:A), (b:B {id: 1}), (:B {id: 2})
        CREATE (a)-[:T]->(b)
    query: |
      MATCH (other:B)
      OPTIONAL MATCH (a)-[r]->(other)
      WITH other WHERE a IS NULL
      RETURN other
    expect:
      values: |
        | other |
        | (:B {id: 2}) |
      side_effects: {}
