meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithWhere4"
  title: "WithWhere4 - Non-Equi-Joins on variables"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Join nodes on inequality
  - name: s1_join_nodes_on_inequality
    setup:
      - |
        CREATE (:A), (:B)
    query: |
      MATCH (a), (b)
      WITH a, b
      WHERE a <> b
      RETURN a, b
    expect:
      values: |
        | a | b |
        | (:A) | (:B) |
        | (:B) | (:A) |
      side_effects: {}

  # [2] Join with disjunctive multi-part predicates including patterns
  - name: s2_join_with_disjunctive_multi_part_predicates_including_patterns
    setup:
      - |
        CREATE (a:TheLabel {id: 0}), (b:TheLabel {id: 1}), (c:TheLabel {id: 2})
        CREATE (a)-[:T]->(b),
               (b)-[:T]->(c)
    query: |
      MATCH (a), (b)
      WITH a, b
      WHERE a.id = 0
        AND (a)-[:T]->(b:TheLabel)
        OR (a)-[:T*]->(b:MissingLabel)
      RETURN DISTINCT b
    expect:
      values: |
        | b |
        | (:TheLabel {id: 1}) |
      side_effects: {}
