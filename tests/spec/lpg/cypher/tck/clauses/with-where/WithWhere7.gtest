meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.WithWhere7"
  title: "WithWhere7 - Variable visibility under aliasing"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] WHERE sees a variable bound before but not after WITH
  - name: s1_where_sees_a_variable_bound_before_but_not_after_with
    setup:
      - |
        CREATE ({name2: 'A'}),
               ({name2: 'B'}),
               ({name2: 'C'})
    query: |
      MATCH (a)
      WITH a.name2 AS name
      WHERE a.name2 = 'B'
      RETURN *
    expect:
      values: |
        | name |
        | 'B' |
      side_effects: {}

  # [2] WHERE sees a variable bound after but not before WITH
  - name: s2_where_sees_a_variable_bound_after_but_not_before_with
    setup:
      - |
        CREATE ({name2: 'A'}),
               ({name2: 'B'}),
               ({name2: 'C'})
    query: |
      MATCH (a)
      WITH a.name2 AS name
      WHERE name = 'B'
      RETURN *
    expect:
      values: |
        | name |
        | 'B' |
      side_effects: {}

  # [3] WHERE sees both, variable bound before but not after WITH and variable bound after but not before WITH
  - name: s3_where_sees_both_variable_bound_before_but_not_after_with_and_variable_bound_after_but_not_before_with
    setup:
      - |
        CREATE ({name2: 'A'}),
               ({name2: 'B'}),
               ({name2: 'C'})
    query: |
      MATCH (a)
      WITH a.name2 AS name
      WHERE name = 'B' OR a.name2 = 'C'
      RETURN *
    expect:
      values: |
        | name |
        | 'B' |
        | 'C' |
      side_effects: {}
