# Converted from the openCypher TCK, tck/features/clauses/with/With1.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.With1"
  title: "With1 - Forward single variable"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Forwarind a node variable 1
  - name: s1_forwarind_a_node_variable_1
    setup:
      - |
        CREATE (:A)-[:REL]->(:B)
    query: |
      MATCH (a:A)
      WITH a
      MATCH (a)-->(b)
      RETURN *
    expect:
      values: |
        | a | b |
        | (:A) | (:B) |
      side_effects: {}

  # [2] Forwarind a node variable 2
  - name: s2_forwarind_a_node_variable_2
    xfail:
      spec: "openCypher TCK 2024.3 With1: [2] Forwarind a node variable 2"
      issue: "fix in 0.6.5"
    setup:
      - |
        CREATE (:A)-[:REL]->(:B)
        CREATE (:X)
    query: |
      MATCH (a:A)
      WITH a
      MATCH (x:X), (a)-->(b)
      RETURN *
    expect:
      values: |
        | a | b | x |
        | (:A) | (:B) | (:X) |
      side_effects: {}

  # [3] Forwarding a relationship variable
  - name: s3_forwarding_a_relationship_variable
    setup:
      - |
        CREATE ()-[:T1]->(:X),
               ()-[:T2]->(:X),
               ()-[:T3]->()
    query: |
      MATCH ()-[r1]->(:X)
      WITH r1 AS r2
      MATCH ()-[r2]->()
      RETURN r2 AS rel
    expect:
      values: |
        | rel |
        | [:T1] |
        | [:T2] |
      side_effects: {}

  # [4] Forwarding a path variable
  - name: s4_forwarding_a_path_variable
    setup:
      - |
        CREATE ()
    query: |
      MATCH p = (a)
      WITH p
      RETURN p
    expect:
      values: |
        | p |
        | <()> |
      side_effects: {}

  # [5] Forwarding null
  - name: s5_forwarding_null
    query: |
      OPTIONAL MATCH (a:Start)
      WITH a
      MATCH (a)-->(b)
      RETURN *
    expect:
      values: |
        | a | b |
      side_effects: {}

  # [6] Forwarding a node variable possibly null
  - name: s6_forwarding_a_node_variable_possibly_null
    setup:
      - |
        CREATE (s:Single), (a:A {num: 42}),
               (b:B {num: 46}), (c:C)
        CREATE (s)-[:REL]->(a),
               (s)-[:REL]->(b),
               (a)-[:REL]->(c),
               (b)-[:LOOP]->(b)
    query: |
      OPTIONAL MATCH (a:A)
      WITH a AS a
      MATCH (b:B)
      RETURN a, b
    expect:
      values: |
        | a | b |
        | (:A {num: 42}) | (:B {num: 46}) |
      side_effects: {}
