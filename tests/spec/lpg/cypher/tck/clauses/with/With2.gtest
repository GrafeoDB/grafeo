meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.With2"
  title: "With2 - Forward single expression"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Forwarding a property to express a join
  - name: s1_forwarding_a_property_to_express_a_join
    setup:
      - |
        CREATE (a:End {num: 42, id: 0}),
               (:End {num: 3}),
               (:Begin {num: a.id})
    query: |
      MATCH (a:Begin)
      WITH a.num AS property
      MATCH (b)
      WHERE b.id = property
      RETURN b
    expect:
      values: |
        | b |
        | (:End {num: 42, id: 0}) |
      side_effects: {}

  # [2] Forwarding a nested map literal
  - name: s2_forwarding_a_nested_map_literal
    query: |
      WITH {name: {name2: 'baz'}} AS nestedMap
      RETURN nestedMap.name.name2
    expect:
      values: |
        | nestedMap.name.name2 |
        | 'baz' |
      side_effects: {}
