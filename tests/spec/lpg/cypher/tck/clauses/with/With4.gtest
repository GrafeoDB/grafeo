meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.With4"
  title: "With4 - Variable aliasing"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Aliasing relationship variable
  - name: s1_aliasing_relationship_variable
    setup:
      - |
        CREATE ()-[:T1]->(),
               ()-[:T2]->()
    query: |
      MATCH ()-[r1]->()
      WITH r1 AS r2
      RETURN r2 AS rel
    expect:
      values: |
        | rel |
        | [:T1] |
        | [:T2] |
      side_effects: {}

  # [2] Aliasing expression to new variable name
  - name: s2_aliasing_expression_to_new_variable_name
    setup:
      - |
        CREATE (:Begin {num: 42}),
               (:End {num: 42}),
               (:End {num: 3})
    query: |
      MATCH (a:Begin)
      WITH a.num AS property
      MATCH (b:End)
      WHERE property = b.num
      RETURN b
    expect:
      values: |
        | b |
        | (:End {num: 42}) |
      side_effects: {}

  # [3] Aliasing expression to existing variable name
  - name: s3_aliasing_expression_to_existing_variable_name
    setup:
      - |
        CREATE ({num: 1, name: 'King Kong'}),
          ({num: 2, name: 'Ann Darrow'})
    query: |
      MATCH (n)
      WITH n.name AS n
      RETURN n
    expect:
      values: |
        | n |
        | 'Ann Darrow' |
        | 'King Kong' |
      side_effects: {}

  # [4] Fail when forwarding multiple aliases with the same name
  # TCK: SyntaxError at compile time: ColumnNameConflict
  - name: s4_fail_when_forwarding_multiple_aliases_with_the_same_name
    query: |
      WITH 1 AS a, 2 AS a
      RETURN a
    expect:
      gql_status: "42"
      side_effects: {}

  # [5] Fail when not aliasing expressions in WITH
  # TCK: SyntaxError at compile time: NoExpressionAlias
  - name: s5_fail_when_not_aliasing_expressions_in_with
    query: |
      MATCH (a)
      WITH a, count(*)
      RETURN a
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Reusing variable names in WITH
  - name: s6_reusing_variable_names_in_with
    setup:
      - |
        CREATE (a:Person), (b:Person), (m:Message {id: 10})
        CREATE (a)-[:LIKE {creationDate: 20160614}]->(m)-[:POSTED_BY]->(b)
    query: |
      MATCH (person:Person)<--(message)<-[like]-(:Person)
      WITH like.creationDate AS likeTime, person AS person
        ORDER BY likeTime, message.id
      WITH head(collect({likeTime: likeTime})) AS latestLike, person AS person
      WITH latestLike.likeTime AS likeTime
        ORDER BY likeTime
      RETURN likeTime
    expect:
      ordered: true
      values: |
        | likeTime |
        | 20160614 |
      side_effects: {}

  # [7] Multiple aliasing and backreferencing
  - name: s7_multiple_aliasing_and_backreferencing
    query: |
      CREATE (m {id: 0})
      WITH {first: m.id} AS m
      WITH {second: m.first} AS m
      RETURN m.second
    expect:
      values: |
        | m.second |
        | 0 |
      side_effects:
        +nodes: 1
        +properties: 1
