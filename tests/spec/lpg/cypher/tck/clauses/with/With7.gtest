meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.With7"
  title: "With7 - WITH on WITH"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] A simple pattern with one bound endpoint
  - name: s1_a_simple_pattern_with_one_bound_endpoint
    setup:
      - |
        CREATE (:A)-[:REL]->(:B)
    query: |
      MATCH (a:A)-[r:REL]->(b:B)
      WITH a AS b, b AS tmp, r AS r
      WITH b AS a, r
      LIMIT 1
      MATCH (a)-[r]->(b)
      RETURN a, r, b
    expect:
      values: |
        | a | r | b |
        | (:A) | [:REL] | (:B) |
      side_effects: {}

  # [2] Multiple WITHs using a predicate and aggregation
  - name: s2_multiple_withs_using_a_predicate_and_aggregation
    setup:
      - |
        CREATE (a {name: 'David'}),
               (b {name: 'Other'}),
               (c {name: 'NotOther'}),
               (d {name: 'NotOther2'}),
               (a)-[:REL]->(b),
               (a)-[:REL]->(c),
               (a)-[:REL]->(d),
               (b)-[:REL]->(),
               (b)-[:REL]->(),
               (c)-[:REL]->(),
               (c)-[:REL]->(),
               (d)-[:REL]->()
    query: |
      MATCH (david {name: 'David'})--(otherPerson)-->()
      WITH otherPerson, count(*) AS foaf
      WHERE foaf > 1
      WITH otherPerson
      WHERE otherPerson.name <> 'NotOther'
      RETURN count(*)
    expect:
      values: |
        | count(*) |
        | 1 |
      side_effects: {}
