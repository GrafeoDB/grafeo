meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Aggregation2"
  title: "Aggregation2 - Min and Max"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] `max()` over integers
  - name: s1_max_over_integers
    query: |
      UNWIND [1, 2, 0, null, -1] AS x
      RETURN max(x)
    expect:
      values: |
        | max(x) |
        | 2 |
      side_effects: {}

  # [2] `min()` over integers
  - name: s2_min_over_integers
    query: |
      UNWIND [1, 2, 0, null, -1] AS x
      RETURN min(x)
    expect:
      values: |
        | min(x) |
        | -1 |
      side_effects: {}

  # [3] `max()` over floats
  - name: s3_max_over_floats
    query: |
      UNWIND [1.0, 2.0, 0.5, null] AS x
      RETURN max(x)
    expect:
      values: |
        | max(x) |
        | 2.0 |
      side_effects: {}

  # [4] `min()` over floats
  - name: s4_min_over_floats
    query: |
      UNWIND [1.0, 2.0, 0.5, null] AS x
      RETURN min(x)
    expect:
      values: |
        | min(x) |
        | 0.5 |
      side_effects: {}

  # [5] `max()` over mixed numeric values
  - name: s5_max_over_mixed_numeric_values
    query: |
      UNWIND [1, 2.0, 5, null, 3.2, 0.1] AS x
      RETURN max(x)
    expect:
      values: |
        | max(x) |
        | 5 |
      side_effects: {}

  # [6] `min()` over mixed numeric values
  - name: s6_min_over_mixed_numeric_values
    query: |
      UNWIND [1, 2.0, 5, null, 3.2, 0.1] AS x
      RETURN min(x)
    expect:
      values: |
        | min(x) |
        | 0.1 |
      side_effects: {}

  # [7] `max()` over strings
  - name: s7_max_over_strings
    query: |
      UNWIND ['a', 'b', 'B', null, 'abc', 'abc1'] AS i
      RETURN max(i)
    expect:
      values: |
        | max(i) |
        | 'b' |
      side_effects: {}

  # [8] `min()` over strings
  - name: s8_min_over_strings
    query: |
      UNWIND ['a', 'b', 'B', null, 'abc', 'abc1'] AS i
      RETURN min(i)
    expect:
      values: |
        | min(i) |
        | 'B' |
      side_effects: {}

  # [9] `max()` over list values
  - name: s9_max_over_list_values
    query: |
      UNWIND [[1], [2], [2, 1]] AS x
      RETURN max(x)
    expect:
      values: |
        | max(x) |
        | [2, 1] |
      side_effects: {}

  # [10] `min()` over list values
  - name: s10_min_over_list_values
    query: |
      UNWIND [[1], [2], [2, 1]] AS x
      RETURN min(x)
    expect:
      values: |
        | min(x) |
        | [1] |
      side_effects: {}

  # [11] `max()` over mixed values
  - name: s11_max_over_mixed_values
    query: |
      UNWIND [1, 'a', null, [1, 2], 0.2, 'b'] AS x
      RETURN max(x)
    expect:
      values: |
        | max(x) |
        | 1 |
      side_effects: {}

  # [12] `min()` over mixed values
  - name: s12_min_over_mixed_values
    query: |
      UNWIND [1, 'a', null, [1, 2], 0.2, 'b'] AS x
      RETURN min(x)
    expect:
      values: |
        | min(x) |
        | [1, 2] |
      side_effects: {}
