meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Aggregation8"
  title: "Aggregation8 - DISTINCT"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Distinct on unbound node
  - name: s1_distinct_on_unbound_node
    query: |
      OPTIONAL MATCH (a)
      RETURN count(DISTINCT a)
    expect:
      values: |
        | count(DISTINCT a) |
        | 0 |
      side_effects: {}

  # [2] Distinct on null
  - name: s2_distinct_on_null
    setup:
      - |
        CREATE ()
    query: |
      MATCH (a)
      RETURN count(DISTINCT a.name)
    expect:
      values: |
        | count(DISTINCT a.name) |
        | 0 |
      side_effects: {}

  # [3] Collect distinct nulls
  - name: s3_collect_distinct_nulls
    query: |
      UNWIND [null, null] AS x
      RETURN collect(DISTINCT x) AS c
    expect:
      values: |
        | c |
        | [] |
      side_effects: {}

  # [4] Collect distinct values mixed with nulls
  - name: s4_collect_distinct_values_mixed_with_nulls
    query: |
      UNWIND [null, 1, null] AS x
      RETURN collect(DISTINCT x) AS c
    expect:
      values: |
        | c |
        | [1] |
      side_effects: {}
