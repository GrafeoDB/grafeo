meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Boolean4"
  title: "Boolean4 - NOT logical operations"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Logical negation of truth values
  - name: s1_logical_negation_of_truth_values
    query: |
      RETURN NOT true AS nt, NOT false AS nf, NOT null AS nn
    expect:
      values: |
        | nt | nf | nn |
        | false | true | null |
      side_effects: {}

  # [2] Double logical negation of truth values
  - name: s2_double_logical_negation_of_truth_values
    query: |
      RETURN NOT NOT true AS nnt, NOT NOT false AS nnf, NOT NOT null AS nnn
    expect:
      values: |
        | nnt | nnf | nnn |
        | true | false | null |
      side_effects: {}

  # [3] NOT and false
  - name: s3_not_and_false
    setup:
      - |
        CREATE ({name: 'a'})
    query: |
      MATCH (n)
      WHERE NOT(n.name = 'apa' AND false)
      RETURN n
    expect:
      values: |
        | n |
        | ({name: 'a'}) |
      side_effects: {}

  # [4] Fail when using NOT on a non-boolean literal #1
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s4_fail_when_using_not_on_a_non_boolean_literal_1
    xfail:
      spec: "openCypher TCK 2024.3 Boolean4: [4] Fail when using NOT on a non-boolean literal #1"
      issue: "#796"
    query: |
      RETURN NOT 0
    expect:
      gql_status: "42"
      side_effects: {}

  # [4] Fail when using NOT on a non-boolean literal #2
