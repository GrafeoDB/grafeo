# Converted from the openCypher TCK, tck/features/expressions/comparison/Comparison3.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Comparison3"
  title: "Comparison3 - Full-Bound Range"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Handling numerical ranges 1
  - name: s1_handling_numerical_ranges_1
    setup:
      - |
        UNWIND [1, 2, 3] AS i
        CREATE ({num: i})
    query: |
      MATCH (n)
      WHERE 1 < n.num < 3
      RETURN n.num
    expect:
      values: |
        | n.num |
        | 2 |
      side_effects: {}

  # [2] Handling numerical ranges 2
  - name: s2_handling_numerical_ranges_2
    setup:
      - |
        UNWIND [1, 2, 3] AS i
        CREATE ({num: i})
    query: |
      MATCH (n)
      WHERE 1 < n.num <= 3
      RETURN n.num
    expect:
      values: |
        | n.num |
        | 2 |
        | 3 |
      side_effects: {}

  # [3] Handling numerical ranges 3
  - name: s3_handling_numerical_ranges_3
    setup:
      - |
        UNWIND [1, 2, 3] AS i
        CREATE ({num: i})
    query: |
      MATCH (n)
      WHERE 1 <= n.num < 3
      RETURN n.num
    expect:
      values: |
        | n.num |
        | 1 |
        | 2 |
      side_effects: {}

  # [4] Handling numerical ranges 4
  - name: s4_handling_numerical_ranges_4
    setup:
      - |
        UNWIND [1, 2, 3] AS i
        CREATE ({num: i})
    query: |
      MATCH (n)
      WHERE 1 <= n.num <= 3
      RETURN n.num
    expect:
      values: |
        | n.num |
        | 1 |
        | 2 |
        | 3 |
      side_effects: {}

  # [5] Handling string ranges 1
  - name: s5_handling_string_ranges_1
    setup:
      - |
        UNWIND ['a', 'b', 'c'] AS c
        CREATE ({name: c})
    query: |
      MATCH (n)
      WHERE 'a' < n.name < 'c'
      RETURN n.name
    expect:
      values: |
        | n.name |
        | 'b' |
      side_effects: {}

  # [6] Handling string ranges 2
  - name: s6_handling_string_ranges_2
    setup:
      - |
        UNWIND ['a', 'b', 'c'] AS c
        CREATE ({name: c})
    query: |
      MATCH (n)
      WHERE 'a' < n.name <= 'c'
      RETURN n.name
    expect:
      values: |
        | n.name |
        | 'b' |
        | 'c' |
      side_effects: {}

  # [7] Handling string ranges 3
  - name: s7_handling_string_ranges_3
    setup:
      - |
        UNWIND ['a', 'b', 'c'] AS c
        CREATE ({name: c})
    query: |
      MATCH (n)
      WHERE 'a' <= n.name < 'c'
      RETURN n.name
    expect:
      values: |
        | n.name |
        | 'a' |
        | 'b' |
      side_effects: {}

  # [8] Handling string ranges 4
  - name: s8_handling_string_ranges_4
    setup:
      - |
        UNWIND ['a', 'b', 'c'] AS c
        CREATE ({name: c})
    query: |
      MATCH (n)
      WHERE 'a' <= n.name <= 'c'
      RETURN n.name
    expect:
      values: |
        | n.name |
        | 'a' |
        | 'b' |
        | 'c' |
      side_effects: {}

  # [9] Handling empty range
  - name: s9_handling_empty_range
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE ({num: 3})
    query: |
      MATCH (n)
      WHERE 10 < n.num <= 3
      RETURN n.num
    expect:
      values: |
        | n.num |
      side_effects: {}
