meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Conditional2"
  title: "Conditional2 - Case Expression"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Simple cases over integers #1
  - name: s1_simple_cases_over_integers_1
    query: |
      RETURN CASE -10
          WHEN -10 THEN 'minus ten'
          WHEN 0 THEN 'zero'
          WHEN 1 THEN 'one'
          WHEN 5 THEN 'five'
          WHEN 10 THEN 'ten'
          WHEN 3000 THEN 'three thousand'
          ELSE 'something else'
        END AS result
    expect:
      values: |
        | result |
        | 'minus ten' |
      side_effects: {}

  # [1] Simple cases over integers #2
  - name: s1_simple_cases_over_integers_2
    query: |
      RETURN CASE 0
          WHEN -10 THEN 'minus ten'
          WHEN 0 THEN 'zero'
          WHEN 1 THEN 'one'
          WHEN 5 THEN 'five'
          WHEN 10 THEN 'ten'
          WHEN 3000 THEN 'three thousand'
          ELSE 'something else'
        END AS result
    expect:
      values: |
        | result |
        | 'zero' |
      side_effects: {}

