meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.ExistentialSubquery3"
  title: "ExistentialSubquery3 - Nested existential subquery"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Nested simple existential subquery
  - name: s1_nested_simple_existential_subquery
    xfail:
      spec: "openCypher TCK 2024.3 ExistentialSubquery3: [1] Nested simple existential subquery"
      issue: "fix in 0.6.5"
    setup:
      - |
        CREATE (a:A {prop: 1})-[:R]->(b:B {prop: 1}),
               (a)-[:R]->(:C {prop: 2}),
               (a)-[:R]->(:D {prop: 3})
    query: |
      MATCH (n) WHERE exists {
        MATCH (m) WHERE exists {
          (n)-[]->(m) WHERE n.prop = m.prop
        }
        RETURN true
      }
      RETURN n
    expect:
      values: |
        | n |
        | (:A {prop:1}) |
      side_effects: {}

  # [2] Nested full existential subquery
  - name: s2_nested_full_existential_subquery
    xfail:
      spec: "openCypher TCK 2024.3 ExistentialSubquery3: [2] Nested full existential subquery"
      issue: "fix in 0.6.5"
    setup:
      - |
        CREATE (a:A {prop: 1})-[:R]->(b:B {prop: 1}),
               (a)-[:R]->(:C {prop: 2}),
               (a)-[:R]->(:D {prop: 3})
    query: |
      MATCH (n) WHERE exists {
        MATCH (m) WHERE exists {
          MATCH (l)<-[:R]-(n)-[:R]->(m) RETURN true
        }
        RETURN true
      }
      RETURN n
    expect:
      values: |
        | n |
        | (:A {prop:1}) |
      side_effects: {}

  # [3] Nested full existential subquery with pattern predicate
  - name: s3_nested_full_existential_subquery_with_pattern_predicate
    xfail:
      spec: "openCypher TCK 2024.3 ExistentialSubquery3: [3] Nested full existential subquery with pattern predicate"
      issue: "fix in 0.6.5"
    setup:
      - |
        CREATE (a:A {prop: 1})-[:R]->(b:B {prop: 1}),
               (a)-[:R]->(:C {prop: 2}),
               (a)-[:R]->(:D {prop: 3})
    query: |
      MATCH (n) WHERE exists {
        MATCH (m) WHERE exists {
          MATCH (l) WHERE (l)<-[:R]-(n)-[:R]->(m) RETURN true
        }
        RETURN true
      }
      RETURN n
    expect:
      values: |
        | n |
        | (:A {prop:1}) |
      side_effects: {}
