meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Graph4"
  title: "Graph4 - Edge relationship type"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] `type()`
  - name: s1_type
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH ()-[r]->()
      RETURN type(r)
    expect:
      values: |
        | type(r) |
        | 'T' |
      side_effects: {}

  # [2] `type()` on two relationships
  - name: s2_type_on_two_relationships
    setup:
      - |
        CREATE ()-[:T1]->()-[:T2]->()
    query: |
      MATCH ()-[r1]->()-[r2]->()
      RETURN type(r1), type(r2)
    expect:
      values: |
        | type(r1) | type(r2) |
        | 'T1' | 'T2' |
      side_effects: {}

  # [3] `type()` on null relationship
  - name: s3_type_on_null_relationship
    xfail:
      spec: "openCypher TCK 2024.3 Graph4: [3] `type()` on null relationship"
      issue: "#800"
    setup:
      - |
        CREATE ()
    query: |
      MATCH (a)
      OPTIONAL MATCH (a)-[r:NOT_THERE]->()
      RETURN type(r), type(null)
    expect:
      values: |
        | type(r) | type(null) |
        | null | null |
      side_effects: {}

  # [4] `type()` on mixed null and non-null relationships
  - name: s4_type_on_mixed_null_and_non_null_relationships
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH (a)
      OPTIONAL MATCH (a)-[r:T]->()
      RETURN type(r)
    expect:
      values: |
        | type(r) |
        | 'T' |
        | null |
      side_effects: {}

  # [5] `type()` handling Any type
  - name: s5_type_handling_any_type
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH (a)-[r]->()
      WITH [r, 1] AS list
      RETURN type(list[0])
    expect:
      values: |
        | type(list[0]) |
        | 'T' |
      side_effects: {}

  # [6] `type()` failing on invalid arguments #1
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s6_type_failing_on_invalid_arguments_1
    xfail:
      spec: "openCypher TCK 2024.3 Graph4: [6] `type()` failing on invalid arguments #1"
      issue: "fix in 0.7.0"
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [r, 0] | type(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [6] `type()` failing on invalid arguments #2
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s6_type_failing_on_invalid_arguments_2
    xfail:
      spec: "openCypher TCK 2024.3 Graph4: [6] `type()` failing on invalid arguments #2"
      issue: "fix in 0.7.0"
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [r, 1.0] | type(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [6] `type()` failing on invalid arguments #3
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s6_type_failing_on_invalid_arguments_3
    xfail:
      spec: "openCypher TCK 2024.3 Graph4: [6] `type()` failing on invalid arguments #3"
      issue: "fix in 0.7.0"
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [r, true] | type(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [6] `type()` failing on invalid arguments #4
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s6_type_failing_on_invalid_arguments_4
    xfail:
      spec: "openCypher TCK 2024.3 Graph4: [6] `type()` failing on invalid arguments #4"
      issue: "fix in 0.7.0"
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [r, ''] | type(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [6] `type()` failing on invalid arguments #5
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s6_type_failing_on_invalid_arguments_5
    xfail:
      spec: "openCypher TCK 2024.3 Graph4: [6] `type()` failing on invalid arguments #5"
      issue: "fix in 0.7.0"
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [r, []] | type(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [7] Failing when using `type()` on a node
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s7_failing_when_using_type_on_a_node
    xfail:
      spec: "openCypher TCK 2024.3 Graph4: [7] Failing when using `type()` on a node"
      issue: "fix in 0.7.0"
    query: |
      MATCH (r)
      RETURN type(r)
    expect:
      gql_status: "42"
      side_effects: {}
