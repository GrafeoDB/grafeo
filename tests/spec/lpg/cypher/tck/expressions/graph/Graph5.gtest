# Converted from the openCypher TCK, tck/features/expressions/graph/Graph5.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)
# Not converted:
#   [2] Single-labels expression on relationships: tagged @ignore upstream

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Graph5"
  title: "Graph5 - Node and edge label expressions"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Single-labels expression on nodes
  - name: s1_single_labels_expression_on_nodes
    setup:
      - |
        CREATE (:A:B:C), (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C), ()
    query: |
      MATCH (a)
      RETURN a, a:B AS result
    expect:
      values: |
        | a | result |
        | (:A:B:C) | true |
        | (:A:B) | true |
        | (:A:C) | false |
        | (:B:C) | true |
        | (:A) | false |
        | (:B) | true |
        | (:C) | false |
        | () | false |
      side_effects: {}

  # [3] Conjunctive labels expression on nodes
  - name: s3_conjunctive_labels_expression_on_nodes
    setup:
      - |
        CREATE (:A:B:C), (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C), ()
    query: |
      MATCH (a)
      RETURN a, a:A:B AS result
    expect:
      values: |
        | a | result |
        | (:A:B:C) | true |
        | (:A:B) | true |
        | (:A:C) | false |
        | (:B:C) | false |
        | (:A) | false |
        | (:B) | false |
        | (:C) | false |
        | () | false |
      side_effects: {}

  # [4] Conjunctive labels expression on nodes with varying order and repeating labels #1
  - name: s4_conjunctive_labels_expression_on_nodes_with_varying_order_and_repeating_labels_1
    setup:
      - |
        CREATE (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C), ()
    query: |
      MATCH (a)
      WHERE a:A:C
      RETURN a
    expect:
      values: |
        | a |
        | (:A:C) |
      side_effects: {}

  # [4] Conjunctive labels expression on nodes with varying order and repeating labels #2
  - name: s4_conjunctive_labels_expression_on_nodes_with_varying_order_and_repeating_labels_2
    setup:
      - |
        CREATE (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C), ()
    query: |
      MATCH (a)
      WHERE a:C:A
      RETURN a
    expect:
      values: |
        | a |
        | (:A:C) |
      side_effects: {}

  # [4] Conjunctive labels expression on nodes with varying order and repeating labels #3
  - name: s4_conjunctive_labels_expression_on_nodes_with_varying_order_and_repeating_labels_3
    setup:
      - |
        CREATE (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C), ()
    query: |
      MATCH (a)
      WHERE a:A:C:A
      RETURN a
    expect:
      values: |
        | a |
        | (:A:C) |
      side_effects: {}

  # [4] Conjunctive labels expression on nodes with varying order and repeating labels #4
  - name: s4_conjunctive_labels_expression_on_nodes_with_varying_order_and_repeating_labels_4
    setup:
      - |
        CREATE (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C), ()
    query: |
      MATCH (a)
      WHERE a:C:C:A
      RETURN a
    expect:
      values: |
        | a |
        | (:A:C) |
      side_effects: {}

  # [4] Conjunctive labels expression on nodes with varying order and repeating labels #5
  - name: s4_conjunctive_labels_expression_on_nodes_with_varying_order_and_repeating_labels_5
    setup:
      - |
        CREATE (:A:B), (:A:C), (:B:C),
               (:A), (:B), (:C), ()
    query: |
      MATCH (a)
      WHERE a:C:A:A:C
      RETURN a
    expect:
      values: |
        | a |
        | (:A:C) |
      side_effects: {}

  # [5] Label expression on null
  - name: s5_label_expression_on_null
    xfail:
      spec: "openCypher TCK 2024.3 Graph5: [5] Label expression on null"
      issue: "#800"
    setup:
      - |
        CREATE (s:Single)
    query: |
      MATCH (n:Single)
      OPTIONAL MATCH (n)-[r:TYPE]-(m)
      RETURN m:TYPE
    expect:
      values: |
        | m:TYPE |
        | null |
      side_effects: {}
