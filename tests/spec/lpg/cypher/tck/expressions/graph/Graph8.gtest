meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Graph8"
  title: "Graph8 - Property keys function"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Using `keys()` on a single node, non-empty result
  - name: s1_using_keys_on_a_single_node_non_empty_result
    setup:
      - |
        CREATE ({name: 'Andres', surname: 'Lopez'})
    query: |
      MATCH (n)
      UNWIND keys(n) AS x
      RETURN DISTINCT x AS theProps
    expect:
      values: |
        | theProps |
        | 'name' |
        | 'surname' |
      side_effects: {}

  # [2] Using `keys()` on multiple nodes, non-empty result
  - name: s2_using_keys_on_multiple_nodes_non_empty_result
    setup:
      - |
        CREATE ({name: 'Andres', surname: 'Lopez'}),
               ({otherName: 'Andres', otherSurname: 'Lopez'})
    query: |
      MATCH (n)
      UNWIND keys(n) AS x
      RETURN DISTINCT x AS theProps
    expect:
      values: |
        | theProps |
        | 'name' |
        | 'surname' |
        | 'otherName' |
        | 'otherSurname' |
      side_effects: {}

  # [3] Using `keys()` on a single node, empty result
  - name: s3_using_keys_on_a_single_node_empty_result
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE ()
    query: |
      MATCH (n)
      UNWIND keys(n) AS x
      RETURN DISTINCT x AS theProps
    expect:
      values: |
        | theProps |
      side_effects: {}

  # [4] Using `keys()` on an optionally matched node
  - name: s4_using_keys_on_an_optionally_matched_node
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE ()
    query: |
      OPTIONAL MATCH (n)
      UNWIND keys(n) AS x
      RETURN DISTINCT x AS theProps
    expect:
      values: |
        | theProps |
      side_effects: {}

  # [5] Using `keys()` on a relationship, non-empty result
  - name: s5_using_keys_on_a_relationship_non_empty_result
    setup:
      - |
        CREATE ()-[:KNOWS {status: 'bad', year: '2015'}]->()
    query: |
      MATCH ()-[r:KNOWS]-()
      UNWIND keys(r) AS x
      RETURN DISTINCT x AS theProps
    expect:
      values: |
        | theProps |
        | 'status' |
        | 'year' |
      side_effects: {}

  # [6] Using `keys()` on a relationship, empty result
  - name: s6_using_keys_on_a_relationship_empty_result
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE ()-[:KNOWS]->()
    query: |
      MATCH ()-[r:KNOWS]-()
      UNWIND keys(r) AS x
      RETURN DISTINCT x AS theProps
    expect:
      values: |
        | theProps |
      side_effects: {}

  # [7] Using `keys()` on an optionally matched relationship
  - name: s7_using_keys_on_an_optionally_matched_relationship
    runner_gap:
      runners: [go, csharp, dart]
      issue: fix in 0.6.4
      reason: "the binding gives no column names for a result without rows"
    setup:
      - |
        CREATE ()-[:KNOWS]->()
    query: |
      OPTIONAL MATCH ()-[r:KNOWS]-()
      UNWIND keys(r) AS x
      RETURN DISTINCT x AS theProps
    expect:
      values: |
        | theProps |
      side_effects: {}

  # [8] Using `keys()` and `IN` to check property existence
  - name: s8_using_keys_and_in_to_check_property_existence
    setup:
      - |
        CREATE ({exists: 42, missing: null})
    query: |
      MATCH (n)
      RETURN 'exists' IN keys(n) AS a,
             'missing' IN keys(n) AS b,
             'missingToo' IN keys(n) AS c
    expect:
      values: |
        | a | b | c |
        | true | false | false |
      side_effects: {}
