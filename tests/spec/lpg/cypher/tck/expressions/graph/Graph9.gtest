meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Graph9"
  title: "Graph9 - Retrieve all properties as a property map"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] `properties()` on a node
  - name: s1_properties_on_a_node
    setup:
      - |
        CREATE (n:Person {name: 'Popeye', level: 9001})
    query: |
      MATCH (p:Person)
      RETURN properties(p) AS m
    expect:
      values: |
        | m |
        | {name: 'Popeye', level: 9001} |
      side_effects: {}

  # [2] `properties()` on a relationship
  - name: s2_properties_on_a_relationship
    setup:
      - |
        CREATE (n)-[:R {name: 'Popeye', level: 9001}]->(n)
    query: |
      MATCH ()-[r:R]->()
      RETURN properties(r) AS m
    expect:
      values: |
        | m |
        | {name: 'Popeye', level: 9001} |
      side_effects: {}

  # [3] `properties()` on null
  - name: s3_properties_on_null
    xfail:
      spec: "openCypher TCK 2024.3 Graph9: [3] `properties()` on null"
      issue: fix in 0.6.5
    query: |
      OPTIONAL MATCH (n:DoesNotExist)
      OPTIONAL MATCH (n)-[r:NOT_THERE]->()
      RETURN properties(n), properties(r), properties(null)
    expect:
      values: |
        | properties(n) | properties(r) | properties(null) |
        | null | null | null |
      side_effects: {}

  # [4] `properties()` on a map
  - name: s4_properties_on_a_map
    query: |
      RETURN properties({name: 'Popeye', level: 9001}) AS m
    expect:
      values: |
        | m |
        | {name: 'Popeye', level: 9001} |
      side_effects: {}

  # [5] `properties()` failing on an integer literal
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s5_properties_failing_on_an_integer_literal
    xfail:
      spec: "openCypher TCK 2024.3 Graph9: [5] `properties()` failing on an integer literal"
      issue: fix in 0.7.0
    query: |
      RETURN properties(1)
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] `properties()` failing on a string literal
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s6_properties_failing_on_a_string_literal
    xfail:
      spec: "openCypher TCK 2024.3 Graph9: [6] `properties()` failing on a string literal"
      issue: fix in 0.7.0
    query: |
      RETURN properties('Cypher')
    expect:
      gql_status: "42"
      side_effects: {}

  # [7] `properties()` failing on a list of booleans
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s7_properties_failing_on_a_list_of_booleans
    xfail:
      spec: "openCypher TCK 2024.3 Graph9: [7] `properties()` failing on a list of booleans"
      issue: fix in 0.7.0
    query: |
      RETURN properties([true, false])
    expect:
      gql_status: "42"
      side_effects: {}
