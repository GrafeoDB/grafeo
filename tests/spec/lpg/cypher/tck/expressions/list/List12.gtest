#
# Converted from the openCypher TCK, tck/features/expressions/list/List12.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.List12"
  title: "List12 - List Comprehension"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Collect and extract using a list comprehension
  - name: s1_collect_and_extract_using_a_list_comprehension
    setup:
      - |
        CREATE (:Label1 {name: 'original'})
    query: |
      MATCH (a:Label1)
      WITH collect(a) AS nodes
      WITH nodes, [x IN nodes | x.name] AS oldNames
      UNWIND nodes AS n
      SET n.name = 'newName'
      RETURN n.name, oldNames
    expect:
      values: |
        | n.name | oldNames |
        | 'newName' | ['original'] |
      side_effects:
        +properties: 1
        -properties: 1

  # [2] Collect and filter using a list comprehension
  - name: s2_collect_and_filter_using_a_list_comprehension
    setup:
      - |
        CREATE (:Label1 {name: 'original'})
    query: |
      MATCH (a:Label1)
      WITH collect(a) AS nodes
      WITH nodes, [x IN nodes WHERE x.name = 'original'] AS noopFiltered
      UNWIND nodes AS n
      SET n.name = 'newName'
      RETURN n.name, size(noopFiltered)
    expect:
      values: |
        | n.name | size(noopFiltered) |
        | 'newName' | 1 |
      side_effects:
        +properties: 1
        -properties: 1

  # [3] Size of list comprehension
  - name: s3_size_of_list_comprehension
    query: |
      MATCH (n)
      OPTIONAL MATCH (n)-[r]->(m)
      RETURN size([x IN collect(r) WHERE x <> null]) AS cn
    expect:
      values: |
        | cn |
        | 0 |
      side_effects: {}

  # [4] Returning a list comprehension
  - name: s4_returning_a_list_comprehension
    setup:
      - |
        CREATE (a:A)
        CREATE (a)-[:T]->(:B),
               (a)-[:T]->(:C)
    query: |
      MATCH p = (n)-->()
      RETURN [x IN collect(p) | head(nodes(x))] AS p
    expect:
      values: |
        | p |
        | [(:A), (:A)] |
      side_effects: {}

  # [5] Using a list comprehension in a WITH
  - name: s5_using_a_list_comprehension_in_a_with
    setup:
      - |
        CREATE (a:A)
        CREATE (a)-[:T]->(:B),
               (a)-[:T]->(:C)
    query: |
      MATCH p = (n:A)-->()
      WITH [x IN collect(p) | head(nodes(x))] AS p, count(n) AS c
      RETURN p, c
    expect:
      values: |
        | p | c |
        | [(:A), (:A)] | 2 |
      side_effects: {}

  # [6] Using a list comprehension in a WHERE
  - name: s6_using_a_list_comprehension_in_a_where
    setup:
      - |
        CREATE (a:A {name: 'c'})
        CREATE (a)-[:T]->(:B),
               (a)-[:T]->(:C)
    query: |
      MATCH (n)-->(b)
      WHERE n.name IN [x IN labels(b) | toLower(x)]
      RETURN b
    expect:
      values: |
        | b |
        | (:C) |
      side_effects: {}

  # [7] Fail when using aggregation in list comprehension
  # TCK: SyntaxError at compile time: InvalidAggregation
  - name: s7_fail_when_using_aggregation_in_list_comprehension
    xfail:
      spec: "openCypher TCK 2024.3 List12: [7] Fail when using aggregation in list comprehension"
      issue: "#798"
    query: |
      MATCH (n)
      RETURN [x IN [1, 2, 3, 4, 5] | count(*)]
    expect:
      gql_status: "42"
      side_effects: {}
