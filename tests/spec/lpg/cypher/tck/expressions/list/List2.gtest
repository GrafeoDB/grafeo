meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.List2"
  title: "List2 - List Slicing"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] List slice
  - name: s1_list_slice
    query: |
      WITH [1, 2, 3, 4, 5] AS list
      RETURN list[1..3] AS r
    expect:
      values: |
        | r |
        | [2, 3] |
      side_effects: {}

  # [2] List slice with implicit end
  - name: s2_list_slice_with_implicit_end
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[1..] AS r
    expect:
      values: |
        | r |
        | [2, 3] |
      side_effects: {}

  # [3] List slice with implicit start
  - name: s3_list_slice_with_implicit_start
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[..2] AS r
    expect:
      values: |
        | r |
        | [1, 2] |
      side_effects: {}

  # [4] List slice with singleton range
  - name: s4_list_slice_with_singleton_range
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[0..1] AS r
    expect:
      values: |
        | r |
        | [1] |
      side_effects: {}

  # [5] List slice with empty range
  - name: s5_list_slice_with_empty_range
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[0..0] AS r
    expect:
      values: |
        | r |
        | [] |
      side_effects: {}

  # [6] List slice with negative range
  - name: s6_list_slice_with_negative_range
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[-3..-1] AS r
    expect:
      values: |
        | r |
        | [1, 2] |
      side_effects: {}

  # [7] List slice with invalid range
  - name: s7_list_slice_with_invalid_range
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[3..1] AS r
    expect:
      values: |
        | r |
        | [] |
      side_effects: {}

  # [8] List slice with exceeding range
  - name: s8_list_slice_with_exceeding_range
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[-5..5] AS r
    expect:
      values: |
        | r |
        | [1, 2, 3] |
      side_effects: {}

  # [9] List slice with null range #1
  - name: s9_list_slice_with_null_range_1
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[null..null] AS r
    expect:
      values: |
        | r |
        | null |
      side_effects: {}

  # [9] List slice with null range #2
  - name: s9_list_slice_with_null_range_2
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[1..null] AS r
    expect:
      values: |
        | r |
        | null |
      side_effects: {}

  # [9] List slice with null range #3
  - name: s9_list_slice_with_null_range_3
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[null..3] AS r
    expect:
      values: |
        | r |
        | null |
      side_effects: {}

  # [9] List slice with null range #4
  - name: s9_list_slice_with_null_range_4
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[..null] AS r
    expect:
      values: |
        | r |
        | null |
      side_effects: {}

  # [9] List slice with null range #5
  - name: s9_list_slice_with_null_range_5
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[null..] AS r
    expect:
      values: |
        | r |
        | null |
      side_effects: {}

  # [10] List slice with parameterised range
  - name: s10_list_slice_with_parameterised_range
    params:
      from: 1
      to: 3
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[$from..$to] AS r
    expect:
      values: |
        | r |
        | [2, 3] |
      side_effects: {}

  # [11] List slice with parameterised invalid range
  - name: s11_list_slice_with_parameterised_invalid_range
    params:
      from: 3
      to: 1
    query: |
      WITH [1, 2, 3] AS list
      RETURN list[$from..$to] AS r
    expect:
      values: |
        | r |
        | [] |
      side_effects: {}
