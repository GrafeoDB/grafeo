meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.List3"
  title: "List3 - List Equality"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Equality between list and literal should return false
  - name: s1_equality_between_list_and_literal_should_return_false
    query: |
      RETURN [1, 2] = 'foo' AS res
    expect:
      values: |
        | res |
        | false |
      side_effects: {}

  # [2] Equality of lists of different length should return false despite nulls
  - name: s2_equality_of_lists_of_different_length_should_return_false_despite_nulls
    query: |
      RETURN [1] = [1, null] AS res
    expect:
      values: |
        | res |
        | false |
      side_effects: {}

  # [3] Equality between different lists with null should return false
  - name: s3_equality_between_different_lists_with_null_should_return_false
    query: |
      RETURN [1, 2] = [null, 'foo'] AS res
    expect:
      values: |
        | res |
        | false |
      side_effects: {}

  # [4] Equality between almost equal lists with null should return null
  - name: s4_equality_between_almost_equal_lists_with_null_should_return_null
    query: |
      RETURN [1, 2] = [null, 2] AS res
    expect:
      values: |
        | res |
        | null |
      side_effects: {}

  # [5] Equality of nested lists of different length should return false despite nulls
  - name: s5_equality_of_nested_lists_of_different_length_should_return_false_despite_nulls
    query: |
      RETURN [[1]] = [[1], [null]] AS res
    expect:
      values: |
        | res |
        | false |
      side_effects: {}

  # [6] Equality between different nested lists with null should return false
  - name: s6_equality_between_different_nested_lists_with_null_should_return_false
    query: |
      RETURN [[1, 2], [1, 3]] = [[1, 2], [null, 'foo']] AS res
    expect:
      values: |
        | res |
        | false |
      side_effects: {}

  # [7] Equality between almost equal nested lists with null should return null
  - name: s7_equality_between_almost_equal_nested_lists_with_null_should_return_null
    query: |
      RETURN [[1, 2], ['foo', 'bar']] = [[1, 2], [null, 'bar']] AS res
    expect:
      values: |
        | res |
        | null |
      side_effects: {}
