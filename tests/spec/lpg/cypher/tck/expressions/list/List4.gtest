meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.List4"
  title: "List4 - List Concatenation"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Concatenating lists of same type
  - name: s1_concatenating_lists_of_same_type
    query: |
      RETURN [1, 10, 100] + [4, 5] AS foo
    expect:
      values: |
        | foo |
        | [1, 10, 100, 4, 5] |
      side_effects: {}

  # [2] Concatenating a list with a scalar of same type
  - name: s2_concatenating_a_list_with_a_scalar_of_same_type
    query: |
      RETURN [false, true] + false AS foo
    expect:
      values: |
        | foo |
        | [false, true, false] |
      side_effects: {}
