#
# Converted from the openCypher TCK, tck/features/expressions/list/List6.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.List6"
  title: "List6 - List size"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Return list size
  - name: s1_return_list_size
    query: |
      RETURN size([1, 2, 3]) AS n
    expect:
      values: |
        | n |
        | 3 |
      side_effects: {}

  # [2] Setting and returning the size of a list property
  - name: s2_setting_and_returning_the_size_of_a_list_property
    setup:
      - |
        CREATE (:TheLabel)
    query: |
      MATCH (n:TheLabel)
      SET n.numbers = [1, 2, 3]
      RETURN size(n.numbers)
    expect:
      values: |
        | size(n.numbers) |
        | 3 |
      side_effects:
        +properties: 1

  # [3] Concatenating and returning the size of literal lists
  - name: s3_concatenating_and_returning_the_size_of_literal_lists
    query: |
      RETURN size([[], []] + [[]]) AS l
    expect:
      values: |
        | l |
        | 3 |
      side_effects: {}

  # [4] `size()` on null list
  - name: s4_size_on_null_list
    xfail:
      spec: "openCypher TCK 2024.3 List6: [4] `size()` on null list"
      issue: "#800"
    query: |
      WITH null AS l
      RETURN size(l), size(null)
    expect:
      values: |
        | size(l) | size(null) |
        | null | null |
      side_effects: {}

  # [5] Fail for `size()` on paths
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s5_fail_for_size_on_paths
    xfail:
      spec: "openCypher TCK 2024.3 List6: [5] Fail for `size()` on paths"
      issue: "fix in 0.7.0"
    query: |
      MATCH p = (a)-[*]->(b)
      RETURN size(p)
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #1
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_1
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #1"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size(()--())
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #2
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_2
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #2"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size(()--(a))
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #3
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_3
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #3"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size((a)-->())
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #4
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_4
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #4"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size((a)<--(a {}))
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #5
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_5
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #5"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size((a)-[:REL]->(b))
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #6
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_6
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #6"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size((a)-[:REL]->(b))
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #7
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_7
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #7"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size((a)-[:REL]->(:C)<-[:REL]-(a {num: 5}))
    expect:
      gql_status: "42"
      side_effects: {}

  # [6] Fail for `size()` on pattern predicates #8
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s6_fail_for_size_on_pattern_predicates_8
    xfail:
      spec: "openCypher TCK 2024.3 List6: [6] Fail for `size()` on pattern predicates #8"
      issue: "#795"
    query: |
      MATCH (a), (b), (c)
      RETURN size(()-[:REL*0..2]->()<-[:REL]-(:A {num: 5}))
    expect:
      gql_status: "42"
      side_effects: {}

  # [7] Using size of pattern comprehension to test existence
  - name: s7_using_size_of_pattern_comprehension_to_test_existence
    setup:
      - |
        CREATE (a:X {num: 42}), (:X {num: 43})
        CREATE (a)-[:T]->()
    query: |
      MATCH (n:X)
      RETURN n, size([(n)--() | 1]) > 0 AS b
    expect:
      values: |
        | n | b |
        | (:X {num: 42}) | true |
        | (:X {num: 43}) | false |
      side_effects: {}

  # [8] Get node degree via size of pattern comprehension
  - name: s8_get_node_degree_via_size_of_pattern_comprehension
    setup:
      - |
        CREATE (x:X),
          (x)-[:T]->(),
          (x)-[:T]->(),
          (x)-[:T]->()
    query: |
      MATCH (a:X)
      RETURN size([(a)-->() | 1]) AS length
    expect:
      values: |
        | length |
        | 3 |
      side_effects: {}

  # [9] Get node degree via size of pattern comprehension that specifies a relationship type
  - name: s9_get_node_degree_via_size_of_pattern_comprehension_that_specifies_a_relationship_type
    setup:
      - |
        CREATE (x:X),
          (x)-[:T]->(),
          (x)-[:T]->(),
          (x)-[:T]->(),
          (x)-[:OTHER]->()
    query: |
      MATCH (a:X)
      RETURN size([(a)-[:T]->() | 1]) AS length
    expect:
      values: |
        | length |
        | 3 |
      side_effects: {}

  # [10] Get node degree via size of pattern comprehension that specifies multiple relationship types
  - name: s10_get_node_degree_via_size_of_pattern_comprehension_that_specifies_multiple_relationship_types
    setup:
      - |
        CREATE (x:X),
          (x)-[:T]->(),
          (x)-[:T]->(),
          (x)-[:T]->(),
          (x)-[:OTHER]->()
    query: |
      MATCH (a:X)
      RETURN size([(a)-[:T|OTHER]->() | 1]) AS length
    expect:
      values: |
        | length |
        | 4 |
      side_effects: {}
