# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Literals2"
  title: "Literals2 - Decimal integer"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Return a short positive integer
  - name: s1_return_a_short_positive_integer
    query: |
      RETURN 1 AS literal
    expect:
      values: |
        | literal |
        | 1 |
      side_effects: {}

  # [2] Return a long positive integer
  - name: s2_return_a_long_positive_integer
    query: |
      RETURN 372036854 AS literal
    expect:
      values: |
        | literal |
        | 372036854 |
      side_effects: {}

  # [3] Return the largest integer
  - name: s3_return_the_largest_integer
    query: |
      RETURN 9223372036854775807 AS literal
    expect:
      values: |
        | literal |
        | 9223372036854775807 |
      side_effects: {}

  # [4] Return a positive zero
  - name: s4_return_a_positive_zero
    query: |
      RETURN 0 AS literal
    expect:
      values: |
        | literal |
        | 0 |
      side_effects: {}

  # [5] Return a negative zero
  - name: s5_return_a_negative_zero
    query: |
      RETURN -0 AS literal
    expect:
      values: |
        | literal |
        | 0 |
      side_effects: {}

  # [6] Return a short negative integer
  - name: s6_return_a_short_negative_integer
    query: |
      RETURN -1 AS literal
    expect:
      values: |
        | literal |
        | -1 |
      side_effects: {}

  # [7] Return a long negative integer
  - name: s7_return_a_long_negative_integer
    query: |
      RETURN -372036854 AS literal
    expect:
      values: |
        | literal |
        | -372036854 |
      side_effects: {}

  # [8] Return the smallest integer
  - name: s8_return_the_smallest_integer
    query: |
      RETURN -9223372036854775808 AS literal
    expect:
      values: |
        | literal |
        | -9223372036854775808 |
      side_effects: {}

  # [9] Fail on a too large integer
  # TCK: SyntaxError at compile time: IntegerOverflow
  - name: s9_fail_on_a_too_large_integer
    query: |
      RETURN 9223372036854775808 AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [10] Fail on a too small integer
  # TCK: SyntaxError at compile time: IntegerOverflow
  - name: s10_fail_on_a_too_small_integer
    query: |
      RETURN -9223372036854775809 AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [11] Fail on an integer containing a alphabetic character
  # TCK: SyntaxError at compile time: InvalidNumberLiteral
  - name: s11_fail_on_an_integer_containing_a_alphabetic_character
    query: |
      RETURN 9223372h54775808 AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [12] Fail on an integer containing a invalid symbol character
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s12_fail_on_an_integer_containing_a_invalid_symbol_character
    query: |
      RETURN 9223372#54775808 AS literal
    expect:
      gql_status: "42"
      side_effects: {}
