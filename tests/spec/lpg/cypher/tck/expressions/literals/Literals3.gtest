#
# Converted from the openCypher TCK, tck/features/expressions/literals/Literals3.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Literals3"
  title: "Literals3 - Hexadecimal integer"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Return a short positive hexadecimal integer
  - name: s1_return_a_short_positive_hexadecimal_integer
    query: |
      RETURN 0x1 AS literal
    expect:
      values: |
        | literal |
        | 1 |
      side_effects: {}

  # [2] Return a long positive hexadecimal integer
  - name: s2_return_a_long_positive_hexadecimal_integer
    query: |
      RETURN 0x162CD4F6 AS literal
    expect:
      values: |
        | literal |
        | 372036854 |
      side_effects: {}

  # [3] Return the largest hexadecimal integer
  - name: s3_return_the_largest_hexadecimal_integer
    query: |
      RETURN 0x7FFFFFFFFFFFFFFF AS literal
    expect:
      values: |
        | literal |
        | 9223372036854775807 |
      side_effects: {}

  # [4] Return a positive hexadecimal zero
  - name: s4_return_a_positive_hexadecimal_zero
    query: |
      RETURN 0x0 AS literal
    expect:
      values: |
        | literal |
        | 0 |
      side_effects: {}

  # [5] Return a negative hexadecimal zero
  - name: s5_return_a_negative_hexadecimal_zero
    query: |
      RETURN -0x0 AS literal
    expect:
      values: |
        | literal |
        | 0 |
      side_effects: {}

  # [6] Return a short negative hexadecimal integer
  - name: s6_return_a_short_negative_hexadecimal_integer
    query: |
      RETURN -0x1 AS literal
    expect:
      values: |
        | literal |
        | -1 |
      side_effects: {}

  # [7] Return a long negative hexadecimal integer
  - name: s7_return_a_long_negative_hexadecimal_integer
    query: |
      RETURN -0x162CD4F6 AS literal
    expect:
      values: |
        | literal |
        | -372036854 |
      side_effects: {}

  # [8] Return the smallest hexadecimal integer
  - name: s8_return_the_smallest_hexadecimal_integer
    xfail:
      spec: "openCypher TCK 2024.3 Literals3: [8] Return the smallest hexadecimal integer"
      issue: fix in 0.6.5
    query: |
      RETURN -0x8000000000000000 AS literal
    expect:
      values: |
        | literal |
        | -9223372036854775808 |
      side_effects: {}

  # [9] Return a lower case hexadecimal integer
  - name: s9_return_a_lower_case_hexadecimal_integer
    query: |
      RETURN 0x1a2b3c4d5e6f7 AS literal
    expect:
      values: |
        | literal |
        | 460367961908983 |
      side_effects: {}

  # [10] Return a upper case hexadecimal integer
  - name: s10_return_a_upper_case_hexadecimal_integer
    query: |
      RETURN 0x1A2B3C4D5E6F7 AS literal
    expect:
      values: |
        | literal |
        | 460367961908983 |
      side_effects: {}

  # [11] Return a mixed case hexadecimal integer
  - name: s11_return_a_mixed_case_hexadecimal_integer
    query: |
      RETURN 0x1A2b3c4D5E6f7 AS literal
    expect:
      values: |
        | literal |
        | 460367961908983 |
      side_effects: {}

  # [12] Fail on an incomplete hexadecimal integer
  # TCK: SyntaxError at compile time: InvalidNumberLiteral
  - name: s12_fail_on_an_incomplete_hexadecimal_integer
    query: |
      RETURN 0x AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [13] Fail on an hexadecimal literal containing a lower case invalid alphanumeric character
  # TCK: SyntaxError at compile time: InvalidNumberLiteral
  - name: s13_fail_on_an_hexadecimal_literal_containing_a_lower_case_invalid_alphanumeric_character
    query: |
      RETURN 0x1A2b3j4D5E6f7 AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [14] Fail on an hexadecimal literal containing a upper case invalid alphanumeric character
  # TCK: SyntaxError at compile time: InvalidNumberLiteral
  - name: s14_fail_on_an_hexadecimal_literal_containing_a_upper_case_invalid_alphanumeric_character
    query: |
      RETURN 0x1A2b3c4Z5E6f7 AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [16] Fail on a too large hexadecimal integer
  # TCK: SyntaxError at compile time: IntegerOverflow
  - name: s16_fail_on_a_too_large_hexadecimal_integer
    query: |
      RETURN 0x8000000000000000 AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [17] Fail on a too small hexadecimal integer
  # TCK: SyntaxError at compile time: IntegerOverflow
  - name: s17_fail_on_a_too_small_hexadecimal_integer
    query: |
      RETURN -0x8000000000000001 AS literal
    expect:
      gql_status: "42"
      side_effects: {}
