# Converted from the openCypher TCK, tck/features/expressions/literals/Literals5.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Literals5"
  title: "Literals5 - Float"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Return a short positive float
  - name: s1_return_a_short_positive_float
    query: |
      RETURN 1.0 AS literal
    expect:
      values: |
        | literal |
        | 1.0 |
      side_effects: {}

  # [2] Return a short positive float without integer digits
  - name: s2_return_a_short_positive_float_without_integer_digits
    query: |
      RETURN .1 AS literal
    expect:
      values: |
        | literal |
        | 0.1 |
      side_effects: {}

  # [3] Return a long positive float
  - name: s3_return_a_long_positive_float
    query: |
      RETURN 3985764.3405892687 AS literal
    expect:
      values: |
        | literal |
        | 3985764.3405892686 |
      side_effects: {}

  # [4] Return a long positive float without integer digits
  - name: s4_return_a_long_positive_float_without_integer_digits
    query: |
      RETURN .3405892687 AS literal
    expect:
      values: |
        | literal |
        | 0.3405892687 |
      side_effects: {}

  # [5] Return a very long positive float
  - name: s5_return_a_very_long_positive_float
    query: |
      RETURN .0 AS literal
    expect:
      values: |
        | literal |
        | 1.2635418652381264e305 |
      side_effects: {}

  # [6] Return a very long positive float without integer digits
  - name: s6_return_a_very_long_positive_float_without_integer_digits
    query: |
      RETURN . AS literal
    expect:
      values: |
        | literal |
        | 1e-305 |
      side_effects: {}

  # [7] Return a positive zero float
  - name: s7_return_a_positive_zero_float
    query: |
      RETURN 0.0 AS literal
    expect:
      values: |
        | literal |
        | 0.0 |
      side_effects: {}

  # [8] Return a positive zero float without integer digits
  - name: s8_return_a_positive_zero_float_without_integer_digits
    query: |
      RETURN .0 AS literal
    expect:
      values: |
        | literal |
        | 0.0 |
      side_effects: {}

  # [9] Return a negative zero float
  - name: s9_return_a_negative_zero_float
    query: |
      RETURN -0.0 AS literal
    expect:
      values: |
        | literal |
        | 0.0 |
      side_effects: {}

  # [10] Return a negative zero float without integer digits
  - name: s10_return_a_negative_zero_float_without_integer_digits
    query: |
      RETURN -.0 AS literal
    expect:
      values: |
        | literal |
        | 0.0 |
      side_effects: {}

  # [11] Return a very long negative float
  - name: s11_return_a_very_long_negative_float
    query: |
      RETURN -.0 AS literal
    expect:
      values: |
        | literal |
        | -1.2635418652381264e305 |
      side_effects: {}

  # [12] Return a very long negative float without integer digits
  - name: s12_return_a_very_long_negative_float_without_integer_digits
    query: |
      RETURN -. AS literal
    expect:
      values: |
        | literal |
        | -1e-305 |
      side_effects: {}

  # [13] Return a positive float with positive lower case exponent
  - name: s13_return_a_positive_float_with_positive_lower_case_exponent
    query: |
      RETURN 1e9 AS literal
    expect:
      values: |
        | literal |
        | 1000000000.0 |
      side_effects: {}

  # [14] Return a positive float with positive upper case exponent
  - name: s14_return_a_positive_float_with_positive_upper_case_exponent
    query: |
      RETURN 1E9 AS literal
    expect:
      values: |
        | literal |
        | 1000000000.0 |
      side_effects: {}

  # [15] Return a positive float with positive lower case exponent without integer digits
  - name: s15_return_a_positive_float_with_positive_lower_case_exponent_without_integer_digits
    query: |
      RETURN .1e9 AS literal
    expect:
      values: |
        | literal |
        | 100000000.0 |
      side_effects: {}

  # [16] Return a positive float with negative lower case exponent
  - name: s16_return_a_positive_float_with_negative_lower_case_exponent
    query: |
      RETURN 1e-5 AS literal
    expect:
      values: |
        | literal |
        | 0.00001 |
      side_effects: {}

  # [17] Return a positive float with negative lower case exponent without integer digits
  - name: s17_return_a_positive_float_with_negative_lower_case_exponent_without_integer_digits
    query: |
      RETURN .1e-5 AS literal
    expect:
      values: |
        | literal |
        | 0.000001 |
      side_effects: {}

  # [18] Return a positive float with negative upper case exponent without integer digits
  - name: s18_return_a_positive_float_with_negative_upper_case_exponent_without_integer_digits
    query: |
      RETURN .1E-5 AS literal
    expect:
      values: |
        | literal |
        | 0.000001 |
      side_effects: {}

  # [19] Return a negative float in with positive lower case exponent
  - name: s19_return_a_negative_float_in_with_positive_lower_case_exponent
    query: |
      RETURN -1e9 AS literal
    expect:
      values: |
        | literal |
        | -1000000000.0 |
      side_effects: {}

  # [20] Return a negative float in with positive upper case exponent
  - name: s20_return_a_negative_float_in_with_positive_upper_case_exponent
    query: |
      RETURN -1E9 AS literal
    expect:
      values: |
        | literal |
        | -1000000000.0 |
      side_effects: {}

  # [21] Return a negative float with positive lower case exponent without integer digits
  - name: s21_return_a_negative_float_with_positive_lower_case_exponent_without_integer_digits
    query: |
      RETURN -.1e9 AS literal
    expect:
      values: |
        | literal |
        | -100000000.0 |
      side_effects: {}

  # [22] Return a negative float with negative lower case exponent
  - name: s22_return_a_negative_float_with_negative_lower_case_exponent
    query: |
      RETURN -1e-5 AS literal
    expect:
      values: |
        | literal |
        | -0.00001 |
      side_effects: {}

  # [23] Return a negative float with negative lower case exponent without integer digits
  - name: s23_return_a_negative_float_with_negative_lower_case_exponent_without_integer_digits
    query: |
      RETURN -.1e-5 AS literal
    expect:
      values: |
        | literal |
        | -0.000001 |
      side_effects: {}

  # [24] Return a negative float with negative upper case exponent without integer digits
  - name: s24_return_a_negative_float_with_negative_upper_case_exponent_without_integer_digits
    query: |
      RETURN -.1E-5 AS literal
    expect:
      values: |
        | literal |
        | -0.000001 |
      side_effects: {}

  # [25] Return a positive float with one integer digit and maximum positive exponent
  - name: s25_return_a_positive_float_with_one_integer_digit_and_maximum_positive_exponent
    query: |
      RETURN 1e308 AS literal
    expect:
      values: |
        | literal |
        | 1e308 |
      side_effects: {}

  # [26] Return a positive float with nine integer digit and maximum positive exponent
  - name: s26_return_a_positive_float_with_nine_integer_digit_and_maximum_positive_exponent
    query: |
      RETURN 123456789e300 AS literal
    expect:
      values: |
        | literal |
        | 1.23456789e308 |
      side_effects: {}

  # [27] Fail when float value is too large
  # TCK: SyntaxError at compile time: FloatingPointOverflow
  - name: s27_fail_when_float_value_is_too_large
    query: |
      RETURN 1.34E999
    expect:
      gql_status: "42"
      side_effects: {}
