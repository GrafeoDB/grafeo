# Converted from the openCypher TCK, tck/features/expressions/literals/Literals7.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Literals7"
  title: "Literals7 - List"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Return an empty list
  - name: s1_return_an_empty_list
    query: |
      RETURN [] AS literal
    expect:
      values: |
        | literal |
        | [] |
      side_effects: {}

  # [2] Return a list containing a boolean
  - name: s2_return_a_list_containing_a_boolean
    query: |
      RETURN [false] AS literal
    expect:
      values: |
        | literal |
        | [false] |
      side_effects: {}

  # [3] Return a list containing a null
  - name: s3_return_a_list_containing_a_null
    query: |
      RETURN [null] AS literal
    expect:
      values: |
        | literal |
        | [null] |
      side_effects: {}

  # [4] Return a list containing a integer
  - name: s4_return_a_list_containing_a_integer
    query: |
      RETURN [1] AS literal
    expect:
      values: |
        | literal |
        | [1] |
      side_effects: {}

  # [5] Return a list containing a hexadecimal integer
  - name: s5_return_a_list_containing_a_hexadecimal_integer
    query: |
      RETURN [-0x162CD4F6] AS literal
    expect:
      values: |
        | literal |
        | [-372036854] |
      side_effects: {}

  # [6] Return a list containing a octal integer
  - name: s6_return_a_list_containing_a_octal_integer
    query: |
      RETURN [0o2613152366] AS literal
    expect:
      values: |
        | literal |
        | [372036854] |
      side_effects: {}

  # [7] Return a list containing a float
  - name: s7_return_a_list_containing_a_float
    query: |
      RETURN [-.1e-5] AS literal
    expect:
      values: |
        | literal |
        | [-0.000001] |
      side_effects: {}

  # [8] Return a list containing a string
  - name: s8_return_a_list_containing_a_string
    query: |
      RETURN ['abc, as#?lßdj '] AS literal
    expect:
      values: |
        | literal |
        | ['abc, as#?lßdj '] |
      side_effects: {}

  # [9] Return a list containing an empty lists
  - name: s9_return_a_list_containing_an_empty_lists
    query: |
      RETURN [[]] AS literal
    expect:
      values: |
        | literal |
        | [[]] |
      side_effects: {}

  # [10] Return seven-deep nested empty lists
  - name: s10_return_seven_deep_nested_empty_lists
    query: |
      RETURN [[[[[[[]]]]]]] AS literal
    expect:
      values: |
        | literal |
        | [[[[[[[]]]]]]] |
      side_effects: {}

  # [11] Return 20-deep nested empty lists
  - name: s11_return_20_deep_nested_empty_lists
    query: |
      RETURN [[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]] AS literal
    expect:
      values: |
        | literal |
        | [[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]] |
      side_effects: {}

  # [12] Return 40-deep nested empty lists
  - name: s12_return_40_deep_nested_empty_lists
    query: |
      RETURN [[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]] AS literal
    expect:
      values: |
        | literal |
        | [[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]] |
      side_effects: {}

  # [13] Return a list containing an empty map
  - name: s13_return_a_list_containing_an_empty_map
    query: |
      RETURN [{}] AS literal
    expect:
      values: |
        | literal |
        | [{}] |
      side_effects: {}

  # [14] Return a list containing multiple integer
  - name: s14_return_a_list_containing_multiple_integer
    query: |
      RETURN [1, -2, 0o77, 0xA4C, 71034856] AS literal
    expect:
      values: |
        | literal |
        | [1, -2, 63, 2636, 71034856] |
      side_effects: {}

  # [16] Return a list containing multiple mixed values
  - name: s16_return_a_list_containing_multiple_mixed_values
    query: |
      RETURN [2E-01, ', as#?lßdj ', null, 71034856, false] AS literal
    expect:
      values: |
        | literal |
        | [0.2, ', as#?lßdj ', null, 71034856, false] |
      side_effects: {}

  # [17] Return a list containing real and fake nested lists
  - name: s17_return_a_list_containing_real_and_fake_nested_lists
    query: |
      RETURN [null, [ ' a ', ' ' ], ' [ a ', ' [ ], ] ', ' [ ', [ ' ' ], ' ] ' ] AS literal
    expect:
      values: |
        | literal |
        | [null, [' a ', ' '], ' [ a ', ' [ ], ] ', ' [ ', [' '], ' ] '] |
      side_effects: {}

  # [18] Return a complex list containing multiple mixed and nested values
  - name: s18_return_a_complex_list_containing_multiple_mixed_and_nested_values
    query: |
      RETURN [ {
                  id: '0001',
                  type: 'donut',
                  name: 'Cake',
                  ppu: 0.55,
                  batters:
                      {
                          batter:
                              [
                                  { id: '1001', type: 'Regular' },
                                  { id: '1002', type: 'Chocolate' },
                                  { id: '1003', type: 'Blueberry' },
                                  { id: '1004', type: 'Devils Food' }
                              ]
                      },
                  topping:
                      [
                          { id: '5001', type: 'None' },
                          { id: '5002', type: 'Glazed' },
                          { id: '5005', type: 'Sugar' },
                          { id: '5007', type: 'Powdered Sugar' },
                          { id: '5006', type: 'Chocolate Sprinkles' },
                          { id: '5003', type: 'Chocolate' },
                          { id: '5004', type: 'Maple' }
                      ]
              },
              {
                  id: '0002',
                  type: 'donut',
                  name: 'Raised',
                  ppu: 0.55,
                  batters:
                      {
                          batter:
                              [
                                  { id: '1001', type: 'Regular' }
                              ]
                      },
                  topping:
                      [
                          { id: '5001', type: 'None' },
                          { id: '5002', type: 'Glazed' },
                          { id: '5005', type: 'Sugar' },
                          { id: '5003', type: 'Chocolate' },
                          { id: '5004', type: 'Maple' }
                      ]
              },
              {
                  id: '0003',
                  type: 'donut',
                  name: 'Old Fashioned',
                  ppu: 0.55,
                  batters:
                      {
                          batter:
                              [
                                  { id: '1001', type: 'Regular' },
                                  { id: '1002', type: 'Chocolate' }
                              ]
                      },
                  topping:
                      [
                          { id: '5001', type: 'None' },
                          { id: '5002', type: 'Glazed' },
                          { id: '5003', type: 'Chocolate' },
                          { id: '5004', type: 'Maple' }
                      ]
              } ] AS literal
    expect:
      values: |
        | literal |
        | [{id: '0001', type: 'donut', name: 'Cake', ppu: 0.55, batters: {batter: [{id: '1001', type: 'Regular'}, {id: '1002', type: 'Chocolate'}, {id: '1003', type: 'Blueberry'}, {id: '1004', type: 'Devils Food'}]}, topping: [{id: '5001', type: 'None'}, {id: '5002', type: 'Glazed'}, {id: '5005', type: 'Sugar'}, {id: '5007', type: 'Powdered Sugar'}, {id: '5006', type: 'Chocolate Sprinkles'}, {id: '5003', type: 'Chocolate'}, {id: '5004', type: 'Maple'}]}, {id: '0002', type: 'donut', name: 'Raised', ppu: 0.55, batters: {batter: [{id: '1001', type: 'Regular'}]}, topping: [{id: '5001', type: 'None'}, {id: '5002', type: 'Glazed'}, {id: '5005', type: 'Sugar'}, {id: '5003', type: 'Chocolate'}, {id: '5004', type: 'Maple'}]}, {id: '0003', type: 'donut', name: 'Old Fashioned', ppu: 0.55, batters: {batter: [{id: '1001', type: 'Regular'}, {id: '1002', type: 'Chocolate'}]}, topping: [{id: '5001', type: 'None'}, {id: '5002', type: 'Glazed'}, {id: '5003', type: 'Chocolate'}, {id: '5004', type: 'Maple'}]}] |
      side_effects: {}

  # [19] Fail on a list containing only a comma
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s19_fail_on_a_list_containing_only_a_comma
    query: |
      RETURN [, ] AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [20] Fail on a nested list with non-matching brackets
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s20_fail_on_a_nested_list_with_non_matching_brackets
    query: |
      RETURN [[[]] AS literal
    expect:
      gql_status: "42"
      side_effects: {}

  # [21] Fail on a nested list with missing commas
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s21_fail_on_a_nested_list_with_missing_commas
    query: |
      RETURN [[','[]',']] AS literal
    expect:
      gql_status: "42"
      side_effects: {}
