# Converted from the openCypher TCK, tck/features/expressions/map/Map3.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Map3"
  title: "Map3 - Keys function"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Using `keys()` on a literal map
  - name: s1_using_keys_on_a_literal_map
    query: |
      RETURN keys({name: 'Alice', age: 38, address: {city: 'London', residential: true}}) AS k
    expect:
      unordered_lists: true
      values: |
        | k |
        | ['name', 'age', 'address'] |
      side_effects: {}

  # [2] Using `keys()` on a parameter map
  - name: s2_using_keys_on_a_parameter_map
    params:
      param: {"name": "Alice", "age": 38, "address": {"city": "London", "residential": true}}
    query: |
      RETURN keys($param) AS k
    expect:
      unordered_lists: true
      values: |
        | k |
        | ['address', 'name', 'age'] |
      side_effects: {}

  # [3] Using `keys()` on null map
  - name: s3_using_keys_on_null_map
    xfail:
      spec: "openCypher TCK 2024.3 Map3: [3] Using `keys()` on null map"
      issue: "#800"
    query: |
      WITH null AS m
      RETURN keys(m), keys(null)
    expect:
      values: |
        | keys(m) | keys(null) |
        | null | null |
      side_effects: {}

  # [4] Using `keys()` on map with null values #1
  - name: s4_using_keys_on_map_with_null_values_1
    query: |
      RETURN keys({}) AS keys
    expect:
      unordered_lists: true
      values: |
        | keys |
        | [] |
      side_effects: {}

  # [4] Using `keys()` on map with null values #2
  - name: s4_using_keys_on_map_with_null_values_2
    query: |
      RETURN keys({k: 1}) AS keys
    expect:
      unordered_lists: true
      values: |
        | keys |
        | ['k'] |
      side_effects: {}

  # [4] Using `keys()` on map with null values #3
  - name: s4_using_keys_on_map_with_null_values_3
    query: |
      RETURN keys({k: null}) AS keys
    expect:
      unordered_lists: true
      values: |
        | keys |
        | ['k'] |
      side_effects: {}

  # [4] Using `keys()` on map with null values #4
  - name: s4_using_keys_on_map_with_null_values_4
    query: |
      RETURN keys({k: null, l: 1}) AS keys
    expect:
      unordered_lists: true
      values: |
        | keys |
        | ['k', 'l'] |
      side_effects: {}

  # [4] Using `keys()` on map with null values #5
  - name: s4_using_keys_on_map_with_null_values_5
    query: |
      RETURN keys({k: 1, l: null}) AS keys
    expect:
      unordered_lists: true
      values: |
        | keys |
        | ['k', 'l'] |
      side_effects: {}

  # [4] Using `keys()` on map with null values #6
  - name: s4_using_keys_on_map_with_null_values_6
    query: |
      RETURN keys({k: null, l: null}) AS keys
    expect:
      unordered_lists: true
      values: |
        | keys |
        | ['k', 'l'] |
      side_effects: {}

  # [4] Using `keys()` on map with null values #7
  - name: s4_using_keys_on_map_with_null_values_7
    query: |
      RETURN keys({k: 1, l: null, m: 1}) AS keys
    expect:
      unordered_lists: true
      values: |
        | keys |
        | ['k', 'l', 'm'] |
      side_effects: {}

  # [5] Using `keys()` and `IN` to check field existence
  - name: s5_using_keys_and_in_to_check_field_existence
    query: |
      WITH {exists: 42, notMissing: null} AS map
      RETURN 'exists' IN keys(map) AS a,
             'notMissing' IN keys(map) AS b,
             'missing' IN keys(map) AS c
    expect:
      values: |
        | a | b | c |
        | true | true | false |
      side_effects: {}
