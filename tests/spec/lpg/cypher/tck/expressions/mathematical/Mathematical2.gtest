meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Mathematical2"
  title: "Mathematical2 - Addition"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Allow addition
  - name: s1_allow_addition
    setup:
      - |
        CREATE ({id: 1337, version: 99})
    query: |
      MATCH (a)
      WHERE a.id = 1337
      RETURN a.version + 5
    expect:
      values: |
        | a.version + 5 |
        | 104 |
      side_effects: {}
