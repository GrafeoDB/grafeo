meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Null1"
  title: "Null1 - IS NULL validation"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Property null check on non-null node
  - name: s1_property_null_check_on_non_null_node
    setup:
      - |
        CREATE ({exists: 42})
    query: |
      MATCH (n)
      RETURN n.missing IS NULL,
             n.exists IS NULL
    expect:
      values: |
        | n.missing IS NULL | n.exists IS NULL |
        | true | false |
      side_effects: {}

  # [2] Property null check on optional non-null node
  - name: s2_property_null_check_on_optional_non_null_node
    setup:
      - |
        CREATE ({exists: 42})
    query: |
      OPTIONAL MATCH (n)
      RETURN n.missing IS NULL,
             n.exists IS NULL
    expect:
      values: |
        | n.missing IS NULL | n.exists IS NULL |
        | true | false |
      side_effects: {}

  # [3] Property null check on null node
  - name: s3_property_null_check_on_null_node
    query: |
      OPTIONAL MATCH (n)
      RETURN n.missing IS NULL
    expect:
      values: |
        | n.missing IS NULL |
        | true |
      side_effects: {}

  # [4] A literal null IS null
  - name: s4_a_literal_null_is_null
    query: |
      RETURN null IS NULL AS value
    expect:
      values: |
        | value |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #1
  - name: s5_is_null_on_a_map_1
    query: |
      WITH {name: 'Mats', name2: 'Pontus'} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [5] IS NULL on a map #2
  - name: s5_is_null_on_a_map_2
    query: |
      WITH {name: 'Mats', name2: 'Pontus'} AS map
      RETURN map.name2 IS NULL AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [5] IS NULL on a map #3
  - name: s5_is_null_on_a_map_3
    query: |
      WITH {name: 'Mats', name2: null} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [5] IS NULL on a map #4
  - name: s5_is_null_on_a_map_4
    query: |
      WITH {name: 'Mats', name2: null} AS map
      RETURN map.name2 IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #5
  - name: s5_is_null_on_a_map_5
    query: |
      WITH {name: null} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #6
  - name: s5_is_null_on_a_map_6
    query: |
      WITH {name: null, name2: null} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #7
  - name: s5_is_null_on_a_map_7
    query: |
      WITH {name: null, name2: null} AS map
      RETURN map.name2 IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #8
  - name: s5_is_null_on_a_map_8
    query: |
      WITH {notName: null, notName2: null} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #9
  - name: s5_is_null_on_a_map_9
    query: |
      WITH {notName: 0, notName2: null} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #10
  - name: s5_is_null_on_a_map_10
    query: |
      WITH {notName: 0} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #11
  - name: s5_is_null_on_a_map_11
    query: |
      WITH {} AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] IS NULL on a map #12
  - name: s5_is_null_on_a_map_12
    query: |
      WITH null AS map
      RETURN map.name IS NULL AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [6] IS NULL is case insensitive
  - name: s6_is_null_is_case_insensitive
    setup:
      - |
        CREATE (a:X {prop: 42}), (:X)
    query: |
      MATCH (n:X)
      RETURN n, n.prop iS NuLl AS b
    expect:
      values: |
        | n | b |
        | (:X {prop: 42}) | false |
        | (:X) | true |
      side_effects: {}
