meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Null3"
  title: "Null3 - Null evaluation"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] The inverse of a null is a null
  - name: s1_the_inverse_of_a_null_is_a_null
    query: |
      RETURN NOT null AS value
    expect:
      values: |
        | value |
        | null |
      side_effects: {}

  # [2] It is unknown - i.e. null - if a null is equal to a null
  - name: s2_it_is_unknown_i_e_null_if_a_null_is_equal_to_a_null
    query: |
      RETURN null = null AS value
    expect:
      values: |
        | value |
        | null |
      side_effects: {}

  # [3] It is unknown - i.e. null - if a null is not equal to a null
  - name: s3_it_is_unknown_i_e_null_if_a_null_is_not_equal_to_a_null
    query: |
      RETURN null <> null AS value
    expect:
      values: |
        | value |
        | null |
      side_effects: {}

  # [4] Using null in IN #1
  - name: s4_using_null_in_in_1
    params:
      elt: null
      coll: null
    query: |
      RETURN $elt IN $coll AS result
    expect:
      values: |
        | result |
        | null |
      side_effects: {}

  # [4] Using null in IN #2
  - name: s4_using_null_in_in_2
    params:
      elt: null
      coll: [1, 2, 3]
    query: |
      RETURN $elt IN $coll AS result
    expect:
      values: |
        | result |
        | null |
      side_effects: {}

  # [4] Using null in IN #3
  - name: s4_using_null_in_in_3
    params:
      elt: null
      coll: [1, 2, 3, null]
    query: |
      RETURN $elt IN $coll AS result
    expect:
      values: |
        | result |
        | null |
      side_effects: {}

  # [4] Using null in IN #4
  - name: s4_using_null_in_in_4
    params:
      elt: null
      coll: []
    query: |
      RETURN $elt IN $coll AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [4] Using null in IN #5
  - name: s4_using_null_in_in_5
    params:
      elt: 1
      coll: [1, 2, 3, null]
    query: |
      RETURN $elt IN $coll AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] Using null in IN #6
  - name: s4_using_null_in_in_6
    params:
      elt: 1
      coll: [null, 1]
    query: |
      RETURN $elt IN $coll AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] Using null in IN #7
  - name: s4_using_null_in_in_7
    params:
      elt: 5
      coll: [1, 2, 3, null]
    query: |
      RETURN $elt IN $coll AS result
    expect:
      values: |
        | result |
        | null |
      side_effects: {}
