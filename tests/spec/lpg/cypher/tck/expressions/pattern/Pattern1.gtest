        | (:A) | (:B) |
        | (:A) | (:D) |
        | (:B) | (:A) |
        | (:B) | (:D) |
        | (:D) | (:A) |
        | (:D) | (:B) |
      side_effects: {}

  # [18] Matching two nodes on a specific type of undirected connection with length 2
  - name: s18_matching_two_nodes_on_a_specific_type_of_undirected_connection_with_length_2
    setup:
      - |
        CREATE (a:A)-[:REL1]->(b:B), (b)-[:REL2]->(a), (a)-[:REL3]->(:C), (a)-[:REL1]->(:D)
    query: |
      MATCH (n), (m) WHERE (n)-[:REL1*2]-(m) RETURN n, m
    expect:
      values: |
        | n | m |
        | (:D) | (:B) |
        | (:B) | (:D) |
      side_effects: {}

  # [19] Using a negated existential pattern predicate
  - name: s19_using_a_negated_existential_pattern_predicate
    setup:
      - |
        CREATE (a:A)-[:REL1]->(b:B), (b)-[:REL2]->(a), (a)-[:REL3]->(:C), (a)-[:REL1]->(:D)
    query: |
      MATCH (n) WHERE NOT (n)-[:REL2]-() RETURN n
    expect:
      values: |
        | n |
        | (:C) |
        | (:D) |
      side_effects: {}

  # [20] Using two existential pattern predicates in a conjunction
  - name: s20_using_two_existential_pattern_predicates_in_a_conjunction
    setup:
      - |
        CREATE (a:A)-[:REL1]->(b:B), (b)-[:REL2]->(a), (a)-[:REL3]->(:C), (a)-[:REL1]->(:D)
    query: |
      MATCH (n) WHERE (n)-[:REL1]-() AND (n)-[:REL3]-() RETURN n
    expect:
      values: |
        | n |
        | (:A) |
      side_effects: {}

  # [21] Using two existential pattern predicates in a disjunction
  - name: s21_using_two_existential_pattern_predicates_in_a_disjunction
    setup:
      - |
        CREATE (a:A)-[:REL1]->(b:B), (b)-[:REL2]->(a), (a)-[:REL3]->(:C), (a)-[:REL1]->(:D)
    query: |
      MATCH (n) WHERE (n)-[:REL1]-() OR (n)-[:REL2]-() RETURN n
    expect:
      values: |
        | n |
        | (:A) |
        | (:B) |
        | (:D) |
      side_effects: {}

  # [22] Fail on using pattern in RETURN projection
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s22_fail_on_using_pattern_in_return_projection
    xfail:
      spec: "openCypher TCK 2024.3 Pattern1: [22] Fail on using pattern in RETURN projection"
      issue: fix in 0.6.5
    query: |
      MATCH (n) RETURN (n)-[]->()
    expect:
      gql_status: "42"
      side_effects: {}

  # [23] Fail on using pattern in WITH projection
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s23_fail_on_using_pattern_in_with_projection
    xfail:
      spec: "openCypher TCK 2024.3 Pattern1: [23] Fail on using pattern in WITH projection"
      issue: fix in 0.6.5
    query: |
      MATCH (n) WITH (n)-[]->() AS x RETURN x
    expect:
      gql_status: "42"
      side_effects: {}

  # [24] Fail on using pattern in right-hand side of SET
  # TCK: SyntaxError at compile time: UnexpectedSyntax
  - name: s24_fail_on_using_pattern_in_right_hand_side_of_set
    xfail:
      spec: "openCypher TCK 2024.3 Pattern1: [24] Fail on using pattern in right-hand side of SET"
      issue: fix in 0.6.5
    query: |
      MATCH (n) SET n.prop = head(nodes(head((n)-[:REL]->()))).foo
    expect:
      gql_status: "42"
      side_effects: {}
