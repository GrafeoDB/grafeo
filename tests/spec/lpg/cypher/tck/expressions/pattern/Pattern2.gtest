# Converted from the openCypher TCK, tck/features/expressions/pattern/Pattern2.feature, by
# scripts/convert_opencypher_tck.py.
# Source: https://github.com/opencypher/openCypher at tag 2024.3 (677cbafabb8c3c5eed458fd3b1ec0daec8d67d23)

meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Pattern2"
  title: "Pattern2 - Pattern Comprehension"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Return a pattern comprehension
  - name: s1_return_a_pattern_comprehension
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [1] Return a pattern comprehension"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (a:A), (b:B)
        CREATE (a)-[:T]->(b),
               (b)-[:T]->(:C)
    query: |
      MATCH (n)
      RETURN [p = (n)-->() | p] AS list
    expect:
      values: |
        | list |
        | [<(:A)-[:T]->(:B)>] |
        | [<(:B)-[:T]->(:C)>] |
        | [] |
      side_effects: {}

  # [2] Return a pattern comprehension with label predicate
  - name: s2_return_a_pattern_comprehension_with_label_predicate
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [2] Return a pattern comprehension with label predicate"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (a:A), (b:B), (c:C), (d:D)
        CREATE (a)-[:T]->(b),
               (a)-[:T]->(c),
               (a)-[:T]->(d)
    query: |
      MATCH (n:A)
      RETURN [p = (n)-->(:B) | p] AS list
    expect:
      values: |
        | list |
        | [<(:A)-[:T]->(:B)>] |
      side_effects: {}

  # [3] Return a pattern comprehension with bound nodes
  - name: s3_return_a_pattern_comprehension_with_bound_nodes
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [3] Return a pattern comprehension with bound nodes"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (a:A), (b:B)
        CREATE (a)-[:T]->(b)
    query: |
      MATCH (a:A), (b:B)
      RETURN [p = (a)-->(b) | p] AS list
    expect:
      values: |
        | list |
        | [<(:A)-[:T]->(:B)>] |
      side_effects: {}

  # [4] Introduce a new node variable in pattern comprehension
  - name: s4_introduce_a_new_node_variable_in_pattern_comprehension
    setup:
      - |
        CREATE (a), (b {name: 'val'}), (c)
        CREATE (a)-[:T]->(b),
               (b)-[:T]->(c)
    query: |
      MATCH (n)
      RETURN [(n)-[:T]->(b) | b.name] AS list
    expect:
      values: |
        | list |
        | ['val'] |
        | [null] |
        | [] |
      side_effects: {}

  # [5] Introduce a new relationship variable in pattern comprehension
  - name: s5_introduce_a_new_relationship_variable_in_pattern_comprehension
    setup:
      - |
        CREATE (a), (b), (c)
        CREATE (a)-[:T {name: 'val'}]->(b),
               (b)-[:T]->(c)
    query: |
      MATCH (n)
      RETURN [(n)-[r:T]->() | r.name] AS list
    expect:
      values: |
        | list |
        | ['val'] |
        | [null] |
        | [] |
      side_effects: {}

  # [6] Aggregate on a pattern comprehension
  - name: s6_aggregate_on_a_pattern_comprehension
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [6] Aggregate on a pattern comprehension"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (a:A), (:A), (:A)
        CREATE (a)-[:HAS]->()
    query: |
      MATCH (n:A)
      RETURN count([p = (n)-[:HAS]->() | p]) AS c
    expect:
      values: |
        | c |
        | 3 |
      side_effects: {}

  # [7] Use a pattern comprehension inside a list comprehension
  - name: s7_use_a_pattern_comprehension_inside_a_list_comprehension
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [7] Use a pattern comprehension inside a list comprehension"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (n1:X {n: 1}), (m1:Y), (i1:Y), (i2:Y)
        CREATE (n1)-[:T]->(m1),
               (m1)-[:T]->(i1),
               (m1)-[:T]->(i2)
        CREATE (n2:X {n: 2}), (m2), (i3:L), (i4:Y)
        CREATE (n2)-[:T]->(m2),
               (m2)-[:T]->(i3),
               (m2)-[:T]->(i4)
    query: |
      MATCH p = (n:X)-->()
      RETURN n, [x IN nodes(p) | size([(x)-->(:Y) | 1])] AS list
    expect:
      values: |
        | n | list |
        | (:X {n: 1}) | [1, 2] |
        | (:X {n: 2}) | [0, 1] |
      side_effects: {}

  # [8] Use a pattern comprehension in WITH
  - name: s8_use_a_pattern_comprehension_in_with
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [8] Use a pattern comprehension in WITH"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (a:A), (b:B)
        CREATE (a)-[:T]->(b),
               (b)-[:T]->(:C)
    query: |
      MATCH (n)-->(b)
      WITH [p = (n)-->() | p] AS ps, count(b) AS c
      RETURN ps, c
    expect:
      values: |
        | ps | c |
        | [<(:A)-[:T]->(:B)>] | 1 |
        | [<(:B)-[:T]->(:C)>] | 1 |
      side_effects: {}

  # [9] Use a variable-length pattern comprehension in WITH
  - name: s9_use_a_variable_length_pattern_comprehension_in_with
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [9] Use a variable-length pattern comprehension in WITH"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (:A)-[:T]->(:B)
    query: |
      MATCH (a:A), (b:B)
      WITH [p = (a)-[*]->(b) | p] AS paths, count(a) AS c
      RETURN paths, c
    expect:
      values: |
        | paths | c |
        | [<(:A)-[:T]->(:B)>] | 1 |
      side_effects: {}

  # [10] Use a pattern comprehension in RETURN
  - name: s10_use_a_pattern_comprehension_in_return
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [10] Use a pattern comprehension in RETURN"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (a:A), (:A), (:A)
        CREATE (a)-[:HAS]->()
    query: |
      MATCH (n:A)
      RETURN [p = (n)-[:HAS]->() | p] AS ps
    expect:
      values: |
        | ps |
        | [<(:A)-[:HAS]->()>] |
        | [] |
        | [] |
      side_effects: {}

  # [11] Use a pattern comprehension and ORDER BY
  - name: s11_use_a_pattern_comprehension_and_order_by
    xfail:
      spec: "openCypher TCK 2024.3 Pattern2: [11] Use a pattern comprehension and ORDER BY"
      issue: fix in 0.6.5
    setup:
      - |
        CREATE (a {time: 10}), (b {time: 20})
        CREATE (a)-[:T]->(b)
    query: |
      MATCH (liker)
      RETURN [p = (liker)--() | p] AS isNew
        ORDER BY liker.time
    expect:
      ordered: true
      values: |
        | isNew |
        | [<({time: 10})-[:T]->({time: 20})>] |
        | [<({time: 20})<-[:T]-({time: 10})>] |
      side_effects: {}
