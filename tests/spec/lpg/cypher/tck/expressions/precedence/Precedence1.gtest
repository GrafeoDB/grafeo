  # [21] Comparison operators take precedence over binary boolean operators in every combination of truth values #5
  - name: s21_comparison_operators_take_precedence_over_binary_boolean_operators_in_every_combination_of_truth_values_5
    query: |
      UNWIND [true, false, null] AS a
      UNWIND [true, false, null] AS b
      UNWIND [true, false, null] AS c
      WITH collect((a AND b <= c) = (a AND (b <= c))) AS eq,
