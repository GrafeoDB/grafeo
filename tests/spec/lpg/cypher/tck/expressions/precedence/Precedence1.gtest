      values: |
        | result |
        | true |
      side_effects: {}

  # [21] Comparison operators take precedence over binary boolean operators in every combination of truth values #3
  - name: s21_comparison_operators_take_precedence_over_binary_boolean_operators_in_every_combination_of_truth_values_3
    query: |
      UNWIND [true, false, null] AS a
      UNWIND [true, false, null] AS b
