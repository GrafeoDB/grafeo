meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Precedence2"
  title: "Precedence2 - On numeric values"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #1
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_1
    query: |
      RETURN 4 * 2 + 3 * 2 AS a,
             4 * 2 + (3 * 2) AS b,
             4 * (2 + 3) * 2 AS c
    expect:
      values: |
        | a | b | c |
        | 14 | 14 | 40 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #2
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_2
    query: |
      RETURN 4 * 2 + 3 / 2 AS a,
             4 * 2 + (3 / 2) AS b,
             4 * (2 + 3) / 2 AS c
    expect:
      values: |
        | a | b | c |
        | 9 | 9 | 10 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #3
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_3
    query: |
      RETURN 4 * 2 + 3 % 2 AS a,
             4 * 2 + (3 % 2) AS b,
             4 * (2 + 3) % 2 AS c
    expect:
      values: |
        | a | b | c |
        | 9 | 9 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #4
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_4
    query: |
      RETURN 4 * 2 - 3 * 2 AS a,
             4 * 2 - (3 * 2) AS b,
             4 * (2 - 3) * 2 AS c
    expect:
      values: |
        | a | b | c |
        | 2 | 2 | -8 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #5
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_5
    query: |
      RETURN 4 * 2 - 3 / 2 AS a,
             4 * 2 - (3 / 2) AS b,
             4 * (2 - 3) / 2 AS c
    expect:
      values: |
        | a | b | c |
        | 7 | 7 | -2 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #6
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_6
    query: |
      RETURN 4 * 2 - 3 % 2 AS a,
             4 * 2 - (3 % 2) AS b,
             4 * (2 - 3) % 2 AS c
    expect:
      values: |
        | a | b | c |
        | 7 | 7 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #7
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_7
    query: |
      RETURN 4 / 2 + 3 * 2 AS a,
             4 / 2 + (3 * 2) AS b,
             4 / (2 + 3) * 2 AS c
    expect:
      values: |
        | a | b | c |
        | 8 | 8 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #8
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_8
    query: |
      RETURN 4 / 2 + 3 / 2 AS a,
             4 / 2 + (3 / 2) AS b,
             4 / (2 + 3) / 2 AS c
    expect:
      values: |
        | a | b | c |
        | 3 | 3 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #9
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_9
    query: |
      RETURN 4 / 2 + 3 % 2 AS a,
             4 / 2 + (3 % 2) AS b,
             4 / (2 + 3) % 2 AS c
    expect:
      values: |
        | a | b | c |
        | 3 | 3 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #10
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_10
    query: |
      RETURN 4 / 2 - 3 * 2 AS a,
             4 / 2 - (3 * 2) AS b,
             4 / (2 - 3) * 2 AS c
    expect:
      values: |
        | a | b | c |
        | -4 | -4 | -8 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #11
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_11
    query: |
      RETURN 4 / 2 - 3 / 2 AS a,
             4 / 2 - (3 / 2) AS b,
             4 / (2 - 3) / 2 AS c
    expect:
      values: |
        | a | b | c |
        | 1 | 1 | -2 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #12
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_12
    query: |
      RETURN 4 / 2 - 3 % 2 AS a,
             4 / 2 - (3 % 2) AS b,
             4 / (2 - 3) % 2 AS c
    expect:
      values: |
        | a | b | c |
        | 1 | 1 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #13
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_13
    query: |
      RETURN 4 % 2 + 3 * 2 AS a,
             4 % 2 + (3 * 2) AS b,
             4 % (2 + 3) * 2 AS c
    expect:
      values: |
        | a | b | c |
        | 6 | 6 | 8 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #14
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_14
    query: |
      RETURN 4 % 2 + 3 / 2 AS a,
             4 % 2 + (3 / 2) AS b,
             4 % (2 + 3) / 2 AS c
    expect:
      values: |
        | a | b | c |
        | 1 | 1 | 2 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #15
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_15
    query: |
      RETURN 4 % 2 + 3 % 2 AS a,
             4 % 2 + (3 % 2) AS b,
             4 % (2 + 3) % 2 AS c
    expect:
      values: |
        | a | b | c |
        | 1 | 1 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #16
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_16
    query: |
      RETURN 4 % 2 - 3 * 2 AS a,
             4 % 2 - (3 * 2) AS b,
             4 % (2 - 3) * 2 AS c
    expect:
      values: |
        | a | b | c |
        | -6 | -6 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #17
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_17
    query: |
      RETURN 4 % 2 - 3 / 2 AS a,
             4 % 2 - (3 / 2) AS b,
             4 % (2 - 3) / 2 AS c
    expect:
      values: |
        | a | b | c |
        | -1 | -1 | 0 |
      side_effects: {}

  # [1] Numeric multiplicative operations takes precedence over numeric additive operations #18
  - name: s1_numeric_multiplicative_operations_takes_precedence_over_numeric_additive_operations_18
    query: |
      RETURN 4 % 2 - 3 % 2 AS a,
             4 % 2 - (3 % 2) AS b,
             4 % (2 - 3) % 2 AS c
    expect:
      values: |
        | a | b | c |
        | -1 | -1 | 0 |
      side_effects: {}

  # [2] Exponentiation takes precedence over numeric multiplicative operations #1
  - name: s2_exponentiation_takes_precedence_over_numeric_multiplicative_operations_1
    query: |
      RETURN 4 ^ 3 * 2 ^ 3 AS a,
             (4 ^ 3) * (2 ^ 3) AS b,
             4 ^ (3 * 2) ^ 3 AS c
    expect:
      values: |
        | a | b | c |
        | 512.0 | 512.0 | 68719476736.0 |
      side_effects: {}

  # [2] Exponentiation takes precedence over numeric multiplicative operations #2
  - name: s2_exponentiation_takes_precedence_over_numeric_multiplicative_operations_2
    query: |
      RETURN 4 ^ 3 / 2 ^ 3 AS a,
             (4 ^ 3) / (2 ^ 3) AS b,
             4 ^ (3 / 2) ^ 3 AS c
    expect:
      values: |
        | a | b | c |
        | 8.0 | 8.0 | 64.0 |
      side_effects: {}

  # [2] Exponentiation takes precedence over numeric multiplicative operations #3
  - name: s2_exponentiation_takes_precedence_over_numeric_multiplicative_operations_3
    query: |
      RETURN 4 ^ 3 % 2 ^ 3 AS a,
             (4 ^ 3) % (2 ^ 3) AS b,
             4 ^ (3 % 2) ^ 3 AS c
    expect:
      values: |
        | a | b | c |
        | 0.0 | 0.0 | 64.0 |
      side_effects: {}

  # [3] Exponentiation takes precedence over numeric additive operations #1
  - name: s3_exponentiation_takes_precedence_over_numeric_additive_operations_1
    query: |
      RETURN 4 ^ 3 + 2 ^ 3 AS a,
             (4 ^ 3) + (2 ^ 3) AS b,
             4 ^ (3 + 2) ^ 3 AS c
    expect:
      values: |
        | a | b | c |
        | 72.0 | 72.0 | 1073741824.0 |
      side_effects: {}

  # [3] Exponentiation takes precedence over numeric additive operations #2
  - name: s3_exponentiation_takes_precedence_over_numeric_additive_operations_2
    query: |
      RETURN 4 ^ 3 - 2 ^ 3 AS a,
             (4 ^ 3) - (2 ^ 3) AS b,
             4 ^ (3 - 2) ^ 3 AS c
    expect:
      values: |
        | a | b | c |
        | 56.0 | 56.0 | 64.0 |
      side_effects: {}

  # [4] Numeric unary negative takes precedence over exponentiation
  - name: s4_numeric_unary_negative_takes_precedence_over_exponentiation
    query: |
      RETURN -3 ^ 2 AS a,
             (-3) ^ 2 AS b,
             -(3 ^ 2) AS c
    expect:
      values: |
        | a | b | c |
        | 9.0 | 9.0 | -9.0 |
      side_effects: {}

  # [5] Numeric unary negative takes precedence over numeric additive operations #1
  - name: s5_numeric_unary_negative_takes_precedence_over_numeric_additive_operations_1
    query: |
      RETURN -3 + 2 AS a,
             (-3) + 2 AS b,
             -(3 + 2) AS c
    expect:
      values: |
        | a | b | c |
        | -1 | -1 | -5 |
      side_effects: {}

  # [5] Numeric unary negative takes precedence over numeric additive operations #2
  - name: s5_numeric_unary_negative_takes_precedence_over_numeric_additive_operations_2
    query: |
      RETURN -3 - 2 AS a,
             (-3) - 2 AS b,
             -(3 - 2) AS c
    expect:
      values: |
        | a | b | c |
        | -5 | -5 | -1 |
      side_effects: {}
