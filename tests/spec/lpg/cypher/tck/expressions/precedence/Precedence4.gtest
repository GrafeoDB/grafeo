meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Precedence4"
  title: "Precedence4 - On null value"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Null predicate takes precedence over comparison operator #1
  - name: s1_null_predicate_takes_precedence_over_comparison_operator_1
    query: |
      RETURN null IS NOT NULL = null IS NULL AS a,
             (null IS NOT NULL) = (null IS NULL) AS b,
             (null IS NOT NULL = null) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | false | false | true |
      side_effects: {}

  # [1] Null predicate takes precedence over comparison operator #2
  - name: s1_null_predicate_takes_precedence_over_comparison_operator_2
    query: |
      RETURN null IS NULL <> null IS NULL AS a,
             (null IS NULL) <> (null IS NULL) AS b,
             (null IS NULL <> null) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | false | false | true |
      side_effects: {}

  # [1] Null predicate takes precedence over comparison operator #3
  - name: s1_null_predicate_takes_precedence_over_comparison_operator_3
    query: |
      RETURN null IS NULL <> null IS NOT NULL AS a,
             (null IS NULL) <> (null IS NOT NULL) AS b,
             (null IS NULL <> null) IS NOT NULL AS c
    expect:
      values: |
        | a | b | c |
        | true | true | false |
      side_effects: {}

  # [2] Null predicate takes precedence over boolean negation
  - name: s2_null_predicate_takes_precedence_over_boolean_negation
    query: |
      RETURN NOT null IS NULL AS a,
             NOT (null IS NULL) AS b,
             (NOT null) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | false | false | true |
      side_effects: {}

  # [3] Null predicate takes precedence over binary boolean operator #1
  - name: s3_null_predicate_takes_precedence_over_binary_boolean_operator_1
    query: |
      RETURN null AND null IS NULL AS a,
             null AND (null IS NULL) AS b,
             (null AND null) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | null | null | true |
      side_effects: {}

  # [3] Null predicate takes precedence over binary boolean operator #2
  - name: s3_null_predicate_takes_precedence_over_binary_boolean_operator_2
    query: |
      RETURN null AND true IS NULL AS a,
             null AND (true IS NULL) AS b,
             (null AND true) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | false | false | true |
      side_effects: {}

  # [3] Null predicate takes precedence over binary boolean operator #3
  - name: s3_null_predicate_takes_precedence_over_binary_boolean_operator_3
    query: |
      RETURN false AND false IS NOT NULL AS a,
             false AND (false IS NOT NULL) AS b,
             (false AND false) IS NOT NULL AS c
    expect:
      values: |
        | a | b | c |
        | false | false | true |
      side_effects: {}

  # [3] Null predicate takes precedence over binary boolean operator #4
  - name: s3_null_predicate_takes_precedence_over_binary_boolean_operator_4
    query: |
      RETURN null OR false IS NULL AS a,
             null OR (false IS NULL) AS b,
             (null OR false) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | null | null | true |
      side_effects: {}

  # [3] Null predicate takes precedence over binary boolean operator #5
  - name: s3_null_predicate_takes_precedence_over_binary_boolean_operator_5
    query: |
      RETURN true OR null IS NULL AS a,
             true OR (null IS NULL) AS b,
             (true OR null) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | true | true | false |
      side_effects: {}

  # [3] Null predicate takes precedence over binary boolean operator #6
  - name: s3_null_predicate_takes_precedence_over_binary_boolean_operator_6
    query: |
      RETURN true XOR null IS NOT NULL AS a,
             true XOR (null IS NOT NULL) AS b,
             (true XOR null) IS NOT NULL AS c
    expect:
      values: |
        | a | b | c |
        | true | true | false |
      side_effects: {}

  # [3] Null predicate takes precedence over binary boolean operator #7
  - name: s3_null_predicate_takes_precedence_over_binary_boolean_operator_7
    query: |
      RETURN true XOR false IS NULL AS a,
             true XOR (false IS NULL) AS b,
             (true XOR false) IS NULL AS c
    expect:
      values: |
        | a | b | c |
        | true | true | false |
      side_effects: {}

  # [4] String predicate takes precedence over binary boolean operator
  - name: s4_string_predicate_takes_precedence_over_binary_boolean_operator
    query: |
      RETURN ('abc' STARTS WITH null OR true) = (('abc' STARTS WITH null) OR true) AS a,
             ('abc' STARTS WITH null OR true) <> ('abc' STARTS WITH (null OR true)) AS b,
             (true OR null STARTS WITH 'abc') = (true OR (null STARTS WITH 'abc')) AS c,
             (true OR null STARTS WITH 'abc') <> ((true OR null) STARTS WITH 'abc') AS d
    expect:
      values: |
        | a | b | c | d |
        | true | null | true | null |
      side_effects: {}
