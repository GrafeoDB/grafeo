  # [3] All quantifier is always equal the none quantifier on the boolean negative of the predicate #5
  - name: s3_all_quantifier_is_always_equal_the_none_quantifier_on_the_boolean_negative_of_the_predicate_5
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS inputList
      UNWIND inputList AS x
      WITH inputList, x, [ y IN inputList WHERE rand() > 0.5 | y] AS list
      WITH inputList, CASE WHEN rand() < 0.5 THEN reverse(list) ELSE list END + x AS list
      UNWIND inputList AS x
      WITH inputList, x, [ y IN inputList WHERE rand() > 0.5 | y] AS list
      WITH inputList, CASE WHEN rand() < 0.5 THEN reverse(list) ELSE list END + x AS list
      UNWIND inputList AS x
      WITH inputList, x, [ y IN inputList WHERE rand() > 0.5 | y] AS list
      WITH inputList, CASE WHEN rand() < 0.5 THEN reverse(list) ELSE list END + x AS list
      WITH all(x IN list WHERE x >= 3) = none(x IN list WHERE NOT (x >= 3)) AS result, count(*) AS cnt
      RETURN result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] All quantifier is always equal the boolean negative of the any quantifier on the boolean negative of the predicate #1
  - name: s4_all_quantifier_is_always_equal_the_boolean_negative_of_the_any_quantifier_on_the_boolean_negative_of_the_predicate_1
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS inputList
      UNWIND inputList AS x
      WITH inputList, x, [ y IN inputList WHERE rand() > 0.5 | y] AS list
      WITH inputList, CASE WHEN rand() < 0.5 THEN reverse(list) ELSE list END + x AS list
      UNWIND inputList AS x
      WITH inputList, x, [ y IN inputList WHERE rand() > 0.5 | y] AS list
      WITH inputList, CASE WHEN rand() < 0.5 THEN reverse(list) ELSE list END + x AS list
      UNWIND inputList AS x
      WITH inputList, x, [ y IN inputList WHERE rand() > 0.5 | y] AS list
      WITH inputList, CASE WHEN rand() < 0.5 THEN reverse(list) ELSE list END + x AS list
      WITH all(x IN list WHERE x = 2) = (NOT any(x IN list WHERE NOT (x = 2))) AS result, count(*) AS cnt
      RETURN result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] All quantifier is always equal the boolean negative of the any quantifier on the boolean negative of the predicate #2
