  # [13] Single quantifier is false if the predicate is statically false and the list is not empty
  - name: s13_single_quantifier_is_false_if_the_predicate_is_statically_false_and_the_list_is_not_empty
    query: |
      RETURN single(x IN [1, null, true, 4.5, 'abc', false] WHERE false) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [14] Single quantifier is false if the predicate is statically true and the list has more than one element
  - name: s14_single_quantifier_is_false_if_the_predicate_is_statically_true_and_the_list_has_more_than_one_element
    query: |
      RETURN single(x IN [1, null, true, 4.5, 'abc', false] WHERE true) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [15] Single quantifier is true if the predicate is statically true and the list has exactly one non-null element
  - name: s15_single_quantifier_is_true_if_the_predicate_is_statically_true_and_the_list_has_exactly_one_non_null_element
    query: |
      RETURN single(x IN [1] WHERE true) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [16] Fail single quantifier on type mismatch between list elements and predicate #1
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s16_fail_single_quantifier_on_type_mismatch_between_list_elements_and_predicate_1
    xfail:
      spec: "openCypher TCK 2024.3 Quantifier2: [16] Fail single quantifier on type mismatch between list elements and predicate #1"
      issue: "fix in 0.6.5"
    query: |
      RETURN single(x IN ['Clara'] WHERE x % 2 = 0) AS result
    expect:
      gql_status: "42"
      side_effects: {}

  # [16] Fail single quantifier on type mismatch between list elements and predicate #2
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s16_fail_single_quantifier_on_type_mismatch_between_list_elements_and_predicate_2
