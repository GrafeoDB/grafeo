meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Quantifier2"
  title: "Quantifier2 - Single quantifier"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Single quantifier is always false on empty list
  - name: s1_single_quantifier_is_always_false_on_empty_list
    query: |
      RETURN single(x IN [] WHERE true) AS a, single(x IN [] WHERE false) AS b, single(x IN [] WHERE x) AS c
    expect:
      values: |
        | a | b | c |
        | false | false | false |
      side_effects: {}

  # [2] Single quantifier on list literal #1
  - name: s2_single_quantifier_on_list_literal_1
    query: |
      RETURN single(x IN [] WHERE x) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [2] Single quantifier on list literal #2
  - name: s2_single_quantifier_on_list_literal_2
    query: |
      RETURN single(x IN [true] WHERE x) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [2] Single quantifier on list literal #3
  - name: s2_single_quantifier_on_list_literal_3
    query: |
      RETURN single(x IN [false] WHERE x) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [2] Single quantifier on list literal #4
  - name: s2_single_quantifier_on_list_literal_4
    query: |
      RETURN single(x IN [true, false] WHERE x) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [2] Single quantifier on list literal #5
  - name: s2_single_quantifier_on_list_literal_5
    query: |
      RETURN single(x IN [false, true] WHERE x) AS result
