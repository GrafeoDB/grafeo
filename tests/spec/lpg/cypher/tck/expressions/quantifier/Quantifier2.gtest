      issue: "fix in 0.6.5"
    query: |
      RETURN single(x IN [false, true] WHERE x % 2 = 0) AS result
    expect:
      gql_status: "42"
      side_effects: {}

  # [16] Fail single quantifier on type mismatch between list elements and predicate #3
  # TCK: SyntaxError at compile time: InvalidArgumentType
  - name: s16_fail_single_quantifier_on_type_mismatch_between_list_elements_and_predicate_3
