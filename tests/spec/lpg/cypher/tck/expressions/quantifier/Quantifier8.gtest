meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Quantifier8"
  title: "Quantifier8 - All quantifier interop"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] All quantifier can nest itself and other quantifiers on nested lists #1
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_1
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE none(y IN x WHERE y = 'ghi')) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [1] All quantifier can nest itself and other quantifiers on nested lists #2
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_2
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE none(y IN x WHERE y = 'def')) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [1] All quantifier can nest itself and other quantifiers on nested lists #3
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_3
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE single(y IN x WHERE y = 'abc')) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [1] All quantifier can nest itself and other quantifiers on nested lists #4
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_4
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE single(y IN x WHERE y = 'ghi')) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [1] All quantifier can nest itself and other quantifiers on nested lists #5
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_5
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE any(y IN x WHERE y = 'abc')) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [1] All quantifier can nest itself and other quantifiers on nested lists #6
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_6
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE any(y IN x WHERE y = 'ghi')) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [1] All quantifier can nest itself and other quantifiers on nested lists #7
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_7
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE all(y IN x WHERE y <> 'ghi')) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [1] All quantifier can nest itself and other quantifiers on nested lists #8
  - name: s1_all_quantifier_can_nest_itself_and_other_quantifiers_on_nested_lists_8
    query: |
      RETURN all(x IN [['abc'], ['abc', 'def']] WHERE all(y IN x WHERE y = 'abc')) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #1
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_1
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE none(y IN list WHERE x = 10 * y)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #2
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_2
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE none(y IN list WHERE x = y)) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #3
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_3
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE single(y IN list WHERE x = y)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #4
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_4
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE single(y IN list WHERE x < y)) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #5
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_5
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE any(y IN list WHERE x % y = 0)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #6
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_6
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE any(y IN list WHERE x < y)) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #7
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_7
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE all(y IN list WHERE abs(x - y) < 10)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [2] All quantifier can nest itself and other quantifiers on the same list #8
  - name: s2_all_quantifier_can_nest_itself_and_other_quantifiers_on_the_same_list_8
    query: |
      WITH [1, 2, 3, 4, 5, 6, 7, 8, 9] AS list
      RETURN all(x IN list WHERE all(y IN list WHERE x < y + 7)) AS result
    expect:
      values: |
        | result |
        | false |
      side_effects: {}

  # [3] All quantifier is equal the none quantifier on the boolean negative of the predicate #1
  - name: s3_all_quantifier_is_equal_the_none_quantifier_on_the_boolean_negative_of_the_predicate_1
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x = 2) = none(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x = 2)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [3] All quantifier is equal the none quantifier on the boolean negative of the predicate #2
  - name: s3_all_quantifier_is_equal_the_none_quantifier_on_the_boolean_negative_of_the_predicate_2
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 2 = 0) = none(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x % 2 = 0)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [3] All quantifier is equal the none quantifier on the boolean negative of the predicate #3
  - name: s3_all_quantifier_is_equal_the_none_quantifier_on_the_boolean_negative_of_the_predicate_3
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 3 = 0) = none(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x % 3 = 0)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [3] All quantifier is equal the none quantifier on the boolean negative of the predicate #4
  - name: s3_all_quantifier_is_equal_the_none_quantifier_on_the_boolean_negative_of_the_predicate_4
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x < 7) = none(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x < 7)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [3] All quantifier is equal the none quantifier on the boolean negative of the predicate #5
  - name: s3_all_quantifier_is_equal_the_none_quantifier_on_the_boolean_negative_of_the_predicate_5
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x >= 3) = none(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x >= 3)) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] All quantifier is equal the boolean negative of the any quantifier on the boolean negative of the predicate #1
  - name: s4_all_quantifier_is_equal_the_boolean_negative_of_the_any_quantifier_on_the_boolean_negative_of_the_predicate_1
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x = 2) = (NOT any(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x = 2))) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] All quantifier is equal the boolean negative of the any quantifier on the boolean negative of the predicate #2
  - name: s4_all_quantifier_is_equal_the_boolean_negative_of_the_any_quantifier_on_the_boolean_negative_of_the_predicate_2
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 2 = 0) = (NOT any(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x % 2 = 0))) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] All quantifier is equal the boolean negative of the any quantifier on the boolean negative of the predicate #3
  - name: s4_all_quantifier_is_equal_the_boolean_negative_of_the_any_quantifier_on_the_boolean_negative_of_the_predicate_3
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 3 = 0) = (NOT any(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x % 3 = 0))) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] All quantifier is equal the boolean negative of the any quantifier on the boolean negative of the predicate #4
  - name: s4_all_quantifier_is_equal_the_boolean_negative_of_the_any_quantifier_on_the_boolean_negative_of_the_predicate_4
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x < 7) = (NOT any(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x < 7))) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [4] All quantifier is equal the boolean negative of the any quantifier on the boolean negative of the predicate #5
  - name: s4_all_quantifier_is_equal_the_boolean_negative_of_the_any_quantifier_on_the_boolean_negative_of_the_predicate_5
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x >= 3) = (NOT any(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE NOT (x >= 3))) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] All quantifier is equal whether the size of the list filtered with same the predicate is equal the size of the unfiltered list #1
  - name: s5_all_quantifier_is_equal_whether_the_size_of_the_list_filtered_with_same_the_predicate_is_equal_the_size_of_the_unfiltered_list_1
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x = 2) = (size([x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x = 2 | x]) = size([1, 2, 3, 4, 5, 6, 7, 8, 9])) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] All quantifier is equal whether the size of the list filtered with same the predicate is equal the size of the unfiltered list #2
  - name: s5_all_quantifier_is_equal_whether_the_size_of_the_list_filtered_with_same_the_predicate_is_equal_the_size_of_the_unfiltered_list_2
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 2 = 0) = (size([x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 2 = 0 | x]) = size([1, 2, 3, 4, 5, 6, 7, 8, 9])) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] All quantifier is equal whether the size of the list filtered with same the predicate is equal the size of the unfiltered list #3
  - name: s5_all_quantifier_is_equal_whether_the_size_of_the_list_filtered_with_same_the_predicate_is_equal_the_size_of_the_unfiltered_list_3
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 3 = 0) = (size([x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x % 3 = 0 | x]) = size([1, 2, 3, 4, 5, 6, 7, 8, 9])) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] All quantifier is equal whether the size of the list filtered with same the predicate is equal the size of the unfiltered list #4
  - name: s5_all_quantifier_is_equal_whether_the_size_of_the_list_filtered_with_same_the_predicate_is_equal_the_size_of_the_unfiltered_list_4
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x < 7) = (size([x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x < 7 | x]) = size([1, 2, 3, 4, 5, 6, 7, 8, 9])) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}

  # [5] All quantifier is equal whether the size of the list filtered with same the predicate is equal the size of the unfiltered list #5
  - name: s5_all_quantifier_is_equal_whether_the_size_of_the_list_filtered_with_same_the_predicate_is_equal_the_size_of_the_unfiltered_list_5
    query: |
      RETURN all(x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x >= 3) = (size([x IN [1, 2, 3, 4, 5, 6, 7, 8, 9] WHERE x >= 3 | x]) = size([1, 2, 3, 4, 5, 6, 7, 8, 9])) AS result
    expect:
      values: |
        | result |
        | true |
      side_effects: {}
