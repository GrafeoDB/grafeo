meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.String10"
  title: "String10 - Exact Substring Search"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Finding exact matches with non-proper substring
  - name: s1_finding_exact_matches_with_non_proper_substring
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel)
    query: |
      MATCH (a)
      WHERE a.name CONTAINS 'ABCDEF'
      RETURN a
    expect:
      values: |
        | a |
        | (:TheLabel {name: 'ABCDEF'}) |
      side_effects: {}

  # [2] Finding substring of string
  - name: s2_finding_substring_of_string
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel)
    query: |
      MATCH (a)
      WHERE a.name CONTAINS 'CD'
      RETURN a
    expect:
      values: |
        | a |
        | (:TheLabel {name: 'ABCDEF'}) |
      side_effects: {}

  # [3] Finding the empty substring
  - name: s3_finding_the_empty_substring
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel)
    query: |
      MATCH (a)
      WHERE a.name CONTAINS ''
      RETURN a
    expect:
      values: |
        | a |
        | (:TheLabel {name: 'ABCDEF'}) |
        | (:TheLabel {name: 'AB'}) |
        | (:TheLabel {name: 'abcdef'}) |
        | (:TheLabel {name: 'ab'}) |
        | (:TheLabel {name: ''}) |
      side_effects: {}

  # [4] Finding strings containing whitespace
  - name: s4_finding_strings_containing_whitespace
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel),
               (:TheLabel {name: 'Foo Foo'}),
               (:TheLabel {name: 'Foo\nFoo'}),
               (:TheLabel {name: 'Foo\tFoo'})
    query: |
      MATCH (a)
      WHERE a.name CONTAINS ' '
      RETURN a.name AS name
    expect:
      values: |
        | name |
        | 'Foo Foo' |
      side_effects: {}

  # [5] Finding strings containing newline
  - name: s5_finding_strings_containing_newline
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel),
               (:TheLabel {name: 'Foo Foo'}),
               (:TheLabel {name: 'Foo\nFoo'}),
               (:TheLabel {name: 'Foo\tFoo'})
    query: |
      MATCH (a)
      WHERE a.name CONTAINS '\n'
      RETURN a.name AS name
    expect:
      values: |
        | name |
        | 'Foo\nFoo' |
      side_effects: {}

  # [6] No string contains null
  - name: s6_no_string_contains_null
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel)
    query: |
      MATCH (a)
      WHERE a.name CONTAINS null
      RETURN a
    expect:
      values: |
        | a |
      side_effects: {}

  # [7] No string does not contain null
  - name: s7_no_string_does_not_contain_null
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel)
    query: |
      MATCH (a)
      WHERE NOT a.name CONTAINS null
      RETURN a
    expect:
      values: |
        | a |
      side_effects: {}

  # [8] Handling non-string operands for CONTAINS
  - name: s8_handling_non_string_operands_for_contains
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel)
    query: |
      WITH [1, 3.14, true, [], {}, null] AS operands
      UNWIND operands AS op1
      UNWIND operands AS op2
      WITH op1 CONTAINS op2 AS v
      RETURN v, count(*)
    expect:
      values: |
        | v | count(*) |
        | null | 36 |
      side_effects: {}

  # [9] NOT with CONTAINS
  - name: s9_not_with_contains
    setup:
      - |
        CREATE (:TheLabel {name: 'ABCDEF'}), (:TheLabel {name: 'AB'}),
               (:TheLabel {name: 'abcdef'}), (:TheLabel {name: 'ab'}),
               (:TheLabel {name: ''}), (:TheLabel)
    query: |
      MATCH (a)
      WHERE NOT a.name CONTAINS 'b'
      RETURN a
    expect:
      values: |
        | a |
        | (:TheLabel {name: 'ABCDEF'}) |
        | (:TheLabel {name: 'AB'}) |
        | (:TheLabel {name: ''}) |
      side_effects: {}
