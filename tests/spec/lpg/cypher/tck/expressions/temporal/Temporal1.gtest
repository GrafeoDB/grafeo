meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal1"
  title: "Temporal1 - Create Temporal Values from a Map"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should construct week date #1
  - name: s1_should_construct_week_date_1
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      RETURN date({year: 1816, week: 1}) AS d
    expect:
      values: |
        | d |
        | '1816-01-01' |
      side_effects: {}

  # [1] Should construct week date #2
  - name: s1_should_construct_week_date_2
    xfail:
      spec: "openCypher TCK 2024.3 Temporal1: [1] Should construct week date #2"
