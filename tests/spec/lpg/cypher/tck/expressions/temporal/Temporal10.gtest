meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal10"
  title: "Temporal10 - Compute Durations Between two Temporal Values"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should split between boundaries correctly #1
  - name: s1_should_split_between_boundaries_correctly_1
    xfail:
      spec: "openCypher TCK 2024.3 Temporal10: [1] Should split between boundaries correctly #1"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      WITH duration.between(localdatetime('2018-01-01T12:00'), localdatetime('2018-01-02T10:00')) AS dur
      RETURN dur, dur.days, dur.seconds, dur.nanosecondsOfSecond
    expect:
      values: |
        | dur | dur.days | dur.seconds | dur.nanosecondsOfSecond |
        | 'PT22H' | 0 | 79200 | 0 |
      side_effects: {}

