meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal2"
  title: "Temporal2 - Create Temporal Values from a String"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should parse date from string #1
  - name: s1_should_parse_date_from_string_1
    runner_gap:
      runners: [wasm]
      issue: fix in 0.7.0
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      RETURN date('2015-07-21') AS result
    expect:
      values: |
        | result |
        | '2015-07-21' |
      side_effects: {}

  # [1] Should parse date from string #2
  - name: s1_should_parse_date_from_string_2
    xfail:
      spec: "openCypher TCK 2024.3 Temporal2: [1] Should parse date from string #2"
