meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal3"
  title: "Temporal3 - Project Temporal Values from other Temporal Values"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should select date #1
  - name: s1_should_select_date_1
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH date({year: 1984, month: 11, day: 11}) AS other
      RETURN date(other) AS result
    expect:
      values: |
        | result |
        | '1984-11-11' |
      side_effects: {}

  # [1] Should select date #2
  - name: s1_should_select_date_2
    xfail:
      spec: "openCypher TCK 2024.3 Temporal3: [1] Should select date #2"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH date({year: 1984, month: 11, day: 11}) AS other
      RETURN date({date: other}) AS result
    expect:
      values: |
        | result |
        | '1984-11-11' |
      side_effects: {}

  # [1] Should select date #3
