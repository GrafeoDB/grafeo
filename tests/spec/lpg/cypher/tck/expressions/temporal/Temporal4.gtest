meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal4"
  title: "Temporal4 - Store Temporal Values"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should store date #1
  - name: s1_should_store_date_1
    runner_gap:
      runners: [wasm]
      issue: fix in 0.7.0
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      CREATE ({created: date({year: 1984, month: 10, day: 11})})
    expect:
      empty: true
      side_effects:
        +nodes: 1
        +properties: 1

  # [1] Should store date #1 (control query)
  - name: s1_should_store_date_1_control
    runner_gap:
      runners: [wasm]
      issue: fix in 0.7.0
      reason: "temporals come back from this binding as text, which passed back is a string"
    setup:
      - |
        CREATE ({created: date({year: 1984, month: 10, day: 11})})
    query: |
      MATCH (n)
      RETURN n.created
    expect:
      values: |
        | n.created |
        | '1984-10-11' |

  # [2] Should store date array #1
  - name: s2_should_store_date_array_1
