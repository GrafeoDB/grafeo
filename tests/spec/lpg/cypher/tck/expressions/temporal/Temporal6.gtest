meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal6"
  title: "Temporal6 - Render Temporal Values as a String"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should serialize date
  - name: s1_should_serialize_date
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH date({year: 1984, month: 10, day: 11}) AS d
      RETURN toString(d) AS ts, date(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | '1984-10-11' | true |
      side_effects: {}

  # [2] Should serialize local time
  - name: s2_should_serialize_local_time
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH localtime({hour: 12, minute: 31, second: 14, nanosecond: 645876123}) AS d
      RETURN toString(d) AS ts, localtime(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | '12:31:14.645876123' | true |
      side_effects: {}

  # [3] Should serialize time
  - name: s3_should_serialize_time
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH time({hour: 12, minute: 31, second: 14, nanosecond: 645876123, timezone: '+01:00'}) AS d
      RETURN toString(d) AS ts, time(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | '12:31:14.645876123+01:00' | true |
      side_effects: {}

  # [4] Should serialize local date time
  - name: s4_should_serialize_local_date_time
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [4] Should serialize local date time"
      issue: "#801"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH localdatetime({year: 1984, month: 10, day: 11, hour: 12, minute: 31, second: 14, nanosecond: 645876123}) AS d
      RETURN toString(d) AS ts, localdatetime(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | '1984-10-11T12:31:14.645876123' | true |
      side_effects: {}

  # [5] Should serialize date time
  - name: s5_should_serialize_date_time
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [5] Should serialize date time"
      issue: "#801"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH datetime({year: 1984, month: 10, day: 11, hour: 12, minute: 31, second: 14, nanosecond: 645876123, timezone: '+01:00'}) AS d
      RETURN toString(d) AS ts, datetime(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | '1984-10-11T12:31:14.645876123+01:00' | true |
      side_effects: {}

  # [6] Should serialize duration #1
  - name: s6_should_serialize_duration_1
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({years: 12, months: 5, days: 14, hours: 16, minutes: 12, seconds: 70, nanoseconds: 1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'P12Y5M14DT16H13M10.000000001S' | true |
      side_effects: {}

  # [6] Should serialize duration #2
  - name: s6_should_serialize_duration_2
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({years: 12, months: 5, days: -14, hours: 16}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'P12Y5M-14DT16H' | true |
      side_effects: {}

  # [6] Should serialize duration #3
  - name: s6_should_serialize_duration_3
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({minutes: 12, seconds: -60}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'PT11M' | true |
      side_effects: {}

  # [6] Should serialize duration #4
  - name: s6_should_serialize_duration_4
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #4"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({seconds: 2, milliseconds: -1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'PT1.999S' | true |
      side_effects: {}

  # [6] Should serialize duration #5
  - name: s6_should_serialize_duration_5
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #5"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({seconds: -2, milliseconds: 1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'PT-1.999S' | true |
      side_effects: {}

  # [6] Should serialize duration #6
  - name: s6_should_serialize_duration_6
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #6"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({seconds: -2, milliseconds: -1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'PT-2.001S' | true |
      side_effects: {}

  # [6] Should serialize duration #7
  - name: s6_should_serialize_duration_7
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #7"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({days: 1, milliseconds: 1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'P1DT0.001S' | true |
      side_effects: {}

  # [6] Should serialize duration #8
  - name: s6_should_serialize_duration_8
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #8"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({days: 1, milliseconds: -1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'P1DT-0.001S' | true |
      side_effects: {}

  # [6] Should serialize duration #9
  - name: s6_should_serialize_duration_9
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #9"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({seconds: 60, milliseconds: -1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'PT59.999S' | true |
      side_effects: {}

  # [6] Should serialize duration #10
  - name: s6_should_serialize_duration_10
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #10"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({seconds: -60, milliseconds: 1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'PT-59.999S' | true |
      side_effects: {}

  # [6] Should serialize duration #11
  - name: s6_should_serialize_duration_11
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [6] Should serialize duration #11"
      issue: "#805"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({seconds: -60, milliseconds: -1}) AS d
      RETURN toString(d) AS ts, duration(toString(d)) = d AS b
    expect:
      values: |
        | ts | b |
        | 'PT-1M-0.001S' | true |
      side_effects: {}

  # [7] Should serialize timezones correctly
  - name: s7_should_serialize_timezones_correctly
    xfail:
      spec: "openCypher TCK 2024.3 Temporal6: [7] Should serialize timezones correctly"
      issue: "#801"
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH datetime({year: 2017, month: 8, day: 8, hour: 12, minute: 31, second: 14, nanosecond: 645876123, timezone: 'Europe/Stockholm'}) AS d
      RETURN toString(d) AS ts
    expect:
      values: |
        | ts |
        | '2017-08-08T12:31:14.645876123+02:00[Europe/Stockholm]' |
      side_effects: {}
