  # [6] Should compare durations for equality #1
  - name: s6_should_compare_durations_for_equality_1
    runner_gap:
      runners: [wasm]
      issue: fix in 0.7.0
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH duration({years: 12, months: 5, days: 14, hours: 16, minutes: 12, seconds: 70}) AS x, date({year: 1984, month: 10, day: 11}) AS d
      RETURN x = d
    expect:
      values: |
        | x = d |
        | false |
      side_effects: {}

