meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal7"
  title: "Temporal7 - Compare Temporal Values"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should compare dates #1
  - name: s1_should_compare_dates_1
    runner_gap:
      runners: [wasm]
      issue: fix in 0.7.0
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH date({year: 1980, month: 12, day: 24}) AS x, date({year: 1984, month: 10, day: 11}) AS d
      RETURN x > d, x < d, x >= d, x <= d, x = d
    expect:
      values: |
        | x > d | x < d | x >= d | x <= d | x = d |
        | false | true | false | true | false |
      side_effects: {}

  # [1] Should compare dates #2
  - name: s1_should_compare_dates_2
    runner_gap:
      runners: [wasm]
      issue: fix in 0.7.0
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH date({year: 1984, month: 10, day: 11}) AS x, date({year: 1984, month: 10, day: 11}) AS d
      RETURN x > d, x < d, x >= d, x <= d, x = d
    expect:
      values: |
        | x > d | x < d | x >= d | x <= d | x = d |
        | false | false | true | true | true |
      side_effects: {}

  # [2] Should compare local times #1
  - name: s2_should_compare_local_times_1
    runner_gap:
      runners: [wasm]
      issue: fix in 0.7.0
      reason: "temporals come back from this binding as text, which passed back is a string"
    query: |
      WITH localtime({hour: 10, minute: 35}) AS x, localtime({hour: 12, minute: 31, second: 14, nanosecond: 645876123}) AS d
      RETURN x > d, x < d, x >= d, x <= d, x = d
    expect:
      values: |
        | x > d | x < d | x >= d | x <= d | x = d |
        | false | true | false | true | false |
      side_effects: {}

