meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal8"
  title: "Temporal8 - Compute Arithmetic Operations on Temporal Values"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should add or subtract duration to or from date #1
  - name: s1_should_add_or_subtract_duration_to_or_from_date_1
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    setup:
      - |
        CREATE (:Duration {dur: duration({years: 12, months: 5, days: 14, hours: 16, minutes: 12, seconds: 70, nanoseconds: 2})})
    query: |
      WITH date({year: 1984, month: 10, day: 11}) AS x
      MATCH (d:Duration)
      RETURN x + d.dur AS sum, x - d.dur AS diff
    expect:
      values: |
        | sum | diff |
        | '1997-03-25' | '1972-04-27' |
      side_effects: {}

  # [1] Should add or subtract duration to or from date #2
  - name: s1_should_add_or_subtract_duration_to_or_from_date_2
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    setup:
      - |
        CREATE (:Duration {dur: duration({months: 1, days: -14, hours: 16, minutes: -12, seconds: 70})})
    query: |
      WITH date({year: 1984, month: 10, day: 11}) AS x
      MATCH (d:Duration)
      RETURN x + d.dur AS sum, x - d.dur AS diff
    expect:
      values: |
        | sum | diff |
        | '1984-10-28' | '1984-09-25' |
      side_effects: {}

