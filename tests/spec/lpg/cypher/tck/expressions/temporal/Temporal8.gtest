        CREATE (:Duration2 {date: duration({years: 12.5, months: 5.5, days: 14.5, hours: 16.5, minutes: 12.5, seconds: 70.5, nanoseconds: 3})})
    query: |
      MATCH (dur:Duration1), (dur2: Duration2)
      RETURN dur.date + dur2.date AS sum, dur.date - dur2.date AS diff
    expect:
      values: |
        | sum | diff |
        | 'P25Y10M58DT67H56M27.000000006S' | 'PT0S' |
      side_effects: {}

  # [7] Should multiply or divide durations by numbers #1
  - name: s7_should_multiply_or_divide_durations_by_numbers_1
    runner_gap:
      runners: [wasm]
      issue: "fix in 0.7.0"
      reason: "temporals come back from this binding as text, which passed back is a string"
    setup:
      - |
        CREATE (:Duration {date: duration({years: 12, months: 5, days: 14, hours: 16, minutes: 12, seconds: 70, nanoseconds: 1})})
    query: |
      MATCH (d:Duration)
      RETURN d.date * 1 AS prod, d.date / 1 AS div
    expect:
      values: |
        | prod | div |
        | 'P12Y5M14DT16H13M10.000000001S' | 'P12Y5M14DT16H13M10.000000001S' |
      side_effects: {}

