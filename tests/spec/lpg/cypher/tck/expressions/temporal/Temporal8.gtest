    setup:
      - |
        CREATE (:Duration {dur: duration({years: 12, months: 5, days: 14, hours: 16, minutes: 12, seconds: 70, nanoseconds: 2})})
    query: |
      WITH localtime({hour: 12, minute: 31, second: 14, nanosecond: 1}) AS x
      MATCH (d:Duration)
      RETURN x + d.dur AS sum, x - d.dur AS diff
    expect:
      values: |
        | sum | diff |
        | '04:44:24.000000003' | '20:18:03.999999999' |
      side_effects: {}

