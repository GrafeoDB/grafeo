meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.Temporal9"
  title: "Temporal9 - Truncate Temporal Values"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Should truncate date #1
  - name: s1_should_truncate_date_1
    xfail:
      spec: "openCypher TCK 2024.3 Temporal9: [1] Should truncate date #1"
      issue: fix in 0.6.5
    runner_gap:
      runners: [python, node, wasm, go, csharp, dart]
      issue: fix in 0.6.4
      reason: "temporals do not come back from this binding without loss"
    query: |
      RETURN date.truncate('millennium', date({year: 2017, month: 10, day: 11}), {day: 2}) AS result
    expect:
      values: |
        | result |
        | '2000-01-02' |
      side_effects: {}

