meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.TypeConversion1"
  title: "TypeConversion1 - To Boolean"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] `toBoolean()` on booleans
  - name: s1_toboolean_on_booleans
    query: |
      UNWIND [true, false] AS b
      RETURN toBoolean(b) AS b
    expect:
      values: |
        | b |
        | true |
        | false |
      side_effects: {}

  # [2] `toBoolean()` on valid literal string
  - name: s2_toboolean_on_valid_literal_string
    query: |
      RETURN toBoolean('true') AS b
    expect:
      values: |
        | b |
        | true |
      side_effects: {}

  # [3] `toBoolean()` on variables with valid string values
  - name: s3_toboolean_on_variables_with_valid_string_values
    query: |
      UNWIND ['true', 'false'] AS s
      RETURN toBoolean(s) AS b
    expect:
      values: |
        | b |
        | true |
        | false |
      side_effects: {}

  # [4] `toBoolean()` on invalid strings
  - name: s4_toboolean_on_invalid_strings
    query: |
      UNWIND [null, '', ' tru ', 'f alse'] AS things
      RETURN toBoolean(things) AS b
    expect:
      values: |
        | b |
        | null |
        | null |
        | null |
        | null |
      side_effects: {}

  # [5] Fail `toBoolean()` on invalid types #Example: list #1
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s5_fail_toboolean_on_invalid_types_example_list_1
    xfail:
      spec: "openCypher TCK 2024.3 TypeConversion1: [5] Fail `toBoolean()` on invalid types #Example: list #1"
      issue: fix in 0.7.0
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [true, []] | toBoolean(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [5] Fail `toBoolean()` on invalid types #Example: map #2
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s5_fail_toboolean_on_invalid_types_example_map_2
    xfail:
      spec: "openCypher TCK 2024.3 TypeConversion1: [5] Fail `toBoolean()` on invalid types #Example: map #2"
      issue: fix in 0.7.0
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [true, {}] | toBoolean(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [5] Fail `toBoolean()` on invalid types #Example: float #3
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s5_fail_toboolean_on_invalid_types_example_float_3
    xfail:
      spec: "openCypher TCK 2024.3 TypeConversion1: [5] Fail `toBoolean()` on invalid types #Example: float #3"
      issue: fix in 0.7.0
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [true, 1.0] | toBoolean(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [5] Fail `toBoolean()` on invalid types #Example: node #4
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s5_fail_toboolean_on_invalid_types_example_node_4
    xfail:
      spec: "openCypher TCK 2024.3 TypeConversion1: [5] Fail `toBoolean()` on invalid types #Example: node #4"
      issue: fix in 0.7.0
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [true, n] | toBoolean(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [5] Fail `toBoolean()` on invalid types #Example: relationship #5
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s5_fail_toboolean_on_invalid_types_example_relationship_5
    xfail:
      spec: "openCypher TCK 2024.3 TypeConversion1: [5] Fail `toBoolean()` on invalid types #Example: relationship #5"
      issue: fix in 0.7.0
    setup:
      - |
        CREATE ()-[:T]->()
    query: |
      MATCH p = (n)-[r:T]->()
      RETURN [x IN [true, r] | toBoolean(x) ] AS list
    expect:
      gql_status: "22"
      side_effects: {}

  # [5] Fail `toBoolean()` on invalid types #Example: path #6
  # TCK: TypeError at runtime: InvalidArgumentValue
  - name: s5_fail_toboolean_on_invalid_types_example_path_6
    xfail:
      spec: "openCypher TCK 2024.3 TypeConversion1: [5] Fail `toBoolean()` on invalid types #Example: path #6"
      issue: fix in 0.7.0
    setup:
      - |
        CREATE ()-[:T]->()
