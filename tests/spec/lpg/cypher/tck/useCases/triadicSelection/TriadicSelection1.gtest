meta:
  language: cypher
  model: lpg
  section: "opencypher-tck.TriadicSelection1"
  title: "TriadicSelection1 - Query three related nodes on binary-tree graphs"
  dataset: empty
  requires: [cypher]
  values_dialect: tck

tests:

  # [1] Handling triadic friend of a friend
  - name: s1_handling_triadic_friend_of_a_friend
    setup:
      - |
        CREATE (a:A {name: 'a'}),
               (b1:X {name: 'b1'}),
               (b2:X {name: 'b2'}),
               (b3:X {name: 'b3'}),
               (b4:X {name: 'b4'}),
               (c11:X {name: 'c11'}),
               (c12:X {name: 'c12'}),
               (c21:X {name: 'c21'}),
               (c22:X {name: 'c22'}),
               (c31:X {name: 'c31'}),
               (c32:X {name: 'c32'}),
               (c41:X {name: 'c41'}),
               (c42:X {name: 'c42'})
        CREATE (a)-[:KNOWS]->(b1),
               (a)-[:KNOWS]->(b2),
               (a)-[:FOLLOWS]->(b3),
               (a)-[:FOLLOWS]->(b4)
        CREATE (b1)-[:FRIEND]->(c11),
               (b1)-[:FRIEND]->(c12),
               (b2)-[:FRIEND]->(c21),
               (b2)-[:FRIEND]->(c22),
               (b3)-[:FRIEND]->(c31),
               (b3)-[:FRIEND]->(c32),
               (b4)-[:FRIEND]->(c41),
               (b4)-[:FRIEND]->(c42)
        CREATE (b1)-[:FRIEND]->(b2),
               (b2)-[:FRIEND]->(b3),
               (b3)-[:FRIEND]->(b4),
               (b4)-[:FRIEND]->(b1);
    query: |
      MATCH (a:A)-[:KNOWS]->(b)-->(c)
      RETURN c.name
    expect:
      values: |
        | c.name |
        | 'b2' |
        | 'b3' |
        | 'c11' |
        | 'c12' |
        | 'c21' |
        | 'c22' |
      side_effects: {}

  # [2] Handling triadic friend of a friend that is not a friend
  - name: s2_handling_triadic_friend_of_a_friend_that_is_not_a_friend
    setup:
      - |
        CREATE (a:A {name: 'a'}),
               (b1:X {name: 'b1'}),
               (b2:X {name: 'b2'}),
               (b3:X {name: 'b3'}),
               (b4:X {name: 'b4'}),
               (c11:X {name: 'c11'}),
               (c12:X {name: 'c12'}),
               (c21:X {name: 'c21'}),
               (c22:X {name: 'c22'}),
               (c31:X {name: 'c31'}),
               (c32:X {name: 'c32'}),
               (c41:X {name: 'c41'}),
               (c42:X {name: 'c42'})
        CREATE (a)-[:KNOWS]->(b1),
               (a)-[:KNOWS]->(b2),
               (a)-[:FOLLOWS]->(b3),
               (a)-[:FOLLOWS]->(b4)
        CREATE (b1)-[:FRIEND]->(c11),
               (b1)-[:FRIEND]->(c12),
               (b2)-[:FRIEND]->(c21),
               (b2)-[:FRIEND]->(c22),
               (b3)-[:FRIEND]->(c31),
               (b3)-[:FRIEND]->(c32),
               (b4)-[:FRIEND]->(c41),
               (b4)-[:FRIEND]->(c42)
        CREATE (b1)-[:FRIEND]->(b2),
               (b2)-[:FRIEND]->(b3),
               (b3)-[:FRIEND]->(b4),
               (b4)-[:FRIEND]->(b1);
    query: |
      MATCH (a:A)-[:KNOWS]->(b)-->(c)
      OPTIONAL MATCH (a)-[r:KNOWS]->(c)
      WITH c WHERE r IS NULL
      RETURN c.name
    expect:
      values: |
        | c.name |
        | 'b3' |
        | 'c11' |
        | 'c12' |
        | 'c21' |
        | 'c22' |
      side_effects: {}

