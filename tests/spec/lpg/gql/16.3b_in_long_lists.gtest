# x IN <a constant list> answers as a walk over it, at every length. A long list is searched as a
# set, so these hold the kinds `=` finds equal, NULL and NaN to what a short list gives. Answers are
# the released walk's. Generated with the Rust tests in in_list_set.rs.

meta:
  language: gql
  model: lpg
  section: "19.7"
  title: IN over long lists
  dataset: empty

tests:

  - name: int_float_2_first
    query: "RETURN 1 IN [1.0, 1000001] AS found"
    expect:
      rows:
        - [true]

  - name: int_float_15_first
    query: "RETURN 1 IN [1.0, 1000001, 1000002, 1000003, 1000004, 1000005, 1000006, 1000007, 1000008, 1000009, 1000010, 1000011, 1000012, 1000013, 1000014] AS found"
    expect:
      rows:
        - [true]

  - name: int_float_15_last
    query: "RETURN 1 IN [1000000, 1000001, 1000002, 1000003, 1000004, 1000005, 1000006, 1000007, 1000008, 1000009, 1000010, 1000011, 1000012, 1000013, 1.0] AS found"
    expect:
      rows:
        - [true]

  - name: int_float_16_first
