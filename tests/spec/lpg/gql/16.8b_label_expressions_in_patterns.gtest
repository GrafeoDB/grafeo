    query: "MATCH (x:A:B) WHERE x.name <> 'Amsterdam' RETURN x.name"
    expect:
      rows:
        - [Vincent]

  - name: a_node_alone_1_is_a
    query: "MATCH (x IS A) WHERE x.name <> 'Amsterdam' RETURN x.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: a_node_alone_1_is_a_on_label
    setup:
      - "CREATE INDEX on_a FOR (n:A) ON (n.k)"
    query: "MATCH (x IS A) WHERE x.name <> 'Amsterdam' RETURN x.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: a_node_alone_1_is_a_on_hub
    setup:
