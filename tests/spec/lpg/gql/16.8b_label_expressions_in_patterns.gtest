# GQL label expressions in every position of a pattern: ISO/IEC 39075:2024 sec 16.8.
#
# Generated from one table with the Rust tests in label_expressions_in_paths.rs. A label
# expression holds wherever a node pattern is written: it was kept on a lone node and on later
# nodes, and dropped on the first node of a path. Key-wide indexes cannot be made from a query,
# so the Rust tests cover those.

meta:
  language: gql
  model: lpg
  section: "16.8"
  title: Label expressions in patterns
  dataset: label_mix
  iso: [G074]

tests:

  # A node alone

  - name: a_node_alone_1_colon_a
    query: "MATCH (x:A) WHERE x.name <> 'Amsterdam' RETURN x.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: a_node_alone_1_colon_a_on_label
    setup:
      - "CREATE INDEX on_a FOR (n:A) ON (n.k)"
    query: "MATCH (x:A) WHERE x.name <> 'Amsterdam' RETURN x.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: a_node_alone_1_colon_a_on_hub
    setup:
      - "CREATE INDEX on_hub FOR (n:T) ON (n.tk)"
    query: "MATCH (x:A) WHERE x.name <> 'Amsterdam' RETURN x.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: a_node_alone_1_colon_a_colon_b
    query: "MATCH (x:A:B) WHERE x.name <> 'Amsterdam' RETURN x.name"
    expect:
      rows:
        - [Vincent]

  - name: a_node_alone_1_colon_a_colon_b_on_label
