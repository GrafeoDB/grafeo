        - [Jules]
        - [Mia]

  - name: later_node_2_any_label
    query: "MATCH (y {name: 'Alix'})-[:R]->(t:T)-[:S]->(x:%) RETURN x.name"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Jules]
        - [Vincent]

  - name: later_node_2_paren_a
    query: "MATCH (y {name: 'Alix'})-[:R]->(t:T)-[:S]->(x:(A)) RETURN x.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: later_node_2_nobody
    query: "MATCH (y {name: 'Alix'})-[:R]->(t:T)-[:S]->(x:Z&A) RETURN x.name"
    expect:
      empty: true
