# What follows a match with a label expression changes only the nodes it holds for.
#
# Generated from one table with the Rust tests in label_expressions_in_paths.rs. Each case reads
# back every node. A DELETE that fails cannot read back here; the Rust test checks nothing moved.

meta:
  language: gql
  model: lpg
  section: "16.8"
  title: Label expressions and the statements after a match
  dataset: label_mix
  iso: [G074]

tests:

  # SET a property

  - name: set_a_property_colon_a
    statements:
      - "MATCH (x:A)-[:R]->(t:T) SET x.hit = true"
      - "MATCH (x) RETURN x.name, x.k, x.hit, size(labels(x)), COUNT { MATCH (x)-[:R]->() } AS out"
    expect:
      rows:
        - [Alix, 1, true, 1, 1]
        - [Amsterdam, null, null, 1, 0]
        - [Gus, 1, null, 1, 1]
        - [Jules, 1, null, 1, 1]
        - [Mia, 1, null, 0, 1]
        - [Vincent, 1, true, 2, 1]

  - name: set_a_property_colon_a_on_label
    setup:
      - "CREATE INDEX on_a FOR (n:A) ON (n.k)"
    statements:
      - "MATCH (x:A)-[:R]->(t:T) SET x.hit = true"
      - "MATCH (x) RETURN x.name, x.k, x.hit, size(labels(x)), COUNT { MATCH (x)-[:R]->() } AS out"
