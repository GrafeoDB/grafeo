# GQL Path Patterns: ISO/IEC 39075:2024 sec 17.1
#
# Covers: variable-length paths (*min..max, *exact, unbounded *),
# multi-label matching, WHERE label predicates, undirected edges,
# edge property filters, path length function, wildcard edges.

meta:
  language: gql
  model: lpg
  section: "17.1"
  title: Path patterns
  dataset: empty
  iso: [G035, G036, G037, G038, G060, G061, G044]

tests:

  # ---------------------------------------------------------------------------
  # Variable-length paths
  # ---------------------------------------------------------------------------

  - name: variable_length_1_to_3
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node {name: 'C'})"
      - "INSERT (:Node {name: 'D'})"
      - "INSERT (:Node:Special {name: 'E'})"
      - "MATCH (a:Node {name: 'A'}), (b:Node {name: 'B'}) INSERT (a)-[:LINK]->(b)"
      - "MATCH (b:Node {name: 'B'}), (c:Node {name: 'C'}) INSERT (b)-[:LINK]->(c)"
      - "MATCH (c:Node {name: 'C'}), (d:Node {name: 'D'}) INSERT (c)-[:LINK]->(d)"
      - "MATCH (d:Node {name: 'D'}), (e:Node {name: 'E'}) INSERT (d)-[:LINK]->(e)"
      - "MATCH (a:Node {name: 'A'}), (c:Node {name: 'C'}) INSERT (a)-[:SHORTCUT]->(c)"
    query: "MATCH (a:Node {name: 'A'})-[:LINK *1..3]->(b:Node) RETURN b.name AS name ORDER BY name"
    expect:
      ordered: true
      rows:
        - [B]
        - [C]
        - [D]

  - name: variable_length_exact_2
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node {name: 'C'})"
      - "MATCH (a:Node {name: 'A'}), (b:Node {name: 'B'}) INSERT (a)-[:LINK]->(b)"
      - "MATCH (b:Node {name: 'B'}), (c:Node {name: 'C'}) INSERT (b)-[:LINK]->(c)"
    query: "MATCH (a:Node {name: 'A'})-[:LINK *2..2]->(b:Node) RETURN b.name AS name"
    expect:
      rows:
        - [C]

  - name: variable_length_unbounded
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node {name: 'C'})"
      - "INSERT (:Node {name: 'D'})"
      - "INSERT (:Node {name: 'E'})"
      - "MATCH (a:Node {name: 'A'}), (b:Node {name: 'B'}) INSERT (a)-[:LINK]->(b)"
      - "MATCH (b:Node {name: 'B'}), (c:Node {name: 'C'}) INSERT (b)-[:LINK]->(c)"
      - "MATCH (c:Node {name: 'C'}), (d:Node {name: 'D'}) INSERT (c)-[:LINK]->(d)"
      - "MATCH (d:Node {name: 'D'}), (e:Node {name: 'E'}) INSERT (d)-[:LINK]->(e)"
    query: "MATCH (a:Node {name: 'A'})-[:LINK*]->(b:Node) RETURN b.name AS name ORDER BY name"
    expect:
      ordered: true
      rows:
        - [B]
        - [C]
        - [D]
        - [E]

  # ---------------------------------------------------------------------------
  # Multi-label matching
  # ---------------------------------------------------------------------------

  - name: multi_label_and_semantics
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node:Special {name: 'C'})"
    query: MATCH (n:Node:Special) RETURN n.name AS name
    expect:
      rows:
        - [C]

  - name: multi_label_no_match_missing_label
    setup:
      - "INSERT (:Node:Special {name: 'A'})"
    query: MATCH (n:Special:Nonexistent) RETURN n.name AS name
    expect:
      empty: true

  # ---------------------------------------------------------------------------
  # WHERE label predicates
  # ---------------------------------------------------------------------------

  - name: where_label_predicate
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node:Special {name: 'C'})"
    query: MATCH (n) WHERE n:Special RETURN n.name AS name
    expect:
      rows:
        - [C]

  - name: where_label_predicate_multi
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node:Special {name: 'B'})"
    query: MATCH (n) WHERE n:Node:Special RETURN n.name AS name
    expect:
      rows:
        - [B]

  - name: where_label_predicate_with_and
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
    query: "MATCH (n) WHERE n:Node AND n.name = 'A' RETURN n.name AS name"
    expect:
      rows:
        - [A]

  # ---------------------------------------------------------------------------
  # Undirected edges
  # ---------------------------------------------------------------------------

  - name: undirected_edge_match
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node {name: 'C'})"
      - "MATCH (a:Node {name: 'A'}), (b:Node {name: 'B'}) INSERT (a)-[:LINK]->(b)"
      - "MATCH (c:Node {name: 'C'}), (b:Node {name: 'B'}) INSERT (c)-[:LINK]->(b)"
    query: "MATCH (a:Node {name: 'B'})-[:LINK]-(b:Node) RETURN b.name AS name ORDER BY name"
    expect:
      ordered: true
      rows:
        - [A]
        - [C]

  # ---------------------------------------------------------------------------
  # Edge property filters in WHERE
  # ---------------------------------------------------------------------------

  - name: edge_property_filter_where
    setup:
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Gus'})"
      - "INSERT (:Person {name: 'Vincent'})"
      - "MATCH (a:Person {name: 'Alix'}), (b:Person {name: 'Gus'}) INSERT (a)-[:RATED {stars: 5}]->(b)"
      - "MATCH (a:Person {name: 'Alix'}), (v:Person {name: 'Vincent'}) INSERT (a)-[:RATED {stars: 2}]->(v)"
    query: "MATCH (a:Person)-[r:RATED]->(b:Person) WHERE r.stars >= 4 RETURN b.name AS name"
    expect:
      rows:
        - [Gus]

  # ---------------------------------------------------------------------------
  # Path length
  # ---------------------------------------------------------------------------

  - name: path_length_four_hops
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node {name: 'C'})"
      - "INSERT (:Node {name: 'D'})"
      - "INSERT (:Node {name: 'E'})"
      - "MATCH (a:Node {name: 'A'}), (b:Node {name: 'B'}) INSERT (a)-[:LINK]->(b)"
      - "MATCH (b:Node {name: 'B'}), (c:Node {name: 'C'}) INSERT (b)-[:LINK]->(c)"
      - "MATCH (c:Node {name: 'C'}), (d:Node {name: 'D'}) INSERT (c)-[:LINK]->(d)"
      - "MATCH (d:Node {name: 'D'}), (e:Node {name: 'E'}) INSERT (d)-[:LINK]->(e)"
    query: "MATCH p = (a:Node {name: 'A'})-[:LINK *1..4]->(b:Node {name: 'E'}) RETURN length(p) AS len"
    expect:
      rows:
        - [4]

  # ---------------------------------------------------------------------------
  # Wildcard edge type
  # ---------------------------------------------------------------------------

  - name: wildcard_edge_any_type
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node {name: 'C'})"
      - "MATCH (a:Node {name: 'A'}), (b:Node {name: 'B'}) INSERT (a)-[:LINK]->(b)"
      - "MATCH (a:Node {name: 'A'}), (c:Node {name: 'C'}) INSERT (a)-[:SHORTCUT]->(c)"
    query: "MATCH (a:Node {name: 'A'})-[]->(b:Node) RETURN b.name AS name ORDER BY name"
    expect:
      ordered: true
      rows:
        - [B]
        - [C]

  # ---------------------------------------------------------------------------
  # Path with intermediate filter
  # ---------------------------------------------------------------------------

  - name: path_with_intermediate_filter
    setup:
      - "INSERT (:Node {name: 'A'})"
      - "INSERT (:Node {name: 'B'})"
      - "INSERT (:Node {name: 'C'})"
      - "INSERT (:Node {name: 'X'})"
      - "MATCH (a:Node {name: 'A'}), (b:Node {name: 'B'}) INSERT (a)-[:LINK]->(b)"
      - "MATCH (b:Node {name: 'B'}), (c:Node {name: 'C'}) INSERT (b)-[:LINK]->(c)"
      - "MATCH (a:Node {name: 'A'}), (x:Node {name: 'X'}) INSERT (a)-[:LINK]->(x)"
      - "MATCH (x:Node {name: 'X'}), (c:Node {name: 'C'}) INSERT (x)-[:LINK]->(c)"
    query: "MATCH (a:Node {name: 'A'})-[:LINK]->(mid:Node)-[:LINK]->(c:Node) WHERE mid.name = 'B' RETURN c.name AS name"
    expect:
      rows:
        - [C]

  # ---------------------------------------------------------------------------
  # The element pattern WHERE of a quantified edge pattern holds for each
  # edge (16.7 <path pattern expression>: inside the quantified pattern the
  # edge variable is one edge; only outside it is it the group list of the
  # edges). Setup: Alix -> Gus -> Vincent -> Mia (w 3, 19, 88, kind 'road')
  # and the shortcut Alix -> Vincent (w 38, kind 'air').
  # ---------------------------------------------------------------------------

  - name: quantified_edge_where_holds_for_each_edge
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    query: "MATCH (a:Person)-[e:KNOWS WHERE e.w > 10]->{1,3}(b) RETURN a.name AS a, b.name AS b, [x IN e | x.w] AS ws"
    expect:
      rows:
        - [Alix, Mia, "[38, 88]"]
        - [Alix, Vincent, "[38]"]
        - [Gus, Mia, "[19, 88]"]
        - [Gus, Vincent, "[19]"]
        - [Vincent, Mia, "[88]"]

  - name: quantified_edge_where_reads_an_earlier_variable
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    query: "UNWIND [19, 50] AS lim MATCH (a:Person {name: 'Alix'})-[e:KNOWS WHERE e.w > lim OR e.w = 3]->{1,3}(b) RETURN lim, b.name AS b, [x IN e | x.w] AS ws"
    expect:
      rows:
        - [19, Gus, "[3]"]
        - [19, Mia, "[38, 88]"]
        - [19, Vincent, "[38]"]
        - [50, Gus, "[3]"]

  - name: quantified_edge_where_keeps_the_empty_path
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    query: "MATCH (a:Person {name: 'Alix'})-[e:KNOWS WHERE e.w > 10]->{0,2}(b) RETURN b.name AS b, size(e) AS hops"
    expect:
      rows:
        - [Alix, 0]
        - [Mia, 2]
        - [Vincent, 1]

  # ---------------------------------------------------------------------------
  # Horizontal aggregation (20.9 <aggregate function>): an aggregate over a
  # property of a group variable is computed per path. Same setup.
  # ---------------------------------------------------------------------------

  - name: horizontal_sum_is_per_path
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    query: "MATCH (a:Person {name: 'Alix'})-[e:KNOWS]->{1,3}(b) RETURN b.name AS name, sum(e.w) AS total, max(e.w) AS high"
    expect:
      columns: [name, total, high]
      rows:
        - [Gus, 3, 3]
        - [Mia, 110, 88]
        - [Mia, 126, 88]
        - [Vincent, 22, 19]
        - [Vincent, 38, 38]

  - name: horizontal_sum_without_alias_returns_only_its_column
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    query: "MATCH (a:Person {name: 'Alix'})-[e:KNOWS]->{1,3}(b) RETURN sum(e.w)"
    expect:
      columns: ["sum(e.w)"]
      rows:
        - [3]
        - [22]
        - [38]
        - [110]
        - [126]

  - name: horizontal_aggregate_beside_a_regular_aggregate
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    query: "MATCH (a:Person {name: 'Alix'})-[e:KNOWS]->{1,3}(b) RETURN sum(e.w) > 50 AS long, count(*) AS paths"
    expect:
      rows:
        - [false, 3]
        - [true, 2]

  - name: horizontal_aggregate_in_with
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    query: "MATCH (a:Person {name: 'Alix'})-[e:KNOWS]->{1,3}(b) WITH b, sum(e.w) AS total WHERE total > 50 RETURN b.name AS name, total ORDER BY total"
    expect:
      ordered: true
      rows:
        - [Mia, 110]
        - [Mia, 126]
