# GQL Schema DDL: ISO/IEC 39075:2024 sec 20.1
#
# Covers: CREATE/DROP NODE TYPE, EDGE TYPE, GRAPH TYPE, SCHEMA,
# ALTER types, NOT NULL constraints, CREATE OR REPLACE, full lifecycle.

meta:
  language: gql
  model: lpg
  section: "20.1"
  title: Schema DDL
  dataset: empty
  iso: [GC01, GC02, GC03, GG01, GG02, GG03, GG20, GG21, GG22]

tests:

  # ---------------------------------------------------------------------------
  # CREATE / DROP NODE TYPE
  # ---------------------------------------------------------------------------

  - name: create_node_type_and_insert
    statements:
      - "CREATE NODE TYPE Vehicle (make STRING NOT NULL, year INTEGER)"
      - "INSERT (:Vehicle {make: 'Volvo', year: 2024})"
      - "MATCH (v:Vehicle) RETURN v.make, v.year"
    expect:
      rows:
        - [Volvo, 2024]

  - name: drop_node_type
    statements:
      - "CREATE NODE TYPE Ephemeral (name STRING)"
      - "DROP NODE TYPE Ephemeral"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  - name: create_node_type_duplicate_fails
    statements:
      - "CREATE NODE TYPE Gadget (name STRING)"
      - "CREATE NODE TYPE Gadget (name STRING)"
    expect:
      error: Gadget

  - name: create_or_replace_node_type
    statements:
      - "CREATE NODE TYPE Widget (name STRING)"
      - "CREATE OR REPLACE NODE TYPE Widget (name STRING, color STRING)"
      - "INSERT (:Widget {name: 'cog', color: 'red'})"
      - "MATCH (w:Widget) RETURN w.name, w.color"
    expect:
      rows:
        - [cog, red]

  - name: drop_nonexistent_node_type_fails
    statements:
      - "DROP NODE TYPE Nonexistent"
    expect:
      error: not found

  # ---------------------------------------------------------------------------
  # CREATE / DROP EDGE TYPE
  # ---------------------------------------------------------------------------

  - name: create_edge_type_and_drop
    statements:
      - "CREATE EDGE TYPE SUPPLIES (quantity INTEGER)"
      - "DROP EDGE TYPE SUPPLIES"
      - "MATCH ()-[r:SUPPLIES]->() RETURN count(r) AS cnt"
    expect:
      rows:
        - [0]

  - name: create_or_replace_edge_type
    statements:
      - "CREATE EDGE TYPE RATES (stars INTEGER)"
      - "CREATE OR REPLACE EDGE TYPE RATES (stars INTEGER, comment STRING)"
      - "MATCH ()-[r:RATES]->() RETURN count(r) AS cnt"
    expect:
      rows:
        - [0]

  # ---------------------------------------------------------------------------
  # ALTER NODE TYPE: ADD / DROP PROPERTY
  # ---------------------------------------------------------------------------

  - name: alter_node_type_add_and_drop_property
    statements:
      - "CREATE NODE TYPE Sensor (id INTEGER NOT NULL)"
      - "ALTER NODE TYPE Sensor ADD PROPERTY location STRING"
      - "ALTER NODE TYPE Sensor DROP PROPERTY location"
      - "INSERT (:Sensor {id: 1})"
      - "MATCH (s:Sensor) RETURN s.id"
    expect:
      rows:
        - [1]

  # `ADD PROPERTY name TYPE` adds `name` with that type (the PROPERTY keyword
  # used to be read as the property name and the type silently dropped).
  - name: alter_node_type_add_property_enforces_its_type
    setup:
      - "CREATE NODE TYPE Sensor (id INTEGER NOT NULL)"
      - "ALTER NODE TYPE Sensor ADD PROPERTY location STRING"
    query: "INSERT (:Sensor {id: 1, location: 5})"
    expect:
      error: "property 'location' on :Sensor expects String"

  - name: alter_node_type_add_property_shows_in_schema
    setup:
      - "CREATE NODE TYPE Sensor (id INTEGER NOT NULL)"
      - "ALTER NODE TYPE Sensor ADD PROPERTY location STRING"
    query: "SHOW NODE TYPES"
    expect:
      rows:
        - [Sensor, "id INT64 NOT NULL, location STRING", "", ""]

  # ---------------------------------------------------------------------------
  # ALTER EDGE TYPE: ADD / DROP PROPERTY
  # ---------------------------------------------------------------------------

  - name: alter_edge_type_add_and_drop_property
    statements:
      - "CREATE EDGE TYPE MONITORS (interval INTEGER)"
      - "ALTER EDGE TYPE MONITORS ADD PROPERTY threshold FLOAT"
      - "ALTER EDGE TYPE MONITORS DROP PROPERTY threshold"
      - "MATCH ()-[r:MONITORS]->() RETURN count(r) AS cnt"
    expect:
      rows:
        - [0]

  # ---------------------------------------------------------------------------
  # CREATE / DROP GRAPH TYPE
  # ---------------------------------------------------------------------------

  - name: create_graph_type_and_drop
    statements:
      - "CREATE GRAPH TYPE temp_type (NODE TYPE Temp (v INTEGER))"
      - "DROP GRAPH TYPE temp_type"
      - "CREATE GRAPH TYPE temp_type (NODE TYPE Temp2 (v INTEGER))"
      - "DROP GRAPH TYPE temp_type"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  - name: alter_graph_type_add_drop_members
    statements:
      - "CREATE NODE TYPE Device (serial STRING)"
      - "CREATE EDGE TYPE CONNECTS"
      - "CREATE GRAPH TYPE iot_network (NODE TYPE Device)"
      - "ALTER GRAPH TYPE iot_network ADD EDGE TYPE CONNECTS"
      - "ALTER GRAPH TYPE iot_network DROP EDGE TYPE CONNECTS"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  # Issue #316: bare `NODE TYPE X` / `EDGE TYPE X` inside CREATE GRAPH TYPE
  # is a reference to an existing catalog entry, not an inline redeclaration.
  # NOT NULL and other constraints on the referenced types must survive.
  - name: create_graph_type_bare_references_preserve_catalog
    statements:
      - "CREATE NODE TYPE Person (name STRING NOT NULL, age INTEGER)"
      - "CREATE EDGE TYPE KNOWS (since INTEGER)"
      - "CREATE GRAPH TYPE social (NODE TYPE Person, EDGE TYPE KNOWS)"
      - "INSERT (:Person {age: 30})"
    expect:
      error: name

  # Issue #316: bare reference to an undefined node type must error at
  # CREATE GRAPH TYPE time, not silently register an empty type.
  - name: create_graph_type_bare_reference_to_missing_type_errors
    statements:
      - "CREATE GRAPH TYPE ghost_schema (NODE TYPE DoesNotExist)"
    expect:
      error: DoesNotExist

  # ---------------------------------------------------------------------------
  # CREATE / DROP SCHEMA
  # ---------------------------------------------------------------------------

  - name: create_and_drop_schema
    statements:
      - "CREATE SCHEMA analytics"
      - "DROP SCHEMA analytics"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  - name: create_duplicate_schema_fails
    statements:
      - "CREATE SCHEMA reporting"
      - "CREATE SCHEMA reporting"
    expect:
      error: reporting

  # ---------------------------------------------------------------------------
  # NOT NULL constraints
  # ---------------------------------------------------------------------------

  - name: not_null_constraint_allows_valid_insert
    statements:
      - "CREATE NODE TYPE Invoice (number INTEGER NOT NULL, total FLOAT NOT NULL)"
      - "INSERT (:Invoice {number: 42, total: 99.95})"
      - "MATCH (i:Invoice) RETURN i.number, i.total"
    expect:
      rows:
        - [42, 99.95]

  - name: not_null_constraint_rejects_missing_property
    statements:
      - "CREATE NODE TYPE Account (owner STRING NOT NULL, balance INTEGER)"
      - "INSERT (:Account {balance: 500})"
    expect:
      error: owner

  # ---------------------------------------------------------------------------
  # Full lifecycle: type -> graph type -> bind
  # ---------------------------------------------------------------------------

  # ---------------------------------------------------------------------------
  # CREATE / DROP / SHOW CONSTRAINT: constraints are stored by name (#420)
  # ---------------------------------------------------------------------------

  # The examples of the GQL schema guide (docs/user-guide/gql/schema.md), which
  # showed the Cypher `REQUIRE ... IS UNIQUE` form (#344).
  - name: schema_guide_constraint_examples
    statements:
      - "CREATE CONSTRAINT FOR (p:Person) ON (p.email) UNIQUE"
      - "CREATE CONSTRAINT FOR (p:Person) ON (p.firstName, p.lastName) NODE KEY"
      - "CREATE CONSTRAINT FOR (p:Person) ON (p.name) NOT NULL"
      - "CREATE CONSTRAINT FOR (p:Person) ON (p.email) EXISTS"
      - "SHOW CONSTRAINTS"
    expect:
      rows:
        - [Person_email_exists, EXISTS, Person, email]
        - [Person_email_unique, UNIQUE, Person, email]
        - [Person_firstName_lastName_node_key, NODE KEY, Person, "firstName, lastName"]
        - [Person_name_not_null, NOT NULL, Person, name]

  # Default names join the properties with `_`, so a property named `a_b` and
  # the pair `(a, b)` would share one; the second gets a suffix.
  - name: unnamed_constraints_with_colliding_default_names
    statements:
      - "CREATE CONSTRAINT FOR (n:Item) ON (n.a_b) UNIQUE"
      - "CREATE CONSTRAINT FOR (n:Item) ON (n.a, n.b) UNIQUE"
      - "SHOW CONSTRAINTS"
    expect:
      rows:
        - [Item_a_b_unique, UNIQUE, Item, a_b]
        - [Item_a_b_unique_2, UNIQUE, Item, "a, b"]

  - name: unnamed_duplicate_constraint_fails
    setup:
      - "CREATE CONSTRAINT FOR (n:Item) ON (n.code) UNIQUE"
    query: "CREATE CONSTRAINT FOR (n:Item) ON (n.code) UNIQUE"
    expect:
      error: "constraint 'Item_code_unique' already exists"

  - name: unnamed_duplicate_constraint_if_not_exists_does_nothing
    statements:
      - "CREATE CONSTRAINT FOR (n:Item) ON (n.code) UNIQUE"
      - "CREATE CONSTRAINT IF NOT EXISTS FOR (n:Item) ON (n.code) UNIQUE"
      - "SHOW CONSTRAINTS"
    expect:
      rows:
        - [Item_code_unique, UNIQUE, Item, code]

  # A constraint on several properties is unique on the combination: nodes may
  # share any one of the values. It used to reject them per property.
  - name: composite_unique_constraint_allows_a_shared_value
    statements:
      - "CREATE CONSTRAINT person_place FOR (n:Person) ON (n.name, n.city) UNIQUE"
      - "INSERT (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "INSERT (:Person {name: 'Alix', city: 'Berlin'})"
      - "INSERT (:Person {name: 'Gus', city: 'Amsterdam'})"
      - "MATCH (n:Person) RETURN count(n)"
    expect:
      rows:
        - [3]

  - name: composite_unique_constraint_rejects_a_duplicate_combination
    setup:
      - "CREATE CONSTRAINT person_place FOR (n:Person) ON (n.name, n.city) UNIQUE"
      - "INSERT (:Person {name: 'Alix', city: 'Amsterdam'})"
    query: "INSERT (:Person {name: 'Alix', city: 'Amsterdam'})"
    expect:
      error: "constraint"

  - name: composite_unique_constraint_checks_set
    setup:
      - "CREATE CONSTRAINT person_place FOR (n:Person) ON (n.name, n.city) UNIQUE"
      - "INSERT (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "INSERT (:Person {name: 'Alix', city: 'Berlin'})"
    query: "MATCH (n:Person {city: 'Berlin'}) SET n.city = 'Amsterdam'"
    expect:
      error: "constraint"

  - name: composite_node_key_allows_a_shared_value
    statements:
      - "CREATE CONSTRAINT person_key FOR (n:Person) ON (n.name, n.city) NODE KEY"
      - "INSERT (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "INSERT (:Person {name: 'Alix', city: 'Berlin'})"
      - "MATCH (n:Person) RETURN count(n)"
    expect:
      rows:
        - [2]

  # SET and REMOVE are checked against the node's constraints; they were not
  # (the node's labels never reached the check).
  - name: set_null_violates_a_not_null_constraint
    setup:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) NOT NULL"
      - "INSERT (:Person {name: 'Alix'})"
    query: "MATCH (n:Person) SET n.name = NULL"
    expect:
      error: "constraint"

  - name: remove_violates_a_not_null_constraint
    setup:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) NOT NULL"
      - "INSERT (:Person {name: 'Alix'})"
    query: "MATCH (n:Person) REMOVE n.name"
    expect:
      error: "constraint"

  - name: set_violates_a_unique_constraint
    setup:
      - "CREATE CONSTRAINT person_email FOR (n:Person) ON (n.email) UNIQUE"
      - "INSERT (:Person {name: 'Alix', email: 'alix@example.org'})"
      - "INSERT (:Person {name: 'Gus', email: 'gus@example.org'})"
    query: "MATCH (n:Person {name: 'Gus'}) SET n.email = 'alix@example.org'"
    expect:
      error: "constraint"

  - name: set_keeps_a_node_own_unique_value
    statements:
      - "CREATE CONSTRAINT person_email FOR (n:Person) ON (n.email) UNIQUE"
      - "INSERT (:Person {name: 'Alix', email: 'alix@example.org'})"
      - "MATCH (n:Person) SET n.email = 'alix@example.org', n.name = 'Alix B'"
      - "MATCH (n:Person) RETURN n.name, n.email"
    expect:
      rows:
        - [Alix B, alix@example.org]

  # SET n:Label checks the node against the constraints of the label it gets,
  # like INSERT with that label would.
  - name: label_add_violates_a_not_null_constraint
    setup:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) NOT NULL"
      - "INSERT (:Guest {email: 'alix@example.org'})"
    query: "MATCH (n:Guest) SET n:Person"
    expect:
      error: "constraint"

  - name: label_add_violates_a_unique_constraint
    setup:
      - "CREATE CONSTRAINT person_email FOR (n:Person) ON (n.email) UNIQUE"
      - "INSERT (:Person {name: 'Alix', email: 'alix@example.org'})"
      - "INSERT (:Guest {name: 'Gus', email: 'alix@example.org'})"
    query: "MATCH (n:Guest) SET n:Person"
    expect:
      error: "constraint"

  - name: label_add_violates_a_composite_node_key
    setup:
      - "CREATE CONSTRAINT person_key FOR (n:Person) ON (n.name, n.city) NODE KEY"
      - "INSERT (:Person {name: 'Alix', city: 'Amsterdam'})"
      - "INSERT (:Guest {name: 'Alix', city: 'Amsterdam'})"
    query: "MATCH (n:Guest) SET n:Person"
    expect:
      error: "constraint"

  - name: label_add_checks_the_node_type
    setup:
      - "CREATE NODE TYPE Sensor (id INTEGER NOT NULL)"
      - "INSERT (:Device {id: 's-1'})"
    query: "MATCH (n:Device) SET n:Sensor"
    expect:
      error: "property 'id' on :Sensor expects"

  # UNIQUE holds within one statement: a value the same transaction wrote
  # earlier counts as taken.
  - name: unique_holds_within_one_statement
    setup:
      - "CREATE CONSTRAINT doc_id FOR (n:Doc) ON (n.id) UNIQUE"
    query: "UNWIND ['a', 'a'] AS x INSERT (:Doc {id: x})"
    expect:
      error: "constraint"

  - name: composite_unique_holds_within_one_statement
    setup:
      - "CREATE CONSTRAINT doc_key FOR (n:Doc) ON (n.id, n.lang) UNIQUE"
    query: "UNWIND ['en', 'en'] AS l INSERT (:Doc {id: 'a', lang: l})"
    expect:
      error: "constraint"

  # SET on an edge never checked the edge type's property types.
  - name: set_on_an_edge_checks_the_edge_type
    setup:
      - "CREATE EDGE TYPE RATES (stars INTEGER)"
      - "INSERT (:Person {name: 'Alix'})-[:RATES {stars: 5}]->(:Movie {title: 'Jackie Brown'})"
    query: "MATCH ()-[r:RATES]->() SET r.stars = 'five'"
    expect:
      error: "property 'stars' on :RATES expects"

  - name: label_add_within_the_constraints_succeeds
    statements:
      - "CREATE CONSTRAINT person_email FOR (n:Person) ON (n.email) UNIQUE"
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) NOT NULL"
      - "INSERT (:Person {name: 'Alix', email: 'alix@example.org'})"
      - "INSERT (:Guest {name: 'Gus', email: 'gus@example.org'})"
      - "MATCH (n:Guest) SET n:Person"
      - "MATCH (n:Person) RETURN n.name ORDER BY n.name"
    expect:
      rows:
        - [Alix]
        - [Gus]

  - name: drop_constraint_removes_it
    statements:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) UNIQUE"
      - "DROP CONSTRAINT person_name"
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Alix'})"
      - "MATCH (n:Person) RETURN count(n)"
    expect:
      rows:
        - [2]

  - name: dropping_one_constraint_keeps_the_others
    setup:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) UNIQUE"
      - "CREATE CONSTRAINT person_name_required FOR (n:Person) ON (n.name) NOT NULL"
      - "DROP CONSTRAINT person_name"
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Alix'})"
    query: "INSERT (:Person {age: 30})"
    expect:
      error: "constraint"

  - name: drop_unknown_constraint_fails
    query: "DROP CONSTRAINT no_such_name"
    expect:
      error: "constraint 'no_such_name' does not exist"

  - name: drop_unknown_constraint_if_exists_succeeds
    query: "DROP CONSTRAINT IF EXISTS no_such_name"
    expect:
      count: 0

  - name: create_constraint_with_a_used_name_fails
    setup:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) UNIQUE"
    query: "CREATE CONSTRAINT person_name FOR (n:City) ON (n.name) UNIQUE"
    expect:
      error: "constraint 'person_name' already exists"

  - name: create_constraint_if_not_exists_keeps_the_first
    statements:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) UNIQUE"
      - "CREATE CONSTRAINT IF NOT EXISTS person_name FOR (n:City) ON (n.name) UNIQUE"
      - "SHOW CONSTRAINTS"
    expect:
      rows:
        - [person_name, UNIQUE, Person, name]

  - name: show_constraints_lists_them
    statements:
      - "CREATE CONSTRAINT person_name FOR (n:Person) ON (n.name) UNIQUE"
      - "CREATE CONSTRAINT FOR (n:City) ON (n.name) NOT NULL"
      - "SHOW CONSTRAINTS"
    expect:
      rows:
        - [City_name_not_null, NOT NULL, City, name]
        - [person_name, UNIQUE, Person, name]

  - name: full_schema_lifecycle
    statements:
      - "CREATE NODE TYPE Employee (name STRING NOT NULL)"
      - "CREATE EDGE TYPE REPORTS_TO"
      - "CREATE GRAPH TYPE org_chart (NODE TYPE Employee, EDGE TYPE REPORTS_TO)"
      - "CREATE GRAPH hr_graph TYPED org_chart"
      # The graph first: ISO/IEC 39075:2024 12.7 Syntax Rule 6 keeps a graph
      # type that a graph has as its type.
      - "DROP GRAPH hr_graph"
      - "DROP GRAPH TYPE org_chart"
      - "DROP NODE TYPE Employee"
      - "DROP EDGE TYPE REPORTS_TO"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  # ---------------------------------------------------------------------------
  # Brace-form graph types (ISO <nested graph type specification>), MAP
  # properties, edge type defaults
  # ---------------------------------------------------------------------------

  - name: brace_form_graph_type_declares_property_types
    setup:
      - "CREATE GRAPH TYPE routes { (:City {name STRING NOT NULL, population INT64})-[:ROUTE {km INT64}]->(:City) }"
    query: "INSERT (:City {name: 'Paris', population: 'many'})"
    expect:
      error: population

  - name: brace_form_graph_type_declares_not_null
    setup:
      - "CREATE GRAPH TYPE routes { (:City {name STRING NOT NULL, population INT64})-[:ROUTE {km INT64}]->(:City) }"
    query: "INSERT (:City {population: 3})"
    expect:
      error: "missing required property 'name'"

  - name: brace_form_graph_type_declares_edge_property_types
    setup:
      - "CREATE GRAPH TYPE routes { (:City {name STRING NOT NULL, population INT64})-[:ROUTE {km INT64}]->(:City) }"
    query: "INSERT (:City {name: 'Paris'})-[:ROUTE {km: 'far'}]->(:City {name: 'Prague'})"
    expect:
      error: km

  - name: brace_form_graph_type_declares_edge_endpoints
    setup:
      - "CREATE GRAPH TYPE routes { (:City {name STRING NOT NULL})-[:ROUTE]->(:City), (:Country {code STRING}) }"
    query: "INSERT (:Country {code: 'NL'})-[:ROUTE]->(:City {name: 'Berlin'})"
    expect:
      error: ROUTE

  - name: brace_form_graph_type_accepts_what_it_declares
    statements:
      - "CREATE GRAPH TYPE routes { (:City {name STRING NOT NULL, population INT64})-[:ROUTE {km INT64}]->(:City) }"
      - "INSERT (:City {name: 'Amsterdam', population: 19})-[:ROUTE {km: 88}]->(:City {name: 'Barcelona'})"
      - "MATCH (a:City)-[r:ROUTE]->(b:City) RETURN a.name, r.km, b.name"
    expect:
      rows:
        - [Amsterdam, 88, Barcelona]

  - name: map_property_takes_a_map
    statements:
      - "CREATE NODE TYPE Config (settings MAP NOT NULL)"
      - "INSERT (:Config {settings: {mode: 'fast', level: 3}})"
      - "MATCH (c:Config) SET c.settings = {mode: 'slow', level: 19}"
      - "MATCH (c:Config) RETURN c.settings.mode, c.settings.level"
    expect:
      rows:
        - [slow, 19]

  - name: map_property_refuses_a_string
    setup:
      - "CREATE NODE TYPE Config (settings MAP)"
    query: "INSERT (:Config {settings: 'fast'})"
    expect:
      error: settings

  - name: map_edge_property_takes_a_map
    statements:
      - "CREATE EDGE TYPE TUNED (changes MAP)"
      - "INSERT (:Config)-[:TUNED {changes: {level: 88}}]->(:Config)"
      - "MATCH ()-[t:TUNED]->() RETURN t.changes.level"
    expect:
      rows:
        - [88]

  - name: edge_type_default_fills_a_missing_property
    statements:
      - "CREATE NODE TYPE City (name STRING, country STRING DEFAULT 'NL')"
      - "CREATE EDGE TYPE ROUTE CONNECTING (City) TO (City) (km INT64 DEFAULT 88)"
      - "INSERT (:City {name: 'Paris'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (a:City)-[r:ROUTE]->(b:City) RETURN a.country, r.km, b.country"
    expect:
      rows:
        - [NL, 88, NL]

  - name: edge_type_default_keeps_a_given_value
    statements:
      - "CREATE EDGE TYPE ROUTE (km INT64 DEFAULT 88)"
      - "INSERT (:City {name: 'Paris'})-[:ROUTE {km: 3}]->(:City {name: 'Prague'})"
      - "MATCH ()-[r:ROUTE]->() RETURN r.km"
    expect:
      rows:
        - [3]

  - name: not_null_edge_property_with_a_default_gets_the_default
    statements:
      - "CREATE EDGE TYPE LEG (minutes INT64 NOT NULL DEFAULT 19)"
      - "INSERT (:Stop)-[:LEG]->(:Stop)"
      - "MATCH ()-[l:LEG]->() RETURN l.minutes"
    expect:
      rows:
        - [19]

  # ---------------------------------------------------------------------------
  # Property types, property names and defaults the DDL checks
  # (ISO/IEC 39075:2024 18.6 <property type>, 18.7 <property value type>
  # Syntax Rule 4, 21.2 <signed numeric literal>; DEFAULT is Grafeo's)
  # ---------------------------------------------------------------------------

  - name: unknown_property_type_is_refused
    query: "CREATE NODE TYPE Town (population INT32)"
    expect:
      error: "'INT32' is not a property type"

  - name: unknown_list_element_type_is_refused
    query: "CREATE EDGE TYPE ROAD (lanes LIST<DECIMAL>)"
    expect:
      error: "'DECIMAL' is not a property type"

  - name: unknown_inline_property_type_is_refused
    query: "CREATE GRAPH TYPE atlas { (:Town {population DECIMAL})-[:ROAD]->(:Town) }"
    expect:
      error: "'DECIMAL' is not a property type"

  - name: keyword_property_names_are_declared
    statements:
      - "CREATE NODE TYPE Trip (starts DATE, ends DATE, contains STRING)"
      - "ALTER NODE TYPE Trip ADD PROPERTY match INT64"
      - "INSERT (:Trip {starts: date('2024-03-19'), ends: date('2024-03-22'), contains: 'Prague', match: 3})"
      - "MATCH (t:Trip) RETURN t.contains, t.match"
    expect:
      rows:
        - [Prague, 3]

  - name: keyword_property_type_is_checked
    setup:
      - "CREATE NODE TYPE Trip (contains STRING)"
    query: "INSERT (:Trip {contains: 3})"
    expect:
      error: contains

  - name: signed_number_defaults
    statements:
      - "CREATE NODE TYPE Reading (celsius INT64 DEFAULT -3, trim FLOAT64 DEFAULT -0.5, scale FLOAT64 DEFAULT 88)"
      - "INSERT (:Reading)"
      - "MATCH (r:Reading) RETURN r.celsius, r.trim, r.scale IS TYPED FLOAT64"
    expect:
      rows:
        - [-3, -0.5, true]

  - name: default_of_another_type_is_refused
    query: "CREATE NODE TYPE Town (x INT64 DEFAULT 'far')"
    expect:
      error: "DEFAULT 'far' is not a value of type INT64"

  - name: default_of_another_type_is_refused_by_alter
    setup:
      - "CREATE EDGE TYPE ROUTE (km INT64)"
    query: "ALTER EDGE TYPE ROUTE ADD lanes INT64 DEFAULT 2.5"
    expect:
      error: "DEFAULT 2.5 is not a value of type INT64"

  - name: null_default_of_a_not_null_property_is_refused
    query: "CREATE NODE TYPE Town (x INT64 NOT NULL DEFAULT NULL)"
    expect:
      error: "DEFAULT NULL"
