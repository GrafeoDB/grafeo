# A change of a type that the data on a closed graph would break is refused, while the data breaks
# it (ISO/IEC 39075:2024 G2000). Generated with the Rust tests in closed_type_writers.rs, which also
# read back that nothing moved, across transactions and from another graph.

meta:
  language: gql
  model: lpg
  title: Type changes over held data
  dataset: empty

tests:

  - name: closed_refuses_alter_node_drop_property
    setup:
      - "CREATE NODE TYPE Held (name STRING, extra INTEGER, k INTEGER)"
      - "CREATE NODE TYPE Other (k INTEGER)"
      - "CREATE NODE TYPE Only (x INTEGER)"
      - "CREATE EDGE TYPE Link (w INTEGER, z INTEGER)"
      - "CREATE EDGE TYPE Lone (w INTEGER)"
      - "CREATE GRAPH TYPE held (NODE TYPE Held, NODE TYPE Other, NODE TYPE Only, EDGE TYPE Link, EDGE TYPE Lone)"
      - "CREATE GRAPH g TYPED held"
      - "USE GRAPH g"
      - "INSERT (:Held {name: 'Alix', extra: 1})-[:Link {w: 1}]->(:Only {x: 1})-[:Lone {w: 2}]->(:Other)"
    query: "ALTER NODE TYPE Held DROP PROPERTY extra"
    expect:
      gql_status: "G2000"

  - name: open_allows_alter_node_drop_property
    setup:
      - "CREATE NODE TYPE Held (name STRING, extra INTEGER, k INTEGER)"
      - "CREATE NODE TYPE Other (k INTEGER)"
      - "CREATE NODE TYPE Only (x INTEGER)"
      - "CREATE EDGE TYPE Link (w INTEGER, z INTEGER)"
      - "CREATE EDGE TYPE Lone (w INTEGER)"
      - "CREATE GRAPH TYPE held { node_types: [Held, Other, Only], edge_types: [Link, Lone], open: true }"
      - "CREATE GRAPH g TYPED held"
      - "USE GRAPH g"
      - "INSERT (:Held {name: 'Alix', extra: 1})-[:Link {w: 1}]->(:Only {x: 1})-[:Lone {w: 2}]->(:Other)"
    statements:
      - "ALTER NODE TYPE Held DROP PROPERTY extra"
      - "MATCH (a:Held {name: 'Alix'}) RETURN a.extra"
    expect:
      rows:
        - [1]

  - name: untyped_allows_alter_node_drop_property
    setup:
      - "CREATE NODE TYPE Held (name STRING, extra INTEGER, k INTEGER)"
      - "CREATE NODE TYPE Other (k INTEGER)"
      - "CREATE NODE TYPE Only (x INTEGER)"
      - "CREATE EDGE TYPE Link (w INTEGER, z INTEGER)"
      - "CREATE EDGE TYPE Lone (w INTEGER)"
      - "CREATE GRAPH g"
      - "USE GRAPH g"
      - "INSERT (:Held {name: 'Alix', extra: 1})-[:Link {w: 1}]->(:Only {x: 1})-[:Lone {w: 2}]->(:Other)"
    statements:
      - "ALTER NODE TYPE Held DROP PROPERTY extra"
      - "MATCH (a:Held {name: 'Alix'}) RETURN a.extra"
    expect:
      rows:
        - [1]

  - name: closed_refuses_alter_node_drop_last_property
    setup:
      - "CREATE NODE TYPE Held (name STRING, extra INTEGER, k INTEGER)"
      - "CREATE NODE TYPE Other (k INTEGER)"
      - "CREATE NODE TYPE Only (x INTEGER)"
      - "CREATE EDGE TYPE Link (w INTEGER, z INTEGER)"
      - "CREATE EDGE TYPE Lone (w INTEGER)"
      - "CREATE GRAPH TYPE held (NODE TYPE Held, NODE TYPE Other, NODE TYPE Only, EDGE TYPE Link, EDGE TYPE Lone)"
      - "CREATE GRAPH g TYPED held"
      - "USE GRAPH g"
      - "INSERT (:Held {name: 'Alix', extra: 1})-[:Link {w: 1}]->(:Only {x: 1})-[:Lone {w: 2}]->(:Other)"
    query: "ALTER NODE TYPE Only DROP PROPERTY x"
    expect:
      gql_status: "G2000"

  - name: open_allows_alter_node_drop_last_property
    setup:
      - "CREATE NODE TYPE Held (name STRING, extra INTEGER, k INTEGER)"
      - "CREATE NODE TYPE Other (k INTEGER)"
      - "CREATE NODE TYPE Only (x INTEGER)"
      - "CREATE EDGE TYPE Link (w INTEGER, z INTEGER)"
      - "CREATE EDGE TYPE Lone (w INTEGER)"
      - "CREATE GRAPH TYPE held { node_types: [Held, Other, Only], edge_types: [Link, Lone], open: true }"
      - "CREATE GRAPH g TYPED held"
      - "USE GRAPH g"
      - "INSERT (:Held {name: 'Alix', extra: 1})-[:Link {w: 1}]->(:Only {x: 1})-[:Lone {w: 2}]->(:Other)"
    statements:
      - "ALTER NODE TYPE Only DROP PROPERTY x"
      - "MATCH (a:Held {name: 'Alix'}) RETURN a.extra"
    expect:
      rows:
        - [1]

  - name: untyped_allows_alter_node_drop_last_property
    setup:
      - "CREATE NODE TYPE Held (name STRING, extra INTEGER, k INTEGER)"
      - "CREATE NODE TYPE Other (k INTEGER)"
      - "CREATE NODE TYPE Only (x INTEGER)"
      - "CREATE EDGE TYPE Link (w INTEGER, z INTEGER)"
