# GQL Temporal Extended: ISO/IEC 39075:2024 sec 21.3
#
# Covers: temporal literal value assertions, hour/minute/second extraction,
# date arithmetic, date comparison in WHERE, timestamp/current_date/current_time,
# date_trunc, date minus date, temporal equality in expressions (=, <>, IN).

meta:
  language: gql
  model: lpg
  section: "21.3"
  title: Temporal functions (extended)
  dataset: empty

tests:

  # ---------------------------------------------------------------------------
  # Typed literal value assertions (verify Display output)
  # ---------------------------------------------------------------------------

  - name: date_literal_value
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DATE '2024-03-15' AS d"
    expect:
      rows:
        - [2024-03-15]

  - name: time_literal_value
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN TIME '14:30:00' AS t"
    expect:
      rows:
        - ["14:30:00"]

  - name: duration_literal_value
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DURATION 'P1Y2M3D' AS d"
    expect:
      rows:
        - [P1Y2M3D]

  - name: datetime_literal_value
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DATETIME '2024-03-15T14:30:00Z' AS dt"
    expect:
      count: 1

  # ---------------------------------------------------------------------------
  # Hour / minute / second extraction from TIME
  # ---------------------------------------------------------------------------

  - name: hour_extraction
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN hour(TIME '14:30:45') AS h"
    expect:
      rows:
        - [14]

  - name: minute_extraction
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN minute(TIME '14:30:45') AS m"
    expect:
      rows:
        - [30]

  - name: second_extraction
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN second(TIME '14:30:45') AS s"
    expect:
      rows:
        - [45]

  # ---------------------------------------------------------------------------
  # Year/month/day on different dates
  # ---------------------------------------------------------------------------

  - name: year_extraction_leap_year
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN year(DATE '2000-02-29') AS y"
    expect:
      rows:
        - [2000]

  - name: month_extraction_december
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN month(DATE '2024-12-31') AS m"
    expect:
      rows:
        - [12]

  - name: day_extraction_first
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN day(DATE '2024-01-01') AS d"
    expect:
      rows:
        - [1]

  # ---------------------------------------------------------------------------
  # Date + Duration arithmetic
  # ---------------------------------------------------------------------------

  - name: date_plus_one_month
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DATE '2024-01-15' + DURATION 'P1M' AS d"
    expect:
      rows:
        - [2024-02-15]

  - name: date_plus_one_year
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DATE '2024-03-15' + DURATION 'P1Y' AS d"
    expect:
      rows:
        - [2025-03-15]

  - name: date_plus_days
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DATE '2024-01-30' + DURATION 'P3D' AS d"
    expect:
      rows:
        - [2024-02-02]

  # ---------------------------------------------------------------------------
  # Date minus Date (returns Duration)
  # ---------------------------------------------------------------------------

  - name: date_minus_date
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DATE '2024-03-15' - DATE '2024-01-01' AS diff"
    expect:
      rows:
        - [P74D]

  # ---------------------------------------------------------------------------
  # Duration arithmetic
  # ---------------------------------------------------------------------------

  - name: duration_plus_duration
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN DURATION 'P1Y' + DURATION 'P6M' AS d"
    expect:
      rows:
        - [P1Y6M]

  # ---------------------------------------------------------------------------
  # Date comparison in WHERE
  # ---------------------------------------------------------------------------

  - name: date_comparison_greater
    setup:
      - "INSERT (:Person {name: 'Alix', birthday: DATE '1990-06-15'})"
      - "INSERT (:Person {name: 'Gus', birthday: DATE '2000-01-01'})"
    query: "MATCH (p:Person) WHERE p.birthday > DATE '1995-01-01' RETURN p.name"
    expect:
      rows:
        - [Gus]

  - name: date_comparison_less
    setup:
      - "INSERT (:Person {name: 'Alix', birthday: DATE '1990-06-15'})"
      - "INSERT (:Person {name: 'Gus', birthday: DATE '2000-01-01'})"
    query: "MATCH (p:Person) WHERE p.birthday < DATE '1995-01-01' RETURN p.name"
    expect:
      rows:
        - [Alix]

  - name: date_comparison_equal
    setup:
      - "INSERT (:Event {name: 'launch', date: DATE '2024-11-01'})"
    query: "MATCH (e:Event) WHERE e.date = DATE '2024-11-01' RETURN e.name"
    expect:
      rows:
        - [launch]

  # ---------------------------------------------------------------------------
  # timestamp() returns a number
  # ---------------------------------------------------------------------------

  - name: timestamp_returns_integer
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN timestamp() AS ts"
    expect:
      count: 1

  # ---------------------------------------------------------------------------
  # current_date() and current_time()
  # ---------------------------------------------------------------------------

  - name: current_date_returns_value
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN current_date() AS d"
    expect:
      count: 1

  - name: current_time_returns_value
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN current_time() AS t"
    expect:
      count: 1

  # ---------------------------------------------------------------------------
  # date_trunc()
  # ---------------------------------------------------------------------------

  - name: date_trunc_to_year
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN date_trunc('year', DATE '2024-07-20') AS d"
    expect:
      rows:
        - [2024-01-01]

  - name: date_trunc_to_month
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN date_trunc('month', DATE '2024-07-20') AS d"
    expect:
      rows:
        - [2024-07-01]

  # ---------------------------------------------------------------------------
  # Hour/minute/second extraction from DATETIME
  # ---------------------------------------------------------------------------

  - name: hour_from_datetime
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN hour(DATETIME '2024-03-15T14:30:45Z') AS h"
    expect:
      rows:
        - [14]

  - name: minute_from_datetime
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN minute(DATETIME '2024-03-15T14:30:45Z') AS m"
    expect:
      rows:
        - [30]

  - name: second_from_datetime
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN second(DATETIME '2024-03-15T14:30:45Z') AS s"
    expect:
      rows:
        - [45]

  # ---------------------------------------------------------------------------
  # Year/month/day from DATETIME
  # ---------------------------------------------------------------------------

  - name: year_from_datetime
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN year(DATETIME '2024-03-15T14:30:00Z') AS y"
    expect:
      rows:
        - [2024]

  - name: month_from_datetime
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN month(DATETIME '2024-03-15T14:30:00Z') AS m"
    expect:
      rows:
        - [3]

  - name: day_from_datetime
    setup:
      - "INSERT (:N {v: 1})"
    query: "MATCH (n:N) RETURN day(DATETIME '2024-03-15T14:30:00Z') AS d"
    expect:
      rows:
        - [15]

  # ---------------------------------------------------------------------------
  # Temporal property storage round-trip
  # ---------------------------------------------------------------------------

  - name: time_property_round_trip
    setup:
      - "INSERT (:Schedule {event: 'standup', time: TIME '09:00:00'})"
    query: "MATCH (s:Schedule) RETURN s.time AS t"
    expect:
      rows:
        - ["09:00:00"]

  - name: duration_property_round_trip
    setup:
      - "INSERT (:Task {name: 'sprint', duration: DURATION 'P2W'})"
    query: "MATCH (t:Task) RETURN t.duration AS d"
    expect:
      rows:
        - [P14D]

  # ---------------------------------------------------------------------------
  # Equality of temporal values in expressions (used to be always false for
  # `=` and always true for `<>`)
  # ---------------------------------------------------------------------------

  - name: temporal_equality_in_expressions
    query: "RETURN DATE '2024-03-15' = DATE '2024-03-15' AS d, TIME '14:30:00' = TIME '14:30:00' AS t, datetime('2024-01-15T14:30:00Z') = datetime('2024-01-15T14:30:00Z') AS dt, DURATION 'P1D' = DURATION 'P1D' AS du"
    expect:
      rows:
        - [true, true, true, true]

  - name: temporal_inequality_in_expressions
    query: "RETURN DATE '2024-03-15' <> DATE '2024-03-15' AS same, DATE '2024-03-15' <> DATE '2024-03-16' AS different, DATE '2024-03-15' = DATE '2024-03-16' AS eq_different"
    expect:
      rows:
        - [false, true, false]

  - name: zoned_datetime_equality_compares_instants
    query: "RETURN zoned_datetime('2024-01-15T14:30:00+01:00') = zoned_datetime('2024-01-15T13:30:00+00:00') AS r"
    expect:
      rows:
        - [true]

  # ISO/IEC 39075:2024 19.3 <comparison predicate>: zoned datetimes order by
  # the instant they denote, with every ordering operator (they gave null,
  # #584). 2022-01-01T00:00+01:00 is 2021-12-31T23:00Z.
  - name: zoned_datetime_ordering_compares_instants
    query: "RETURN zoned_datetime('2022-01-01T00:00:00+01:00') < zoned_datetime('2021-12-31T23:30:00Z') AS lt, zoned_datetime('2022-01-01T00:00:00+01:00') <= zoned_datetime('2021-12-31T23:30:00Z') AS le, zoned_datetime('2022-01-01T00:00:00+01:00') > zoned_datetime('2021-12-31T23:30:00Z') AS gt, zoned_datetime('2022-01-01T00:00:00+01:00') >= zoned_datetime('2021-12-31T23:30:00Z') AS ge"
    expect:
      rows:
        - [true, true, false, false]

  - name: zoned_datetime_literals_compare_as_instants
    query: "RETURN ZONED DATETIME '2022-01-01T00:00:00Z' > ZONED DATETIME '2000-01-01T00:00:00+00:00' AS later, ZONED DATETIME '2021-12-31T23:00:00Z' >= ZONED DATETIME '2022-01-01T00:00:00+01:00' AS same_instant"
    expect:
      rows:
        - [true, true]

  # A timestamp compares with a zoned datetime as an instant in UTC (it was
  # null, and `=` was false).
  - name: timestamp_and_zoned_datetime_compare_as_instants
    query: "RETURN datetime('2024-03-15T10:30:00Z') = zoned_datetime('2024-03-15T11:30:00+01:00') AS eq, datetime('2024-03-15T10:30:00Z') < zoned_datetime('2024-03-15T11:31:00+01:00') AS lt, zoned_datetime('2024-03-15T11:31:00+01:00') > datetime('2024-03-15T10:30:00Z') AS gt"
    expect:
      rows:
        - [true, true, true]

  - name: filter_on_stored_zoned_datetimes_keeps_later_instants
    setup:
      - "INSERT (:Event {name: 'Alix', at: ZONED DATETIME '2024-03-15T10:30:00+01:00'})"
      - "INSERT (:Event {name: 'Gus', at: ZONED DATETIME '2019-03-15T10:30:00Z'})"
      - "INSERT (:Event {name: 'Jules', at: ZONED DATETIME '2020-01-01T00:30:00+01:00'})"
      - "INSERT (:Event {name: 'Mia', at: datetime('2024-03-15T10:30:00Z')})"
    query: "MATCH (e:Event) FILTER e.at >= ZONED_DATETIME('2020-01-01T00:00:00Z') RETURN e.name"
    expect:
      rows:
        - [Alix]
        - [Mia]

  - name: zoned_datetime_range_on_stored_values
    setup:
      - "INSERT (:Event {name: 'Alix', at: ZONED DATETIME '2024-03-15T10:30:00+01:00'})"
      - "INSERT (:Event {name: 'Gus', at: ZONED DATETIME '2019-03-15T10:30:00Z'})"
    query: "MATCH (e:Event) WHERE e.at > ZONED DATETIME '2020-01-01T00:00:00Z' AND e.at < ZONED DATETIME '2030-01-01T00:00:00Z' RETURN e.name"
    expect:
      rows:
        - [Alix]

  - name: temporal_in_list
    query: "RETURN DATE '2024-03-15' IN [DATE '2024-03-14', DATE '2024-03-15'] AS r"
    expect:
      rows:
        - [true]

  - name: projected_date_property_equality
    setup:
      - "INSERT (:Event {name: 'launch', d: DATE '2024-03-15'})"
      - "INSERT (:Event {name: 'review', d: DATE '2024-04-01'})"
    query: "MATCH (e:Event) WITH e.name AS name, e.d AS d WHERE d = DATE '2024-03-15' RETURN name"
    expect:
      rows:
        - [launch]

  - name: offset_time_equality_compares_instants
    query: "RETURN time('14:00:00+01:00') = time('13:00:00Z') AS same_instant, time('14:00:00+01:00') = time('14:00:00Z') AS different, time('14:00:00') = time('14:00:00+01:00') AS local_vs_offset"
    expect:
      rows:
        - [true, false, false]

  # ---------------------------------------------------------------------------
  # datetime({epochMillis: n}) and datetime({epochSeconds: n, nanosecond: m})
  # are the instant that long after 1970-01-01T00:00:00Z (they were null), and
  # the component functions read them like the Cypher accessors (d.month)
  # ---------------------------------------------------------------------------

  - name: datetime_from_epoch_millis_components
    query: "RETURN year(datetime({epochMillis: 1590433388088})) AS y, month(datetime({epochMillis: 1590433388088})) AS m, day(datetime({epochMillis: 1590433388088})) AS d, hour(datetime({epochMillis: 1590433388088})) AS h"
    expect:
      rows:
        - [2020, 5, 25, 19]

  - name: datetime_from_epoch_equals_parsed_datetime
    query: "RETURN datetime({epochMillis: 1590364800000}) = datetime('2020-05-25T00:00:00Z') AS millis, datetime({epochSeconds: 1590364800}) = datetime('2020-05-25T00:00:00Z') AS seconds"
    expect:
      rows:
        - [true, true]

  - name: epoch_birthday_filtered_by_month_and_day
    setup:
      - "INSERT (:Person {name: 'Alix', birthday: 585446400000}), (:Person {name: 'Gus', birthday: 585273600000}), (:Person {name: 'Vincent', birthday: 586569600000})"
    query: "MATCH (p:Person) WHERE (month(datetime({epochMillis: p.birthday})) = 7 AND day(datetime({epochMillis: p.birthday})) >= 21) OR month(datetime({epochMillis: p.birthday})) = 8 RETURN p.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]
