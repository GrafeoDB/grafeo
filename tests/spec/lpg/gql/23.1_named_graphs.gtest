# GQL Named Graphs: ISO/IEC 39075:2024 sec 23.1
#
# Covers: CREATE GRAPH, CREATE GRAPH IF NOT EXISTS, DROP GRAPH,
# DROP GRAPH IF EXISTS, USE GRAPH, data isolation between named graphs,
# SESSION SET GRAPH, SESSION RESET, SHOW GRAPHS.

meta:
  language: gql
  model: lpg
  section: "23.1"
  title: Named graphs
  dataset: empty
  iso: [GC04, GC05, GQ01]

tests:

  # ---------------------------------------------------------------------------
  # CREATE GRAPH
  # ---------------------------------------------------------------------------

  - name: create_graph_basic
    statements:
      - "CREATE GRAPH analytics"
      - "SHOW GRAPHS"
    expect:
      rows:
        - [analytics]

  - name: create_graph_if_not_exists
    statements:
      - "CREATE GRAPH analytics"
      - "CREATE GRAPH IF NOT EXISTS analytics"
      - "SHOW GRAPHS"
    expect:
      rows:
        - [analytics]

  - name: create_graph_duplicate_fails
    statements:
      - "CREATE GRAPH analytics"
      - "CREATE GRAPH analytics"
    expect:
      error: analytics

  - name: create_multiple_graphs
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "SHOW GRAPHS"
    expect:
      ordered: true
      rows:
        - [alpha]
        - [beta]

  # ---------------------------------------------------------------------------
  # DROP GRAPH
  # ---------------------------------------------------------------------------

  - name: drop_graph_basic
    statements:
      - "CREATE GRAPH temp"
      - "DROP GRAPH temp"
      - "SHOW GRAPHS"
    expect:
      empty: true

  - name: drop_graph_if_exists
    statements:
      - "DROP GRAPH IF EXISTS nonexistent"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  - name: drop_graph_nonexistent_fails
    statements:
      - "DROP GRAPH nonexistent"
    expect:
      error: nonexistent

  # ---------------------------------------------------------------------------
  # USE GRAPH: data isolation
  # ---------------------------------------------------------------------------

  - name: use_graph_isolates_inserts
    statements:
      - "INSERT (:Person {name: 'Alix'})"
      - "CREATE GRAPH analytics"
      - "USE GRAPH analytics"
      - "INSERT (:Event {type: 'click'})"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [1]

  - name: default_graph_unchanged_after_named_insert
    statements:
      - "CREATE GRAPH analytics"
      - "USE GRAPH analytics"
      - "INSERT (:Event {type: 'click'})"
      - "USE GRAPH default"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  - name: two_named_graphs_independent
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE GRAPH alpha"
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Gus'})"
      - "USE GRAPH beta"
      - "INSERT (:Animal {species: 'Cat'})"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [1]

  - name: switch_back_to_alpha_sees_two_nodes
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE GRAPH alpha"
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Gus'})"
      - "USE GRAPH beta"
      - "INSERT (:Animal {species: 'Cat'})"
      - "USE GRAPH alpha"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [2]

  - name: default_empty_after_named_graph_inserts
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE GRAPH alpha"
      - "INSERT (:Person {name: 'Alix'})"
      - "USE GRAPH beta"
      - "INSERT (:Animal {species: 'Cat'})"
      - "USE GRAPH default"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  # ---------------------------------------------------------------------------
  # Edge isolation
  # ---------------------------------------------------------------------------

  - name: edges_isolated_between_graphs
    statements:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
      - "CREATE GRAPH social"
      - "USE GRAPH social"
      - "INSERT (:Person {name: 'Vincent'})-[:WORKS_WITH]->(:Person {name: 'Jules'})"
      - "MATCH ()-[r]->() RETURN count(r) AS cnt"
    expect:
      rows:
        - [1]

  - name: default_edge_still_exists
    statements:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
      - "CREATE GRAPH social"
      - "USE GRAPH social"
      - "INSERT (:Person {name: 'Vincent'})-[:WORKS_WITH]->(:Person {name: 'Jules'})"
      - "USE GRAPH default"
      - "MATCH ()-[r]->() RETURN count(r) AS cnt"
    expect:
      rows:
        - [1]

  # ---------------------------------------------------------------------------
  # SESSION SET GRAPH / SESSION RESET
  # ---------------------------------------------------------------------------

  - name: session_set_graph_isolates
    statements:
      - "CREATE GRAPH mydb"
      - "SESSION SET GRAPH mydb"
      - "INSERT (:Person {name: 'Gus'})"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [1]

  - name: session_set_graph_default_empty
    statements:
      - "CREATE GRAPH mydb"
      - "SESSION SET GRAPH mydb"
      - "INSERT (:Person {name: 'Gus'})"
      - "SESSION SET GRAPH default"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  - name: session_reset_returns_to_default
    statements:
      - "INSERT (:Person {name: 'Alix'})"
      - "CREATE GRAPH other"
      - "USE GRAPH other"
      - "SESSION RESET"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [1]

  # ---------------------------------------------------------------------------
  # SHOW GRAPHS
  # ---------------------------------------------------------------------------

  - name: show_graphs_empty_initially
    query: "SHOW GRAPHS"
    expect:
      empty: true

  - name: show_graphs_sorted_alphabetically
    statements:
      - "CREATE GRAPH beta"
      - "CREATE GRAPH alpha"
      - "SHOW GRAPHS"
    expect:
      ordered: true
      rows:
        - [alpha]
        - [beta]

  - name: show_graphs_reflects_drop
    statements:
      - "CREATE GRAPH temp"
      - "DROP GRAPH temp"
      - "SHOW GRAPHS"
    expect:
      empty: true

  # ---------------------------------------------------------------------------
  # Drop active graph
  # ---------------------------------------------------------------------------

  - name: drop_active_graph_resets_to_default
    statements:
      - "CREATE GRAPH temp"
      - "USE GRAPH temp"
      - "INSERT (:Temp {val: 'ephemeral'})"
      - "DROP GRAPH temp"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  # ---------------------------------------------------------------------------
  # Same query, different graph (cache isolation)
  # ---------------------------------------------------------------------------

  - name: same_query_different_graph
    statements:
      - "INSERT (:Person {name: 'Alix'})"
      - "CREATE GRAPH empty_g"
      - "USE GRAPH empty_g"
      - "MATCH (n) RETURN count(n) AS cnt"
    expect:
      rows:
        - [0]

  # ---------------------------------------------------------------------------
  # USE g <statement>: a statement focused on a graph (ISO/IEC 39075 use graph
  # clause, GQ01). It reads and writes g, and the session's current graph stays
  # as it was (web#55: USE GRAPH g and an INSERT in one string did nothing).
  # ---------------------------------------------------------------------------

  - name: use_graph_then_insert_in_one_statement_writes_that_graph
    statements:
      - "CREATE GRAPH floria"
      - "USE GRAPH floria INSERT (:Person {name: 'Alix'})"
      - "USE GRAPH floria"
      - "MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Alix]

  - name: use_then_insert_writes_that_graph
    statements:
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix'})"
      - "USE floria MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Alix]

  - name: use_then_insert_leaves_the_session_graph
    statements:
      - "INSERT (:Person {name: 'Gus'})"
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix'})"
      - "MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Gus]

  - name: use_then_match_reads_that_graph
    statements:
      - "INSERT (:Person {name: 'Gus'})"
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix'})"
      - "USE floria MATCH (n:Person) RETURN n.name"
    expect:
      rows:
        - [Alix]

  - name: use_reads_its_graph_from_another_session_graph
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE alpha INSERT (:Person {name: 'Alix'})"
      - "USE GRAPH beta"
      - "USE alpha MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Alix]

  - name: use_two_graphs_in_turn_alpha
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE alpha INSERT (:Person {name: 'Alix'})"
      - "USE beta INSERT (:Person {name: 'Gus'})"
      - "USE alpha MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Alix]

  - name: use_two_graphs_in_turn_beta
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE alpha INSERT (:Person {name: 'Alix'})"
      - "USE beta INSERT (:Person {name: 'Gus'})"
      - "USE beta MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Gus]

  - name: use_then_update_and_delete_leave_the_session_graph
    statements:
      - "INSERT (:Person {name: 'Alix', city: 'Paris'})"
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix', city: 'Berlin'}), (:Person {name: 'Gus'})"
      - "USE floria MATCH (n:Person {name: 'Alix'}) SET n.city = 'Prague'"
      - "USE floria MATCH (n:Person {name: 'Gus'}) DELETE n"
      - "MATCH (n:Person) RETURN n.name, n.city"
    expect:
      rows:
        - [Alix, Paris]

  - name: use_then_update_and_delete_change_that_graph
    statements:
      - "INSERT (:Person {name: 'Alix', city: 'Paris'})"
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix', city: 'Berlin'}), (:Person {name: 'Gus'})"
      - "USE floria MATCH (n:Person {name: 'Alix'}) SET n.city = 'Prague'"
      - "USE floria MATCH (n:Person {name: 'Gus'}) DELETE n"
      - "USE floria MATCH (n:Person) RETURN n.name, n.city"
    expect:
      rows:
        - [Alix, Prague]

  - name: use_then_insert_with_return
    statements:
      - "CREATE GRAPH floria"
      - "USE floria INSERT (p:Person {name: 'Alix'}) RETURN p.name"
    expect:
      rows:
        - [Alix]

  - name: use_current_graph_reads_the_session_graph
    statements:
      - "INSERT (:Person {name: 'Gus'})"
      - "CREATE GRAPH floria"
      - "USE CURRENT_GRAPH MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Gus]

  - name: use_default_reads_the_default_graph
    statements:
      - "INSERT (:Person {name: 'Gus'})"
      - "CREATE GRAPH floria"
      - "USE GRAPH floria"
      - "USE default MATCH (n) RETURN n.name"
    expect:
      rows:
        - [Gus]

  - name: use_a_missing_graph_fails
    statements:
      - "USE nowhere MATCH (n) RETURN n"
    expect:
      error: "Graph 'nowhere' does not exist"
      gql_status: "42002"

  - name: use_a_missing_graph_insert_fails
    statements:
      - "USE nowhere INSERT (:Person {name: 'Alix'})"
    expect:
      error: "Graph 'nowhere' does not exist"
      gql_status: "42002"

  - name: use_without_a_statement_fails
    statements:
      - "CREATE GRAPH floria"
      - "USE floria"
    expect:
      error: "USE floria must be followed by a query or a data-modifying statement"

  - name: use_before_a_schema_statement_fails
    statements:
      - "CREATE GRAPH floria"
      - "USE floria CREATE GRAPH other"
    expect:
      error: "USE floria must be followed by a query or a data-modifying statement"

  - name: use_the_same_graph_on_every_union_operand
    statements:
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix'}), (:City {name: 'Paris'})"
      - "USE floria MATCH (p:Person) RETURN p.name AS name UNION USE floria MATCH (c:City) RETURN c.name AS name"
    expect:
      rows:
        - [Alix]
        - [Paris]

  - name: use_on_one_union_operand_only_is_not_supported_yet
    statements:
      - "CREATE GRAPH floria"
      - "USE floria MATCH (p:Person) RETURN p.name AS name UNION MATCH (c:City) RETURN c.name AS name"
    expect:
      error: "not supported yet"

  - name: use_different_graphs_on_union_operands_is_not_supported_yet
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE alpha MATCH (p:Person) RETURN p.name AS name UNION USE beta MATCH (p:Person) RETURN p.name AS name"
    expect:
      error: "not supported yet"

  - name: use_the_same_graph_on_every_next_statement
    statements:
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix', age: 30}), (:Person {name: 'Gus', age: 25})"
      - "USE floria MATCH (p:Person) RETURN p.name AS name, p.age AS age NEXT USE floria FILTER age > 26 RETURN name"
    expect:
      rows:
        - [Alix]

  - name: use_different_graphs_on_next_statements_is_not_supported_yet
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE alpha MATCH (p:Person) RETURN p.name AS name NEXT USE beta RETURN name"
    expect:
      error: "not supported yet"

  - name: use_the_same_graph_again_inside_the_query
    statements:
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix'}), (:City {name: 'Paris'})"
      - "USE floria MATCH (p:Person) USE floria MATCH (c:City) RETURN p.name, c.name"
    expect:
      rows:
        - [Alix, Paris]

  - name: use_another_graph_inside_the_query_is_not_supported_yet
    statements:
      - "CREATE GRAPH alpha"
      - "CREATE GRAPH beta"
      - "USE alpha MATCH (p:Person) USE beta MATCH (c:City) RETURN p.name, c.name"
    expect:
      error: "not supported yet"

  - name: select_from_a_graph_reads_that_graph
    statements:
      - "INSERT (:Person {name: 'Gus'})"
      - "CREATE GRAPH floria"
      - "USE floria INSERT (:Person {name: 'Alix'})"
      - "SELECT n.name FROM floria MATCH (n:Person)"
    expect:
      rows:
        - [Alix]
