# GQL CAST to each type: ISO/IEC 39075:2024 sec 20.10 (cast specification)
#
# Covers: CAST to INT64, FLOAT64, STRING, BOOLEAN, DATE, TIME, DATETIME,
# ZONED DATETIME, DURATION and LIST<type> from each kind of value, the type
# name synonyms (INTEGER, INT, BIGINT, DOUBLE, REAL, VARCHAR, TEXT, BOOL), a
# value that does not convert (null), text that spells no number (22018), a
# float outside the INT64 range (22003), null itself, and a type name CAST
# does not know (a syntax error, 42001). Casts to DECIMAL are in
# decimal_numbers.gtest.

meta:
  language: gql
  model: lpg
  section: "20.10"
  title: CAST to each type
  dataset: empty

tests:

  # ---------------------------------------------------------------------------
  # INT64
  # ---------------------------------------------------------------------------

  - name: cast_text_to_int64
    query: "RETURN CAST('42' AS INT64) AS a, CAST('-7' AS INT64) AS b, CAST('+5' AS INT64) AS c"
    expect:
      rows:
        - [42, -7, 5]

  - name: cast_numbers_to_int64_truncates_towards_zero
    query: "RETURN CAST(4.9e0 AS INT64) AS a, CAST(-4.9e0 AS INT64) AS b, CAST(toDecimal('-2.7') AS INT64) AS c, CAST(true AS INT64) AS d, CAST(false AS INT64) AS e"
    expect:
      rows:
        - [4, -4, -2, 1, 0]

  # Decimal text converts as the number it spells, truncated toward zero
  # (as toInteger does, and as a float does above).
  - name: cast_decimal_text_to_int64_truncates_towards_zero
    query: "RETURN CAST('4.2' AS INT64) AS a, CAST('-4.7' AS INT64) AS b, CAST(' 2.9 ' AS INT) AS c"
    expect:
      rows:
        - [4, -4, 2]

  # Text that spells no number fails with 22018 (invalid character value for
  # cast, as SQL); toInteger of it is null instead.
  - name: cast_to_int64_of_a_name_fails
    query: "RETURN CAST('Alix' AS INT64) AS a"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_int64_of_empty_text_fails
    query: "RETURN CAST('' AS INT64) AS a"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_int64_of_only_spaces_fails
    query: "RETURN CAST('   ' AS INT64) AS a"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_int64_of_a_date_is_null
    # Control: a value of another kind does not convert (no text to read).
    query: "RETURN CAST(DATE '2024-03-15' AS INT64) AS d"
    expect:
      rows:
        - [null]

  # A float outside the INT64 range, an infinity and NaN fail with 22003, as
  # the integer operators do; the largest float below 2^63 converts.
  - name: cast_to_int64_of_a_float_above_the_range_fails
    query: "RETURN CAST(9.9e18 AS INT64) AS big"
    expect:
      error: ""
      gql_status: "22003"

  - name: cast_to_int64_of_a_float_below_the_range_fails
    query: "RETURN CAST(-1.0e19 AS INT64) AS small"
    expect:
      error: ""
      gql_status: "22003"

  - name: cast_to_int64_of_two_to_the_63_fails
    query: "RETURN CAST(9223372036854775808.0e0 AS INT64) AS edge"
    expect:
      error: ""
      gql_status: "22003"

  - name: cast_to_int64_of_infinity_fails
    query: "RETURN CAST(Infinity AS INT64) AS inf"
    expect:
      error: ""
      gql_status: "22003"

  - name: cast_to_int64_of_nan_fails
    query: "RETURN CAST(NaN AS INT64) AS nan"
    expect:
      error: ""
      gql_status: "22003"

  - name: cast_to_int64_of_the_floats_at_the_range_ends
    # 9223372036854774784 is the largest float below 2^63; -2^63 is a float.
    query: "RETURN CAST(9223372036854774784.0e0 AS INT64) AS hi, CAST(-9223372036854775808.0e0 AS INT64) AS lo"
    expect:
      rows:
        - [9223372036854774784, -9223372036854775808]

  # A text loses its leading and trailing spaces first, as SQL casts a
  # character string; a cast to STRING keeps them.
  - name: cast_text_with_surrounding_spaces_to_int64
    query: "RETURN CAST(' 42 ' AS INT64) AS a, CAST('  -7' AS INT) AS b"
    expect:
      rows:
        - [42, -7]

  - name: cast_text_with_surrounding_spaces_to_each_type
    query: "RETURN CAST(' 1.5 ' AS FLOAT64) AS f, CAST(' 1.50 ' AS DECIMAL) AS d, CAST(' true ' AS BOOLEAN) AS b, CAST(' 2024-03-15 ' AS DATE) AS dt, CAST(' PT1H ' AS DURATION) = DURATION 'PT1H' AS du"
    expect:
      rows:
        - [1.5, 1.50, true, "2024-03-15", true]

  - name: a_cast_to_string_keeps_the_spaces
    query: "RETURN CAST(' 42 ' AS STRING) AS s, char_length(CAST(' 42 ' AS STRING)) AS n"
    expect:
      rows:
        - [" 42 ", 4]

  - name: only_surrounding_spaces_are_trimmed
    query: "RETURN CAST(' 4 2 ' AS INT64) AS inner_space"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_int64_of_a_letter_before_digits_fails
    query: "RETURN CAST('x42' AS INT64) AS letter"
    expect:
      error: ""
      gql_status: "22018"

  # ---------------------------------------------------------------------------
  # FLOAT64
  # ---------------------------------------------------------------------------

  - name: cast_to_float64
    query: "RETURN CAST('1.5' AS FLOAT64) AS a, CAST('1e3' AS FLOAT64) AS b, CAST(2 AS FLOAT64) AS c, CAST(toDecimal('1.50') AS FLOAT64) AS d"
    expect:
      rows:
        - [1.5, 1000, 2, 1.5]

  - name: cast_to_float64_is_a_float
    query: "RETURN CAST(2 AS FLOAT64) IS TYPED FLOAT64 AS int, CAST('2' AS FLOAT64) IS TYPED FLOAT64 AS text"
    expect:
      rows:
        - [true, true]

  - name: cast_to_float64_of_text_that_is_no_number_fails
    query: "RETURN CAST('Gus' AS FLOAT64) AS a"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_float64_of_a_date_is_null
    query: "RETURN CAST(DATE '2024-03-15' AS FLOAT64) AS b"
    expect:
      rows:
        - [null]

  # ---------------------------------------------------------------------------
  # DECIMAL of text: trimmed and read as toDecimal reads it; text that is no
  # number fails (22018), and a number past 38 digits too (22003)
  # ---------------------------------------------------------------------------

  - name: cast_text_to_decimal_reads_number_text
    query: "RETURN CAST(' 1e3 ' AS DECIMAL) AS a, CAST('-2.50' AS DECIMAL) AS b, CAST(' 0.125 ' AS DECIMAL) AS c, CAST('7' AS DECIMAL) IS TYPED DECIMAL AS typed"
    expect:
      rows:
        - [1000, -2.50, 0.125, true]

  - name: cast_to_decimal_of_a_name_fails
    query: "RETURN CAST('Alix' AS DECIMAL) AS d"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_decimal_of_empty_text_fails
    query: "RETURN CAST('  ' AS DECIMAL) AS d"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_decimal_of_text_past_38_digits_fails
    query: "RETURN CAST('123456789012345678901234567890123456789' AS DECIMAL) AS d"
    expect:
      error: ""
      gql_status: "22003"

  - name: cast_to_decimal_of_text_at_38_digits
    # Control: 38 digits fit.
    query: "RETURN CAST('12345678901234567890123456789012345678' AS DECIMAL) = toDecimal('12345678901234567890123456789012345678') AS same"
    expect:
      rows:
        - [true]

  - name: cast_to_decimal_of_a_property_that_is_no_number_fails
    setup:
      - "INSERT (:Item {price: '19.95'}), (:Item {price: 'free'})"
    query: "MATCH (i:Item) RETURN CAST(i.price AS DECIMAL) AS p"
    expect:
      error: ""
      gql_status: "22018"

  # Booleans and numbers convert into each other, 1 and 0, in every direction
  # (as DuckDB casts them; ISO GQL has no such cast).
  - name: cast_a_boolean_to_float64
    query: "RETURN CAST(true AS FLOAT64) AS t, CAST(false AS FLOAT64) AS f"
    expect:
      rows:
        - [1, 0]

  - name: cast_a_boolean_to_decimal
    query: "RETURN CAST(true AS DECIMAL) AS t, CAST(false AS DECIMAL(5, 2)) AS f, CAST(true AS DECIMAL) IS TYPED DECIMAL AS typed"
    expect:
      rows:
        - [1, 0.00, true]

  - name: cast_a_stored_boolean_to_each_number
    setup:
      - "INSERT (:N {b: true}), (:N {b: false})"
    query: "MATCH (n:N) RETURN CAST(n.b AS INT64) AS i, CAST(n.b AS FLOAT64) AS f ORDER BY i"
    expect:
      ordered: true
      rows:
        - [0, 0]
        - [1, 1]

  # ---------------------------------------------------------------------------
  # STRING
  # ---------------------------------------------------------------------------

  - name: cast_to_string_of_each_kind
    query: "RETURN CAST(42 AS STRING) AS i, CAST(1.5e0 AS STRING) AS f, CAST(1.50 AS STRING) AS d, CAST(true AS STRING) AS b, CAST(DATE '2024-03-15' AS STRING) AS dt, CAST([1, 2] AS STRING) AS l"
    expect:
      rows:
        - ["42", "1.5", "1.50", "true", "2024-03-15", "[1, 2]"]

  # ---------------------------------------------------------------------------
  # BOOLEAN
  # ---------------------------------------------------------------------------

  - name: cast_text_to_boolean_ignores_case
    query: "RETURN CAST('true' AS BOOLEAN) AS a, CAST('FALSE' AS BOOLEAN) AS b, CAST('True' AS BOOLEAN) AS c, CAST('yes' AS BOOLEAN) AS d"
    expect:
      rows:
        - [true, false, true, null]

  - name: cast_to_boolean_of_a_boolean_and_of_a_number
    query: "RETURN CAST(true AS BOOLEAN) AS a, CAST(0 AS BOOLEAN) AS b, CAST(1.5e0 AS BOOLEAN) AS c, CAST(-3 AS BOOLEAN) AS d, CAST(0.0e0 AS BOOLEAN) AS e, CAST(0.00 AS BOOLEAN) AS f, CAST(0.01 AS BOOLEAN) AS g"
    expect:
      rows:
        - [true, false, true, true, false, false, true]

  - name: cast_a_list_of_booleans_and_numbers
    query: "RETURN CAST([true, false] AS LIST<FLOAT64>) AS f, CAST([true, false] AS LIST<FLOAT64>)[0] IS TYPED FLOAT64 AS typed, CAST([0, 2] AS LIST<BOOLEAN>) AS b"
    expect:
      rows:
        - [[1, 0], true, [false, true]]

  # ---------------------------------------------------------------------------
  # Temporal types
  # ---------------------------------------------------------------------------

  - name: cast_text_to_a_date
    query: "RETURN CAST('2024-03-15' AS DATE) = DATE '2024-03-15' AS valid, CAST('2024-13-01' AS DATE) AS invalid, CAST('Alix' AS DATE) AS text"
    expect:
      rows:
        - [true, null, null]

  - name: cast_a_datetime_to_its_local_date
    query: "RETURN CAST(ZONED DATETIME '2024-03-15T23:30:00+01:00' AS DATE) = DATE '2024-03-15' AS zoned, CAST(datetime('2024-03-15T10:00:00') AS DATE) = DATE '2024-03-15' AS local"
    expect:
      rows:
        - [true, true]

  - name: cast_text_and_datetimes_to_a_time
    query: "RETURN CAST('13:45:00' AS TIME) = TIME '13:45:00' AS text, CAST(datetime('2024-03-15T13:45:00') AS TIME) = TIME '13:45:00' AS local, CAST('25:00:00' AS TIME) AS invalid"
    expect:
      rows:
        - [true, true, null]

  - name: cast_text_to_datetimes
    query: "RETURN CAST('2024-03-15T10:00:00' AS DATETIME) = datetime('2024-03-15T10:00:00') AS local, CAST('2024-03-15T10:00:00+01:00' AS ZONED DATETIME) = ZONED DATETIME '2024-03-15T09:00:00Z' AS zoned"
    expect:
      rows:
        - [true, true]

  - name: cast_text_to_a_duration
    query: "RETURN CAST('P1D' AS DURATION) = DURATION 'P1D' AS day, CAST('PT90M' AS DURATION) = DURATION 'PT1H30M' AS minutes, CAST('Alix' AS DURATION) AS text"
    expect:
      rows:
        - [true, true, null]

  # ---------------------------------------------------------------------------
  # Lists
  # ---------------------------------------------------------------------------

  - name: cast_to_a_typed_list_converts_each_item
    query: "RETURN CAST(['1', '2'] AS LIST<INT64>) AS ints, CAST(['1', '2'] AS LIST<INT64>)[0] IS TYPED INT64 AS int, CAST([1, 2] AS LIST<STRING>)[1] IS TYPED STRING AS string"
    expect:
      rows:
        - [[1, 2], true, true]

  # ---------------------------------------------------------------------------
  # Synonyms, null, unknown types
  # ---------------------------------------------------------------------------

  - name: cast_type_name_synonyms
    query: "RETURN CAST('42' AS INTEGER) AS a, CAST('42' AS INT) AS b, CAST('42' AS BIGINT) AS c, CAST('1.5' AS DOUBLE) AS d, CAST('1.5' AS REAL) AS e, CAST(42 AS VARCHAR) AS f, CAST(42 AS TEXT) AS g, CAST('true' AS BOOL) AS h"
    expect:
      rows:
        - [42, 42, 42, 1.5, 1.5, "42", "42", true]

  - name: cast_of_null_is_null_for_every_type
    query: "RETURN CAST(null AS INT64) AS a, CAST(null AS FLOAT64) AS b, CAST(null AS STRING) AS c, CAST(null AS BOOLEAN) AS d, CAST(null AS DATE) AS e"
    expect:
      rows:
        - [null, null, null, null, null]

  - name: cast_a_property_of_each_row
    setup:
      - "INSERT (:Person {name: 'Alix', age: '30'}), (:Person {name: 'Gus', age: ' 25 '})"
    query: "MATCH (p:Person) RETURN p.name, CAST(p.age AS INT64) + 1 AS next"
    expect:
      rows:
        - [Alix, 31]
        - [Gus, 26]

  # One row whose text is no number fails the statement (22018), as SQL.
  - name: cast_a_property_that_is_no_number_fails
    setup:
      - "INSERT (:Person {name: 'Alix', age: '30'}), (:Person {name: 'Mia', age: 'unknown'})"
    query: "MATCH (p:Person) RETURN p.name, CAST(p.age AS INT64) + 1 AS next"
    expect:
      error: ""
      gql_status: "22018"

  - name: cast_to_an_unknown_type_is_a_syntax_error
    query: "RETURN CAST('x' AS NOSUCHTYPE) AS a"
    expect:
      error: "Unsupported CAST type: NOSUCHTYPE"
      gql_status: "42001"
