  - name: cypher_map_against_list
    language: cypher
    query: "RETURN {a: 1} = [1] AS eq, {a: 1} <> [1] AS ne, {a: 1} < [1] AS lt, {a: 1} <= [1] AS le, {a: 1} > [1] AS gt, {a: 1} >= [1] AS ge"
    expect:
      rows:
        - [false, true, null, null, null, null]

  # Two lists or two maps whose elements differ in kind: the rule reaches them through the elements.

  - name: gql_list_with_a_number_against_list_with_a_string
    query: "RETURN [1] = ['1'] AS eq, [1] <> ['1'] AS ne, [1.0e0] = ['1'] AS feq"
    expect:
      rows:
        - [false, true, false]

  - name: cypher_list_with_a_number_against_list_with_a_string
    language: cypher
    query: "RETURN [1] = ['1'] AS eq, [1] <> ['1'] AS ne, [1.0] = ['1'] AS feq, [1] < ['1'] AS lt, [1] > ['1'] AS gt"
    expect:
      rows:
        - [false, true, false, null, null]

  - name: gql_map_with_a_number_against_map_with_a_string
    query: "RETURN {a: 1} = {a: '1'} AS eq, {a: 1} <> {a: '1'} AS ne"
    expect:
      rows:
        - [false, true]

  - name: cypher_map_with_a_number_against_map_with_a_string
    language: cypher
    query: "RETURN {a: 1} = {a: '1'} AS eq, {a: 1} <> {a: '1'} AS ne"
    expect:
      rows:
        - [false, true]
