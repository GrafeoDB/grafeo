# A value of one kind against a value of another (GA04): `=` is false and `<>` true in both languages;
# `<`, `<=`, `>`, `>=` order the two by kind in GQL (the order ORDER BY uses: map, list, ..., string,
# boolean, number) and are null in Cypher. Generated with comparison_across_kinds.rs, which also runs
# every value of each kind, parameters, stored values with and without an index, and the other forms.

meta:
  language: gql
  model: lpg
  title: Comparison across kinds
  dataset: empty
  requires: [cypher]

tests:

  - name: gql_number_against_string
    query: "RETURN 0 = '0' AS eq, 0 <> '0' AS ne"
    expect:
      rows:
        - [false, true]

  - name: cypher_number_against_string
    language: cypher
    query: "RETURN 0 = '0' AS eq, 0 <> '0' AS ne, 0 < '0' AS lt, 0 <= '0' AS le, 0 > '0' AS gt, 0 >= '0' AS ge"
    expect:
      rows:
        - [false, true, null, null, null, null]

  - name: gql_number_against_bool
    query: "RETURN 0 = false AS eq, 0 <> false AS ne"
    expect:
      rows:
        - [false, true]

  - name: cypher_number_against_bool
    language: cypher
    query: "RETURN 0 = false AS eq, 0 <> false AS ne, 0 < false AS lt, 0 <= false AS le, 0 > false AS gt, 0 >= false AS ge"
    expect:
      rows:
        - [false, true, null, null, null, null]

  - name: gql_number_against_date
    query: "RETURN 0 = DATE '2024-01-01' AS eq, 0 <> DATE '2024-01-01' AS ne"
    expect:
      rows:
        - [false, true]

  - name: cypher_number_against_date
    language: cypher
    query: "RETURN 0 = date('2024-01-01') AS eq, 0 <> date('2024-01-01') AS ne, 0 < date('2024-01-01') AS lt, 0 <= date('2024-01-01') AS le, 0 > date('2024-01-01') AS gt, 0 >= date('2024-01-01') AS ge"
    expect:
      rows:
        - [false, true, null, null, null, null]

  - name: gql_number_against_datetime
    query: "RETURN 0 = DATETIME '2024-01-01T10:00:00' AS eq, 0 <> DATETIME '2024-01-01T10:00:00' AS ne"
    expect:
      rows:
        - [false, true]

  - name: cypher_number_against_datetime
    language: cypher
    query: "RETURN 0 = localdatetime('2024-01-01T10:00:00') AS eq, 0 <> localdatetime('2024-01-01T10:00:00') AS ne, 0 < localdatetime('2024-01-01T10:00:00') AS lt, 0 <= localdatetime('2024-01-01T10:00:00') AS le, 0 > localdatetime('2024-01-01T10:00:00') AS gt, 0 >= localdatetime('2024-01-01T10:00:00') AS ge"
    expect:
      rows:
        - [false, true, null, null, null, null]

  - name: gql_number_against_time
    query: "RETURN 0 = TIME '10:00:00' AS eq, 0 <> TIME '10:00:00' AS ne"
    expect:
      rows:
        - [false, true]

  - name: cypher_number_against_time
    language: cypher
    query: "RETURN 0 = localtime('10:00:00') AS eq, 0 <> localtime('10:00:00') AS ne, 0 < localtime('10:00:00') AS lt, 0 <= localtime('10:00:00') AS le, 0 > localtime('10:00:00') AS gt, 0 >= localtime('10:00:00') AS ge"
    expect:
      rows:
        - [false, true, null, null, null, null]

  - name: gql_number_against_duration
    query: "RETURN 0 = DURATION 'P1D' AS eq, 0 <> DURATION 'P1D' AS ne"
