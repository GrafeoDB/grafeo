# Graph types in use
#
# ISO/IEC 39075 12.7: a graph type that a graph has as its type cannot be
# dropped or replaced, with or without IF EXISTS: drop the graph first. A graph
# of a type that does not exist is an invalid reference (42002).

meta:
  language: gql
  model: lpg
  section: "12.7"
  title: Graph types in use
  dataset: empty

tests:

  - name: a_graph_type_in_use_cannot_be_dropped
    setup:
      - "CREATE NODE TYPE City (name STRING NOT NULL)"
      - "CREATE GRAPH TYPE trips (NODE TYPE City)"
      - "CREATE GRAPH g TYPED trips"
    query: "DROP GRAPH TYPE trips"
    expect:
      error: "graph type 'trips' is the type of graph 'g': drop the graph first"
      gql_status: "42000"

  - name: if_exists_does_not_drop_a_graph_type_in_use
    setup:
      - "CREATE NODE TYPE City (name STRING NOT NULL)"
      - "CREATE GRAPH TYPE trips (NODE TYPE City)"
      - "CREATE GRAPH g TYPED trips"
    query: "DROP GRAPH TYPE IF EXISTS trips"
    expect:
      error: "graph type 'trips' is the type of graph 'g': drop the graph first"
      gql_status: "42000"

  - name: a_graph_type_in_use_cannot_be_replaced
    setup:
      - "CREATE NODE TYPE City (name STRING NOT NULL)"
      - "CREATE GRAPH TYPE trips (NODE TYPE City)"
      - "CREATE GRAPH g TYPED trips"
    query: "CREATE OR REPLACE GRAPH TYPE trips (NODE TYPE City)"
    expect:
      error: "graph type 'trips' is the type of graph 'g': drop the graph first"
      gql_status: "42000"

  - name: a_graph_type_whose_graph_was_dropped_can_be_dropped
    setup:
      - "CREATE NODE TYPE City (name STRING NOT NULL)"
      - "CREATE GRAPH TYPE trips (NODE TYPE City)"
      - "CREATE GRAPH g TYPED trips"
      - "DROP GRAPH g"
      - "DROP GRAPH TYPE trips"
    query: "SHOW GRAPH TYPES"
    expect:
      empty: true

  - name: a_graph_of_a_type_that_does_not_exist
    query: "CREATE GRAPH h TYPED missing"
    expect:
      error: "Type not found: missing"
      gql_status: "42002"
