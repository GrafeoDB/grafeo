# An equality on a key no index serves reads the key's column. Generated with the Rust tests in
# key_column_read.rs, which also run these reopened and thawed, with old readers, and read what
# rows_scanned says.

meta:
  language: gql
  model: lpg
  title: Read of a key's column
  dataset: empty

tests:

  - name: integers_found
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: integers_where
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k = 2 RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: integers_by_a_float
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2.0}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: integers_by_a_fraction
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2.5}) RETURN n.name"
    expect:
      empty: true

  - name: integers_inside_the_bounds
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 0}) RETURN n.name"
    expect:
      empty: true

  - name: integers_beyond_the_bounds
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 99}) RETURN n.name"
    expect:
      empty: true

  - name: integers_by_a_word
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 'Alix'}) RETURN n.name"
    expect:
      empty: true

  - name: integers_by_a_boolean
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: true}) RETURN n.name"
    expect:
      empty: true

  - name: integers_in
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k IN [1, 3, 99] RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Jules"]

  - name: integers_in_with_a_float
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k IN [1.0, 3] RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Jules"]

  - name: integers_in_with_null
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k IN [NULL, 1] RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: integers_in_nothing
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k IN [] RETURN n.name"
    expect:
      empty: true

  - name: integers_in_only_null
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k IN [NULL] RETURN n.name"
    expect:
      empty: true

  - name: floats_found
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L {k: 1.5}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: floats_by_an_integer
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: floats_a_negative_zero_by_zero
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L {k: 0.0}) RETURN n.name"
    expect:
      rows:
        - ["Jules"]

  - name: floats_a_negative_zero_by_the_integer
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L {k: 0}) RETURN n.name"
    expect:
      rows:
        - ["Jules"]

  - name: floats_in
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L) WHERE n.k IN [1.5, 2] RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]

  - name: floats_beyond_the_bounds
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L {k: 99.5}) RETURN n.name"
    expect:
      empty: true

  - name: floats_by_a_word
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L {k: 'Alix'}) RETURN n.name"
    expect:
      empty: true

  - name: strings_found
    setup:
      - "INSERT (:L {name: 'Alix', k: 'Amsterdam'}), (:L {name: 'Gus', k: 'Berlin'}), (:L {name: 'Mia', k: 'Berlin'}), (:L {name: 'Jules', k: 'berlin'}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 'Berlin'})"
    query: "MATCH (n:L {k: 'Berlin'}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: strings_by_case
    setup:
      - "INSERT (:L {name: 'Alix', k: 'Amsterdam'}), (:L {name: 'Gus', k: 'Berlin'}), (:L {name: 'Mia', k: 'Berlin'}), (:L {name: 'Jules', k: 'berlin'}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 'Berlin'})"
    query: "MATCH (n:L {k: 'berlin'}) RETURN n.name"
    expect:
      rows:
        - ["Jules"]

  - name: strings_missing
    setup:
      - "INSERT (:L {name: 'Alix', k: 'Amsterdam'}), (:L {name: 'Gus', k: 'Berlin'}), (:L {name: 'Mia', k: 'Berlin'}), (:L {name: 'Jules', k: 'berlin'}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 'Berlin'})"
    query: "MATCH (n:L {k: 'Paris'}) RETURN n.name"
    expect:
      empty: true

  - name: strings_empty
    setup:
      - "INSERT (:L {name: 'Alix', k: 'Amsterdam'}), (:L {name: 'Gus', k: 'Berlin'}), (:L {name: 'Mia', k: 'Berlin'}), (:L {name: 'Jules', k: 'berlin'}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 'Berlin'})"
    query: "MATCH (n:L {k: ''}) RETURN n.name"
    expect:
      empty: true

  - name: strings_by_an_integer
    setup:
      - "INSERT (:L {name: 'Alix', k: 'Amsterdam'}), (:L {name: 'Gus', k: 'Berlin'}), (:L {name: 'Mia', k: 'Berlin'}), (:L {name: 'Jules', k: 'berlin'}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 'Berlin'})"
    query: "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      empty: true

  - name: strings_in
    setup:
      - "INSERT (:L {name: 'Alix', k: 'Amsterdam'}), (:L {name: 'Gus', k: 'Berlin'}), (:L {name: 'Mia', k: 'Berlin'}), (:L {name: 'Jules', k: 'berlin'}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 'Berlin'})"
    query: "MATCH (n:L) WHERE n.k IN ['Amsterdam', 'berlin', 'Paris'] RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Jules"]

  - name: booleans_found
    setup:
      - "INSERT (:L {name: 'Alix', k: true}), (:L {name: 'Gus', k: false}), (:L {name: 'Mia', k: false}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: false})"
    query: "MATCH (n:L {k: false}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: booleans_true
    setup:
      - "INSERT (:L {name: 'Alix', k: true}), (:L {name: 'Gus', k: false}), (:L {name: 'Mia', k: false}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: false})"
    query: "MATCH (n:L {k: true}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: booleans_by_an_integer
    setup:
      - "INSERT (:L {name: 'Alix', k: true}), (:L {name: 'Gus', k: false}), (:L {name: 'Mia', k: false}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: false})"
    query: "MATCH (n:L {k: 1}) RETURN n.name"
    expect:
      empty: true

  - name: mixed_an_integer
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 'Berlin'}), (:L {name: 'Vincent', k: true}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: mixed_finds_both_numbers
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 'Berlin'}), (:L {name: 'Vincent', k: true}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: mixed_finds_both_numbers_by_a_float
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 'Berlin'}), (:L {name: 'Vincent', k: true}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2.0}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: mixed_a_string
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 'Berlin'}), (:L {name: 'Vincent', k: true}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 'Berlin'}) RETURN n.name"
    expect:
      rows:
        - ["Jules"]

  - name: mixed_a_boolean
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 'Berlin'}), (:L {name: 'Vincent', k: true}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: true}) RETURN n.name"
    expect:
      rows:
        - ["Vincent"]

  - name: mixed_in_each_kind
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 'Berlin'}), (:L {name: 'Vincent', k: true}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k IN [1, 'Berlin', true] RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Jules"]
        - ["Vincent"]

  - name: a_key_no_node_holds
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {none: 1}) RETURN n.name"
    expect:
      empty: true

  - name: a_key_no_node_holds_beside_one
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2, none: 1}) RETURN n.name"
    expect:
      empty: true

  - name: is_null_is_not_an_equality
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k IS NULL RETURN n.name"
    expect:
      rows:
        - ["Hans"]

  - name: two_keys
    setup:
      - "INSERT (:L {name: 'Alix', a: 1, b: 1}), (:L {name: 'Gus', a: 1, b: 2}), (:L {name: 'Mia', a: 2, b: 1})"
    query: "MATCH (n:L {a: 1, b: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: two_keys_the_other_first
    setup:
      - "INSERT (:L {name: 'Alix', a: 1, b: 1}), (:L {name: 'Gus', a: 1, b: 2}), (:L {name: 'Mia', a: 2, b: 1})"
    query: "MATCH (n:L {b: 1, a: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: with_a_range
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L) WHERE n.k = 2 AND n.name > 'H' RETURN n.name"
    expect:
      rows:
        - ["Mia"]

  - name: with_another_check
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) WHERE n.name <> 'Gus' RETURN n.name"
    expect:
      rows:
        - ["Mia"]

  - name: found_then_a_hop
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
      - "MATCH (a:L {name: 'Gus'}), (b:L {name: 'Alix'}) INSERT (a)-[:R]->(b)"
    query: "MATCH (n:L {k: 2})-[:R]->(m) RETURN m.name"
    expect:
      rows:
        - ["Alix"]

  - name: a_second_match
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 1}) MATCH (m:L {k: 3}) RETURN n.name, m.name"
    expect:
      rows:
        - ["Alix", "Jules"]

  - name: optional_finds_nothing
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "OPTIONAL MATCH (n:L {k: 99}) RETURN n.name"
    expect:
      rows:
        - [null]

  - name: optional_finds
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "OPTIONAL MATCH (n:L {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: count_of_none
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 99}) RETURN count(n) AS c"
    expect:
      rows:
        - [0]

  - name: sum_of_found
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN sum(n.k) AS s"
    expect:
      rows:
        - [4]

  - name: limit
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name ORDER BY n.name LIMIT 1"
    expect:
      rows:
        - ["Gus"]

  - name: in_row_order
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name LIMIT 2"
    expect:
      ordered: true
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: label
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n:A {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Vincent"]

  - name: label_and
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n:A&B {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Vincent"]

  - name: label_or
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n:A|B {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Vincent"]

  - name: label_not
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n:!A {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Jules"]
        - ["Mia"]

  - name: label_any
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n:% {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Jules"]
        - ["Vincent"]

  - name: no_label
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Jules"]
        - ["Mia"]
        - ["Vincent"]

  - name: label_nobody_has
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n:Absent {k: 1}) RETURN n.name"
    expect:
      empty: true

  - name: label_or_nobody_has
    setup:
      - "INSERT (:A {name: 'Alix', k: 1}), (:B {name: 'Gus', k: 1}), (:A:B {name: 'Vincent', k: 1}), (:C {name: 'Jules', k: 1}), ({name: 'Mia', k: 1}), (:A {name: 'Butch', k: 2})"
    query: "MATCH (n:A|Absent {k: 1}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Vincent"]

  - name: after_an_update
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Alix'}) SET n.k = 2"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]

  - name: after_an_update_the_old_value
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Alix'}) SET n.k = 2"
      - "MATCH (n:L {k: 1}) RETURN n.name"
    expect:
      empty: true

  - name: after_an_update_to_a_string
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Alix'}) SET n.k = 'Berlin'"
      - "MATCH (n:L {k: 'Berlin'}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_an_update_to_a_string_the_others
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Alix'}) SET n.k = 'Berlin'"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: after_a_delete
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Gus'}) DELETE n"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Mia"]

  - name: after_a_removed_value
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Gus'}) REMOVE n.k"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Mia"]

  - name: after_a_removed_label
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Gus'}) REMOVE n:L"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Mia"]

  - name: after_an_added_label
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:M {name: 'Butch'}) SET n:L"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Butch"]
        - ["Gus"]
        - ["Mia"]

  - name: after_a_value_on_a_row_with_none
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "MATCH (n:L {name: 'Hans'}) SET n.k = 2"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Hans"]
        - ["Mia"]

  - name: after_an_insert
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    statements:
      - "INSERT (:L {name: 'Vincent', k: 2})"
      - "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]
        - ["Mia"]
        - ["Vincent"]

  - name: another_graph
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
      - "CREATE GRAPH g"
      - "USE GRAPH g"
      - "INSERT (:L {name: 'Vincent', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name"
    expect:
      rows:
        - ["Vincent"]

  - name: a_string_by_an_integer
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 42}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]

  - name: a_string_by_a_float
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 42.0e0}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]
        - ["Jules"]
        - ["Vincent"]

  - name: a_string_by_a_string
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: '042'}) RETURN n.name"
    expect:
      rows:
        - ["Gus"]

  - name: a_string_by_its_own_text
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: '42'}) RETURN n.name"
    expect:
      rows:
        - ["Alix"]

  - name: a_string_by_a_near_text
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: '42 '}) RETURN n.name"
    expect:
      empty: true

  - name: a_string_in_a_list_of_numbers
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L) WHERE n.k IN [42, 0] RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Marcus"]
        - ["Harm"]
        - ["Mia"]

  - name: a_string_by_zero
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 0}) RETURN n.name"
    expect:
      rows:
        - ["Harm"]
        - ["Marcus"]

  - name: a_string_by_infinity
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: Infinity}) RETURN n.name"
    expect:
      rows:
        - ["Hans"]

  - name: a_string_by_nan
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: NaN}) RETURN n.name"
    expect:
      empty: true

  - name: nan_as_a_string
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 'nan'}) RETURN n.name"
    expect:
      rows:
        - ["Django"]

  - name: inf_as_a_string
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 'inf'}) RETURN n.name"
    expect:
      rows:
        - ["Hans"]

  - name: the_empty_string
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: ''}) RETURN n.name"
    expect:
      rows:
        - ["Shosanna"]

  - name: no_number_finds_the_empty_string
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 1}) RETURN n.name"
    expect:
      empty: true

  - name: a_string_that_reads_as_no_number
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 'abc'}) RETURN n.name"
    expect:
      rows:
        - ["Lucas"]

  - name: limit_over_integers
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name LIMIT 1"
    expect:
      ordered: true
      rows:
        - ["Gus"]

  - name: limit_over_floats
    setup:
      - "INSERT (:L {name: 'Alix', k: 1.5}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2.0}), (:L {name: 'Jules', k: -0.0}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2.0})"
    query: "MATCH (n:L {k: 2.0}) RETURN n.name LIMIT 1"
    expect:
      ordered: true
      rows:
        - ["Gus"]

  - name: limit_over_strings
    setup:
      - "INSERT (:L {name: 'Alix', k: 'Amsterdam'}), (:L {name: 'Gus', k: 'Berlin'}), (:L {name: 'Mia', k: 'Berlin'}), (:L {name: 'Jules', k: 'berlin'}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 'Berlin'})"
    query: "MATCH (n:L {k: 'Berlin'}) RETURN n.name LIMIT 1"
    expect:
      ordered: true
      rows:
        - ["Gus"]

  - name: limit_over_booleans
    setup:
      - "INSERT (:L {name: 'Alix', k: true}), (:L {name: 'Gus', k: false}), (:L {name: 'Mia', k: false}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: false})"
    query: "MATCH (n:L {k: false}) RETURN n.name LIMIT 1"
    expect:
      ordered: true
      rows:
        - ["Gus"]

  - name: limit_over_mixed
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2.0}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 'Berlin'}), (:L {name: 'Vincent', k: true}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name LIMIT 1"
    expect:
      ordered: true
      rows:
        - ["Gus"]

  - name: limit_over_number_strings
    setup:
      - "INSERT (:L {name: 'Alix', k: '42'}), (:L {name: 'Gus', k: '042'}), (:L {name: 'Mia', k: '+42'}), (:L {name: 'Jules', k: '42.0'}), (:L {name: 'Vincent', k: '4.2e1'}), (:L {name: 'Butch', k: ' 42'}), (:L {name: 'Django', k: 'nan'}), (:L {name: 'Hans', k: 'inf'}), (:L {name: 'Shosanna', k: ''}), (:L {name: 'Lucas', k: 'abc'}), (:L {name: 'Marcus', k: '0'}), (:L {name: 'Harm', k: '-0'})"
    query: "MATCH (n:L {k: 42}) RETURN n.name LIMIT 2"
    expect:
      ordered: true
      rows:
        - ["Alix"]
        - ["Gus"]

  - name: limit_skips_the_first
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name SKIP 1 LIMIT 1"
    expect:
      ordered: true
      rows:
        - ["Mia"]

  - name: limit_past_the_end
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 2}) RETURN n.name LIMIT 99"
    expect:
      ordered: true
      rows:
        - ["Gus"]
        - ["Mia"]

  - name: limit_of_none_found
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 2}), (:L {name: 'Jules', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 2})"
    query: "MATCH (n:L {k: 99}) RETURN n.name LIMIT 1"
    expect:
      empty: true

  - name: after_a_write_no_index_equality
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t:Hub {c: 4}) RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_no_index_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t:Hub) WHERE t.c IN [4, 5] RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_no_index_no_label
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t {c: 4}) RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_no_index_no_label_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t) WHERE t.c IN [4, 5] RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_no_index_the_old_value
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
    query: "MATCH (h:Hub) SET h.c = 9 WITH h OPTIONAL MATCH (t:Hub {c: 1}) RETURN t.name"
    expect:
      rows:
        - [null]

  - name: after_a_write_no_index_the_old_value_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
    query: "MATCH (h:Hub) SET h.c = 9 WITH h OPTIONAL MATCH (t:Hub) WHERE t.c IN [1, 2] RETURN t.name"
    expect:
      rows:
        - [null]

  - name: after_a_write_an_index_equality
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_hub FOR (n:Hub) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t:Hub {c: 4}) RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_hub FOR (n:Hub) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t:Hub) WHERE t.c IN [4, 5] RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_no_label
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_hub FOR (n:Hub) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t {c: 4}) RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_no_label_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_hub FOR (n:Hub) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t) WHERE t.c IN [4, 5] RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_the_old_value
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_hub FOR (n:Hub) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 9 WITH h OPTIONAL MATCH (t:Hub {c: 1}) RETURN t.name"
    expect:
      rows:
        - [null]

  - name: after_a_write_an_index_the_old_value_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_hub FOR (n:Hub) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 9 WITH h OPTIONAL MATCH (t:Hub) WHERE t.c IN [1, 2] RETURN t.name"
    expect:
      rows:
        - [null]

  - name: after_a_write_an_index_of_another_label_equality
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_other FOR (n:Other) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t:Hub {c: 4}) RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_of_another_label_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_other FOR (n:Other) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t:Hub) WHERE t.c IN [4, 5] RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_of_another_label_no_label
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_other FOR (n:Other) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t {c: 4}) RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_of_another_label_no_label_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_other FOR (n:Other) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 4 WITH h OPTIONAL MATCH (t) WHERE t.c IN [4, 5] RETURN t.name"
    expect:
      rows:
        - ["Alix"]

  - name: after_a_write_an_index_of_another_label_the_old_value
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_other FOR (n:Other) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 9 WITH h OPTIONAL MATCH (t:Hub {c: 1}) RETURN t.name"
    expect:
      rows:
        - [null]

  - name: after_a_write_an_index_of_another_label_the_old_value_in
    setup:
      - "INSERT (:Hub {name: 'Alix', c: 1})"
      - "CREATE INDEX on_other FOR (n:Other) ON (n.c)"
    query: "MATCH (h:Hub) SET h.c = 9 WITH h OPTIONAL MATCH (t:Hub) WHERE t.c IN [1, 2] RETURN t.name"
    expect:
      rows:
        - [null]

  # A list as long as the rows it is read among: its rows are the same on either side.
  - name: list_shorter_than_a_label
    setup:
      - "INSERT (:Few {k: 0}), (:Few {k: 1}), (:Few {k: 2}), (:Many {k: 3}), (:Many {k: 4}), (:Many {k: 5}), (:Many {k: 6})"
    query: "MATCH (n:Few) WHERE n.k IN [0, 1] RETURN n.k ORDER BY n.k"
    expect:
      ordered: true
      rows:
        - [0]
        - [1]

  - name: list_as_long_as_a_label
    setup:
      - "INSERT (:Few {k: 0}), (:Few {k: 1}), (:Few {k: 2}), (:Many {k: 3}), (:Many {k: 4}), (:Many {k: 5}), (:Many {k: 6})"
    query: "MATCH (n:Few) WHERE n.k IN [0, 2, 3] RETURN n.k ORDER BY n.k"
    expect:
      ordered: true
      rows:
        - [0]
        - [2]

  - name: list_longer_than_a_label
    setup:
      - "INSERT (:Few {k: 0}), (:Few {k: 1}), (:Few {k: 2}), (:Many {k: 3}), (:Many {k: 4}), (:Many {k: 5}), (:Many {k: 6})"
    query: "MATCH (n:Few) WHERE n.k IN [0, 1, 2, 3, 4, 5] RETURN n.k ORDER BY n.k"
    expect:
      ordered: true
      rows:
        - [0]
        - [1]
        - [2]

  - name: list_as_long_as_a_union
    setup:
      - "INSERT (:Few {k: 0}), (:Few {k: 1}), (:Pair {k: 2}), (:Many {k: 3}), (:Many {k: 4})"
    query: "MATCH (n:Few|Pair) WHERE n.k IN [0, 2, 3] RETURN n.k ORDER BY n.k"
    expect:
      ordered: true
      rows:
        - [0]
        - [2]

  - name: list_as_long_as_every_node
    setup:
      - "INSERT (:Few {k: 0}), (:Few {k: 1}), (:Pair {k: 2})"
    query: "MATCH (n) WHERE n.k IN [0, 2, 9] RETURN n.k ORDER BY n.k"
    expect:
      ordered: true
      rows:
        - [0]
        - [2]

  - name: list_of_a_repeated_key_as_long_as_a_label
    setup:
      - "INSERT (:Few {k: 0}), (:Few {k: 1}), (:Many {k: 0})"
    query: "MATCH (n:Few) WHERE n.k IN [0, 0] RETURN n.k"
    expect:
      rows:
        - [0]

  - name: list_of_spellings_as_long_as_a_label
    setup:
      - "INSERT (:Few {k: '042'}), (:Few {k: 42}), (:Few {k: '42.0'}), (:Many {k: 42})"
    query: "MATCH (n:Few) WHERE n.k IN [42, 7, 8] RETURN n.k"
    expect:
      count: 2

  # A key text ending in another digit, and in the same one.
  - name: number_key_over_text_with_another_last_digit
    setup:
      - "INSERT (:T {k: '41'}), (:T {k: '42'}), (:T {k: '042'}), (:T {k: '+42'}), (:T {k: '-42'}), (:T {k: '42 '}), (:T {k: ''}), (:T {k: 'a2'})"
    query: "MATCH (n:T {k: 42}) RETURN n.k"
    expect:
      count: 3

  - name: negative_key_over_text_with_its_last_digit
    setup:
      - "INSERT (:T {k: '-7'}), (:T {k: '7'}), (:T {k: '-07'}), (:T {k: '-8'})"
    query: "MATCH (n:T {k: -7}) RETURN n.k"
    expect:
      count: 2

  - name: union_of_a_label_with_no_node
    setup:
      - "INSERT (:A {k: 5}), (:B {k: 5}), (:C {k: 5})"
    query: "MATCH (n:A|Nobody {k: 5}) RETURN labels(n) AS l"
    expect:
      count: 1
