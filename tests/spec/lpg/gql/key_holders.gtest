# Whoever holds a key is found once, whichever way it is looked up and whichever labels are
# indexed: a node of one label, of two, of a label with no index, and of none. Generated from one
# table with the Rust tests in key_holders.rs. A key-wide index cannot be made from a query, so
# the Rust tests cover that.

meta:
  language: gql
  model: lpg
  title: Who holds a key
  dataset: key_holders

tests:

  - name: label_far_no_index
    query: "MATCH (n:Far {k: 7}) RETURN n.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: label_far_on_far
    setup:
      - "CREATE INDEX on_far FOR (n:Far) ON (n.k)"
    query: "MATCH (n:Far {k: 7}) RETURN n.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: label_far_on_near
    setup:
      - "CREATE INDEX on_near FOR (n:Near) ON (n.k)"
    query: "MATCH (n:Far {k: 7}) RETURN n.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: label_far_on_far_near
    setup:
      - "CREATE INDEX on_far FOR (n:Far) ON (n.k)"
      - "CREATE INDEX on_near FOR (n:Near) ON (n.k)"
    query: "MATCH (n:Far {k: 7}) RETURN n.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: label_far_on_every_label
    setup:
      - "CREATE INDEX on_far FOR (n:Far) ON (n.k)"
      - "CREATE INDEX on_near FOR (n:Near) ON (n.k)"
      - "CREATE INDEX on_other FOR (n:Other) ON (n.k)"
    query: "MATCH (n:Far {k: 7}) RETURN n.name"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: label_near_no_index
    query: "MATCH (n:Near {k: 7}) RETURN n.name"
    expect:
      rows:
        - [Gus]
        - [Vincent]

  - name: label_near_on_far
