# #743: a NODE KEY is the values of its properties taken together. No two nodes of the label hold the
# same values, and every node of the label holds a value for each property: UNIQUE over the tuple plus
# NOT NULL on each property, on insert, update and a label added, checked at each write (a swap in one
# SET is refused), in each graph on its own, and refused with GRAFEO-V001. node_key_claims.rs also
# covers existing data, transactions, the index it builds, the direct API, a reopen, a crash and replay,
# and the comparison with UNIQUE and NOT NULL.

meta:
  language: gql
  model: lpg
  title: NODE KEY constraints
  dataset: empty

tests:

  - name: the_same_tuple_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    query: "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    expect:
      error: ""

  - name: one_property_alone_may_repeat
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
      - "INSERT (:Person {first: 'Alix', last: 'Mia'})"
      - "INSERT (:Person {first: 'Vincent', last: 'Gus'})"
    query: "MATCH (p:Person) RETURN count(p) AS c"
    expect:
      rows:
        - [3]

  - name: a_missing_key_property_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
    query: "INSERT (:Person {first: 'Mia'})"
    expect:
      error: ""

  - name: a_null_key_property_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
    query: "INSERT (:Person {first: 'Mia', last: null})"
    expect:
      error: ""

  - name: removing_a_key_property_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    query: "MATCH (p:Person {first: 'Alix'}) REMOVE p.last"
    expect:
      error: ""

  - name: an_update_to_a_taken_key_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'}), (:Person {first: 'Vincent', last: 'Gus'})"
    query: "MATCH (p:Person {first: 'Vincent'}) SET p.first = 'Alix'"
    expect:
      error: ""

  - name: an_update_to_a_free_key_is_taken
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'}), (:Person {first: 'Vincent', last: 'Gus'})"
      - "MATCH (p:Person {first: 'Vincent'}) SET p.last = 'Mia'"
    query: "MATCH (p:Person {first: 'Vincent'}) RETURN p.last AS l"
    expect:
      rows:
        - ["Mia"]

  - name: a_label_added_with_a_taken_key_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'}), (:Guest {first: 'Alix', last: 'Gus'})"
    query: "MATCH (g:Guest) SET g:Person"
    expect:
      error: ""

  - name: a_label_added_without_a_key_property_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Guest {first: 'Mia'})"
    query: "MATCH (g:Guest) SET g:Person"
    expect:
      error: ""

  - name: existing_duplicates_refuse_the_constraint
    setup:
      - "INSERT (:Person {first: 'Alix', last: 'Gus'}), (:Person {first: 'Alix', last: 'Gus'})"
    query: "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
    expect:
      error: ""

  - name: another_label_is_not_held
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'}), (:Other {first: 'Alix', last: 'Gus'}), (:Other {first: 'Mia'})"
    query: "MATCH (o:Other) RETURN count(o) AS c"
    expect:
      rows:
        - [2]

  - name: cypher_writes_the_same_key
    language: cypher
    requires: [cypher]
    statements:
      - "CREATE CONSTRAINT person_key FOR (p:Person) REQUIRE (p.first, p.last) IS NODE KEY"
      - "CREATE (:Person {first: 'Alix', last: 'Gus'})"
      - "CREATE (:Person {first: 'Alix', last: 'Gus'})"
    expect:
      error: ""

  - name: setting_a_key_property_to_null_is_refused
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    query: "MATCH (p:Person) SET p.last = null"
    expect:
      error: "GRAFEO-V001"

  - name: a_swap_in_one_set_is_refused_at_its_first_write
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus', n: 1}), (:Person {first: 'Alix', last: 'Mia', n: 2})"
    query: "MATCH (a:Person {n: 1}), (b:Person {n: 2}) SET a.last = 'Mia', b.last = 'Gus'"
    expect:
      error: "GRAFEO-V001"

  - name: a_key_moves_through_a_free_value
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus', n: 1}), (:Person {first: 'Alix', last: 'Mia', n: 2})"
      - "MATCH (a:Person {n: 1}) SET a.last = 'Gus (moving)'"
      - "MATCH (b:Person {n: 2}) SET b.last = 'Gus'"
      - "MATCH (a:Person {n: 1}) SET a.last = 'Mia'"
    query: "MATCH (p:Person) RETURN p.n AS n, p.last AS last ORDER BY n"
    expect:
      ordered: true
      rows:
        - [1, "Mia"]
        - [2, "Gus"]

  - name: a_key_taken_in_another_graph_is_free_here
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
      - "CREATE GRAPH branch"
      - "USE GRAPH branch"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    query: "MATCH (p:Person) RETURN count(p) AS c"
    expect:
      rows:
        - [1]

  - name: a_key_taken_in_this_graph_is_refused_here
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "CREATE GRAPH branch"
      - "USE GRAPH branch"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    query: "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    expect:
      error: "GRAFEO-V001"

  - name: the_key_is_required_in_every_graph
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "CREATE GRAPH branch"
      - "USE GRAPH branch"
    query: "INSERT (:Person {first: 'Mia'})"
    expect:
      error: "GRAFEO-V001"

  - name: a_duplicate_is_a_schema_violation
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    query: "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    expect:
      error: "GRAFEO-V001"

  - name: a_missing_key_property_is_a_schema_violation
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
    query: "INSERT (:Person {first: 'Mia'})"
    expect:
      error: "GRAFEO-V001"

  - name: a_removed_key_property_is_a_schema_violation
    setup:
      - "CREATE CONSTRAINT person_key FOR (p:Person) ON (p.first, p.last) NODE KEY"
      - "INSERT (:Person {first: 'Alix', last: 'Gus'})"
    query: "MATCH (p:Person) REMOVE p.first"
    expect:
      error: "GRAFEO-V001"
