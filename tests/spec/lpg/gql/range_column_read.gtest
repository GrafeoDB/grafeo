# A range on a key reads the key's column and answers as the filter it stands for, by GA04 b: two
# values of one kind compare as their kind does, two of different kinds by kind in GQL (dates, text,
# booleans, numbers) and not at all in Cypher; a string never reads as a number. Generated with a model
# of the rule; range_column_read.rs runs these over more kinds, reopened and thawed, with old readers,
# and reads what rows_scanned says.

meta:
  language: gql
  model: lpg
  title: Read of a range on a key
  dataset: empty

tests:

  - name: integers_above_int_0
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 1})"
    query: "MATCH (n:L) WHERE n.k > 0 RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]

  - name: cypher_integers_above_int_0
    language: cypher
    requires: [cypher]
    setup:
      - "CREATE (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 1})"
    query: "MATCH (n:L) WHERE n.k > 0 RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]

  - name: integers_from_int_0
    setup:
      - "INSERT (:L {name: 'Alix', k: 1}), (:L {name: 'Gus', k: 2}), (:L {name: 'Mia', k: 3}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: 1})"
    query: "MATCH (n:L) WHERE n.k >= 0 RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]

  - name: cypher_integers_from_int_0
    language: cypher
    requires: [cypher]
