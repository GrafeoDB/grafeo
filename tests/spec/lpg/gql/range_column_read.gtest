      - "CREATE (:L {name: 'Alix', k: date('2024-01-01')}), (:L {name: 'Gus', k: date('2024-06-15')}), (:L {name: 'Mia', k: date('2025-01-01')}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: date('2024-01-01')})"
    query: "MATCH (n:L) WHERE n.k <= '2024' RETURN n.name"
    expect:
      empty: true

  - name: dates_between
    setup:
      - "INSERT (:L {name: 'Alix', k: date('2024-01-01')}), (:L {name: 'Gus', k: date('2024-06-15')}), (:L {name: 'Mia', k: date('2025-01-01')}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: date('2024-01-01')})"
    query: "MATCH (n:L) WHERE n.k >= date('2024-01-01') AND n.k <= date('2024-06-15') RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]

  - name: dates_bound_first
    setup:
      - "INSERT (:L {name: 'Alix', k: date('2024-01-01')}), (:L {name: 'Gus', k: date('2024-06-15')}), (:L {name: 'Mia', k: date('2025-01-01')}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: date('2024-01-01')})"
    query: "MATCH (n:L) WHERE date('2024-01-01') <= n.k RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]

  - name: dates_no_label
    setup:
      - "INSERT (:L {name: 'Alix', k: date('2024-01-01')}), (:L {name: 'Gus', k: date('2024-06-15')}), (:L {name: 'Mia', k: date('2025-01-01')}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: date('2024-01-01')})"
    query: "MATCH (n) WHERE n.k >= date('2024-01-01') RETURN n.name"
    expect:
      rows:
        - ["Alix"]
        - ["Gus"]
        - ["Mia"]
        - ["Butch"]

  - name: dates_null_bound
    setup:
      - "INSERT (:L {name: 'Alix', k: date('2024-01-01')}), (:L {name: 'Gus', k: date('2024-06-15')}), (:L {name: 'Mia', k: date('2025-01-01')}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: date('2024-01-01')})"
    query: "MATCH (n:L) WHERE n.k > null RETURN n.name"
    expect:
      empty: true

  - name: dates_key_no_node_holds
    setup:
      - "INSERT (:L {name: 'Alix', k: date('2024-01-01')}), (:L {name: 'Gus', k: date('2024-06-15')}), (:L {name: 'Mia', k: date('2025-01-01')}), (:L {name: 'Hans'}), (:M {name: 'Butch', k: date('2024-01-01')})"
    query: "MATCH (n:L) WHERE n.nothing >= date('2024-01-01') RETURN n.name"
    expect:
      empty: true
