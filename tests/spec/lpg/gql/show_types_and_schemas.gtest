# SHOW EDGE TYPES, SHOW GRAPH TYPES and SHOW SCHEMAS
#
# The catalog lists what DDL declared: an edge type with its properties and
# endpoint node types, a graph type with whether it is open and its member
# types, and the schemas. Types declared outside a schema are not listed
# inside it.

meta:
  language: gql
  model: lpg
  section: "16.13"
  title: SHOW types and schemas
  dataset: empty

tests:

  - name: show_edge_types
    setup:
      - "CREATE NODE TYPE City (name STRING NOT NULL)"
      - "CREATE EDGE TYPE ROUTE CONNECTING (City) TO (City) (km INT64 NOT NULL)"
    query: "SHOW EDGE TYPES"
    expect:
      columns: [name, properties, source_types, target_types]
      rows:
        - [ROUTE, "km INT64 NOT NULL", City, City]

  - name: show_graph_types
    setup:
      - "CREATE NODE TYPE City (name STRING NOT NULL)"
      - "CREATE EDGE TYPE ROUTE CONNECTING (City) TO (City) (km INT64 NOT NULL)"
      - "CREATE GRAPH TYPE trips (NODE TYPE City, EDGE TYPE ROUTE)"
    query: "SHOW GRAPH TYPES"
    expect:
      columns: [name, open, node_types, edge_types]
      rows:
        - [trips, false, City, ROUTE]

  - name: show_schemas
    setup:
      - "CREATE SCHEMA s1"
      - "CREATE SCHEMA s2"
    query: "SHOW SCHEMAS"
    expect:
      columns: [name]
      rows:
        - [s1]
        - [s2]

  - name: no_schemas_at_first
    query: "SHOW SCHEMAS"
    expect:
      empty: true

  - name: types_declared_outside_a_schema_are_not_listed_in_it
    statements:
      - "CREATE NODE TYPE City (name STRING NOT NULL)"
      - "CREATE EDGE TYPE ROUTE CONNECTING (City) TO (City)"
      - "CREATE SCHEMA s1"
      - "SESSION SET SCHEMA s1"
      - "SHOW EDGE TYPES"
    expect:
      empty: true
