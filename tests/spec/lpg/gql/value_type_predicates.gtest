# Value type predicates: IS TYPED and IS NOT TYPED
#
# ISO/IEC 39075 value type predicate: `x IS TYPED t` is true when the value of
# x is of type t, and IS NOT TYPED is its negation. A node is of type NODE, an
# edge of EDGE, and every non-null value of ANY; the null value is of the
# NULL type. The types are those of type DDL (two-word ones and nested
# LIST<...> included), plus NULL, PATH, GRAPH and NOTHING (of which no value
# is). A name that is no type is a syntax error (42001); an ISO type the
# predicate cannot decide yet, as INT32 for an integer, is not supported (42000).
# NODE, EDGE, ANY, ZONED DATETIME and nested lists were false or a syntax
# error before.

meta:
  language: gql
  model: lpg
  section: "19.7"
  title: Value type predicates
  dataset: social_network

tests:

  - name: scalar_values_are_of_their_types
    query: "RETURN 3 IS TYPED INT64 AS i, 'x' IS TYPED STRING AS s, 1.5e0 IS TYPED FLOAT64 AS f, true IS TYPED BOOLEAN AS b, [1] IS TYPED LIST AS l"
    expect:
      rows:
        - [true, true, true, true, true]

  - name: a_value_of_another_type
    query: "RETURN 3 IS TYPED STRING AS s, 'x' IS TYPED INT64 AS i, [1] IS TYPED BOOLEAN AS b"
    expect:
      rows:
        - [false, false, false]

  - name: is_not_typed_is_the_negation
    query: "RETURN 3 IS NOT TYPED STRING AS s, 3 IS NOT TYPED INT64 AS i"
    expect:
      rows:
        - [true, false]

  - name: a_property_value_is_of_its_type
    query: "MATCH (p:Person {name: 'Alix'}) RETURN p.age IS TYPED INT64 AS age, p.name IS TYPED STRING AS name"
    expect:
      rows:
        - [true, true]

  - name: a_node_is_of_type_node
    query: "MATCH (p:Person {name: 'Alix'}) RETURN p IS TYPED NODE AS r"
    expect:
      rows:
        - [true]

  - name: an_edge_is_of_type_edge
    query: "MATCH (:Person {name: 'Alix'})-[k:KNOWS]->() RETURN k IS TYPED EDGE AS r"
    expect:
      rows:
        - [true]

  - name: every_value_is_of_type_any
    query: "RETURN 3 IS TYPED ANY AS i, 'x' IS TYPED ANY AS s"
    expect:
      rows:
        - [true, true]

  - name: a_two_word_type
    query: "RETURN zoned_datetime('2024-03-15T10:00:00Z') IS TYPED ZONED DATETIME AS r"
    expect:
      rows:
        - [true]

  - name: a_nested_list_type
    query: "RETURN [[1]] IS TYPED LIST<LIST<INT64>> AS r"
    expect:
      rows:
        - [true]

  - name: a_list_of_its_item_type
    query: "RETURN [1, 2] IS TYPED LIST<INT64> AS ints, [1, 'x'] IS TYPED LIST<INT64> AS mixed, [1, null] IS TYPED LIST<INT64> AS with_null"
    expect:
      rows:
        - [true, false, true]

  - name: local_datetime_and_its_aliases
    query: "RETURN datetime('2024-03-15T10:00:00') IS TYPED LOCAL DATETIME AS local, datetime('2024-03-15T10:00:00') IS TYPED DATETIME AS alias, datetime('2024-03-15T10:00:00') IS TYPED ZONED DATETIME AS zoned"
    expect:
      rows:
        - [true, true, false]

  - name: a_decimal_type_with_precision_and_scale
    query: "RETURN 1.25 IS TYPED DECIMAL AS any_scale, 1.25 IS TYPED DECIMAL(6, 2) AS fits, 12345.6 IS TYPED DECIMAL(6, 2) AS too_many_digits"
    expect:
      rows:
        - [true, true, false]

  - name: null_is_of_the_null_type_only
    query: "RETURN null IS TYPED NULL AS null_type, null IS TYPED INT64 AS int64, 3 IS TYPED NULL AS three"
    expect:
      rows:
        - [true, false, false]

  - name: a_path_is_of_type_path
    query: "MATCH p = (:Person {name: 'Alix'})-[:KNOWS]->() RETURN p IS TYPED PATH AS path, p IS TYPED NODE AS node"
    expect:
      rows:
        - [true, false]

  - name: a_map_is_not_a_node
    query: "RETURN {name: 'Alix'} IS TYPED NODE AS node, {name: 'Alix'} IS TYPED MAP AS map"
    expect:
      rows:
        - [false, true]

  - name: a_name_that_is_no_type_is_a_syntax_error
    query: "RETURN 3 IS TYPED STIRNG AS r"
    expect:
      error: "'STIRNG' is not a property type"
      gql_status: "42001"

  - name: an_iso_type_the_predicate_cannot_decide_is_not_supported
    query: "RETURN 3 IS TYPED INT32 AS r"
    expect:
      error: "IS TYPED INT32 is not supported yet"
      gql_status: "42000"

  - name: zoned_time_is_not_supported
    query: "RETURN time('10:00:00') IS TYPED ZONED TIME AS r"
    expect:
      error: "IS TYPED ZONED TIME is not supported yet"
      gql_status: "42000"

  - name: a_node_is_not_of_its_id_type
    query: "MATCH (p:Person {name: 'Alix'}) RETURN p IS TYPED INT64 AS int64, p IS TYPED ANY AS any, p IS NOT TYPED NODE AS not_node"
    expect:
      rows:
        - [false, true, false]

  - name: no_value_is_a_graph_or_of_nothing
    query: "RETURN 'Alix' IS TYPED GRAPH AS graph, 3 IS TYPED NOTHING AS nothing, 'Alix' IS NOT TYPED GRAPH AS not_graph"
    expect:
      rows:
        - [false, false, true]
