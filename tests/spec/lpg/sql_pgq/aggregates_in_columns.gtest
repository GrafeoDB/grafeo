# SQL/PGQ: an aggregate in the COLUMNS of GRAPH_TABLE
#
# COLUMNS gives one row per match of the pattern and cannot aggregate the
# matches; the outer SELECT does (ISO/IEC 9075-16). An aggregate in a column
# is a 42000 error that says so and names the column, whatever the outer
# SELECT lists (it gave the GQL hint about RETURN and WITH when the SELECT
# named columns).

meta:
  language: sql-pgq
  model: lpg
  section: "4.39"
  title: Aggregates in COLUMNS
  dataset: social_network

tests:

  - name: an_aggregate_in_columns_under_a_select_of_columns
    query: |
      SELECT cnt FROM GRAPH_TABLE (
        MATCH (p:Person)
        COLUMNS (count(p) AS cnt)
      )
    expect:
      error: "aggregate count in the COLUMNS of GRAPH_TABLE (column 'cnt'): COLUMNS gives one row per match and cannot aggregate the matches; aggregate in the outer SELECT instead"
      gql_status: "42000"

  - name: an_aggregate_in_columns_under_select_star
    query: |
      SELECT * FROM GRAPH_TABLE (
        MATCH (p:Person)
        COLUMNS (sum(p.age) AS total)
      )
    expect:
      error: "aggregate sum in the COLUMNS of GRAPH_TABLE (column 'total')"
      gql_status: "42000"

  - name: an_aggregate_in_columns_under_an_aggregating_select
    query: |
      SELECT COUNT(*) AS n FROM GRAPH_TABLE (
        MATCH (p:Person)
        COLUMNS (avg(p.age) AS mean)
      )
    expect:
      error: "aggregate avg in the COLUMNS of GRAPH_TABLE (column 'mean')"
      gql_status: "42000"

  - name: an_aggregate_inside_a_column_expression
    query: |
      SELECT older FROM GRAPH_TABLE (
        MATCH (p:Person)
        COLUMNS (max(p.age) + 1 AS older)
      )
    expect:
      error: "aggregate max in the COLUMNS of GRAPH_TABLE (column 'older')"
      gql_status: "42000"

  - name: the_outer_select_aggregates_instead
    query: |
      SELECT COUNT(*) AS n, SUM(age) AS total, MAX(age) AS oldest FROM GRAPH_TABLE (
        MATCH (p:Person)
        COLUMNS (p.age AS age)
      )
    expect:
      rows:
        - [3, 90, 35]
