# SQL/PGQ GRAPH_TABLE takes GQL's patterns, so a label expression holds in every position.
#
# Generated from one table with the Rust tests in label_expressions_in_paths.rs.

meta:
  language: sql-pgq
  model: lpg
  title: Label expressions in GRAPH_TABLE
  dataset: label_mix

tests:

  - name: first_node_colon_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_colon_a_colon_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A:B)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_is_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_is_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A&B)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A&B)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_a_or_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A|B)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Vincent]

  - name: first_node_not_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:!A)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Gus]
        - [Jules]
        - [Mia]

  - name: first_node_any_label
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:%)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Jules]
        - [Vincent]

  - name: first_node_paren_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:(A))-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_nobody
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:Z&A)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      empty: true

  - name: first_node_incoming_colon_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_incoming_colon_a_colon_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A:B)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_incoming_is_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_incoming_is_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A&B)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_incoming_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A&B)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_incoming_a_or_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A|B)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Vincent]

  - name: first_node_incoming_not_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:!A)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Gus]
        - [Jules]
        - [Mia]

  - name: first_node_incoming_any_label
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:%)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Jules]
        - [Vincent]

  - name: first_node_incoming_paren_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:(A))<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_incoming_nobody
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:Z&A)<-[:S]-(t IS T) COLUMNS (x.name AS r))"
    expect:
      empty: true

  - name: first_node_where_colon_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_where_colon_a_colon_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A:B WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_where_is_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_where_is_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A&B WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_where_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A&B WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_where_a_or_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A|B WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Vincent]

  - name: first_node_where_not_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:!A WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Gus]
        - [Jules]
        - [Mia]

  - name: first_node_where_any_label
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:% WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Jules]
        - [Vincent]

  - name: first_node_where_paren_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:(A) WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_where_nobody
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:Z&A WHERE x.k = 1)-[:R]->(t IS T) COLUMNS (x.name AS r))"
    expect:
      empty: true

  - name: first_node_two_hops_colon_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_two_hops_colon_a_colon_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A:B)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_two_hops_is_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: first_node_two_hops_is_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x IS A&B)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_two_hops_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A&B)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: first_node_two_hops_a_or_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:A|B)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Vincent]

  - name: first_node_two_hops_not_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:!A)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Gus]
        - [Jules]
        - [Mia]

  - name: first_node_two_hops_any_label
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:%)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Jules]
        - [Vincent]

  - name: first_node_two_hops_paren_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:(A))-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
