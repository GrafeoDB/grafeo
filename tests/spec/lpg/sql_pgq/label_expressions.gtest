        - [Alix]
        - [Vincent]

  - name: first_node_two_hops_nobody
    query: "SELECT r FROM GRAPH_TABLE (MATCH (x:Z&A)-[:R]->(t IS T)-[:S]->(y {name: 'Alix'}) COLUMNS (x.name AS r))"
    expect:
      empty: true

  - name: comma_separated_colon_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:A)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: comma_separated_colon_a_colon_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:A:B)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: comma_separated_is_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x IS A)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: comma_separated_is_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x IS A&B)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: comma_separated_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:A&B)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: comma_separated_a_or_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:A|B)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Vincent]

  - name: comma_separated_not_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:!A)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Gus]
        - [Jules]
        - [Mia]

  - name: comma_separated_any_label
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:%)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Jules]
        - [Vincent]

  - name: comma_separated_paren_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:(A))-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: comma_separated_nobody
    query: "SELECT r FROM GRAPH_TABLE (MATCH (u IS T), (x:Z&A)-[:R]->(u) COLUMNS (x.name AS r))"
    expect:
      empty: true

  - name: far_end_colon_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:A) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: far_end_colon_a_colon_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:A:B) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: far_end_is_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x IS A) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: far_end_is_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x IS A&B) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: far_end_a_and_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:A&B) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: far_end_a_or_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:A|B) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Vincent]

  - name: far_end_not_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:!A) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Gus]
        - [Jules]
        - [Mia]

  - name: far_end_any_label
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:%) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Jules]
        - [Vincent]

  - name: far_end_paren_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:(A)) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: far_end_nobody
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:Z&A) COLUMNS (x.name AS r))"
    expect:
      empty: true

  - name: later_node_colon_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:A)-[:R]->(u IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: later_node_colon_a_colon_b
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x:A:B)-[:R]->(u IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Vincent]

  - name: later_node_is_a
    query: "SELECT r FROM GRAPH_TABLE (MATCH (t IS T)-[:S]->(x IS A)-[:R]->(u IS T) COLUMNS (x.name AS r))"
    expect:
      rows:
        - [Alix]
        - [Vincent]

  - name: later_node_is_a_and_b
