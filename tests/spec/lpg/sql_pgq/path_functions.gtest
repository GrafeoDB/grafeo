# SQL/PGQ path functions
#
# A path variable names the edges of a variable-length pattern. LENGTH(p)
# counts them, EDGES(p) lists them and RELATIONSHIPS(p), its openCypher
# spelling, returns what EDGES(p) returns (0.6.0: it returned something
# else). The names match in any case.

meta:
  language: sql-pgq
  model: lpg
  section: "4.39"
  title: Path functions
  dataset: social_network

tests:

  - name: relationships_has_as_many_entries_as_edges
    query: |
      SELECT * FROM GRAPH_TABLE (
        MATCH (src:Person)-[p:KNOWS*1..3]->(dst:Person)
        COLUMNS (src.name AS source, dst.name AS target,
                 size(RELATIONSHIPS(p)) AS rels, size(EDGES(p)) AS edges, LENGTH(p) AS hops)
      )
    expect:
      columns: [source, target, rels, edges, hops]
      rows:
        - [Alix, Gus, 1, 1, 1]
        - [Alix, Vincent, 2, 2, 2]
        - [Gus, Vincent, 1, 1, 1]

  - name: relationships_equals_edges
    query: |
      SELECT * FROM GRAPH_TABLE (
        MATCH (src:Person)-[p:KNOWS*1..3]->(dst:Person)
        COLUMNS (RELATIONSHIPS(p) = EDGES(p) AS same)
      )
    expect:
      rows:
        - [true]
        - [true]
        - [true]

  - name: relationships_in_where
    query: |
      SELECT * FROM GRAPH_TABLE (
        MATCH (src:Person)-[p:KNOWS*1..3]->(dst:Person)
        WHERE size(RELATIONSHIPS(p)) = 2
        COLUMNS (src.name AS source, dst.name AS target)
      )
    expect:
      rows:
        - [Alix, Vincent]

  - name: path_functions_match_in_any_case
    query: |
      SELECT * FROM GRAPH_TABLE (
        MATCH (src:Person {name: 'Alix'})-[p:KNOWS*2]->(dst:Person)
        COLUMNS (size(relationships(p)) AS rels, size(edges(p)) AS edges, length(p) AS hops)
      )
    expect:
      rows:
        - [2, 2, 2]

  - name: a_path_with_no_match_gives_no_rows
    query: |
      SELECT * FROM GRAPH_TABLE (
        MATCH (src:Person {name: 'Vincent'})-[p:KNOWS*1..3]->(dst:Person)
        COLUMNS (size(RELATIONSHIPS(p)) AS rels)
      )
    expect:
      empty: true
