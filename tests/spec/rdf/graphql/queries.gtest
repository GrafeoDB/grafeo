# GraphQL over RDF: queries on triples
#
# Covers: a root field as an rdf:type, scalar fields as predicates, an
# argument as a filter, nested fields as links between resources, variables,
# and mutation rejection. The data is triples in the example.org vocabulary,
# which GraphQL over RDF reads by default.

meta:
  language: graphql-rdf
  model: rdf
  section: queries
  title: GraphQL queries on RDF triples
  dataset: example_people
  requires: [graphql, sparql, rdf]

tests:

  # ---------------------------------------------------------------------------
  # Types and fields
  # ---------------------------------------------------------------------------

  - name: root_field_selects_by_type
    query: "{ person { name } }"
    expect:
      rows:
        - [Alix]
        - [Gus]
        - [Mia]

  - name: scalar_fields_read_their_predicates
    query: "{ person { name age } }"
    expect:
      columns: [name, age]
      rows:
        - [Alix, 30]
        - [Gus, 25]
        - [Mia, 32]

  - name: another_type_reads_its_own_resources
    query: "{ organization { name city } }"
    expect:
      rows:
        - [Grafeo OSS, Amsterdam]

  - name: a_type_with_no_resources_is_empty
    query: "{ city { name } }"
    expect:
      empty: true

  # ---------------------------------------------------------------------------
  # Arguments and variables
  # ---------------------------------------------------------------------------

  - name: an_argument_filters_on_its_predicate
    query: "{ person(name: \"Gus\") { name age } }"
    expect:
      rows:
        - [Gus, 25]

  - name: a_variable_fills_an_argument
    query: "query ByName($who: String!) { person(name: $who) { name city } }"
    params:
      who: "Mia"
    expect:
      rows:
        - [Mia, Prague]

  # ---------------------------------------------------------------------------
  # Nested fields follow links
  # ---------------------------------------------------------------------------

  - name: a_nested_field_follows_its_predicate
    query: "{ person(name: \"Alix\") { name knows { friend: name } } }"
    expect:
      rows:
        - [Alix, Gus]
        - [Alix, Mia]

  # Today the nested `name` and its parent's `name` are two columns of one name, which is
  # refused (GRAFEO-Q002); the cases above alias the nested field.
  - name: a_nested_field_may_repeat_a_parent_field_name
    xfail:
      spec: "GraphQL over RDF names a nested field's column as GraphQL on the property graph does"
      issue: "fix in 0.6.4"
    query: "{ person(name: \"Alix\") { name knows { name } } }"
    expect:
      rows:
        - [Alix, Gus]
        - [Alix, Mia]

  - name: a_nested_field_keeps_only_linked_resources
    query: "{ person { name worksAt { employer: name } } }"
    expect:
      rows:
        - [Alix, Grafeo OSS]

  # ---------------------------------------------------------------------------
  # Mutations are refused
  # ---------------------------------------------------------------------------

  - name: rdf_create_mutation_rejected
    query: "mutation { createPerson(name: \"Test\") { name } }"
    expect:
      error: "Only Query"

  - name: rdf_delete_mutation_rejected
    query: "mutation { deletePerson(name: \"Alix\") }"
    expect:
      error: "Only Query"
