# SPARQL Error Cases
#
# Covers: syntax errors, malformed queries, unknown prefixes,
# invalid expressions, type errors, malformed IRIs.

meta:
  language: sparql
  model: rdf
  section: errors
  title: Error Cases
  dataset: empty
  requires: [sparql, rdf]

tests:

  # ---------------------------------------------------------------------------
  # Syntax errors
  # ---------------------------------------------------------------------------

  - name: missing_where_clause
    query: "SELECT ?s { ?s ?p ?o"
    expect:
      error: ""

  - name: unclosed_brace
    query: "SELECT ?s WHERE { ?s ?p ?o"
    expect:
      error: ""

  - name: missing_select_variables
    query: "SELECT WHERE { ?s ?p ?o }"
    expect:
      error: ""

  - name: empty_query
    query: ""
    expect:
      error: ""

  - name: nonsense_query
    query: "FROBNICATE DATA { <a> <b> <c> }"
    expect:
      error: ""

  # ---------------------------------------------------------------------------
  # Malformed IRIs and literals
  # ---------------------------------------------------------------------------

  - name: malformed_typed_literal
    # An IRI holds no space (grammar rule 139, IRIREF).
    query: "SELECT ?s WHERE { ?s ?p \"abc\"^^<invalid iri> }"
    expect:
      error: "expected IRI or prefixed name"

  # ---------------------------------------------------------------------------
  # Unknown prefix
  # ---------------------------------------------------------------------------

  # A prefix other than rdf, rdfs, xsd, owl and fn must be declared
  # (rdf/sparql/prefixes.gtest).
  - name: undefined_prefix
    query: "SELECT ?s WHERE { ?s foaf:name ?o }"
    expect:
      error: "foaf"
      gql_status: "42001"

  # ---------------------------------------------------------------------------
  # Invalid expressions
  # ---------------------------------------------------------------------------

  - name: division_by_zero
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/val> 10 .
        }
    query: "SELECT ((?v / 0) AS ?r) WHERE { <http://ex.org/a> <http://ex.org/val> ?v }"
    expect:
      rows:
        - [null]

  # An aggregate without GROUP BY is one group of every solution (SPARQL 1.1
  # section 11.4): valid.
  - name: aggregate_without_group_by
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/val> 1 .
          <http://ex.org/b> <http://ex.org/val> 2 .
        }
    query: "SELECT (COUNT(?o) AS ?c) WHERE { ?s ?p ?o }"
    expect:
      rows:
        - [2]

  # Beside an aggregate, a variable may be projected only when it is grouped
  # (SPARQL 1.1 section 11.4, "Aggregate Projection Restrictions"): `?s` is
  # not, so the query is an error.
  - name: ungrouped_variable_beside_an_aggregate
    skip: "the ungrouped ?s beside COUNT is accepted instead of rejected"
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/val> 1 .
          <http://ex.org/b> <http://ex.org/val> 2 .
        }
    query: "SELECT ?s (COUNT(?o) AS ?c) WHERE { ?s ?p ?o }"
    expect:
      error: ""

  # ---------------------------------------------------------------------------
  # Type errors
  # ---------------------------------------------------------------------------

  - name: str_plus_integer
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/val> "hello" .
        }
    query: "SELECT (?v + 1 AS ?r) WHERE { <http://ex.org/a> <http://ex.org/val> ?v }"
    expect:
      rows:
        - [null]

  # ---------------------------------------------------------------------------
  # Empty result edge cases
  # ---------------------------------------------------------------------------

  - name: query_empty_store
    query: "SELECT ?s ?p ?o WHERE { ?s ?p ?o }"
    expect:
      count: 0

  - name: filter_no_match
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/val> 10 .
        }
    query: "SELECT ?v WHERE { ?s <http://ex.org/val> ?v FILTER(?v > 100) }"
    expect:
      count: 0
