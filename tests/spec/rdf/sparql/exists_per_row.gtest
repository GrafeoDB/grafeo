  - name: case_15
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT ?s { ?s :t :k } LIMIT 1 } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: case_15_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { SELECT ?s { ?s :t :k } LIMIT 1 } }"
    expect:
      empty: true

  - name: case_16
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT (COUNT(*) AS ?n) { ?s :p ?o } } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: case_16_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { SELECT (COUNT(*) AS ?n) { ?s :p ?o } } }"
    expect:
      empty: true

  - name: case_17
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT ?s (COUNT(*) AS ?n) { ?s :p ?o } GROUP BY ?s } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_17_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { SELECT ?s (COUNT(*) AS ?n) { ?s :p ?o } GROUP BY ?s } }"
    expect:
      rows:
        - ["urn:b"]

  - name: case_18
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT ?k { :d :q ?k } GROUP BY ?k HAVING(?s = :a) } }"
