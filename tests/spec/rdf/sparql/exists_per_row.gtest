  - name: a_sub_select
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:a> <urn:q> 2 . <urn:a> <urn:q> 3 . <urn:a> <urn:r> 0 . <urn:b> <urn:p> 3 . <urn:b> <urn:q> 2 . <urn:b> <urn:t> 0 . <urn:e> <urn:q> 9 . GRAPH <urn:g1> { <urn:c> <urn:p> 1 . <urn:c> <urn:q> 2 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:d> <urn:q> 2 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o FILTER(EXISTS { { SELECT ?s WHERE { ?s <urn:q> ?x FILTER(?x > ?o) } } }) }"
    expect:
      rows:
