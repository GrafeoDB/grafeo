    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { { ?s :p ?o } UNION { :d :q ?z FILTER(?s = :b) } } }"
    expect:
