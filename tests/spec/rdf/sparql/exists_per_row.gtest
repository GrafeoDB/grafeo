  - name: case_14_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { SELECT ?o { ?x :p ?o FILTER(?x = ?s) } } }"
