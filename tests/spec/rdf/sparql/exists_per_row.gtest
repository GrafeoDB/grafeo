# EXISTS reads the row by the SPARQL 1.2 draft's definition (sec 17.4.1.4, 18.3.2.7). Generated with sparql_exists_per_row.rs.

meta:
  language: sparql
  model: rdf
  section: "17.4.1.4"
  title: EXISTS reads the row
  dataset: empty
  requires: [sparql, rdf]

tests:

  - name: case_1
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { ?s :p ?o } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_1_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { ?s :p ?o } }"
    expect:
      rows:
        - ["urn:b"]

  - name: case_2
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { FILTER(?s = :a) } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_2_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { FILTER(?s = :a) } }"
    expect:
      rows:
        - ["urn:b"]

  - name: case_3
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o FILTER(?s = :a) } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_3_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { :d :q ?o FILTER(?s = :a) } }"
    expect:
      rows:
        - ["urn:b"]

  - name: case_4
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o { FILTER(?s = :a) } } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_4_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { :d :q ?o { FILTER(?s = :a) } } }"
    expect:
      rows:
        - ["urn:b"]

  - name: case_5
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o OPTIONAL { ?s :p ?y } } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: case_5_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { :d :q ?o OPTIONAL { ?s :p ?y } } }"
    expect:
      empty: true

  - name: case_6
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o OPTIONAL { :d :q ?y FILTER(?s = :a) } } }"
