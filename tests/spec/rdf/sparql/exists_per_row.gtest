    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k OPTIONAL { ?s :w ?u } FILTER NOT EXISTS { :a :p ?u } }"
    expect:
      empty: true

  - name: a_blank_node_in_the_row_is_a_term
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . _:n :t :k . :a :p :c }"
    query: "PREFIX : <urn:> SELECT (COUNT(*) AS ?c) WHERE { ?s :t :k FILTER EXISTS { :a :p ?z OPTIONAL { ?s :p ?y } FILTER(BOUND(?y)) } }"
    expect:
      rows:
        - [1]

  - name: a_blank_node_in_the_row_keeps_its_rows
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . _:n :t :k . :a :p :c }"
    query: "PREFIX : <urn:> SELECT (COUNT(*) AS ?c) WHERE { ?s :t :k FILTER EXISTS { :a :p ?o OPTIONAL { ?s :p ?y } } }"
    expect:
      rows:
        - [2]

  - name: the_row_binds_the_graph_variable
    setup:
      - "PREFIX : <urn:> INSERT DATA { GRAPH :g1 { :a :t :k . :a :p :c } GRAPH :g2 { :b :t :k . :d :p :c } }"
    query: "PREFIX : <urn:> SELECT ?g ?s WHERE { GRAPH ?g { ?s :t :k } FILTER EXISTS { GRAPH ?g { ?x :p ?o FILTER(?x = ?s) } } }"
    expect:
      rows:
        - ["urn:g1", "urn:a"]

  - name: the_row_binds_the_graph_variable_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { GRAPH :g1 { :a :t :k . :a :p :c } GRAPH :g2 { :b :t :k . :d :p :c } }"
    query: "PREFIX : <urn:> SELECT ?g ?s WHERE { GRAPH ?g { ?s :t :k } FILTER NOT EXISTS { GRAPH ?g { ?x :p ?o FILTER(?x = ?s) } } }"
    expect:
      rows:
        - ["urn:g2", "urn:b"]

  - name: from_named_chooses_the_graph_of_a_per_row_form
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . GRAPH :g1 { :x :p :c } GRAPH :g2 { :a :p :c } }"
    query: "PREFIX : <urn:> SELECT ?s FROM :a0 FROM NAMED :g1 WHERE { BIND(:a AS ?s) FILTER EXISTS { GRAPH ?h { ?y :p ?o FILTER(?y = ?s) } } }"
    expect:
      empty: true

  - name: bind_agrees_with_the_row
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { BIND(:a AS ?s) } }"
    expect:
      rows:
        - ["urn:a"]

  - name: bind_of_an_error_leaves_the_rows_value
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { BIND(1 / 0 AS ?s) } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: an_alias_must_agree_with_the_row
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT (:a AS ?s) { :d :q ?o } } }"
    expect:
      rows:
        - ["urn:a"]

  - name: a_nested_exists_reads_the_outer_row
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o FILTER EXISTS { :d :q ?y FILTER(?s = :a) } } }"
    expect:
      rows:
        - ["urn:a"]

  - name: a_nested_not_exists_reads_the_outer_row
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o FILTER NOT EXISTS { :d :q ?y FILTER(?s = :a) } } }"
    expect:
      rows:
        - ["urn:b"]

  - name: a_zero_length_path_of_a_bound_end_is_not_in_the_graph
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { BIND(:nowhere AS ?s) FILTER EXISTS { ?s :r* ?y } }"
    expect:
      empty: true

  - name: a_zero_length_path_of_a_constant_keeps_its_row
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :nowhere :r* ?y } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: offset_of_a_sub_select_reads_per_row
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT ?s { ?s :t :k } OFFSET 1 } }"
    expect:
      empty: true

  - name: below_an_aggregation_a_key_reads_the_row
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT (COUNT(*) AS ?n) { ?s :p ?o } HAVING(COUNT(*) > 0) } }"
    expect:
      rows:
        - ["urn:a"]

  - name: a_filter_in_a_nested_group
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:a> <urn:q> 2 . <urn:a> <urn:q> 3 . <urn:a> <urn:r> 0 . <urn:b> <urn:p> 3 . <urn:b> <urn:q> 2 . <urn:b> <urn:t> 0 . <urn:e> <urn:q> 9 . GRAPH <urn:g1> { <urn:c> <urn:p> 1 . <urn:c> <urn:q> 2 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:d> <urn:q> 2 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o FILTER(EXISTS { ?s <urn:q> ?x { FILTER(?x > ?o) } }) }"
    expect:
      empty: true

  - name: a_filter_in_a_nested_group_beside_a_triple
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:a> <urn:q> 2 . <urn:a> <urn:q> 3 . <urn:a> <urn:r> 0 . <urn:b> <urn:p> 3 . <urn:b> <urn:q> 2 . <urn:b> <urn:t> 0 . <urn:e> <urn:q> 9 . GRAPH <urn:g1> { <urn:c> <urn:p> 1 . <urn:c> <urn:q> 2 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:d> <urn:q> 2 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o FILTER(EXISTS { ?s <urn:q> ?x { ?s <urn:q> ?y FILTER(?y > ?o) } }) }"
    expect:
      rows:
        - ["urn:a"]

  - name: a_filter_in_optional
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:a> <urn:q> 2 . <urn:a> <urn:q> 3 . <urn:a> <urn:r> 0 . <urn:b> <urn:p> 3 . <urn:b> <urn:q> 2 . <urn:b> <urn:t> 0 . <urn:e> <urn:q> 9 . GRAPH <urn:g1> { <urn:c> <urn:p> 1 . <urn:c> <urn:q> 2 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:d> <urn:q> 2 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o FILTER(EXISTS { ?s <urn:q> ?x OPTIONAL { ?s <urn:r> ?y FILTER(?y > ?o) } }) }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: a_filter_in_union
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:a> <urn:q> 2 . <urn:a> <urn:q> 3 . <urn:a> <urn:r> 0 . <urn:b> <urn:p> 3 . <urn:b> <urn:q> 2 . <urn:b> <urn:t> 0 . <urn:e> <urn:q> 9 . GRAPH <urn:g1> { <urn:c> <urn:p> 1 . <urn:c> <urn:q> 2 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:d> <urn:q> 2 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o FILTER(EXISTS { { ?s <urn:q> ?x FILTER(?x > ?o) } UNION { ?s <urn:r> ?x } }) }"
    expect:
      rows:
        - ["urn:a"]

  - name: a_filter_in_minus
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:a> <urn:q> 2 . <urn:a> <urn:q> 3 . <urn:a> <urn:r> 0 . <urn:b> <urn:p> 3 . <urn:b> <urn:q> 2 . <urn:b> <urn:t> 0 . <urn:e> <urn:q> 9 . GRAPH <urn:g1> { <urn:c> <urn:p> 1 . <urn:c> <urn:q> 2 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:d> <urn:q> 2 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o FILTER(EXISTS { ?s <urn:q> ?x MINUS { ?s <urn:r> ?y FILTER(?y > ?o) } }) }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: a_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:a> <urn:q> 2 . <urn:a> <urn:q> 3 . <urn:a> <urn:r> 0 . <urn:b> <urn:p> 3 . <urn:b> <urn:q> 2 . <urn:b> <urn:t> 0 . <urn:e> <urn:q> 9 . GRAPH <urn:g1> { <urn:c> <urn:p> 1 . <urn:c> <urn:q> 2 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:d> <urn:q> 2 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o FILTER(EXISTS { ?s <urn:q> ?x BIND(?x + ?o AS ?y) }) }"
