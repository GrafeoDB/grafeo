  - name: case_6_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { :d :q ?o OPTIONAL { :d :q ?y FILTER(?s = :a) } } }"
    expect:
      empty: true

  - name: case_7
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { ?s :t :k MINUS { ?s :t :k } } }"
    expect:
      empty: true

  - name: case_7_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { ?s :t :k MINUS { ?s :t :k } } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: case_8
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o MINUS { :d :q :e } } }"
    expect:
      empty: true

  - name: case_8_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { :d :q ?o MINUS { :d :q :e } } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: case_9
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { :d :q ?o MINUS { :nobody :q ?z } } }"
    expect:
      rows:
        - ["urn:a"]
        - ["urn:b"]

  - name: case_9_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { :d :q ?o MINUS { :nobody :q ?z } } }"
    expect:
      empty: true

  - name: case_10
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { BIND(:a AS ?s) } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_10_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { BIND(:a AS ?s) } }"
    expect:
      rows:
        - ["urn:b"]

  - name: case_11
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { BIND(?s AS ?y) FILTER(?y = :a) } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_11_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { BIND(?s AS ?y) FILTER(?y = :a) } }"
    expect:
      rows:
        - ["urn:b"]

  - name: case_12
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER EXISTS { SELECT ?s { ?s :p ?o } } }"
    expect:
      rows:
        - ["urn:a"]

  - name: case_12_not
    setup:
      - "PREFIX : <urn:> INSERT DATA { :a :t :k . :b :t :k . :a :p :c . :d :q :e . GRAPH :g { :c :r :e } }"
    query: "PREFIX : <urn:> SELECT ?s WHERE { ?s :t :k FILTER NOT EXISTS { SELECT ?s { ?s :p ?o } } }"
