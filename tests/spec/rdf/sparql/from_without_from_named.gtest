  - name: path_plus_in_variable
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
