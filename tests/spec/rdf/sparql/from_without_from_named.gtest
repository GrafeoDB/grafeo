    statements:
      - "WITH <urn:g1> INSERT { <urn:r> <urn:saw> ?g } WHERE { GRAPH ?g { ?s <urn:p> ?o } }"
      - "SELECT ?o WHERE { GRAPH <urn:g1> { <urn:r> <urn:saw> ?o } }"
