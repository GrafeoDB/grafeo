  - name: path_optional_in_variable
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?o FROM <urn:g1> WHERE { GRAPH ?g { <urn:a> <urn:q>? ?o } }"
    expect:
      empty: true

  - name: path_optional_in_the_same_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?o FROM <urn:g1> WHERE { GRAPH <urn:g1> { <urn:a> <urn:q>? ?o } }"
    expect:
      empty: true

  - name: path_optional_both_ends_free
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?s ?o FROM <urn:g1> WHERE { GRAPH ?g { ?s <urn:q>? ?o } }"
    expect:
      empty: true

