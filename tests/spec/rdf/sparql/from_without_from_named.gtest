# SPARQL dataset of `FROM` with no `FROM NAMED` (SPARQL 1.1 sec 13.2, 13.2.1, 18.6): a default graph and
# no named graphs, so GRAPH finds nothing, whatever its pattern; `FROM NAMED` still lists the named
# graphs. `WITH` is not a dataset clause (Update 3.1.3): GRAPH in its WHERE reads the store's named
# graphs. Generated with the Rust tests in sparql_from_without_from_named.rs.

meta:
  language: sparql
  model: rdf
  section: "13.2"
  title: FROM with no FROM NAMED
  dataset: empty
  requires: [sparql, rdf]

tests:

  - name: graph_variable
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?s FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: graph_variable_star
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT * FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: graph_the_same_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { GRAPH <urn:g1> { ?s ?p ?o } }"
    expect:
      empty: true

  - name: graph_another_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { GRAPH <urn:g2> { ?s ?p ?o } }"
    expect:
      empty: true

  - name: graph_variable_empty_group
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g FROM <urn:g1> WHERE { GRAPH ?g { } }"
    expect:
      empty: true

  - name: graph_variable_bind
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?x FROM <urn:g1> WHERE { GRAPH ?g { BIND(1 AS ?x) } }"
    expect:
      empty: true

  - name: graph_iri_bind
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?x FROM <urn:g1> WHERE { GRAPH <urn:g1> { BIND(1 AS ?x) } }"
    expect:
      empty: true

  - name: graph_iri_optional
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { GRAPH <urn:g1> { OPTIONAL { ?s <urn:p> ?o } } }"
    expect:
      empty: true

  - name: two_from
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?s FROM <urn:g1> FROM <urn:g2> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: two_from_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> FROM <urn:g2> WHERE { GRAPH <urn:g2> { ?s ?p ?o } }"
    expect:
      empty: true

  - name: the_same_from_twice
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?s FROM <urn:g1> FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: from_of_no_graph
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?s FROM <urn:nograph> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: from_of_no_graph_empty_group
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g FROM <urn:nograph> WHERE { GRAPH ?g { } }"
    expect:
      empty: true

  - name: two_patterns
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?a ?c FROM <urn:g1> WHERE { GRAPH ?g { ?a <urn:q> ?b . ?b <urn:q> ?c } }"
    expect:
      empty: true

  - name: three_patterns
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?a ?v FROM <urn:g1> WHERE { GRAPH ?g { ?a <urn:q> ?b . ?b <urn:q> ?c . ?a <urn:p> ?v } }"
    expect:
      empty: true

  - name: two_patterns_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?a ?c FROM <urn:g1> WHERE { GRAPH <urn:g1> { ?a <urn:q> ?b . ?b <urn:q> ?c } }"
    expect:
      empty: true

  - name: filter_inside
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { GRAPH ?g { ?s <urn:p> ?o FILTER(?o = 1) } }"
    expect:
      empty: true

  - name: filter_on_the_variable
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } FILTER(?g = <urn:g1>) }"
    expect:
      empty: true

  - name: values_of_the_variable
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { VALUES ?g { <urn:g1> } GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: bind_of_the_variable
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { BIND(<urn:g1> AS ?g) GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: nested
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?s FROM <urn:g1> WHERE { GRAPH ?g { GRAPH <urn:g1> { ?s ?p ?o } } }"
    expect:
      empty: true

  - name: distinct
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT DISTINCT ?g FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: order_and_limit
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } } ORDER BY ?g LIMIT 1"
    expect:
      empty: true

  - name: count
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT (COUNT(*) AS ?c) FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      rows:
        - [0]

  - name: count_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT (COUNT(*) AS ?c) FROM <urn:g1> WHERE { GRAPH <urn:g1> { ?s ?p ?o } }"
    expect:
      rows:
        - [0]

  - name: count_by_graph
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g (COUNT(*) AS ?c) FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } } GROUP BY ?g"
    expect:
      empty: true

  - name: sub_select_around
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?s FROM <urn:g1> WHERE { { SELECT ?g ?s WHERE { GRAPH ?g { ?s <urn:p> ?o } } } }"
    expect:
      empty: true

  - name: sub_select_inside
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "SELECT ?g ?c FROM <urn:g1> WHERE { GRAPH ?g { { SELECT (COUNT(*) AS ?c) WHERE { ?s ?p ?o } } } }"
    expect:
      empty: true

  - name: ask_variable
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "ASK FROM <urn:g1> { GRAPH ?g { ?s ?p ?o } }"
    expect:
      rows:
        - [false]

  - name: ask_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "ASK FROM <urn:g1> { GRAPH <urn:g1> { ?s ?p ?o } }"
    expect:
      rows:
        - [false]

  - name: construct
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "CONSTRUCT { ?s ?p ?o } FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: construct_iri
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "CONSTRUCT { ?s ?p ?o } FROM <urn:g1> WHERE { GRAPH <urn:g1> { ?s ?p ?o } }"
    expect:
      empty: true

  - name: describe
    setup:
      - "INSERT DATA { <urn:d> <urn:p> 0 . GRAPH <urn:g1> { <urn:a> <urn:p> 1 . <urn:a> <urn:q> <urn:b> . <urn:b> <urn:q> <urn:c> } GRAPH <urn:g2> { <urn:a> <urn:p> 2 . <urn:x> <urn:q> <urn:y> } }"
    query: "DESCRIBE ?s FROM <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
