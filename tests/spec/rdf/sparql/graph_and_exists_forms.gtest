# SPARQL graph patterns and EXISTS as an expression (SPARQL 1.1 sec 13.3, 17.4.1.4, 18.6 and grammar
# rule 54): a `.` after a pattern that is not a triple; a graph the dataset does not name; a
# sub-SELECT inside GRAPH ?g; EXISTS in BIND, a projection, a function and ORDER BY. Generated with
# the Rust tests in sparql_graph_and_exists_forms.rs, which also compare each `.` with the form
# without it.

meta:
  language: sparql
  model: rdf
  section: "18.6"
  title: Graph patterns and EXISTS as an expression
  dataset: empty
  requires: [sparql, rdf]

tests:

  - name: dot_after_filter
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o . FILTER(?o = 1) . }"
    expect:
      count: 1

  - name: no_dot_after_filter
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s <urn:p> ?o . FILTER(?o = 1)  }"
    expect:
      count: 1

  - name: dot_after_a_nested_group
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { { ?s ?q ?y } . }"
    expect:
      count: 2

  - name: no_dot_after_a_nested_group
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { { ?s ?q ?y }  }"
    expect:
      count: 2

  - name: dot_in_optional
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?a ?b ?c OPTIONAL { { ?s ?q ?y } . } }"
    expect:
      count: 4

  - name: no_dot_in_optional
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?a ?b ?c OPTIONAL { { ?s ?q ?y }  } }"
    expect:
      count: 4

  - name: dot_in_minus
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?a ?b ?c MINUS { { ?a ?b ?c } . } }"
    expect:
      count: 0

  - name: no_dot_in_minus
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?a ?b ?c MINUS { { ?a ?b ?c }  } }"
    expect:
      count: 0

  - name: dot_in_graph_variable
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { GRAPH ?g { { ?s ?q ?y } . } }"
    expect:
      count: 3

  - name: no_dot_in_graph_variable
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { GRAPH ?g { { ?s ?q ?y }  } }"
    expect:
      count: 3

  - name: dot_filter_in_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?o WHERE { GRAPH <urn:g1> { <urn:c> <urn:p> ?o . FILTER(?o = 4) . } }"
    expect:
      count: 1

  - name: no_dot_filter_in_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?o WHERE { GRAPH <urn:g1> { <urn:c> <urn:p> ?o . FILTER(?o = 4)  } }"
    expect:
      count: 1

  - name: dot_after_optional
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o OPTIONAL { ?s ?q ?y } . }"
    expect:
      count: 2

  - name: no_dot_after_optional
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o OPTIONAL { ?s ?q ?y }  }"
    expect:
      count: 2

  - name: dot_after_minus
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o MINUS { ?s <urn:q> ?y } . }"
    expect:
      count: 1

  - name: no_dot_after_minus
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o MINUS { ?s <urn:q> ?y }  }"
    expect:
      count: 1

  - name: dot_after_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { GRAPH ?g { ?s ?p ?o } . }"
    expect:
      count: 3

  - name: no_dot_after_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { GRAPH ?g { ?s ?p ?o }  }"
    expect:
      count: 3

  - name: dot_after_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o BIND(1 AS ?x) . }"
    expect:
      count: 2

  - name: no_dot_after_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o BIND(1 AS ?x)  }"
    expect:
      count: 2

  - name: dot_after_values
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { VALUES ?s { <urn:a> } . ?s ?p ?o }"
    expect:
      count: 1

  - name: no_dot_after_values
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { VALUES ?s { <urn:a> }  ?s ?p ?o }"
    expect:
      count: 1

  - name: dot_after_union
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { { ?s <urn:p> ?o } UNION { ?s <urn:q> ?o } . }"
    expect:
      count: 2

  - name: no_dot_after_union
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { { ?s <urn:p> ?o } UNION { ?s <urn:q> ?o }  }"
    expect:
      count: 2

  - name: dot_then_more_triples
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s ?y WHERE { ?s <urn:p> ?o FILTER(?o = 1) . ?s <urn:p> ?y }"
    expect:
      count: 1

  - name: no_dot_then_more_triples
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s ?y WHERE { ?s <urn:p> ?o FILTER(?o = 1)  ?s <urn:p> ?y }"
    expect:
      count: 1

  - name: dot_after_service_is_not_a_syntax_error
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { SERVICE <urn:e> { ?s ?p ?o } . }"
    expect:
      error: "SERVICE"

  - name: refuses_a_dot_before_anything
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { . ?s ?p ?o }"
    expect:
      error: "unexpected"

  - name: refuses_a_dot_two_after_a_triple
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o . . }"
    expect:
      error: "unexpected"

  - name: refuses_a_dot_two_after_a_filter
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { ?s ?p ?o FILTER(?o = 1) . . }"
    expect:
      error: "unexpected"

  - name: refuses_a_dot_two_after_a_group
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { { ?s ?p ?o } . . }"
    expect:
      error: "unexpected"

  - name: refuses_a_dot_only_a_dot
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { . }"
    expect:
      error: "unexpected"

  - name: no_graph_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?x WHERE { GRAPH <urn:nograph> { BIND(1 AS ?x) } }"
    expect:
      empty: true

  - name: no_graph_values
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?x WHERE { GRAPH <urn:nograph> { VALUES ?x { 1 } } }"
    expect:
      empty: true

  - name: no_graph_empty_group
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { GRAPH <urn:nograph> { } }"
    expect:
      empty: true

  - name: no_graph_nested_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?x WHERE { GRAPH <urn:nograph> { { BIND(1 AS ?x) } } }"
    expect:
      empty: true

  - name: no_graph_filter_only
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT * WHERE { GRAPH <urn:nograph> { FILTER(true) } }"
    expect:
      empty: true

  - name: no_graph_under_optional
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s ?x WHERE { ?s <urn:p> ?o OPTIONAL { GRAPH <urn:nograph> { BIND(1 AS ?x) } } }"
    expect:
      rows:
        - ["urn:a", null]

  - name: a_named_graph_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?x WHERE { GRAPH <urn:g1> { BIND(1 AS ?x) } }"
    expect:
      rows:
        - [1]

  - name: a_named_graph_empty_group
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g WHERE { GRAPH ?g { } }"
    expect:
      rows:
        - ["urn:g1"]
        - ["urn:g2"]

  - name: each_graph_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?x WHERE { GRAPH ?g { BIND(1 AS ?x) } }"
    expect:
      rows:
        - ["urn:g1", 1]
        - ["urn:g2", 1]

  - name: graph_visit_default_graph_is_not_one
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s WHERE { GRAPH ?g { ?s <urn:q> ?o } }"
    expect:
      empty: true

  - name: graph_visit_named_ones_only
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      rows:
        - ["urn:g1", "urn:c"]
        - ["urn:g2", "urn:d"]
        - ["urn:g2", "urn:e"]

  - name: graph_visit_from_named
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s FROM NAMED <urn:g1> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      rows:
        - ["urn:g1", "urn:c"]

  - name: graph_visit_from_named_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?x FROM NAMED <urn:g1> WHERE { GRAPH ?g { BIND(1 AS ?x) } }"
    expect:
      rows:
        - ["urn:g1", 1]

  - name: graph_visit_from_named_empty_group
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g FROM NAMED <urn:g2> WHERE { GRAPH ?g { } }"
    expect:
      rows:
        - ["urn:g2"]

  - name: graph_visit_from_named_of_no_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g FROM NAMED <urn:nograph> WHERE { GRAPH ?g { BIND(1 AS ?x) } }"
    expect:
      rows:
        - ["urn:nograph"]

  - name: graph_visit_from_named_a_constant_it_lists
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?x FROM NAMED <urn:nograph> WHERE { GRAPH <urn:nograph> { BIND(1 AS ?x) } }"
    expect:
      rows:
        - [1]

  - name: graph_visit_from_named_a_constant_it_does_not_list
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?x FROM NAMED <urn:g1> WHERE { GRAPH <urn:nograph> { BIND(1 AS ?x) } }"
    expect:
      empty: true

  - name: graph_visit_from_named_of_no_graph_a_triple
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s FROM NAMED <urn:nograph> WHERE { GRAPH ?g { ?s ?p ?o } }"
    expect:
      empty: true

  - name: graph_visit_from_named_a_constant_outside_it
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?x FROM NAMED <urn:g1> WHERE { GRAPH <urn:g2> { BIND(1 AS ?x) } }"
    expect:
      empty: true

  - name: exists_in_a_filter_guard
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s ?p ?v FILTER(EXISTS { ?s <urn:p> ?o }) }"
    expect:
      rows:
        - ["urn:a"]

  - name: a_listed_graph_keeps_its_row_after_its_last_triple_goes
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    statements:
      - "DELETE DATA { GRAPH <urn:g1> { <urn:c> <urn:p> 4 } }"
      - "SELECT ?g FROM NAMED <urn:g1> WHERE { GRAPH ?g { BIND(1 AS ?x) } }"
    expect:
      rows:
        - ["urn:g1"]

  - name: update_with_no_graph_writes_nothing
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    statements:
      - "INSERT { <urn:t> <urn:p> 9 } WHERE { GRAPH <urn:nograph> { BIND(1 AS ?x) } }"
      - "SELECT ?v WHERE { <urn:t> <urn:p> ?v }"
    expect:
      empty: true

  - name: delete_with_no_graph_removes_nothing
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    statements:
      - "DELETE { <urn:a> <urn:p> 1 } WHERE { GRAPH <urn:nograph> { BIND(1 AS ?x) } }"
      - "SELECT ?v WHERE { <urn:a> <urn:p> ?v }"
    expect:
      rows:
        - [1]

  - name: update_where_with_a_dot
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    statements:
      - "DELETE { ?s <urn:p> ?o } WHERE { ?s <urn:p> ?o . FILTER(?o = 1) . }"
      - "SELECT ?s WHERE { ?s <urn:p> ?o }"
    expect:
      empty: true

  - name: an_empty_named_graph_is_a_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    statements:
      - "CREATE GRAPH <urn:empty>"
      - "SELECT ?x WHERE { GRAPH <urn:empty> { BIND(1 AS ?x) } }"
    expect:
      rows:
        - [1]

  - name: sub_select_count_of_a_listed_graph_with_no_triples
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?c FROM NAMED <urn:nograph> WHERE { GRAPH ?g { { SELECT (COUNT(*) AS ?c) WHERE { ?s ?p ?o } } } }"
    expect:
      rows:
        - ["urn:nograph", 0]

  - name: sub_select_from_named
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s FROM NAMED <urn:g2> WHERE { GRAPH ?g { { SELECT ?s WHERE { ?s <urn:p> ?o } } } }"
    expect:
      rows:
        - ["urn:g2", "urn:d"]
        - ["urn:g2", "urn:e"]

  - name: sub_select_binds_the_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s WHERE { GRAPH ?g { { SELECT ?s WHERE { ?s <urn:p> ?o } } } }"
    expect:
      rows:
        - ["urn:g1", "urn:c"]
        - ["urn:g2", "urn:d"]
        - ["urn:g2", "urn:e"]

  - name: sub_select_aggregate_per_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?c WHERE { GRAPH ?g { { SELECT (COUNT(*) AS ?c) WHERE { ?s ?p ?o } } } }"
    expect:
      rows:
        - ["urn:g1", 1]
        - ["urn:g2", 2]

  - name: sub_select_limit_per_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s WHERE { GRAPH ?g { { SELECT ?s WHERE { ?s <urn:p> ?o } ORDER BY ?s LIMIT 1 } } }"
    expect:
      rows:
        - ["urn:g1", "urn:c"]
        - ["urn:g2", "urn:d"]

  - name: sub_select_in_a_named_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { GRAPH <urn:g1> { { SELECT ?s WHERE { ?s <urn:p> ?o } } } }"
    expect:
      rows:
        - ["urn:c"]

  - name: sub_select_in_no_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { GRAPH <urn:nograph> { { SELECT ?s WHERE { ?s <urn:p> ?o } } } }"
    expect:
      empty: true

  - name: sub_select_with_the_graph_fixed
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s WHERE { VALUES ?g { <urn:g1> } GRAPH ?g { { SELECT ?s WHERE { ?s <urn:p> ?o } } } }"
    expect:
      rows:
        - ["urn:g1", "urn:c"]

  - name: sub_select_beside_a_triple
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s ?v WHERE { GRAPH ?g { ?s <urn:p> ?v { SELECT ?s WHERE { ?s <urn:p> ?o } } } }"
    expect:
      rows:
        - ["urn:g1", "urn:c", 4]
        - ["urn:g2", "urn:d", 5]
        - ["urn:g2", "urn:e", 6]

  - name: bind_exists_true
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?w WHERE { BIND(EXISTS { <urn:a> <urn:p> ?o } AS ?w) }"
    expect:
      rows:
        - [true]

  - name: bind_exists_false
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?w WHERE { BIND(EXISTS { <urn:a> <urn:q> ?o } AS ?w) }"
    expect:
      rows:
        - [false]

  - name: bind_not_exists
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?w WHERE { BIND(NOT EXISTS { <urn:a> <urn:q> ?o } AS ?w) }"
    expect:
      rows:
        - [true]

  - name: bind_exists_per_row
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s ?w WHERE { ?s ?p ?v BIND(EXISTS { ?s <urn:p> ?o } AS ?w) }"
    expect:
      rows:
        - ["urn:a", true]
        - ["urn:b", false]

  - name: project_exists
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT (EXISTS { <urn:a> <urn:p> ?o } AS ?w) WHERE { }"
    expect:
      rows:
        - [true]

  - name: project_exists_per_row
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s (EXISTS { ?s <urn:p> ?o } AS ?w) WHERE { ?s ?p ?v }"
    expect:
      rows:
        - ["urn:a", true]
        - ["urn:b", false]

  - name: project_not_exists
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s (NOT EXISTS { ?s <urn:p> ?o } AS ?w) WHERE { ?s ?p ?v }"
    expect:
      rows:
        - ["urn:a", false]
        - ["urn:b", true]

  - name: exists_inside_a_function
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s (IF(EXISTS { ?s <urn:p> ?o }, 1, 0) AS ?w) WHERE { ?s ?p ?v }"
    expect:
      rows:
        - ["urn:a", 1]
        - ["urn:b", 0]

  - name: bound_exists_in_a_filter
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s ?p ?v BIND(EXISTS { ?s <urn:p> ?o } AS ?w) FILTER(?w) }"
    expect:
      rows:
        - ["urn:a"]

  - name: exists_inside_each_graph_bind
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s ?w WHERE { GRAPH ?g { ?s <urn:p> ?o BIND(EXISTS { ?s <urn:p> 4 } AS ?w) } }"
    expect:
      rows:
        - ["urn:g1", "urn:c", true]
        - ["urn:g2", "urn:d", false]
        - ["urn:g2", "urn:e", false]

  - name: exists_inside_each_graph_filter
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?s WHERE { GRAPH ?g { ?s <urn:p> ?o FILTER(EXISTS { ?s <urn:p> 4 }) } }"
    expect:
      rows:
        - ["urn:g1", "urn:c"]

  - name: exists_inside_a_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?g ?w WHERE { GRAPH ?g { <urn:c> ?p ?v BIND(EXISTS { <urn:c> <urn:p> ?o } AS ?w) } }"
    expect:
      rows:
        - ["urn:g1", true]

  - name: update_binds_exists
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
      - "INSERT { <urn:t> <urn:p> ?w } WHERE { BIND(EXISTS { <urn:a> <urn:p> ?o } AS ?w) }"
    query: "SELECT ?v WHERE { <urn:t> <urn:p> ?v }"
    expect:
      rows:
        - [true]

  - name: update_sub_select_binds_the_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
      - "INSERT { <urn:t> <urn:from> ?g } WHERE { GRAPH ?g { { SELECT ?s WHERE { ?s <urn:p> 4 } } } }"
    query: "SELECT ?v WHERE { <urn:t> <urn:from> ?v }"
    expect:
      rows:
        - ["urn:g1"]

  - name: update_filters_on_exists_inside_a_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
      - "INSERT { <urn:t> <urn:from> ?g } WHERE { GRAPH ?g { ?s <urn:p> ?o FILTER(EXISTS { ?s <urn:p> 4 }) } }"
    query: "SELECT ?v WHERE { <urn:t> <urn:from> ?v }"
    expect:
      rows:
        - ["urn:g1"]

  - name: update_binds_exists_inside_a_graph
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
      - "INSERT { ?s <urn:w> ?w } WHERE { GRAPH ?g { ?s <urn:p> ?o BIND(EXISTS { ?s <urn:p> 4 } AS ?w) } }"
    query: "SELECT ?s ?v WHERE { ?s <urn:w> ?v }"
    expect:
      rows:
        - ["urn:c", true]
        - ["urn:d", false]
        - ["urn:e", false]

  - name: exists_in_order_by
    setup:
      - "INSERT DATA { <urn:a> <urn:p> 1 . <urn:b> <urn:q> 2 . GRAPH <urn:g1> { <urn:c> <urn:p> 4 } GRAPH <urn:g2> { <urn:d> <urn:p> 5 . <urn:e> <urn:p> 6 } }"
    query: "SELECT ?s WHERE { ?s ?p ?v } ORDER BY (EXISTS { ?s <urn:p> ?o })"
    expect:
      ordered: true
      rows:
        - ["urn:b"]
        - ["urn:a"]
