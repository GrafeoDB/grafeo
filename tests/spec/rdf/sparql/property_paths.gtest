  - name: sequence_adversarial_preserves_route_multiplicity
    # A finite sequence retains the two routes to d, alongside g and h.
    setup:
      - |
        PREFIX e: <http://ex.org/>
        INSERT DATA {
          e:s e:REL e:a .
          e:s e:REL e:b .
          e:a e:REL e:d .
          e:b e:REL e:d .
          e:d e:REL e:e .
