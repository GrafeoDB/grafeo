  - name: one_or_more_adversarial_free_endpoints
    # Alternate routes to d, cycles at e/f and g, a duplicate OTHER
    # triple and disconnected u -> v: exactly 26 distinct REL pairs.
    setup:
      - |
        PREFIX e: <http://ex.org/>
        INSERT DATA {
          e:s e:REL e:a .
          e:s e:REL e:b .
          e:a e:REL e:d .
          e:b e:REL e:d .
          e:d e:REL e:e .
          e:e e:REL e:f .
          e:f e:REL e:e .
          e:b e:REL e:g .
          e:g e:REL e:g .
          e:a e:REL e:h .
          e:h e:REL e:d .
          e:s e:OTHER e:x .
          e:s e:OTHER e:x .
          e:u e:REL e:v .
        }
    query: |
      PREFIX e: <http://ex.org/>
      SELECT ?s ?o WHERE { ?s e:REL+ ?o }
    expect:
      rows:
        - [http://ex.org/s, http://ex.org/a]
