# SPARQL UNION and MINUS
#
# Covers: UNION combining two branches, UNION with disjoint variables,
# MINUS excluding matching solutions.
# Inspired by Blazegraph and Jena UNION/MINUS handling bugs.

meta:
  language: sparql
  model: rdf
  section: union_minus
  title: UNION and MINUS
  dataset: empty
  requires: [sparql, rdf]

tests:

  # ---------------------------------------------------------------------------
  # UNION
  # ---------------------------------------------------------------------------

  - name: union_returns_both_branches
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/city> "Amsterdam" .
        }
    query: |
      SELECT ?val WHERE {
        { <http://ex.org/a> <http://ex.org/name> ?val }
        UNION
        { <http://ex.org/a> <http://ex.org/city> ?val }
      }
    expect:
      rows:
        - [Alix]
        - [Amsterdam]

  - name: union_no_dedup_by_default
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/x> "same" .
          <http://ex.org/a> <http://ex.org/y> "same" .
        }
    query: |
      SELECT ?val WHERE {
        { <http://ex.org/a> <http://ex.org/x> ?val }
        UNION
        { <http://ex.org/a> <http://ex.org/y> ?val }
      }
    expect:
      count: 2

  - name: union_with_different_predicates
    setup:
      - |
        INSERT DATA {
          <http://ex.org/alix> <http://ex.org/name> "Alix" .
          <http://ex.org/gus> <http://ex.org/nick> "Gus" .
        }
    query: |
      SELECT ?val WHERE {
        { ?s <http://ex.org/name> ?val }
        UNION
        { ?s <http://ex.org/nick> ?val }
      }
    expect:
      rows:
        - [Alix]
        - [Gus]

  - name: union_one_branch_empty
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
        }
    query: |
      SELECT ?val WHERE {
        { <http://ex.org/a> <http://ex.org/name> ?val }
        UNION
        { <http://ex.org/a> <http://ex.org/nonexistent> ?val }
      }
    expect:
      rows:
        - [Alix]

  # ---------------------------------------------------------------------------
  # UNION over branches with different variables (#365, SPARQL 1.1 sec 18.2.1):
  # the result has every branch variable, unbound where a branch lacks it.
  # ---------------------------------------------------------------------------

  - name: union_heterogeneous_vars_explicit
    # ?y exists only in the second branch.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/b> .
          <http://ex.org/a> <http://ex.org/q> <http://ex.org/z> .
        }
    query: |
      SELECT ?x ?y WHERE {
        { ?s <http://ex.org/p> ?x }
        UNION
        { ?s <http://ex.org/q> ?y }
      }
    expect:
      columns: [x, y]
      rows:
        - [http://ex.org/b, null]
        - [null, http://ex.org/z]

  - name: union_heterogeneous_vars_reversed
    # Same as above with the branches swapped.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/b> .
          <http://ex.org/a> <http://ex.org/q> <http://ex.org/z> .
        }
    query: |
      SELECT ?y ?x WHERE {
        { ?s <http://ex.org/q> ?y }
        UNION
        { ?s <http://ex.org/p> ?x }
      }
    expect:
      columns: [y, x]
      rows:
        - [http://ex.org/z, null]
        - [null, http://ex.org/b]

  - name: union_three_branches_heterogeneous
    # Three branches, each with its own variable.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/b> .
          <http://ex.org/a> <http://ex.org/q> <http://ex.org/z> .
          <http://ex.org/a> <http://ex.org/r> <http://ex.org/w> .
        }
    query: |
      SELECT ?x ?y ?z WHERE {
        { ?s <http://ex.org/p> ?x }
        UNION
        { ?s <http://ex.org/q> ?y }
        UNION
        { ?s <http://ex.org/r> ?z }
      }
    expect:
      columns: [x, y, z]
      rows:
        - [http://ex.org/b, null, null]
        - [null, http://ex.org/z, null]
        - [null, null, http://ex.org/w]

  - name: union_bind_misaligned_v001
    # The wider first branch binds ?dir at a different column than the second.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/b> .
          <http://ex.org/c> <http://ex.org/q> <http://ex.org/d> .
        }
    query: |
      SELECT ?s ?dir WHERE {
        { ?s <http://ex.org/p> ?o . BIND("out" AS ?dir) }
        UNION
        { ?s <http://ex.org/q> ?dir }
      }
    expect:
      columns: [s, dir]
      rows:
        - [http://ex.org/a, out]
        - [http://ex.org/c, http://ex.org/d]

  - name: union_select_star_no_corruption
    # SELECT * must not show a later branch's values under the first branch's names.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/b> .
          <http://ex.org/a> <http://ex.org/q> <http://ex.org/z> .
        }
    query: |
      SELECT * WHERE {
        { ?s <http://ex.org/p> ?x }
        UNION
        { ?s <http://ex.org/q> ?y }
      }
    expect:
      columns: [s, x, y]
      rows:
        - [http://ex.org/a, http://ex.org/b, null]
        - [http://ex.org/a, null, http://ex.org/z]

  - name: union_same_arity_control
    # Control: branches with the same variables.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/b> .
          <http://ex.org/a> <http://ex.org/q> <http://ex.org/z> .
        }
    query: |
      SELECT ?x WHERE {
        { ?s <http://ex.org/p> ?x }
        UNION
        { ?s <http://ex.org/q> ?x }
      }
    expect:
      columns: [x]
      rows:
        - [http://ex.org/b]
        - [http://ex.org/z]

  - name: union_distinct_over_null
    # DISTINCT deduplicates rows containing unbound values.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/m> .
          <http://ex.org/b> <http://ex.org/p> <http://ex.org/n> .
          <http://ex.org/c> <http://ex.org/q> <http://ex.org/z> .
          <http://ex.org/d> <http://ex.org/q> <http://ex.org/z> .
        }
    query: |
      SELECT DISTINCT ?y WHERE {
        { ?s <http://ex.org/p> ?x }
        UNION
        { ?s <http://ex.org/q> ?y }
      }
    expect:
      columns: [y]
      rows:
        - [null]
        - [http://ex.org/z]

  - name: union_order_by_unbound_first
    # ORDER BY puts unbound values first ascending (SPARQL 1.1 15.1).
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/p> <http://ex.org/m> .
          <http://ex.org/b> <http://ex.org/p> <http://ex.org/n> .
          <http://ex.org/c> <http://ex.org/q> <http://ex.org/z> .
          <http://ex.org/d> <http://ex.org/q> <http://ex.org/z> .
        }
    query: |
      SELECT DISTINCT ?y WHERE {
        { ?s <http://ex.org/p> ?x }
        UNION
        { ?s <http://ex.org/q> ?y }
      }
      ORDER BY ?y
    expect:
      ordered: true
      columns: [y]
      terms:
        - [null]
        - ['<http://ex.org/z>']

  # ---------------------------------------------------------------------------
  # MINUS
  # ---------------------------------------------------------------------------

  - name: minus_excludes_matching_solutions
    setup:
      - |
        INSERT DATA {
          <http://ex.org/alix> <http://ex.org/name> "Alix" .
          <http://ex.org/alix> <http://ex.org/city> "Amsterdam" .
          <http://ex.org/gus> <http://ex.org/name> "Gus" .
          <http://ex.org/gus> <http://ex.org/city> "Berlin" .
          <http://ex.org/vincent> <http://ex.org/name> "Vincent" .
          <http://ex.org/vincent> <http://ex.org/city> "Amsterdam" .
        }
    query: |
      SELECT ?name WHERE {
        ?s <http://ex.org/name> ?name .
        ?s <http://ex.org/city> ?city .
        MINUS {
          ?s <http://ex.org/city> "Amsterdam" .
        }
      }
    expect:
      rows:
        - [Gus]

  - name: minus_no_shared_variables_keeps_all
    # MINUS with no overlapping variables has no effect per SPARQL spec
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/b> <http://ex.org/age> "30" .
        }
    query: |
      SELECT ?name WHERE {
        ?s <http://ex.org/name> ?name .
        MINUS {
          ?other <http://ex.org/age> ?a .
        }
      }
    expect:
      rows:
        - [Alix]

  - name: minus_excludes_all_when_all_match
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/b> <http://ex.org/flag> "yes" .
        }
    query: |
      SELECT ?name WHERE {
        ?s <http://ex.org/name> ?name .
        MINUS {
          ?s <http://ex.org/flag> "yes" .
        }
      }
    expect:
      empty: true

  # A MINUS after another MINUS, or after VALUES, still removes the solutions it
  # matches: each MINUS applies to the solutions of everything before it in the
  # group (SPARQL 1.1, 18.2.2.6), whatever the operator that produced them.

  - name: a_second_minus_in_a_chain_excludes_too
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/b> <http://ex.org/banned> "yes" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
    query: |
      SELECT ?name WHERE {
        ?s <http://ex.org/name> ?name .
        MINUS { ?s <http://ex.org/flag> "yes" . }
        MINUS { ?s <http://ex.org/banned> "yes" . }
      }
    expect:
      rows:
        - [Vincent]

  - name: a_third_minus_in_a_chain_excludes_too
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/b> <http://ex.org/banned> "yes" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
          <http://ex.org/c> <http://ex.org/left> "yes" .
          <http://ex.org/d> <http://ex.org/name> "Mia" .
        }
    query: |
      SELECT ?name WHERE {
        ?s <http://ex.org/name> ?name .
        MINUS { ?s <http://ex.org/flag> "yes" . }
        MINUS { ?s <http://ex.org/banned> "yes" . }
        MINUS { ?s <http://ex.org/left> "yes" . }
      }
    expect:
      rows:
        - [Mia]

  - name: a_minus_after_values_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/flag> "yes" .
        }
    query: |
      SELECT ?s WHERE {
        VALUES ?s { <http://ex.org/a> <http://ex.org/b> }
        MINUS { ?s <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]

  # A MINUS after a group element of any shape: a sub-SELECT that ends in DISTINCT, an
  # ORDER BY (with LIMIT or OFFSET or alone), a GROUP BY (its key, and an aggregate's alias),
  # or a projected alias. The MINUS shares the variable the sub-SELECT returns.

  - name: a_minus_after_a_distinct_subselect_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
    query: |
      SELECT ?s WHERE {
        { SELECT DISTINCT ?s WHERE { ?s <http://ex.org/name> ?n } }
        MINUS { ?s <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]
        - [http://ex.org/c]

  - name: a_minus_after_an_ordered_subselect_with_limit_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
    query: |
      SELECT ?s WHERE {
        { SELECT ?s WHERE { ?s <http://ex.org/name> ?n } ORDER BY ?s LIMIT 2 }
        MINUS { ?s <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]

  - name: a_minus_after_an_ordered_subselect_with_offset_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
    query: |
      SELECT ?s WHERE {
        { SELECT ?s WHERE { ?s <http://ex.org/name> ?n } ORDER BY ?s OFFSET 0 }
        MINUS { ?s <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]
        - [http://ex.org/c]

  - name: a_minus_after_an_ordered_subselect_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
    query: |
      SELECT ?s WHERE {
        { SELECT ?s WHERE { ?s <http://ex.org/name> ?n } ORDER BY ?s }
        MINUS { ?s <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]
        - [http://ex.org/c]

  - name: a_minus_on_a_group_key_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
    query: |
      SELECT ?s WHERE {
        { SELECT ?s (COUNT(*) AS ?k) WHERE { ?s <http://ex.org/name> ?n } GROUP BY ?s }
        MINUS { ?s <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]
        - [http://ex.org/c]

  - name: a_minus_on_an_aggregate_alias_excludes
    # Alix has two names, so only her count is 2: the MINUS removes the counts of 1.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
      - |
        INSERT DATA { <http://ex.org/a> <http://ex.org/name> "Alix Amsterdam" . }
    query: |
      SELECT ?s WHERE {
        { SELECT ?s (COUNT(*) AS ?k) WHERE { ?s <http://ex.org/name> ?n } GROUP BY ?s }
        MINUS { VALUES ?k { 1 } }
      }
    expect:
      rows:
        - [http://ex.org/a]

  - name: a_minus_on_a_projected_alias_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
    query: |
      SELECT ?t WHERE {
        { SELECT (?s AS ?t) WHERE { ?s <http://ex.org/name> ?n } }
        MINUS { ?t <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]
        - [http://ex.org/c]

  # Shapes MINUS already handled, kept as guards of the same class.

  - name: a_minus_after_filter_not_exists_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/flag> "yes" .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
        }
      - |
        INSERT DATA { <http://ex.org/b> <http://ex.org/banned> "yes" . }
    query: |
      SELECT ?s WHERE {
        ?s <http://ex.org/name> ?n .
        FILTER NOT EXISTS { ?s <http://ex.org/banned> "yes" }
        MINUS { ?s <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/c]

  - name: a_minus_on_an_optional_variable_excludes
    # Vincent has no city: his ?c is unbound, which shares nothing, so he stays.
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/name> "Alix" .
          <http://ex.org/a> <http://ex.org/city> <http://ex.org/amsterdam> .
          <http://ex.org/b> <http://ex.org/name> "Gus" .
          <http://ex.org/b> <http://ex.org/city> <http://ex.org/rotterdam> .
          <http://ex.org/c> <http://ex.org/name> "Vincent" .
          <http://ex.org/amsterdam> <http://ex.org/closed> "yes" .
        }
    query: |
      SELECT ?s WHERE {
        ?s <http://ex.org/name> ?n .
        OPTIONAL { ?s <http://ex.org/city> ?c }
        MINUS { ?c <http://ex.org/closed> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/b]
        - [http://ex.org/c]

  - name: a_minus_after_a_property_path_excludes
    setup:
      - |
        INSERT DATA {
          <http://ex.org/a> <http://ex.org/knows> <http://ex.org/b> .
          <http://ex.org/b> <http://ex.org/knows> <http://ex.org/c> .
          <http://ex.org/b> <http://ex.org/flag> "yes" .
        }
    query: |
      SELECT ?s ?o WHERE {
        ?s <http://ex.org/knows>+ ?o .
        MINUS { ?o <http://ex.org/flag> "yes" . }
      }
    expect:
      rows:
        - [http://ex.org/a, http://ex.org/c]
        - [http://ex.org/b, http://ex.org/c]
