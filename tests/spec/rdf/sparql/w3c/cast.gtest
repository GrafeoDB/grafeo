        - ['<http://example.org/n02>', '"1"^^<http://www.w3.org/2001/XMLSchema#integer>', '"1"']
        - ['<http://example.org/n03>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>', '"-1"']
        - ['<http://example.org/n04>', '"0.0"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"0"']
        - ['<http://example.org/n05>', '"1.0"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"1"']
