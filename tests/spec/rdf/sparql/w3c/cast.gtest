          <http://example.org/n08> <http://example.org/p> "1E0"^^<http://www.w3.org/2001/XMLSchema#double> .
          <http://example.org/n09> <http://example.org/p> "0E1"^^<http://www.w3.org/2001/XMLSchema#float> .
          <http://example.org/n10> <http://example.org/p> "1E0"^^<http://www.w3.org/2001/XMLSchema#float> .
          <http://example.org/n11> <http://example.org/p> "1.25"^^<http://www.w3.org/2001/XMLSchema#float> .
          <http://example.org/n12> <http://example.org/p> "-7.875"^^<http://www.w3.org/2001/XMLSchema#float> .
          <http://example.org/n13> <http://example.org/p> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n14> <http://example.org/p> "-2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s01> <http://example.org/p> <http://example.org/z> .
          <http://example.org/s02> <http://example.org/p> "string" .
          <http://example.org/s03> <http://example.org/p> "-10.2E3" .
          <http://example.org/s04> <http://example.org/p> "+33.3300" .
          <http://example.org/s05> <http://example.org/p> "0.0" .
          <http://example.org/s06> <http://example.org/p> "0" .
          <http://example.org/s07> <http://example.org/p> "0E1" .
          <http://example.org/s08> <http://example.org/p> "1.5" .
          <http://example.org/s09> <http://example.org/p> "1" .
          <http://example.org/s10> <http://example.org/p> "1E0" .
          <http://example.org/s11> <http://example.org/p> "13" .
          <http://example.org/s12> <http://example.org/p> "2002-10-10T17:00:00Z" .
          <http://example.org/s13> <http://example.org/p> "false" .
          <http://example.org/s14> <http://example.org/p> "true" .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT
          ?a
