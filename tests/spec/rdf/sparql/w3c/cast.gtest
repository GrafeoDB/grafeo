  # xsd:string cast
  - name: cast_string
    xfail:
      spec: "W3C SPARQL 1.1 cast/cast-string"
      issue: fix in 0.6.4
    setup:
      - |
        INSERT DATA {
          <http://example.org/b01> <http://example.org/p> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
          <http://example.org/b02> <http://example.org/p> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
          <http://example.org/b03> <http://example.org/p> "0"^^<http://www.w3.org/2001/XMLSchema#boolean> .
          <http://example.org/n01> <http://example.org/p> "0"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n02> <http://example.org/p> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n03> <http://example.org/p> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
