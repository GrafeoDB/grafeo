      terms:
        - ['<http://example.org/s01>', '<http://example.org/z>', null]
        - ['<http://example.org/s02>', '"string"', null]
        - ['<http://example.org/s03>', '"-10.2E3"', null]
        - ['<http://example.org/s04>', '"+33.3300"', null]
        - ['<http://example.org/s05>', '"0.0"', null]
        - ['<http://example.org/s06>', '"0"', '"0"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/s07>', '"0E1"', null]
        - ['<http://example.org/s08>', '"1.5"', null]
        - ['<http://example.org/s09>', '"1"', '"1"^^<http://www.w3.org/2001/XMLSchema#integer>']
