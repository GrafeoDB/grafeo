        INSERT DATA {
          <http://example/x1> <http://example/p> "a" .
          <http://example/x1> <http://example/q> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example/x2> <http://example/p> _:b0 .
          <http://example/x2> <http://example/q> "1" .
          <http://example/x3> <http://example/p> <http://example/a> .
          <http://example/x3> <http://example/q> "1" .
          <http://example/x4> <http://example/p> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example/x4> <http://example/q> "2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example/x5> <http://example/p> "1.0"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example/x5> <http://example/q> "2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example/x6> <http://example/p> "1" .
          <http://example/x6> <http://example/q> "2" .
          <http://example/x7> <http://example/p> "1"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example/x7> <http://example/q> "2" .
          <http://example/x8> <http://example/p> "1"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example/x8> <http://example/q> "2"^^<http://www.w3.org/2001/XMLSchema#integer> .
        }
    query: |
      PREFIX  : <http://example/>

      SELECT  ?x ?y ( str(?x) + str(?y) AS ?sum)
      WHERE
          { ?s :p ?x ; :q ?y .
          }
    expect:
      terms:
        - ['_:b', '"1"', null]
        - ['<http://example/a>', '"1"', null]
        - ['"1"', '"2"', null]
        - ['"1"^^<http://www.w3.org/2001/XMLSchema#integer>', '"2"^^<http://www.w3.org/2001/XMLSchema#integer>', null]
        - ['"1"', '"2"', null]
        - ['"1"', '"2"^^<http://www.w3.org/2001/XMLSchema#integer>', null]
        - ['"1.0"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"2"^^<http://www.w3.org/2001/XMLSchema#integer>', null]
        - ['"a"', '"1"^^<http://www.w3.org/2001/XMLSchema#integer>', null]

  # MD5()
  - name: md5_01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT (MD5(?l) AS ?hash) WHERE {
          :s1 :str ?l
      }
    expect:
      terms:
        - ['"acbd18db4cc2f85cedef654fccc4a4d8"']

