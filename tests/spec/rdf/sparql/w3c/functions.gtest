  # IF()
  - name: if01
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "english"@en .
          <http://example.org/s4> <http://example.org/str> "français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
        }
    query: |
      BASE <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?o (IF(lang(?o) = "ja", true, false) AS ?integer)
      WHERE {
          ?s ?p ?o
      }
    expect:
      terms:
        - ['"123"', '"false"^^<http://www.w3.org/2001/XMLSchema#boolean>']
        - ['"def"', '"false"^^<http://www.w3.org/2001/XMLSchema#boolean>']
        - ['"français"@fr', '"false"^^<http://www.w3.org/2001/XMLSchema#boolean>']
        - ['"日本語"@ja', '"true"^^<http://www.w3.org/2001/XMLSchema#boolean>']
        - ['"7"^^<http://www.w3.org/2001/XMLSchema#integer>', '"false"^^<http://www.w3.org/2001/XMLSchema#boolean>']
        - ['"abc"', '"false"^^<http://www.w3.org/2001/XMLSchema#boolean>']
        - ['"english"@en', '"false"^^<http://www.w3.org/2001/XMLSchema#boolean>']

  # IF() error propogation
  - name: if02
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "english"@en .
          <http://example.org/s4> <http://example.org/str> "français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
        }
    query: |
      SELECT (IF(1/0, false, true) AS ?error) WHERE {}
    expect:
      terms:
        - [null]

  # COALESCE() without arguments
  - name: coalesce_empty
    setup:
      - |
        INSERT DATA {
          <http://example.org/n0> <http://example.org/p> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n1> <http://example.org/p> "0"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n1> <http://example.org/q> "0"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/p> "0"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/q> "2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n3> <http://example.org/p> "4"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n3> <http://example.org/q> "2"^^<http://www.w3.org/2001/XMLSchema#integer> .
        }
    query: |
      SELECT (COALESCE() AS ?err) WHERE {}
    expect:
      terms:
        - [null]

  # STRBEFORE()
  - name: strbefore01a
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "english"@en .
          <http://example.org/s4> <http://example.org/str> "français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s (STRBEFORE(?str,"s") AS ?prefix) WHERE {
          ?s :str ?str
      }
    expect:
      terms:
        - ['<http://example.org/s1>', '""']
        - ['<http://example.org/s2>', '""']
        - ['<http://example.org/s3>', '"engli"@en']
        - ['<http://example.org/s4>', '"françai"@fr']
        - ['<http://example.org/s5>', '""']
        - ['<http://example.org/s6>', '""']
        - ['<http://example.org/s7>', null]

  # STRBEFORE() datatyping
  - name: strbefore02
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "abc" .
          <http://example.org/s2> <http://example.org/str> "abc"@en .
          <http://example.org/s3> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT
          ?s
          ?str
          (STRBEFORE(?str,"b") AS ?bb)
          (STRBEFORE(?str,"bc") AS ?bbc)
          (STRBEFORE(?str,"b"@cy) AS ?bbcy)
          (STRBEFORE(?str,"") AS ?b)
          (STRBEFORE(?str,""@en) AS ?ben)
          (STRBEFORE(?str,"b"^^xsd:string) AS ?bbx)
          (STRBEFORE(?str,"xyz"^^xsd:string) AS ?bxyzx)
      WHERE {
          ?s :str ?str
      }
    expect:
      terms:
        - ['<http://example.org/s1>', '"abc"', '"a"', '"a"', null, '""', null, '"a"', '""']
        - ['<http://example.org/s2>', '"abc"@en', '"a"@en', '"a"@en', null, '""@en', '""@en', '"a"@en', '""']
        - ['<http://example.org/s3>', '"abc"', '"a"', '"a"', null, '""', null, '"a"', '""']

  # STRAFTER()
  - name: strafter01a
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "english"@en .
          <http://example.org/s4> <http://example.org/str> "français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s (STRAFTER(?str,"e") AS ?suffix) WHERE {
          ?s :str ?str
      }
    expect:
      terms:
        - ['<http://example.org/s1>', '""']
        - ['<http://example.org/s2>', '""']
        - ['<http://example.org/s3>', '"nglish"@en']
        - ['<http://example.org/s4>', '""']
        - ['<http://example.org/s5>', '""']
        - ['<http://example.org/s6>', '"f"']
        - ['<http://example.org/s7>', null]

  # STRAFTER() datatyping
  - name: strafter02
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "abc" .
          <http://example.org/s2> <http://example.org/str> "abc"@en .
          <http://example.org/s3> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT
          ?s
          ?str
          (STRAFTER(?str,"b") AS ?ab)
          (STRAFTER(?str,"ab") AS ?aab)
          (STRAFTER(?str,"b"@cy) AS ?abcy)
          (STRAFTER(?str,"") AS ?a)
          (STRAFTER(?str,""@en) AS ?aen)
          (STRAFTER(?str,"b"^^xsd:string) AS ?abx)
          (STRAFTER(?str,"xyz"^^xsd:string) AS ?axyzx)
      WHERE {
          ?s :str ?str
      }
    expect:
      terms:
        - ['<http://example.org/s1>', '"abc"', '"c"', '"c"', null, '"abc"', null, '"c"', '""']
        - ['<http://example.org/s2>', '"abc"@en', '"c"@en', '"c"@en', null, '"abc"@en', '"abc"@en', '"c"@en', '""']
        - ['<http://example.org/s3>', '"abc"', '"c"', '"c"', null, '"abc"', null, '"c"', '""']

  # REPLACE()
  - name: replace01
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "English"@en .
          <http://example.org/s4> <http://example.org/str> "Français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/s8> <http://example.org/str> "banana" .
          <http://example.org/s9> <http://example.org/str> "abcd" .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s (REPLACE(?str,"[^a-z0-9]", "-") AS ?new) WHERE {
          ?s :str ?str
      }
    expect:
      terms:
        - ['<http://example.org/s1>', '"123"']
        - ['<http://example.org/s2>', '"---"@ja']
        - ['<http://example.org/s3>', '"-nglish"@en']
        - ['<http://example.org/s4>', '"-ran-ais"@fr']
        - ['<http://example.org/s5>', '"abc"']
        - ['<http://example.org/s6>', '"def"']
        - ['<http://example.org/s7>', null]
        - ['<http://example.org/s8>', '"banana"']
        - ['<http://example.org/s9>', '"abcd"']

  # REPLACE() with overlapping pattern
  - name: replace02
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "English"@en .
          <http://example.org/s4> <http://example.org/str> "Français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/s8> <http://example.org/str> "banana" .
          <http://example.org/s9> <http://example.org/str> "abcd" .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT (REPLACE(?str,"ana", "*") AS ?new) WHERE {
          :s8 :str ?str
      }
    expect:
      terms:
        - ['"b*na"']

  # REPLACE() with captured substring
  - name: replace03
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "English"@en .
          <http://example.org/s4> <http://example.org/str> "Français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/s8> <http://example.org/str> "banana" .
          <http://example.org/s9> <http://example.org/str> "abcd" .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT (REPLACE(?str,"(ab)|(a)", "[1=$1][2=$2]") AS ?new) WHERE {
          :s9 :str ?str
      }
    expect:
      terms:
        - ['"[1=ab][2=]cd"']

  # REPLACE() with the 'i' option
  - name: replace_case_insensitive
    query: |
      SELECT (REPLACE("aAbBaC", "a", "~/", "i") AS ?new) WHERE {}
    expect:
      terms:
        - ['"~/~/bB~/C"']

  # UUID() pattern match
  - name: uuid01
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT (STRLEN(STR(?uuid)) AS ?length)
      WHERE {
          BIND(UUID() AS ?uuid)
          FILTER(ISIRI(?uuid) && REGEX(STR(?uuid), "^urn:uuid:[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$", "i"))
      }
    expect:
      terms:
        - ['"45"^^<http://www.w3.org/2001/XMLSchema#integer>']

  # UUID() per binding
  - name: uuid02
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      ASK {
          BIND(UUID() AS ?u1)
          BIND(UUID() AS ?u2)
          FILTER(?u1 != ?u2)
      }
    expect:
      rows:
        - [true]

  # STRUUID() pattern match
  - name: struuid01
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT (STRLEN(?uuid) AS ?length)
      WHERE {
          BIND(STRUUID() AS ?uuid)
          FILTER(ISLITERAL(?uuid) && REGEX(?uuid, "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$", "i"))
      }
    expect:
      terms:
        - ['"36"^^<http://www.w3.org/2001/XMLSchema#integer>']
