  # BNODE(str)
  - name: bnode01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s1 ?s2
      (BNODE(?s1) AS ?b1) (BNODE(?s2) AS ?b2)
      WHERE {
          ?a :str ?s1 .
          ?b :str ?s2 .
          FILTER (?a = :s1 || ?a = :s3)
          FILTER (?b = :s1 || ?b = :s3)
      }
    expect:
      terms:
        - ['"BAZ"', '"BAZ"', '_:b', '_:b']
        - ['"foo"', '"foo"', '_:b', '_:b']
        - ['"foo"', '"BAZ"', '_:b', '_:b']
        - ['"BAZ"', '"foo"', '_:b', '_:b']

