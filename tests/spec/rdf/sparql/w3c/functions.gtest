# W3C SPARQL 1.1 Test Suite: Functions
# Generated from the W3C manifest by scripts/convert_w3c_sparql.py
# Source: https://github.com/w3c/rdf-tests at 7b5afb91857a9c282c03d2e45d3f76485797c901
# Copyright W3C (MIT, ERCIM, Keio, Beihang), used under the W3C test suite
# licences: https://www.w3.org/Consortium/Legal/2008/04-testsuite-copyright.html
# Not converted:
#   plus-1-corrected: spec-disagreement: the result writes the computed decimal 3 in its XSD 1.0 canonical form 3.0; Grafeo writes the XSD 1.1 canonical form 3
#   coalesce01: spec-disagreement: the result writes the computed decimal 2 in its XSD 1.0 canonical form 2.0; Grafeo writes the XSD 1.1 canonical form 2

meta:
  language: sparql
  model: rdf
  section: "w3c.functions"
  title: W3C Functions
  dataset: empty
  requires: [sparql, rdf]

tests:

  # STRDT()
  - name: strdt01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s (STRDT(?str,xsd:string) AS ?str1) WHERE {
          ?s :str ?str
          FILTER(LANGMATCHES(LANG(?str), "en"))
      }
    expect:
      terms:
        - ['<http://example.org/s2>', null]

  # STRDT(STR())
  - name: strdt02
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s (STRDT(STR(?str),xsd:string) AS ?str1) WHERE {
          ?s :str ?str
          FILTER(LANGMATCHES(LANG(?str), "en"))
      }
    expect:
      terms:
        - ['<http://example.org/s2>', '"bar"']

  # STRDT() TypeErrors (updated for RDF 1.1)
  - name: strdt03_rdf11
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s (STRDT(?o,xsd:string) AS ?str1) WHERE {
          ?s ?p ?o
      }
    expect:
      terms:
        - ['<http://example.org/n1>', null]
        - ['<http://example.org/n2>', null]
        - ['<http://example.org/n3>', null]
        - ['<http://example.org/n4>', null]
        - ['<http://example.org/n5>', null]
        - ['<http://example.org/s1>', '"foo"']
        - ['<http://example.org/s2>', null]
        - ['<http://example.org/s3>', '"BAZ"']
        - ['<http://example.org/s4>', '"食べ物"']
        - ['<http://example.org/s5>', '"100%"']
        - ['<http://example.org/s6>', '"abc"']
        - ['<http://example.org/s7>', '"DEF"']
        - ['<http://example.org/d1>', null]
        - ['<http://example.org/d2>', null]
        - ['<http://example.org/d3>', null]
        - ['<http://example.org/d4>', null]

  # STRLANG()
  - name: strlang01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT ?s (STRLANG(?str,"en-US") AS ?s2) WHERE {
          ?s :str ?str
          FILTER(LANGMATCHES(LANG(?str), "en"))
      }
    expect:
      terms:
        - ['<http://example.org/s2>', null]

  # STRLANG(STR())
  - name: strlang02
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT ?s (STRLANG(STR(?str),"en-US") AS ?s2) WHERE {
          ?s :str ?str
          FILTER(LANGMATCHES(LANG(?str), "en"))
      }
    expect:
      terms:
        - ['<http://example.org/s2>', '"bar"@en-US']

  # STRLANG() TypeErrors (updated for RDF 1.1)
  - name: strlang03_rdf11
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT ?s (STRLANG(?o,"en-US") AS ?str1) WHERE {
          ?s ?p ?o
      }
    expect:
      terms:
        - ['<http://example.org/n1>', null]
        - ['<http://example.org/n2>', null]
        - ['<http://example.org/n3>', null]
        - ['<http://example.org/n4>', null]
        - ['<http://example.org/n5>', null]
        - ['<http://example.org/s1>', '"foo"@en-us']
        - ['<http://example.org/s2>', null]
        - ['<http://example.org/s3>', '"BAZ"@en-us']
        - ['<http://example.org/s4>', '"食べ物"@en-us']
        - ['<http://example.org/s5>', '"100%"@en-us']
        - ['<http://example.org/s6>', '"abc"@en-us']
        - ['<http://example.org/s7>', '"DEF"@en-us']
        - ['<http://example.org/d1>', null]
        - ['<http://example.org/d2>', null]
        - ['<http://example.org/d3>', null]
        - ['<http://example.org/d4>', null]

  # STRLANG() with language tags differing in case
  - name: strlang04
    query: |
      SELECT (STRLANG("abc", "en") = STRLANG("abc", "EN") AS ?res0) (STRLANG("abc", "EN") = "abc"@en AS ?res1) {}
    expect:
      terms:
        - ['"true"^^<http://www.w3.org/2001/XMLSchema#boolean>', '"true"^^<http://www.w3.org/2001/XMLSchema#boolean>']

  # isNumeric()
  - name: isnumeric01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT ?s ?num WHERE {
          ?s ?p ?num
          FILTER isNumeric(?num)
      }
    expect:
      terms:
        - ['<http://example.org/n3>', '"1.1"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n2>', '"-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n1>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/n5>', '"2.5"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n4>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>']

  # ABS()
  - name: abs01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT * WHERE {
          ?s :num ?num
          FILTER(ABS(?num) >= 2)
      }
    expect:
      terms:
        - ['<http://example.org/n5>', '"2.5"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n4>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>']

  # CEIL()
  - name: ceil01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s ?num (CEIL(?num) AS ?ceil) WHERE {
          ?s :num ?num
      }
    expect:
      terms:
        - ['<http://example.org/n1>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/n5>', '"2.5"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"3"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n4>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/n3>', '"1.1"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"2"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n2>', '"-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"-1"^^<http://www.w3.org/2001/XMLSchema#decimal>']

  # FLOOR()
  - name: floor01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s ?num (FLOOR(?num) AS ?floor) WHERE {
          ?s :num ?num
      }
    expect:
      terms:
        - ['<http://example.org/n1>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/n5>', '"2.5"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"2"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n4>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/n3>', '"1.1"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"1"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n2>', '"-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"-2"^^<http://www.w3.org/2001/XMLSchema#decimal>']

  # ROUND()
  - name: round01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT ?s ?num (ROUND(?num) AS ?round) WHERE {
          ?s :num ?num
      }
    expect:
      terms:
        - ['<http://example.org/n1>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>', '"-1"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/n5>', '"2.5"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"3"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n4>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>', '"-2"^^<http://www.w3.org/2001/XMLSchema#integer>']
        - ['<http://example.org/n3>', '"1.1"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"1"^^<http://www.w3.org/2001/XMLSchema#decimal>']
        - ['<http://example.org/n2>', '"-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal>', '"-2"^^<http://www.w3.org/2001/XMLSchema#decimal>']

  # CONCAT()
  - name: concat01
    setup:
      - |
        INSERT DATA {
          <http://example.org/d1> <http://example.org/date> "2010-06-21T11:28:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d2> <http://example.org/date> "2010-12-21T15:38:02-08:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d3> <http://example.org/date> "2008-06-20T23:59:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/d4> <http://example.org/date> "2011-02-01T01:02:03"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
          <http://example.org/n1> <http://example.org/num> "-1"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n2> <http://example.org/num> "-1.6"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n3> <http://example.org/num> "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/n4> <http://example.org/num> "-2"^^<http://www.w3.org/2001/XMLSchema#integer> .
          <http://example.org/n5> <http://example.org/num> "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> .
          <http://example.org/s1> <http://example.org/str> "foo" .
          <http://example.org/s2> <http://example.org/str> "bar"@en .
          <http://example.org/s3> <http://example.org/str> "BAZ" .
          <http://example.org/s4> <http://example.org/str> "食べ物" .
          <http://example.org/s5> <http://example.org/str> "100%" .
          <http://example.org/s6> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "DEF"^^<http://www.w3.org/2001/XMLSchema#string> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT (CONCAT(?str1,?str2) AS ?str) WHERE {
          :s6 :str ?str1 .
          :s7 :str ?str2 .
      }
    expect:
      terms:
        - ['"abcDEF"']

  # CONCAT() 2
  - name: concat02
    setup:
      - |
        INSERT DATA {
          <http://example.org/s1> <http://example.org/str> "123" .
          <http://example.org/s2> <http://example.org/str> "日本語"@ja .
          <http://example.org/s3> <http://example.org/str> "english"@en .
          <http://example.org/s4> <http://example.org/str> "français"@fr .
          <http://example.org/s5> <http://example.org/str> "abc"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s6> <http://example.org/str> "def"^^<http://www.w3.org/2001/XMLSchema#string> .
          <http://example.org/s7> <http://example.org/str> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
        }
    query: |
      PREFIX : <http://example.org/>
      SELECT (CONCAT(?str1,?str2) AS ?str) WHERE {
          ?s1 :str ?str1 .
          ?s2 :str ?str2 .
      }
    expect:
      terms:
        - ['"abcabc"']
        - ['"abcdef"']
        - ['"defabc"']
        - ['"defdef"']
        - ['"englishenglish"@en']
        - ['"françaisfrançais"@fr']
        - ['"日本語日本語"@ja']
        - ['"123abc"']
        - ['"123def"']
        - ['"123english"']
        - ['"123français"']
        - ['"123日本語"']
        - ['"123123"']
        - ['"abc123"']
        - ['"abcenglish"']
        - ['"abcfrançais"']
        - ['"abc日本語"']
        - ['"def123"']
        - ['"defenglish"']
        - ['"deffrançais"']
        - ['"def日本語"']
        - ['"english123"']
        - ['"englishabc"']
        - ['"englishdef"']
        - ['"englishfrançais"']
        - ['"english日本語"']
        - ['"français123"']
        - ['"françaisabc"']
        - ['"françaisdef"']
        - ['"françaisenglish"']
        - ['"français日本語"']
        - ['"日本語123"']
        - ['"日本語abc"']
        - ['"日本語def"']
        - ['"日本語english"']
        - ['"日本語français"']
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]
        - [null]

  # CONCAT() without parameter
