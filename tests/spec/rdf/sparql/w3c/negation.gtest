  # Subtraction with MINUS from a fully bound minuend
  - name: full_minuend
    xfail:
      spec: "W3C SPARQL 1.1 negation/full-minuend"
      issue: fix in 0.6.4
    setup:
      - |
        INSERT DATA {
          <http://example/a0> <http://example/p1> <http://example/b0> .
          <http://example/a0> <http://example/p2> <http://example/c0> .
          <http://example/a1> <http://example/p1> <http://example/b1> .
          <http://example/a1> <http://example/p2> <http://example/c1> .
          <http://example/a2> <http://example/p1> <http://example/b2> .
          <http://example/a2> <http://example/p2> <http://example/c2> .
          <http://example/a3> <http://example/p1> <http://example/b3> .
          <http://example/a3> <http://example/p2> <http://example/c3> .
          <http://example/d0> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
          <http://example/d1> <http://example/q1> <http://example/b1> .
          <http://example/d1> <http://example/q2> <http://example/c1> .
          <http://example/d1> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
          <http://example/d2> <http://example/q1> <http://example/b2> .
          <http://example/d2> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
          <http://example/d3> <http://example/q1> <http://example/b3> .
          <http://example/d3> <http://example/q2> <http://example/cx> .
          <http://example/d3> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
        }
    query: |
      prefix : <http://example/>

      select ?a ?b ?c {
        ?a :p1 ?b; :p2 ?c
        MINUS {
          ?d a :Sub
          OPTIONAL { ?d :q1 ?b }
          OPTIONAL { ?d :q2 ?c }
        }
      }
      order by ?a
    expect:
      terms:
        - ['<http://example/a0>', '<http://example/b0>', '<http://example/c0>']
        - ['<http://example/a3>', '<http://example/b3>', '<http://example/c3>']

  # Subtraction with MINUS from a partially bound minuend
  - name: partial_minuend
    xfail:
      spec: "W3C SPARQL 1.1 negation/partial-minuend"
      issue: fix in 0.6.4
    setup:
      - |
        INSERT DATA {
          <http://example/a1> <http://example/p1> <http://example/b1> .
          <http://example/a1> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Min> .
          <http://example/a2> <http://example/p1> <http://example/b2> .
          <http://example/a2> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Min> .
          <http://example/a3> <http://example/p1> <http://example/b3> .
          <http://example/a3> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Min> .
          <http://example/a4> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Min> .
          <http://example/d1> <http://example/q1> <http://example/b1> .
          <http://example/d1> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
          <http://example/d3> <http://example/q1> <http://example/b3> .
          <http://example/d3> <http://example/q2> <http://example/c3> .
          <http://example/d3> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
          <http://example/d4> <http://example/q1> <http://example/b4> .
          <http://example/d4> <http://example/q2> <http://example/c4> .
          <http://example/d4> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
          <http://example/d5> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Sub> .
        }
    query: |
      prefix : <http://example/>

      select ?a ?b ?c {
        ?a a :Min
        OPTIONAL { ?a :p1 ?b }
        OPTIONAL { ?a :p2 ?c }
        MINUS {
          ?d a :Sub
          OPTIONAL { ?d :q1 ?b }
          OPTIONAL { ?d :q2 ?c }
        }
      }
      order by ?a
    expect:
      terms:
        - ['<http://example/a2>', '<http://example/b2>', null]
        - ['<http://example/a4>', null, null]
