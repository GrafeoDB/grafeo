# A node or an edge compared with a value of another kind (#180)
#
# A node or an edge is equal only to an entity of its own kind. Compared with
# a number, a string or an entity of the other kind, Cypher keeps them apart,
# as openCypher defines it (= is false, <> true, <, <=, >, >= null), and GQL
# fails the comparison as not comparable (22G04), as ISO GQL makes a node and
# a number. Both evaluate a node to its id inside an expression, so
# `startNode(r) = id(s)` was true, and so was node 0 = edge 0. A comparison of
# two entities of one kind, and of their ids, is unchanged.

meta:
  model: lpg
  section: rosetta
  title: Entities compared with values
  dataset: empty
  requires: [cypher]

tests:

  # ---------------------------------------------------------------------------
  # Same kind: unchanged
  # ---------------------------------------------------------------------------

  - name: a_start_node_equals_the_bound_node
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      gql: "MATCH (s)-[r:KNOWS]->(t) RETURN startNode(r) = s AS a, endNode(r) = t AS b, startNode(r) = t AS c, id(startNode(r)) = id(s) AS d"
      cypher: "MATCH (s)-[r:KNOWS]->(t) RETURN startNode(r) = s AS a, endNode(r) = t AS b, startNode(r) = t AS c, id(startNode(r)) = id(s) AS d"
    expect:
      rows:
        - [true, true, false, true]

  - name: a_node_is_in_a_list_of_nodes
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      gql: "MATCH (s)-[r:KNOWS]->(t) RETURN s IN [s, t] AS a, s IN [t] AS b, id(s) IN [id(t), id(s)] AS c"
      cypher: "MATCH (s)-[r:KNOWS]->(t) RETURN s IN [s, t] AS a, s IN [t] AS b, id(s) IN [id(t), id(s)] AS c"
    expect:
      rows:
        - [true, false, true]

  - name: a_node_compared_with_null_is_null
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) RETURN n = null AS a, n <> null AS b"
      cypher: "MATCH (n:P) RETURN n = null AS a, n <> null AS b"
    expect:
      rows:
        - [null, null]

  # ---------------------------------------------------------------------------
  # Cypher: apart
  # ---------------------------------------------------------------------------

  - name: cypher_keeps_a_node_and_its_id_apart
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      cypher: "MATCH (s)-[r:KNOWS]->(t) RETURN startNode(r) = id(s) AS a, s = id(s) AS b, s <> id(s) AS c, s < id(s) + 1 AS d"
    expect:
      rows:
        - [false, false, true, null]

  - name: cypher_keeps_a_node_and_a_string_apart
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      cypher: "MATCH (n:P) RETURN n = 'Alix' AS a, n <> 'Alix' AS b"
    expect:
      rows:
        - [false, true]

  - name: cypher_keeps_a_node_and_an_edge_apart
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      cypher: "MATCH (s)-[r:KNOWS]->(t) RETURN s = r AS a, r = s AS b, s <> r AS c"
    expect:
      rows:
        - [false, false, true]

  - name: cypher_finds_no_node_in_a_list_of_ids
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      cypher: "MATCH (s)-[r:KNOWS]->(t) RETURN s IN [id(s), id(t)] AS a, s IN [id(s), s] AS b"
    expect:
      rows:
        - [false, true]

  - name: cypher_filters_no_node_equal_to_an_integer
    setup:
      - "INSERT (:P {name: 'Alix'}), (:P {name: 'Gus'})"
    variants:
      cypher: "MATCH (n:P) WHERE n = 0 OR n = 1 RETURN n.name AS name"
    expect:
      empty: true

  # ---------------------------------------------------------------------------
  # GQL: not comparable
  # ---------------------------------------------------------------------------

  - name: gql_cannot_compare_a_node_with_its_id
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      gql: "MATCH (s)-[r:KNOWS]->(t) RETURN startNode(r) = id(s) AS a"
    expect:
      gql_status: "22G04"

  - name: gql_cannot_order_a_node_and_a_number
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) RETURN n < 5 AS a"
    expect:
      gql_status: "22G04"

  - name: gql_cannot_compare_a_node_with_a_string
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) RETURN n = 'Alix' AS a"
    expect:
      gql_status: "22G04"

  - name: gql_cannot_compare_a_node_with_an_edge
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      gql: "MATCH (s)-[r:KNOWS]->(t) RETURN s = r AS a"
    expect:
      gql_status: "22G04"

  - name: gql_cannot_look_for_a_node_in_a_list_of_ids
    setup:
      - "INSERT (:P {name: 'Alix'})-[:KNOWS]->(:P {name: 'Gus'})"
    variants:
      gql: "MATCH (s)-[r:KNOWS]->(t) RETURN s IN [id(s), id(t)] AS a"
    expect:
      gql_status: "22G04"

  - name: gql_cannot_filter_a_node_by_an_integer
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) WHERE n = 0 RETURN n.name AS name"
    expect:
      gql_status: "22G04"
