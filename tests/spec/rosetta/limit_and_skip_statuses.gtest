# Rosetta: LIMIT, SKIP and OFFSET parameters of the wrong value
#
# A row count is a non-negative integer. ISO/IEC 39075 gives a negative one
# 22G02 (negative limit value) and a value of another type 22G03 (invalid
# value type); GQL's SKIP and OFFSET follow LIMIT, and Cypher's LIMIT and SKIP
# take the same codes. A count of 0 and one past the last row are fine.

meta:
  model: lpg
  section: rosetta
  title: LIMIT and SKIP parameter statuses
  dataset: empty
  requires: [cypher]

tests:

  # ---------------------------------------------------------------------------
  # 22G02: a negative count
  # ---------------------------------------------------------------------------

  - name: a_negative_skip_parameter
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    variants:
      gql: "MATCH (n:Person) RETURN n.name AS name SKIP $k"
      cypher: "MATCH (n:Person) RETURN n.name AS name SKIP $k"
    params:
      k: -1
    expect:
      error: "must be non-negative, got -1"
      gql_status: "22G02"

  - name: a_negative_offset_parameter
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    query: "MATCH (n:Person) RETURN n.name AS name OFFSET $k"
    params:
      k: -2
    expect:
      error: "must be non-negative, got -2"
      gql_status: "22G02"

  - name: a_negative_limit_parameter_in_cypher
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    variants:
      cypher: "MATCH (n:Person) RETURN n.name AS name LIMIT $k"
    params:
      k: -1
    expect:
      error: "must be non-negative, got -1"
      gql_status: "22G02"

  # ---------------------------------------------------------------------------
  # 22G03: a count that is no integer
  # ---------------------------------------------------------------------------

  - name: a_skip_parameter_that_is_text
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    variants:
      gql: "MATCH (n:Person) RETURN n.name AS name SKIP $k"
      cypher: "MATCH (n:Person) RETURN n.name AS name SKIP $k"
    params:
      k: "three"
    expect:
      error: "must be an integer"
      gql_status: "22G03"

  - name: a_limit_parameter_that_is_text_in_cypher
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    variants:
      cypher: "MATCH (n:Person) RETURN n.name AS name LIMIT $k"
    params:
      k: "three"
    expect:
      error: "must be an integer"
      gql_status: "22G03"

  - name: a_limit_parameter_that_is_a_float
    setup:
      - "INSERT (:Person {name: 'Alix'})"
    variants:
      gql: "MATCH (n:Person) RETURN n.name AS name LIMIT $k"
      cypher: "MATCH (n:Person) RETURN n.name AS name LIMIT $k"
    params:
      k: 1.5
    expect:
      error: "must be an integer"
      gql_status: "22G03"

  # ---------------------------------------------------------------------------
  # Counts that are fine
  # ---------------------------------------------------------------------------

  - name: a_limit_of_zero_gives_no_rows
    setup:
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (n:Person) RETURN n.name AS name LIMIT $k"
      cypher: "MATCH (n:Person) RETURN n.name AS name LIMIT $k"
    params:
      k: 0
    expect:
      empty: true

  - name: a_skip_past_the_last_row_gives_no_rows
    setup:
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (n:Person) RETURN n.name AS name ORDER BY name SKIP $k"
      cypher: "MATCH (n:Person) RETURN n.name AS name ORDER BY name SKIP $k"
    params:
      k: 2
    expect:
      empty: true

  - name: skip_and_limit_parameters_together
    setup:
      - "INSERT (:Person {name: 'Alix'})"
      - "INSERT (:Person {name: 'Gus'})"
      - "INSERT (:Person {name: 'Vincent'})"
    variants:
      gql: "MATCH (n:Person) RETURN n.name AS name ORDER BY name SKIP $s LIMIT $k"
      cypher: "MATCH (n:Person) RETURN n.name AS name ORDER BY name SKIP $s LIMIT $k"
    params:
      s: 1
      k: 1
    expect:
      ordered: true
      rows:
        - [Gus]
