  - name: collected_list_key_after_count
    setup:
      - "INSERT (p:Person {id: 5})-[:STUDY_AT]->(:Uni {name: 'UvA'}), (p)-[:WORK_AT]->(:Company {name: 'Siemens'})"
    variants:
      gql: "MATCH (f:Person)-[:STUDY_AT]->(u) WITH f, collect(u.name) AS unis WITH f, count(1) AS a, unis RETURN unis, a"
      cypher: "MATCH (f:Person)-[:STUDY_AT]->(u) WITH f, collect(u.name) AS unis WITH f, count(1) AS a, unis RETURN unis, a"
