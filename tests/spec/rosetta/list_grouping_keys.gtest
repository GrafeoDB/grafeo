    variants:
      gql: "MATCH (f:Person)-[:STUDY_AT]->(u) WITH f, collect(u.name) AS unis WITH unis, avg(1) AS a RETURN unis, a"
      cypher: "MATCH (f:Person)-[:STUDY_AT]->(u) WITH f, collect(u.name) AS unis WITH unis, avg(1) AS a RETURN unis, a"
    expect:
      rows:
