  - name: literal_list_key_after_collect
    setup:
      - "INSERT (p:Person {id: 5})-[:STUDY_AT]->(:Uni {name: 'UvA'}), (p)-[:WORK_AT]->(:Company {name: 'Siemens'})"
    variants:
      gql: "MATCH (f:Person) WITH f, [f.id, 1] AS l WITH f, collect(1) AS a, l RETURN l, a"
      cypher: "MATCH (f:Person) WITH f, [f.id, 1] AS l WITH f, collect(1) AS a, l RETURN l, a"
    expect:
      rows:
        - [[5, 1], [1]]

  - name: literal_list_key_after_sum
    setup:
      - "INSERT (p:Person {id: 5})-[:STUDY_AT]->(:Uni {name: 'UvA'}), (p)-[:WORK_AT]->(:Company {name: 'Siemens'})"
    variants:
