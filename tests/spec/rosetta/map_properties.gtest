# Rosetta: access into map-valued properties
#
# `n.meta.route` reads key `route` of the map stored in property `meta`, the
# same as `n.meta['route']`, in GQL and Cypher. A missing key, or a property
# that is not a map, gives null.

meta:
  model: lpg
  section: rosetta
  title: Map-valued property access
  dataset: empty
  requires: [cypher]

tests:

  - name: nested_map_property_dot_access
    setup:
      - "INSERT (:A {id: 'a', meta: {route: 'directory', score: 0.5}})"
      - "INSERT (:A {id: 'b', meta: {route: 'llm', score: 0.9}})"
    variants:
      gql: "MATCH (n:A) WHERE n.meta.route = 'directory' RETURN n.id, n.meta.score"
      cypher: "MATCH (n:A) WHERE n.meta.route = 'directory' RETURN n.id, n.meta.score"
    expect:
      rows:
        - [a, 0.5]

  - name: nested_map_property_dot_access_missing_key_is_null
    setup:
      - "INSERT (:A {id: 'a', meta: {route: 'directory'}})"
    variants:
      gql: "MATCH (n:A) RETURN n.meta.missing"
      cypher: "MATCH (n:A) RETURN n.meta.missing"
    expect:
      rows:
        - [null]

  - name: nested_map_property_dot_access_two_levels
    setup:
      - "INSERT (:A {id: 'a', meta: {a: {b: 'deep'}}})"
      - "INSERT (:A {id: 'b', meta: {a: {b: 'shallow'}}})"
    variants:
      gql: "MATCH (n:A) WHERE n.meta.a.b = 'deep' RETURN n.id, n.meta.a.b, n.meta.a.missing"
      cypher: "MATCH (n:A) WHERE n.meta.a.b = 'deep' RETURN n.id, n.meta.a.b, n.meta.a.missing"
    expect:
      rows:
        - [a, deep, null]

  - name: nested_map_property_dot_access_matches_subscript
    setup:
      - "INSERT (:A {id: 'a', meta: {route: 'directory'}})"
      - "INSERT (:A {id: 'b', meta: 'plain text'})"
      - "INSERT (:A {id: 'c'})"
    variants:
      gql: "MATCH (n:A) RETURN n.id, n.meta.route AS dotted, n.meta['route'] AS subscript"
      cypher: "MATCH (n:A) RETURN n.id, n.meta.route AS dotted, n.meta['route'] AS subscript"
    expect:
      rows:
        - [a, directory, directory]
        - [b, null, null]
        - [c, null, null]

  - name: nested_map_property_dot_access_on_edge
    setup:
      - "INSERT (:A {id: 'a'})-[:R {meta: {route: 'directory'}}]->(:A {id: 'b'})"
    variants:
      gql: "MATCH (:A)-[r:R]->(:A) RETURN r.meta.route"
      cypher: "MATCH (:A)-[r:R]->(:A) RETURN r.meta.route"
    expect:
      rows:
        - [directory]

  - name: nested_map_property_dot_access_in_order_by
    setup:
      - "INSERT (:A {id: 'a', meta: {score: 0.5}})"
      - "INSERT (:A {id: 'b', meta: {score: 0.9}})"
      - "INSERT (:A {id: 'c', meta: {score: 0.7}})"
    variants:
      gql: "MATCH (n:A) RETURN n.id ORDER BY n.meta.score DESC"
      cypher: "MATCH (n:A) RETURN n.id ORDER BY n.meta.score DESC"
    expect:
      ordered: true
      rows:
        - [b]
        - [c]
        - [a]

  # A column without an alias is named as written: `n.meta.score`, while the
  # subscript form keeps its brackets.
  - name: nested_map_property_dot_access_names_its_column
    setup:
      - "INSERT (:A {id: 'a', meta: {score: 0.5, a: {b: 'deep'}}})"
    variants:
      gql: "MATCH (n:A) RETURN n.meta.score, n.meta.a.b, n.meta['score']"
      cypher: "MATCH (n:A) RETURN n.meta.score, n.meta.a.b, n.meta['score']"
    expect:
      columns: [n.meta.score, n.meta.a.b, "n.meta['score']"]
      rows:
        - [0.5, deep, 0.5]

  # Map-shaped bases: a map literal, a map bound to a variable, properties()
  # and an element of a list of maps.
  - name: nested_map_property_dot_access_on_map_values
    setup:
      - "INSERT (:A {id: 'a', items: [{k: 'first'}, {k: 'second'}]})"
    variants:
      gql: "MATCH (n:A) WITH n, {route: {to: 'x'}} AS m RETURN m.route.to, properties(n).id, n.items[1].k, [{k: 'y'}][0].k"
      cypher: "MATCH (n:A) WITH n, {route: {to: 'x'}} AS m RETURN m.route.to, properties(n).id, n.items[1].k, [{k: 'y'}][0].k"
    expect:
      rows:
        - [x, a, second, y]

  # Dotted access reads a key of a map, and the property of a node or edge
  # that an expression returns (startNode and endNode return nodes).
  - name: dot_access_on_an_endpoint_function_reads_the_node
    setup:
      - "INSERT (:A {id: 'a'})-[:R]->(:A {id: 'b'})"
    variants:
      gql: "MATCH (:A)-[r:R]->(:A) RETURN startNode(r).id, endNode(r).id"
      cypher: "MATCH (:A)-[r:R]->(:A) RETURN startNode(r).id, endNode(r).id"
    expect:
      rows:
        - [a, b]

  # On an aggregate in the same clause it is an error, never a silent null:
  # name the aggregate with WITH first.
  - name: dot_access_on_a_collected_node_is_an_error
    setup:
      - "INSERT (:A {id: 'a'})"
    variants:
      gql: "MATCH (n:A) RETURN head(collect(n)).id"
      cypher: "MATCH (n:A) RETURN collect(n)[0].id"
    expect:
      error: "reads an aggregate"

  - name: dot_access_on_a_collected_node_after_with
    setup:
      - "INSERT (:A {id: 'a'})"
    variants:
      gql: "MATCH (n:A) WITH collect(n) AS ns RETURN head(ns).id, ns[0].id"
      cypher: "MATCH (n:A) WITH collect(n) AS ns RETURN head(ns).id, ns[0].id"
    expect:
      rows:
        - [a, a]
