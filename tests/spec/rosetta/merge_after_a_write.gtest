# Rosetta: MERGE after a write
#
# A MERGE after a write in the same query sees all of what the query wrote
# before it, also what the rows after the current one wrote, as a MATCH there
# does: the row i writes (:P {k: i}) and merges k: 4 - i, which a later row
# writes for the first row. It used to see only what the rows up to its own
# wrote, so it created the node again and the later row's write made a
# duplicate. A MERGE still sees what it created for the rows before its own.
#
# The count after the WITH reads what the query wrote.

meta:
  model: lpg
  section: rosetta
  title: MERGE after a write
  dataset: empty
  requires: [cypher]

tests:

  - name: a_merge_after_a_write_finds_the_later_rows_nodes
    variants:
      gql: "FOR i IN range(1, 3) INSERT (:P {k: i}) WITH i MERGE (t:P {k: 4 - i}) ON MATCH SET t.matched = true ON CREATE SET t.created = true WITH count(*) AS merged MATCH (p:P) RETURN merged, count(p) AS nodes, count(p.matched) AS matched, count(p.created) AS created"
      cypher: "UNWIND range(1, 3) AS i CREATE (:P {k: i}) WITH i MERGE (t:P {k: 4 - i}) ON MATCH SET t.matched = true ON CREATE SET t.created = true WITH count(*) AS merged MATCH (p:P) RETURN merged, count(p) AS nodes, count(p.matched) AS matched, count(p.created) AS created"
    expect:
      rows:
        - [3, 3, 3, 0]

  - name: a_merge_after_a_write_finds_the_later_rows_nodes_through_an_index
    setup:
      - "CREATE INDEX idx_k FOR (n:P) ON (n.k)"
    variants:
      gql: "FOR i IN range(1, 3) INSERT (:P {k: i}) WITH i MERGE (t:P {k: 4 - i}) ON MATCH SET t.matched = true ON CREATE SET t.created = true WITH count(*) AS merged MATCH (p:P) RETURN merged, count(p) AS nodes, count(p.matched) AS matched, count(p.created) AS created"
      cypher: "UNWIND range(1, 3) AS i CREATE (:P {k: i}) WITH i MERGE (t:P {k: 4 - i}) ON MATCH SET t.matched = true ON CREATE SET t.created = true WITH count(*) AS merged MATCH (p:P) RETURN merged, count(p) AS nodes, count(p.matched) AS matched, count(p.created) AS created"
    expect:
      rows:
        - [3, 3, 3, 0]

  # GQL takes a MERGE right after an INSERT.
  - name: a_merge_right_after_an_insert_finds_the_later_rows_nodes
    variants:
      gql: "FOR i IN range(1, 3) INSERT (:P {k: i}) MERGE (t:P {k: 4 - i}) WITH count(*) AS merged MATCH (p:P) RETURN merged, count(p) AS nodes"
    expect:
      rows:
        - [3, 3]

  # The row i links the hubs k: i and k: i + 1, then merges the link from
  # k: 5 - i to k: 6 - i, which the row 5 - i writes.
  - name: a_relationship_merge_after_a_write_finds_the_later_rows_edges
    variants:
      gql: "FOR i IN range(1, 4) MERGE (a:Hub {k: i}) MERGE (b:Hub {k: i + 1}) INSERT (a)-[:R]->(b) WITH i MERGE (c:Hub {k: 5 - i}) MERGE (d:Hub {k: 6 - i}) MERGE (c)-[r:R]->(d) ON MATCH SET r.matched = true ON CREATE SET r.created = true WITH count(*) AS merged MATCH ()-[r:R]->() RETURN merged, count(r) AS edges, count(r.matched) AS matched, count(r.created) AS created"
      cypher: "UNWIND range(1, 4) AS i MERGE (a:Hub {k: i}) MERGE (b:Hub {k: i + 1}) CREATE (a)-[:R]->(b) WITH i MERGE (c:Hub {k: 5 - i}) MERGE (d:Hub {k: 6 - i}) MERGE (c)-[r:R]->(d) ON MATCH SET r.matched = true ON CREATE SET r.created = true WITH count(*) AS merged MATCH ()-[r:R]->() RETURN merged, count(r) AS edges, count(r.matched) AS matched, count(r.created) AS created"
    expect:
      rows:
        - [4, 4, 4, 0]

  # The same links between hubs that are there before the query, with the
  # relationship MERGE right after the write of the links.
  - name: a_relationship_merge_right_after_a_write_finds_the_later_rows_edges
    setup:
      - "FOR k IN range(1, 5) INSERT (:Hub {k: k})"
    variants:
      gql: "FOR i IN range(1, 4) MATCH (a:Hub {k: i}), (b:Hub {k: i + 1}), (c:Hub {k: 5 - i}), (d:Hub {k: 6 - i}) INSERT (a)-[:R]->(b) MERGE (c)-[r:R]->(d) ON MATCH SET r.matched = true ON CREATE SET r.created = true WITH count(*) AS merged MATCH ()-[r:R]->() RETURN merged, count(r) AS edges, count(r.matched) AS matched, count(r.created) AS created"
      cypher: "UNWIND range(1, 4) AS i MATCH (a:Hub {k: i}), (b:Hub {k: i + 1}), (c:Hub {k: 5 - i}), (d:Hub {k: 6 - i}) CREATE (a)-[:R]->(b) MERGE (c)-[r:R]->(d) ON MATCH SET r.matched = true ON CREATE SET r.created = true WITH count(*) AS merged MATCH ()-[r:R]->() RETURN merged, count(r) AS edges, count(r.matched) AS matched, count(r.created) AS created"
    expect:
      rows:
        - [4, 4, 4, 0]

  # Two rows of key 3 still create one node.
  - name: a_merge_after_a_write_sees_its_own_earlier_rows
    variants:
      gql: "FOR i IN [1, 2] INSERT (:N {k: i}) WITH i FOR k IN [3, 3, 19] MERGE (:P {k: k}) WITH count(*) AS merged MATCH (p:P) RETURN merged, count(p) AS nodes"
      cypher: "UNWIND [1, 2] AS i CREATE (:N {k: i}) WITH i UNWIND [3, 3, 19] AS k MERGE (:P {k: k}) WITH count(*) AS merged MATCH (p:P) RETURN merged, count(p) AS nodes"
    expect:
      rows:
        - [6, 2]
