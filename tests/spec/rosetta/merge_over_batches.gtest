# Rosetta: a MERGE per row of a batch
#
# A MERGE fed by UNWIND (Cypher) or FOR (GQL) runs once per row, and each row
# sees what the rows before it wrote, as in openCypher. Two reports:
#
# - #172: `UNWIND $batch AS item MERGE (x {qn: item.qn}) SET x.name =
#   item.name` left name null when the batch was a parameter list of maps.
# - #317: an ON MATCH SET that reads the MERGE variable (n.cnt = n.cnt + 1)
#   must see the previous row's update, so three equal keys count to 3.

meta:
  model: lpg
  section: rosetta
  title: MERGE per row of a batch
  dataset: empty
  requires: [cypher]

tests:

  # ---------------------------------------------------------------------------
  # #172: properties from a parameter list of maps
  # ---------------------------------------------------------------------------

  - name: merge_sets_a_property_from_each_map_of_a_parameter
    params:
      batch: [{"qn": "test://foo", "name": "Foo"}, {"qn": "test://bar", "name": "Bar"}]
    variants:
      gql: "FOR item IN $batch MERGE (x:Sym {qn: item.qn}) SET x.name = item.name RETURN x.qn AS qn, x.name AS name"
      cypher: "UNWIND $batch AS item MERGE (x:Sym {qn: item.qn}) SET x.name = item.name RETURN x.qn AS qn, x.name AS name"
    expect:
      rows:
        - ["test://bar", Bar]
        - ["test://foo", Foo]

  - name: merge_adds_each_map_of_a_parameter
    params:
      batch: [{"qn": "test://foo", "name": "Foo"}, {"qn": "test://bar", "name": "Bar"}]
    variants:
      cypher: "UNWIND $batch AS item MERGE (x:Sym {qn: item.qn}) SET x += item RETURN x.qn AS qn, x.name AS name"
    expect:
      rows:
        - ["test://bar", Bar]
        - ["test://foo", Foo]

  - name: merge_from_a_parameter_stores_the_properties
    language: cypher
    params:
      batch: [{"qn": "test://foo", "name": "Foo"}, {"qn": "test://bar", "name": "Bar"}]
    statements:
      - "UNWIND $batch AS item MERGE (x:Sym {qn: item.qn}) SET x.name = item.name"
      - "MATCH (x:Sym) RETURN x.qn AS qn, x.name AS name, count(*) AS nodes"
    expect:
      rows:
        - ["test://bar", Bar, 1]
        - ["test://foo", Foo, 1]

  - name: merge_from_a_parameter_updates_the_matched_nodes
    language: cypher
    setup:
      - "INSERT (:Sym {qn: 'test://foo', name: 'Old'})"
    params:
      batch: [{"qn": "test://foo", "name": "Foo"}, {"qn": "test://bar", "name": "Bar"}]
    statements:
      - "UNWIND $batch AS item MERGE (x:Sym {qn: item.qn}) SET x.name = item.name"
      - "MATCH (x:Sym) RETURN x.qn AS qn, x.name AS name, count(*) AS nodes"
    expect:
      rows:
        - ["test://bar", Bar, 1]
        - ["test://foo", Foo, 1]

  # ---------------------------------------------------------------------------
  # #317: each row sees the previous row's ON MATCH update
  # ---------------------------------------------------------------------------

  - name: merge_on_match_increments_once_per_row
    language: cypher
    statements:
      - "UNWIND [1, 1, 1] AS k MERGE (n:Counter {id: k}) ON CREATE SET n.cnt = 1 ON MATCH SET n.cnt = n.cnt + 1"
      - "MATCH (n:Counter) RETURN n.id AS id, n.cnt AS cnt"
    expect:
      rows:
        - [1, 3]

  - name: merge_on_match_increments_per_key
    language: cypher
    statements:
      - "UNWIND [1, 2, 1, 1, 2] AS k MERGE (n:Counter {id: k}) ON CREATE SET n.cnt = 1 ON MATCH SET n.cnt = n.cnt + 1"
      - "MATCH (n:Counter) RETURN n.id AS id, n.cnt AS cnt"
    expect:
      rows:
        - [1, 3]
        - [2, 2]

  - name: merge_on_match_increments_per_key_in_gql
    statements:
      - "FOR k IN [1, 2, 1, 1, 2] MERGE (n:Counter {id: k}) ON CREATE SET n.cnt = 1 ON MATCH SET n.cnt = n.cnt + 1"
      - "MATCH (n:Counter) RETURN n.id AS id, n.cnt AS cnt"
    expect:
      rows:
        - [1, 3]
        - [2, 2]

  - name: merge_on_match_increment_over_an_existing_node
    language: cypher
    setup:
      - "INSERT (:Counter {id: 1, cnt: 10})"
    statements:
      - "UNWIND [1, 1, 1] AS k MERGE (n:Counter {id: k}) ON CREATE SET n.cnt = 1 ON MATCH SET n.cnt = n.cnt + 1"
      - "MATCH (n:Counter) RETURN n.id AS id, n.cnt AS cnt"
    expect:
      rows:
        - [1, 13]
