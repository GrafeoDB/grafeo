# Rosetta: MERGE of a relationship pattern
#
# MERGE matches the whole pattern, or when nothing matches creates all of it,
# in GQL as in Cypher (openCypher's MERGE): the variables bound before are
# reused, every other node and relationship is matched or created with the
# rest. A node the pattern does not connect is not reused, a node with neither
# a label nor a property is any node, and a pattern of more than one
# relationship is merged as a whole (it was refused, and before that merged
# its first relationship and dropped the rest without a word).

meta:
  model: lpg
  section: rosetta
  title: MERGE of a relationship pattern
  dataset: empty
  requires: [cypher]

tests:

  # Vincent does not know Gus: the MERGE creates the relationship with a new
  # Gus (the existing one is not connected), so two Gus nodes, one known.
  - name: merge_to_an_anonymous_labeled_node_creates_the_whole_pattern
    setup:
      - "INSERT (:Person {name: 'Alix'}), (:Person {name: 'Gus'}), (:Person {name: 'Vincent'})"
    variants:
      gql: "MATCH (v:Person {name: 'Vincent'}) MERGE (v)-[:KNOWS]->(:Person {name: 'Gus'}) WITH count(*) AS merged MATCH (p:Person {name: 'Gus'}) OPTIONAL MATCH (p)<-[r:KNOWS]-(:Person {name: 'Vincent'}) RETURN merged, count(DISTINCT p) AS gus, count(r) AS r"
      cypher: "MATCH (v:Person {name: 'Vincent'}) MERGE (v)-[:KNOWS]->(:Person {name: 'Gus'}) WITH count(*) AS merged MATCH (p:Person {name: 'Gus'}) OPTIONAL MATCH (p)<-[r:KNOWS]-(:Person {name: 'Vincent'}) RETURN merged, count(DISTINCT p) AS gus, count(r) AS r"
    expect:
      rows:
        - [1, 2, 1]

  # Once Vincent knows a Gus, the MERGE finds the whole pattern.
  - name: merge_finds_the_whole_pattern
    setup:
      - "INSERT (v:Person {name: 'Vincent'})-[:KNOWS]->(:Person {name: 'Gus'}), (:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (v:Person {name: 'Vincent'}) MERGE (v)-[:KNOWS]->(:Person {name: 'Gus'}) WITH count(*) AS merged MATCH (p:Person {name: 'Gus'}) RETURN merged, count(p) AS gus"
      cypher: "MATCH (v:Person {name: 'Vincent'}) MERGE (v)-[:KNOWS]->(:Person {name: 'Gus'}) WITH count(*) AS merged MATCH (p:Person {name: 'Gus'}) RETURN merged, count(p) AS gus"
    expect:
      rows:
        - [1, 2]

  - name: merge_from_an_anonymous_node_it_creates
    setup:
      - "INSERT (:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (g:Person {name: 'Gus'}) MERGE (:City {name: 'Prague'})-[:HOME_OF]->(g) WITH count(*) AS merged MATCH (c:City)-[:HOME_OF]->(p:Person) RETURN merged, c.name AS c, p.name AS p"
      cypher: "MATCH (g:Person {name: 'Gus'}) MERGE (:City {name: 'Prague'})-[:HOME_OF]->(g) WITH count(*) AS merged MATCH (c:City)-[:HOME_OF]->(p:Person) RETURN merged, c.name AS c, p.name AS p"
    expect:
      rows:
        - [1, Prague, Gus]

  # A node with neither a label nor a property is any node: Vincent knows
  # nobody, so the MERGE creates an empty node with the relationship.
  - name: an_anonymous_node_without_a_label_or_property_is_any_node
    setup:
      - "INSERT (:Person {name: 'Vincent'})"
    variants:
      gql: "MATCH (v:Person {name: 'Vincent'}) MERGE (v)-[:KNOWS]->(x) WITH count(*) AS merged MATCH (n) RETURN merged, count(n) AS nodes"
      cypher: "MATCH (v:Person {name: 'Vincent'}) MERGE (v)-[:KNOWS]->(x) WITH count(*) AS merged MATCH (n) RETURN merged, count(n) AS nodes"
    expect:
      rows:
        - [1, 2]

  - name: a_merge_of_two_relationships_is_created_whole
    setup:
      - "INSERT (:Person {name: 'Alix'}), (:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person {name: 'Alix'}), (b:Person {name: 'Gus'}) MERGE (a)-[:S]->(b)-[:T]->(:N {id: 3}) WITH count(*) AS merged MATCH (:Person {name: 'Alix'})-[:S]->(:Person {name: 'Gus'})-[:T]->(n:N) RETURN merged, n.id AS id"
      cypher: "MATCH (a:Person {name: 'Alix'}), (b:Person {name: 'Gus'}) MERGE (a)-[:S]->(b)-[:T]->(:N {id: 3}) WITH count(*) AS merged MATCH (:Person {name: 'Alix'})-[:S]->(:Person {name: 'Gus'})-[:T]->(n:N) RETURN merged, n.id AS id"
    expect:
      rows:
        - [1, 3]
