# Negative literals in property maps and expressions (#160)
#
# A negative number is a number wherever an expression may stand: in a
# property map, in parentheses, as a difference, as the smallest integer and
# in a list or a nested map, in GQL and Cypher, and SQL/PGQ reads the stored
# values back. GQL reads -6.248 as an exact DECIMAL and Cypher as a FLOAT, as
# each language types a number with a point. #160 reported a negative literal
# in a property map that failed to insert.

meta:
  model: lpg
  section: rosetta
  title: Negative literals
  dataset: empty
  requires: [cypher, sql-pgq]

tests:

  - name: negative_literal_forms_in_a_property_map
    variants:
      gql: "INSERT (l:Location {a: (-6.248), b: 0 - 6.248, c: -6, d: -(6)}) RETURN l.a AS a, l.b AS b, l.c AS c, l.d AS d"
      cypher: "CREATE (l:Location {a: (-6.248), b: 0 - 6.248, c: -6, d: -(6)}) RETURN l.a AS a, l.b AS b, l.c AS c, l.d AS d"
    expect:
      rows:
        - [-6.248, -6.248, -6, -6]

  - name: a_negative_literal_keeps_its_language_type
    variants:
      gql: "RETURN -6.248 IS TYPED DECIMAL AS dec, -6 IS TYPED INT64 AS int, -6.248e0 IS TYPED FLOAT64 AS float"
    expect:
      rows:
        - [true, true, true]

  - name: the_smallest_integer_as_a_literal_and_a_difference
    variants:
      gql: "RETURN -9223372036854775807 - 1 AS d, -9223372036854775808 AS lit"
      cypher: "RETURN -9223372036854775807 - 1 AS d, -9223372036854775808 AS lit"
    expect:
      rows:
        - [-9223372036854775808, -9223372036854775808]

  - name: negative_values_inside_lists_and_maps
    variants:
      gql: "INSERT (n:N {xs: [-1, -2.5e0, 3], m: {lat: -33.8688e0}}) RETURN n.xs[0] + n.xs[1] AS s, n.m.lat < 0 AS south"
      cypher: "CREATE (n:N {xs: [-1, -2.5, 3], m: {lat: -33.8688}}) RETURN n.xs[0] + n.xs[1] AS s, n.m.lat < 0 AS south"
    expect:
      rows:
        - [-3.5, true]

  - name: stored_negative_values_read_in_every_language
    setup:
      - "INSERT (:Location {name: 'Sydney', lat: -33.8688e0, depth: -12})"
    variants:
      gql: "MATCH (l:Location) WHERE l.lat < -30 AND l.depth = -12 RETURN l.name AS name, l.lat AS lat"
      cypher: "MATCH (l:Location) WHERE l.lat < -30 AND l.depth = -12 RETURN l.name AS name, l.lat AS lat"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (l:Location) WHERE l.lat < -30 AND l.depth = -12 COLUMNS (l.name AS name, l.lat AS lat))"
    expect:
      rows:
        - [Sydney, -33.8688]

  - name: a_negative_parameter_in_a_property_map
    params:
      lat: -33.8688
    variants:
      gql: "INSERT (l:Location {lat: $lat, south: $lat < 0}) RETURN l.lat AS lat, l.south AS south"
      cypher: "CREATE (l:Location {lat: $lat, south: $lat < 0}) RETURN l.lat AS lat, l.south AS south"
    expect:
      rows:
        - [-33.8688, true]

  - name: set_and_merge_with_negative_literals
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (p:P) SET p.balance = -250.75, p.floor = -2 RETURN p.balance AS b, p.floor AS f"
      cypher: "MERGE (p:P {name: 'Alix'}) SET p.balance = -250.75, p.floor = -2 RETURN p.balance AS b, p.floor AS f"
    expect:
      rows:
        - [-250.75, -2]
