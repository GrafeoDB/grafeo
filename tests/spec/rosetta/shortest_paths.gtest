# Rosetta: shortest-path searches in GQL and Cypher
#
# A shortest-path search returns a row only for a pair of nodes that has a
# path, and the path must fit the hop bounds of the edge pattern: `->+`,
# `-[*]->` (at least one hop), `->*`, `-[*0..]->` (zero or more),
# `->{1,2}`, `-[*..2]->`. Without a quantifier the edge is a single hop.
# OPTIONAL MATCH keeps a pair without a path, with a null path.
#
# Setup (GQL): Amsterdam -> Berlin -> Prague -> Amsterdam (a cycle of ROUTE
# edges), and Paris without routes.

meta:
  model: lpg
  section: rosetta
  title: Shortest paths cross-language equivalence
  dataset: empty
  requires: [cypher]

tests:

  # ---------------------------------------------------------------------------
  # Pairs without a path
  # ---------------------------------------------------------------------------

  - name: no_path_has_no_row
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:City {name: 'Paris'})-[:ROUTE]->+(b:City {name: 'Berlin'}) RETURN a.name, b.name, length(p)"
      cypher: "MATCH p = shortestPath((a:City {name: 'Paris'})-[:ROUTE*]->(b:City {name: 'Berlin'})) RETURN a.name, b.name, length(p)"
    expect:
      empty: true

  - name: all_shortest_without_a_path_has_no_row
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ALL SHORTEST (a:City {name: 'Paris'})-[:ROUTE]->+(b:City {name: 'Berlin'}) RETURN a.name, b.name, length(p)"
      cypher: "MATCH p = allShortestPaths((a:City {name: 'Paris'})-[:ROUTE*]->(b:City {name: 'Berlin'})) RETURN a.name, b.name, length(p)"
    expect:
      empty: true

  - name: optional_match_keeps_a_pair_without_a_path
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH (a:City), (b:City {name: 'Berlin'}) OPTIONAL MATCH p = ANY SHORTEST (a)-[:ROUTE]->+(b) RETURN a.name, b.name, length(p)"
      cypher: "MATCH (a:City), (b:City {name: 'Berlin'}) OPTIONAL MATCH p = shortestPath((a)-[:ROUTE*]->(b)) RETURN a.name, b.name, length(p)"
    expect:
      rows:
        - [Amsterdam, Berlin, 1]
        - [Berlin, Berlin, 3]
        - [Paris, Berlin, null]
        - [Prague, Berlin, 2]

  # ---------------------------------------------------------------------------
  # A node paired with itself
  # ---------------------------------------------------------------------------

  - name: one_hop_minimum_finds_the_cycle_back
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:City {name: 'Amsterdam'})-[:ROUTE]->+(b:City {name: 'Amsterdam'}) RETURN length(p)"
      cypher: "MATCH p = shortestPath((a:City {name: 'Amsterdam'})-[:ROUTE*]->(b:City {name: 'Amsterdam'})) RETURN length(p)"
    expect:
      rows:
        - [3]

  - name: one_hop_minimum_has_no_zero_length_self_path
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:City {name: 'Paris'})-[:ROUTE]->+(b:City {name: 'Paris'}) RETURN length(p)"
      cypher: "MATCH p = shortestPath((a:City {name: 'Paris'})-[:ROUTE*]->(b:City {name: 'Paris'})) RETURN length(p)"
    expect:
      empty: true

  - name: zero_hop_minimum_keeps_the_zero_length_self_path
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:City {name: 'Paris'})-[:ROUTE]->*(b:City {name: 'Paris'}) RETURN length(p)"
      cypher: "MATCH p = shortestPath((a:City {name: 'Paris'})-[:ROUTE*0..]->(b:City {name: 'Paris'})) RETURN length(p)"
    expect:
      rows:
        - [0]

  - name: all_shortest_with_a_one_hop_minimum
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ALL SHORTEST (a:City {name: 'Amsterdam'})-[:ROUTE]->+(b:City) RETURN b.name, length(p)"
      cypher: "MATCH p = allShortestPaths((a:City {name: 'Amsterdam'})-[:ROUTE*]->(b:City)) RETURN b.name, length(p)"
    expect:
      rows:
        - [Amsterdam, 3]
        - [Berlin, 1]
        - [Prague, 2]

  # ---------------------------------------------------------------------------
  # Hop bounds
  # ---------------------------------------------------------------------------

  - name: maximum_drops_a_longer_path
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:City {name: 'Amsterdam'})-[:ROUTE]->{1,1}(b:City {name: 'Prague'}) RETURN length(p)"
      cypher: "MATCH p = shortestPath((a:City {name: 'Amsterdam'})-[:ROUTE*1..1]->(b:City {name: 'Prague'})) RETURN length(p)"
    expect:
      empty: true

  - name: maximum_keeps_a_path_within_it
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:City {name: 'Amsterdam'})-[:ROUTE]->{1,2}(b:City {name: 'Prague'}) RETURN length(p)"
      cypher: "MATCH p = shortestPath((a:City {name: 'Amsterdam'})-[:ROUTE*..2]->(b:City {name: 'Prague'})) RETURN length(p)"
    expect:
      rows:
        - [2]

  - name: no_quantifier_means_one_hop
    setup:
      - "INSERT (:City {name: 'Amsterdam'})-[:ROUTE]->(:City {name: 'Berlin'})-[:ROUTE]->(:City {name: 'Prague'})"
      - "MATCH (p:City {name: 'Prague'}), (a:City {name: 'Amsterdam'}) INSERT (p)-[:ROUTE]->(a)"
      - "INSERT (:City {name: 'Paris'})"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:City {name: 'Amsterdam'})-[:ROUTE]->(b:City) RETURN b.name, length(p)"
      cypher: "MATCH p = shortestPath((a:City {name: 'Amsterdam'})-[:ROUTE]->(b:City)) RETURN b.name, length(p)"
    expect:
      rows:
        - [Berlin, 1]

  # ---------------------------------------------------------------------------
  # The path and the edge variable (#572): the path variable binds the path
  # found, its nodes and edges, and the variable of a quantified edge pattern
  # is a group variable, the list of the path's edges. The edge pattern's
  # property map holds for every edge of a path before the shortest is picked
  # (ISO/IEC 39075:2024 16.6).
  #
  # Setup: Alix -> Gus -> Vincent -> Mia (KNOWS, w 3, 19, 88, kind 'road')
  # and the shortcut Alix -> Vincent (w 38, kind 'air').
  # ---------------------------------------------------------------------------

  - name: edge_variable_binds_the_edges_of_the_path
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:Person {name: 'Alix'})-[e:KNOWS]->{1,4}(b:Person {name: 'Mia'}) RETURN size(e) AS n, [x IN e | x.w] AS ws, [v IN nodes(p) | v.name] AS names"
      cypher: "MATCH p = shortestPath((a:Person {name: 'Alix'})-[e:KNOWS*1..4]->(b:Person {name: 'Mia'})) RETURN size(e) AS n, [x IN e | x.w] AS ws, [v IN nodes(p) | v.name] AS names"
    expect:
      rows:
        - [2, "[38, 88]", "[Alix, Vincent, Mia]"]

  - name: edge_property_map_holds_for_every_edge_of_the_search
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:Person {name: 'Alix'})-[e:KNOWS {kind: 'road'}]->{1,4}(b:Person {name: 'Mia'}) RETURN length(p) AS len, [x IN e | x.w] AS ws"
      cypher: "MATCH p = shortestPath((a:Person {name: 'Alix'})-[e:KNOWS* {kind: 'road'}]->(b:Person {name: 'Mia'})) RETURN length(p) AS len, [x IN e | x.w] AS ws"
    expect:
      rows:
        - [3, "[3, 19, 88]"]

  - name: shortest_path_is_not_null
    setup:
      - "INSERT (alix:Person {name: 'Alix'}), (gus:Person {name: 'Gus'}), (vincent:Person {name: 'Vincent'}), (mia:Person {name: 'Mia'}), (alix)-[:KNOWS {w: 3, kind: 'road'}]->(gus), (gus)-[:KNOWS {w: 19, kind: 'road'}]->(vincent), (vincent)-[:KNOWS {w: 88, kind: 'road'}]->(mia), (alix)-[:KNOWS {w: 38, kind: 'air'}]->(vincent)"
    variants:
      gql: "MATCH p = ANY SHORTEST (a:Person {name: 'Alix'})-[:KNOWS]->+(b:Person {name: 'Mia'}) RETURN p IS NULL AS missing, [r IN edges(p) | r.w] AS ws"
      cypher: "MATCH p = shortestPath((a:Person {name: 'Alix'})-[:KNOWS*]->(b:Person {name: 'Mia'})) RETURN p IS NULL AS missing, [r IN relationships(p) | r.w] AS ws"
    expect:
      rows:
        - [false, "[38, 88]"]

  - name: all_shortest_binds_each_path
    setup:
      - "INSERT (ams:City {name: 'Amsterdam'}), (ber:City {name: 'Berlin'}), (par:City {name: 'Paris'}), (pra:City {name: 'Prague'}), (ams)-[:ROUTE {w: 3}]->(ber), (ber)-[:ROUTE {w: 19}]->(pra), (ams)-[:ROUTE {w: 88}]->(par), (par)-[:ROUTE {w: 38}]->(pra)"
    variants:
      gql: "MATCH p = ALL SHORTEST (a:City {name: 'Amsterdam'})-[r:ROUTE]->+(b:City {name: 'Prague'}) RETURN [n IN nodes(p) | n.name] AS names, [x IN r | x.w] AS ws"
      cypher: "MATCH p = allShortestPaths((a:City {name: 'Amsterdam'})-[r:ROUTE*]->(b:City {name: 'Prague'})) RETURN [n IN nodes(p) | n.name] AS names, [x IN r | x.w] AS ws"
    expect:
      rows:
        - ["[Amsterdam, Berlin, Prague]", "[3, 19]"]
        - ["[Amsterdam, Paris, Prague]", "[88, 38]"]
