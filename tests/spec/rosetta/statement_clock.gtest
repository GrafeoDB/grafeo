# One clock per statement (#179)
#
# Every clock function without arguments reads one instant per statement:
# now(), current_timestamp, timestamp(), current_date, current_time and the
# argument-free date(), time(), localtime(), datetime(), localdatetime(),
# zonedDatetime() and zonedTime(). So every row of a statement sees the same
# value, two clock calls in one row agree, and the clock functions agree with
# each other. rand() is drawn per call. openCypher: timestamp() "returns the
# same value during one entire query". 100,000 rows run long enough for a
# clock read per call to tick, also for timestamp()'s milliseconds.

meta:
  model: lpg
  section: rosetta
  title: Statement clock
  dataset: empty
  requires: [cypher]

tests:

  - name: every_row_of_a_statement_sees_one_now
    skip: "#179: the clock is read per call until the statement clock lands"
    variants:
      gql: "FOR i IN range(1, 100000) RETURN count(DISTINCT now()) AS now, count(DISTINCT current_timestamp()) AS ts, count(DISTINCT timestamp()) AS ms"
      cypher: "UNWIND range(1, 100000) AS i RETURN count(DISTINCT now()) AS now, count(DISTINCT current_timestamp()) AS ts, count(DISTINCT timestamp()) AS ms"
    expect:
      rows:
        - [1, 1, 1]

  - name: every_row_of_a_statement_sees_one_date_and_time
    skip: "#179: the clock is read per call until the statement clock lands"
    variants:
      gql: "FOR i IN range(1, 100000) RETURN count(DISTINCT current_date()) AS d, count(DISTINCT current_time()) AS t, count(DISTINCT date()) AS d0, count(DISTINCT time()) AS t0, count(DISTINCT localtime()) AS lt"
      cypher: "UNWIND range(1, 100000) AS i RETURN count(DISTINCT current_date()) AS d, count(DISTINCT current_time()) AS t, count(DISTINCT date()) AS d0, count(DISTINCT time()) AS t0, count(DISTINCT localtime()) AS lt"
    expect:
      rows:
        - [1, 1, 1, 1, 1]

  - name: every_row_of_a_statement_sees_one_datetime
    skip: "#179: the clock is read per call until the statement clock lands"
    variants:
      gql: "FOR i IN range(1, 100000) RETURN count(DISTINCT datetime()) AS dt, count(DISTINCT localdatetime()) AS ldt, count(DISTINCT zonedDatetime()) AS zdt, count(DISTINCT zonedTime()) AS zt"
      cypher: "UNWIND range(1, 100000) AS i RETURN count(DISTINCT datetime()) AS dt, count(DISTINCT localdatetime()) AS ldt, count(DISTINCT zonedDatetime()) AS zdt, count(DISTINCT zonedTime()) AS zt"
    expect:
      rows:
        - [1, 1, 1, 1]

  # Two reads in one row are the same instant, and the clock functions
  # derive from it: the date of now() is current_date.
  - name: clock_functions_in_one_row_agree
    skip: "#179: the clock is read per call until the statement clock lands"
    variants:
      gql: "RETURN now() = current_timestamp() AS same_instant, now() = now() AS twice, timestamp() = timestamp() AS ms_twice, date(now()) = current_date() AS same_day, datetime() = localdatetime() AS same_local"
      cypher: "RETURN now() = current_timestamp() AS same_instant, now() = now() AS twice, timestamp() = timestamp() AS ms_twice, date(now()) = current_date() AS same_day, datetime() = localdatetime() AS same_local"
    expect:
      rows:
        - [true, true, true, true, true]

  # A write over many rows stores one value (already so before #179's fix).
  - name: a_write_over_many_rows_stores_one_timestamp
    setup:
      - "FOR i IN range(1, 100000) INSERT (:Event {i: i})"
    variants:
      gql: "MATCH (e:Event) SET e.at = timestamp() RETURN count(DISTINCT e.at) AS stamps, count(e) AS events"
      cypher: "MATCH (e:Event) SET e.at = timestamp() RETURN count(DISTINCT e.at) AS stamps, count(e) AS events"
    expect:
      rows:
        - [1, 100000]

  # rand() stays per call.
  - name: rand_differs_per_row
    variants:
      gql: "FOR i IN range(1, 1000) RETURN count(DISTINCT rand()) > 1 AS varies"
      cypher: "UNWIND range(1, 1000) AS i RETURN count(DISTINCT rand()) > 1 AS varies"
    expect:
      rows:
        - [true]
