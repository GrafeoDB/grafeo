# Text and temporal values stored on nodes, in GQL, Cypher and SQL/PGQ
#
# The value fixes of 0.6.0 read the same from stored properties in every
# language that has the operation: LIKE wildcards match a line break,
# normalize gives NFC, a duration times or divided by a number carries
# fractions down, and a zoned datetime plus a duration keeps its offset.

meta:
  model: lpg
  section: rosetta
  title: Stored text and temporal values
  dataset: empty
  requires: [cypher, sql-pgq]

tests:

  - name: like_matches_a_stored_line_break
    setup:
      - "INSERT (:P {t: 'Alix\nGus'})"
    variants:
      gql: "MATCH (p:P) RETURN p.t LIKE 'Alix%' AS percent, p.t LIKE 'Alix_Gus' AS underscore"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (p:P) COLUMNS (p.t LIKE 'Alix%' AS percent, p.t LIKE 'Alix_Gus' AS underscore))"
    expect:
      rows:
        - [true, true]

  - name: normalize_composes_a_stored_string
    setup:
      - "INSERT (:P {t: 'e\u0301', c: '\u00e9'})"
    variants:
      gql: "MATCH (p:P) RETURN normalize(p.t) = p.c AS same, p.t = p.c AS before"
      cypher: "MATCH (p:P) RETURN normalize(p.t) = p.c AS same, p.t = p.c AS before"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (p:P) COLUMNS (normalize(p.t) = p.c AS same, p.t = p.c AS before))"
    expect:
      rows:
        - [true, false]

  - name: a_stored_duration_scaled_by_a_number
    setup:
      - "INSERT (:P {stay: DURATION 'P1D', longer: DURATION 'P1DT12H', half: DURATION 'PT12H'})"
    variants:
      gql: "MATCH (p:P) RETURN p.stay * 1.5 = p.longer AS times, p.stay / 2 = p.half AS divided, 1.5 * p.stay = p.longer AS left_factor"
      cypher: "MATCH (p:P) RETURN p.stay * 1.5 = p.longer AS times, p.stay / 2 = p.half AS divided, 1.5 * p.stay = p.longer AS left_factor"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (p:P) COLUMNS (p.stay * 1.5 = p.longer AS times, p.stay / 2 = p.half AS divided, 1.5 * p.stay = p.longer AS left_factor))"
    expect:
      rows:
        - [true, true, true]

  - name: a_stored_duration_divided_by_zero
    setup:
      - "INSERT (:P {stay: DURATION 'P1D'})"
    variants:
      gql: "MATCH (p:P) RETURN p.stay / 0 AS r"
      cypher: "MATCH (p:P) RETURN p.stay / 0 AS r"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (p:P) COLUMNS (p.stay / 0 AS r))"
    expect:
      gql_status: "22012"

  - name: a_stored_zoned_datetime_plus_a_stored_duration
    setup:
      - "INSERT (:P {at: zoned_datetime('2024-03-15T10:00:00+01:00'), stay: DURATION 'PT1H', expected: zoned_datetime('2024-03-15T11:00:00+01:00')})"
    variants:
      gql: "MATCH (p:P) RETURN p.at + p.stay = p.expected AS later, toString(p.at + p.stay) AS text, toString(p.at - p.stay) AS earlier"
      cypher: "MATCH (p:P) RETURN p.at + p.stay = p.expected AS later, toString(p.at + p.stay) AS text, toString(p.at - p.stay) AS earlier"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (p:P) COLUMNS (p.at + p.stay = p.expected AS later, CAST(p.at + p.stay AS VARCHAR) AS text, CAST(p.at - p.stay AS VARCHAR) AS earlier))"
    expect:
      rows:
        - [true, "2024-03-15T11:00:00+01:00", "2024-03-15T09:00:00+01:00"]

  - name: two_stored_zoned_datetimes_differ_by_a_duration
    setup:
      - "INSERT (:P {a: zoned_datetime('2024-03-15T12:00:00+01:00'), b: zoned_datetime('2024-03-15T10:00:00Z'), hour: DURATION 'PT1H'})"
    variants:
      gql: "MATCH (p:P) RETURN p.a - p.b = p.hour AS r"
      cypher: "MATCH (p:P) RETURN p.a - p.b = p.hour AS r"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (p:P) COLUMNS (p.a - p.b = p.hour AS r))"
    expect:
      rows:
        - [true]
