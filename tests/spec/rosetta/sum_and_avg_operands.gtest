# What SUM and AVG take
#
# SUM and AVG take numbers, or durations: a string (a numeric one included), a
# boolean, a list or a map among their operands is a type error (22G03), in
# GQL, Cypher and SQL/PGQ, as openCypher defines it, and so are numbers mixed
# with durations. Null operands are skipped and an empty group is null, as
# before. The sum of durations adds them component by component, and their
# average divides that sum, carrying fractions down. They skipped what was no
# number and summed numeric strings. SPARQL keeps its own rules.

meta:
  model: lpg
  section: rosetta
  title: SUM and AVG operands
  dataset: empty
  requires: [cypher, sql-pgq]

tests:

  # ---------------------------------------------------------------------------
  # Type errors
  # ---------------------------------------------------------------------------

  - name: sum_of_a_list_with_a_string_is_a_type_error
    variants:
      gql: "UNWIND [1, 'Alix', 2] AS x RETURN sum(x) AS s"
      cypher: "UNWIND [1, 'Alix', 2] AS x RETURN sum(x) AS s"
    expect:
      gql_status: "22G03"

  - name: sum_of_a_numeric_string_is_a_type_error
    variants:
      gql: "UNWIND ['5', '7'] AS x RETURN sum(x) AS s"
      cypher: "UNWIND ['5', '7'] AS x RETURN sum(x) AS s"
    expect:
      gql_status: "22G03"

  - name: avg_of_booleans_is_a_type_error
    variants:
      gql: "UNWIND [true, false] AS x RETURN avg(x) AS a"
      cypher: "UNWIND [true, false] AS x RETURN avg(x) AS a"
    expect:
      gql_status: "22G03"

  - name: sum_of_lists_is_a_type_error
    variants:
      gql: "UNWIND [[1], [2]] AS x RETURN sum(x) AS s"
      cypher: "UNWIND [[1], [2]] AS x RETURN sum(x) AS s"
    expect:
      gql_status: "22G03"

  - name: sum_of_a_stored_string_property_is_a_type_error
    setup:
      - "INSERT (:P {v: 1}), (:P {v: 'Alix'}), (:P {v: 2})"
    variants:
      gql: "MATCH (n:P) RETURN sum(n.v) AS s"
      cypher: "MATCH (n:P) RETURN sum(n.v) AS s"
      sql-pgq: "SELECT SUM(v) AS s FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (n.v AS v))"
    expect:
      gql_status: "22G03"

  - name: avg_of_a_stored_string_property_is_a_type_error
    setup:
      - "INSERT (:P {v: 1}), (:P {v: 'Alix'})"
    variants:
      gql: "MATCH (n:P) RETURN avg(n.v) AS a"
      cypher: "MATCH (n:P) RETURN avg(n.v) AS a"
      sql-pgq: "SELECT AVG(v) AS a FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (n.v AS v))"
    expect:
      gql_status: "22G03"

  - name: sum_distinct_of_strings_is_a_type_error
    setup:
      - "INSERT (:P {v: 'Alix'}), (:P {v: 'Alix'})"
    variants:
      gql: "MATCH (n:P) RETURN sum(DISTINCT n.v) AS s"
      cypher: "MATCH (n:P) RETURN sum(DISTINCT n.v) AS s"
    expect:
      gql_status: "22G03"

  - name: a_type_error_in_one_group_fails_the_query
    setup:
      - "INSERT (:P {city: 'Amsterdam', v: 1}), (:P {city: 'Berlin', v: 'x'}), (:P {city: 'Berlin', v: 2})"
    variants:
      gql: "MATCH (n:P) RETURN n.city AS city, sum(n.v) AS s"
      cypher: "MATCH (n:P) RETURN n.city AS city, sum(n.v) AS s"
      sql-pgq: "SELECT city, SUM(v) AS s FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (n.city AS city, n.v AS v)) GROUP BY city"
    expect:
      gql_status: "22G03"

  - name: numbers_mixed_with_durations_are_a_type_error
    variants:
      gql: "UNWIND [DURATION 'P1D', 3] AS x RETURN sum(x) AS s"
      cypher: "UNWIND [duration('P1D'), 3] AS x RETURN sum(x) AS s"
    expect:
      gql_status: "22G03"

  - name: a_duration_after_numbers_is_a_type_error
    variants:
      gql: "UNWIND [3, DURATION 'P1D'] AS x RETURN avg(x) AS a"
      cypher: "UNWIND [3, duration('P1D')] AS x RETURN avg(x) AS a"
    expect:
      gql_status: "22G03"

  # ---------------------------------------------------------------------------
  # What they take
  # ---------------------------------------------------------------------------

  - name: numbers_and_nulls_still_sum
    setup:
      - "INSERT (:P {v: 1}), (:P {v: 2.5e0}), (:P {w: 3})"
    variants:
      gql: "MATCH (n:P) RETURN sum(n.v) AS s, avg(n.v) AS a, count(n.v) AS c"
      cypher: "MATCH (n:P) RETURN sum(n.v) AS s, avg(n.v) AS a, count(n.v) AS c"
      sql-pgq: "SELECT SUM(v) AS s, AVG(v) AS a, COUNT(v) AS c FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (n.v AS v))"
    expect:
      rows:
        - [3.5, 1.75, 2]

  - name: sum_and_avg_of_no_values_are_null
    setup:
      - "INSERT (:P {w: 3})"
    variants:
      gql: "MATCH (n:P) RETURN sum(n.v) AS s, avg(n.v) AS a"
      cypher: "MATCH (n:P) RETURN sum(n.v) AS s, avg(n.v) AS a"
    expect:
      rows:
        - [null, null]

  - name: sum_and_avg_of_durations
    variants:
      gql: "UNWIND [DURATION 'P1D', DURATION 'PT12H', null] AS d RETURN toString(sum(d)) AS s, toString(avg(d)) AS a"
      cypher: "UNWIND [duration('P1D'), duration('PT12H'), null] AS d RETURN toString(sum(d)) AS s, toString(avg(d)) AS a"
    expect:
      rows:
        - ["P1DT12H", "PT18H"]

  - name: avg_of_durations_carries_fractions_down
    variants:
      gql: "UNWIND [DURATION 'P1M', DURATION 'P0D'] AS d RETURN toString(avg(d)) AS a"
      cypher: "UNWIND [duration('P1M'), duration('P0D')] AS d RETURN toString(avg(d)) AS a"
    expect:
      rows:
        - ["P15DT5H14M33S"]

  - name: sum_of_distinct_durations
    variants:
      gql: "UNWIND [DURATION 'P1D', DURATION 'P1D', DURATION 'PT1H'] AS d RETURN toString(sum(DISTINCT d)) AS s"
      cypher: "UNWIND [duration('P1D'), duration('P1D'), duration('PT1H')] AS d RETURN toString(sum(DISTINCT d)) AS s"
    expect:
      rows:
        - ["P1DT1H"]

  - name: sum_of_stored_durations_per_group
    setup:
      - "INSERT (:Stay {city: 'Amsterdam', length: DURATION 'P2D'}), (:Stay {city: 'Amsterdam', length: DURATION 'PT6H'}), (:Stay {city: 'Prague', length: DURATION 'P1D'})"
    variants:
      gql: "MATCH (s:Stay) RETURN s.city AS city, toString(sum(s.length)) AS total ORDER BY city"
      cypher: "MATCH (s:Stay) RETURN s.city AS city, toString(sum(s.length)) AS total ORDER BY city"
    expect:
      ordered: true
      rows:
        - [Amsterdam, "P2DT6H"]
        - [Prague, "P1D"]
