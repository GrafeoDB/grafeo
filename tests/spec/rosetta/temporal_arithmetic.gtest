# Rosetta: datetime and duration arithmetic
#
# ISO/IEC 39075 datetime value expressions: a datetime plus or minus a
# duration is a datetime of the same type (a zoned one keeps its offset), and
# a datetime minus a datetime is the duration between them. A duration times
# or divided by a number scales it, a fraction of a month carrying into days
# and of a day into hours (openCypher's rule); a division by zero is 22012.
# Cypher's datetime() is zoned, as openCypher defines it: it keeps its offset
# (+00:00 without one); localdatetime() and GQL's datetime are local.

meta:
  model: lpg
  section: rosetta
  title: Datetime and duration arithmetic
  dataset: empty
  requires: [cypher]

tests:

  # ---------------------------------------------------------------------------
  # Local datetimes and dates
  # ---------------------------------------------------------------------------

  - name: a_local_datetime_plus_a_duration
    query: "RETURN datetime('2024-03-15T10:00:00') + DURATION 'PT1H' = datetime('2024-03-15T11:00:00') AS r"
    expect:
      rows:
        - [true]

  - name: a_local_datetime_minus_a_local_datetime_is_a_duration
    query: "RETURN datetime('2024-03-15T12:00:00') - datetime('2024-03-15T10:00:00') = DURATION 'PT2H' AS r"
    expect:
      rows:
        - [true]

  - name: a_date_minus_a_date_is_a_duration_in_days
    query: "RETURN date('2024-03-15') - date('2024-03-10') = DURATION 'P5D' AS r"
    expect:
      rows:
        - [true]

  # ---------------------------------------------------------------------------
  # Zoned datetimes
  # ---------------------------------------------------------------------------

  - name: a_zoned_datetime_plus_a_duration_keeps_its_offset
    query: "RETURN zoned_datetime('2024-03-15T10:00:00+01:00') + DURATION 'PT1H' = zoned_datetime('2024-03-15T11:00:00+01:00') AS same, toString(zoned_datetime('2024-03-15T10:00:00+01:00') + DURATION 'PT1H') AS text"
    expect:
      rows:
        - [true, "2024-03-15T11:00:00+01:00"]

  - name: a_cypher_datetime_keeps_its_offset
    variants:
      cypher: "WITH datetime('2024-03-15T10:00:00+01:00') AS d RETURN d.hour AS hour, d.offset AS offset"
    expect:
      rows:
        - [10, "+01:00"]

  - name: a_cypher_datetime_plus_a_duration_keeps_its_offset
    variants:
      cypher: "WITH datetime('2024-03-15T10:00:00+01:00') + duration('PT1H') AS d RETURN d.hour AS hour, d.offset AS offset"
    expect:
      rows:
        - [11, "+01:00"]

  - name: a_zoned_datetime_minus_a_duration
    query: "RETURN ZONED DATETIME '2024-03-15T10:00:00+01:00' - DURATION 'PT1H' = ZONED DATETIME '2024-03-15T09:00:00+01:00' AS r"
    expect:
      rows:
        - [true]

  - name: a_zoned_datetime_minus_a_zoned_datetime_is_a_duration
    query: "RETURN zoned_datetime('2024-03-15T12:00:00+01:00') - zoned_datetime('2024-03-15T10:00:00Z') = DURATION 'PT1H' AS r"
    expect:
      rows:
        - [true]

  # ---------------------------------------------------------------------------
  # Scaling durations
  # ---------------------------------------------------------------------------

  - name: a_duration_times_an_integer
    variants:
      gql: "RETURN DURATION 'P1D' * 2 = DURATION 'P2D' AS r"
      cypher: "RETURN duration('P1D') * 2 = duration('P2D') AS r"
    expect:
      rows:
        - [true]

  - name: a_duration_divided_by_an_integer
    variants:
      gql: "RETURN DURATION 'P2D' / 2 = DURATION 'P1D' AS r"
      cypher: "RETURN duration('P2D') / 2 = duration('P1D') AS r"
    expect:
      rows:
        - [true]

  - name: a_duration_times_a_decimal
    variants:
      gql: "RETURN DURATION 'P1D' * 1.5 = DURATION 'P1DT12H' AS r"
      cypher: "RETURN duration('P1D') * 1.5 = duration('P1DT12H') AS r"
    expect:
      rows:
        - [true]

  - name: a_duration_divided_by_zero
    variants:
      gql: "RETURN DURATION 'P1D' / 0 AS r"
      cypher: "RETURN duration('P1D') / 0 AS r"
    expect:
      error: "division by zero"
      gql_status: "22012"

  - name: a_duration_times_a_float_and_a_fraction_of_a_month
    variants:
      gql: "RETURN DURATION 'P1D' * 1.5e0 = DURATION 'P1DT12H' AS f, DURATION 'P1M' * 1.5 = DURATION 'P1M15DT5H14M33S' AS m, 0.5 * DURATION 'PT1H' = DURATION 'PT30M' AS left_factor"
      cypher: "RETURN duration('P1D') * 1.5 = duration('P1DT12H') AS f, duration('P1M') * 1.5 = duration('P1M15DT5H14M33S') AS m, 0.5 * duration('PT1H') = duration('PT30M') AS left_factor"
    expect:
      rows:
        - [true, true, true]

  # A division keeps the fraction: half a day is 12 hours, not 0 days
  - name: a_duration_divided_keeps_its_fraction
    variants:
      gql: "RETURN DURATION 'P1D' / 2 = DURATION 'PT12H' AS half_day, DURATION 'P1D' / 0.5 = DURATION 'P2D' AS by_decimal, DURATION 'PT1H' / 4.0e0 = DURATION 'PT15M' AS by_float"
      cypher: "RETURN duration('P1D') / 2 = duration('PT12H') AS half_day, duration('P1D') / 0.5 = duration('P2D') AS by_decimal, duration('PT1H') / 4.0 = duration('PT15M') AS by_float"
    expect:
      rows:
        - [true, true, true]

  - name: a_duration_divided_by_a_zero_decimal_or_float
    variants:
      gql: "RETURN DURATION 'P1D' / 0.0 AS r"
      cypher: "RETURN duration('P1D') / 0.0 AS r"
    expect:
      gql_status: "22012"

  - name: a_duration_scaled_by_null_is_null
    variants:
      gql: "RETURN DURATION 'P1D' * null AS a, DURATION 'P1D' / null AS b"
      cypher: "RETURN duration('P1D') * null AS a, duration('P1D') / null AS b"
    expect:
      rows:
        - [null, null]

  - name: a_zoned_datetime_plus_a_month_moves_its_local_date
    query: "RETURN toString(zoned_datetime('2024-01-31T23:30:00+01:00') + DURATION 'P1M') AS month, toString(DURATION 'P1D' + zoned_datetime('2024-03-15T10:00:00-05:00')) AS day_first"
    expect:
      rows:
        - ["2024-02-29T23:30:00+01:00", "2024-03-16T10:00:00-05:00"]

  - name: a_cypher_datetime_without_an_offset_is_at_utc
    variants:
      cypher: "WITH datetime('2024-03-15T10:00:00') AS d, datetime({year: 2024, month: 3, day: 15, hour: 10, timezone: '+02:00'}) AS m RETURN toString(d) AS d, d.offset AS o, toString(m) AS m, m.hour AS h"
    expect:
      rows:
        - ["2024-03-15T10:00:00Z", "Z", "2024-03-15T10:00:00+02:00", 10]

  - name: a_cypher_datetime_keeps_its_offset_in_its_text
    variants:
      cypher: "RETURN toString(datetime('2024-03-15T10:00:00+01:00')) AS z, toString(localdatetime('2024-03-15T10:00:00')) AS l"
    expect:
      rows:
        - ["2024-03-15T10:00:00+01:00", "2024-03-15T10:00:00"]

  - name: a_local_datetime_has_no_zone_in_its_text
    query: "RETURN toString(datetime('2024-03-15T10:00:00')) AS l, CAST(local_datetime('2024-03-15T10:00:00.25') AS STRING) AS c, toString(zoned_datetime('2024-03-15T10:00:00+01:00')) AS z"
    expect:
      rows:
        - ["2024-03-15T10:00:00", "2024-03-15T10:00:00.25", "2024-03-15T10:00:00+01:00"]
