# Rosetta: unary plus
#
# `+x` is the number x, in GQL, Cypher and SQL/PGQ, as SQL's <sign> and ISO
# GQL's numeric value expression define it, and `-x` its negation. Both take
# numbers and durations: any other value under a sign is a type error
# (22G03), as ISO GQL makes it a data exception; null stays null. SQL/PGQ did
# not parse `+x`, and GQL and Cypher passed any value through it unchanged.

meta:
  model: lpg
  section: rosetta
  title: Unary plus
  dataset: empty
  requires: [cypher, sql-pgq]

tests:

  - name: a_number_under_plus_is_the_number
    setup:
      - "INSERT (:P {age: 30})"
    variants:
      gql: "MATCH (n:P) RETURN +n.age AS a, -(+n.age) AS b, +(-n.age) AS c"
      cypher: "MATCH (n:P) RETURN +n.age AS a, -(+n.age) AS b, +(-n.age) AS c"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (+n.age AS a, -(+n.age) AS b, +(-n.age) AS c))"
    expect:
      rows:
        - [30, -30, -30]

  - name: a_float_under_plus_stays_a_float
    setup:
      - "INSERT (:P {w: 2.5e0})"
    variants:
      gql: "MATCH (n:P) RETURN +n.w / 2 AS h"
      cypher: "MATCH (n:P) RETURN +n.w / 2 AS h"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (+n.w / 2 AS h))"
    expect:
      rows:
        - [1.25]

  - name: plus_in_a_filter
    setup:
      - "INSERT (:P {age: 30}), (:P {age: 2})"
    variants:
      gql: "MATCH (n:P) WHERE +n.age > 3 RETURN n.age AS a"
      cypher: "MATCH (n:P) WHERE +n.age > 3 RETURN n.age AS a"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (n:P) WHERE +n.age > 3 COLUMNS (n.age AS a))"
    expect:
      rows:
        - [30]

  - name: plus_of_a_stored_string_is_a_type_error
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) RETURN +n.name AS a"
      cypher: "MATCH (n:P) RETURN +n.name AS a"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (+n.name AS a))"
    expect:
      gql_status: "22G03"

  - name: minus_of_a_stored_string_is_a_type_error
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) RETURN -n.name AS b"
      cypher: "MATCH (n:P) RETURN -n.name AS b"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (-n.name AS b))"
    expect:
      gql_status: "22G03"

  - name: minus_of_a_string_literal_is_a_type_error
    variants:
      gql: "RETURN -'Alix' AS a"
      cypher: "RETURN -'Alix' AS a"
    expect:
      gql_status: "22G03"

  - name: plus_of_a_boolean_literal_is_a_type_error
    variants:
      gql: "RETURN +true AS a"
      cypher: "RETURN +true AS a"
    expect:
      gql_status: "22G03"

  - name: minus_of_a_list_is_a_type_error
    variants:
      gql: "RETURN -[1, 2] AS a"
      cypher: "RETURN -[1, 2] AS a"
    expect:
      gql_status: "22G03"

  - name: a_sign_on_a_string_in_a_filter_is_a_type_error
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) WHERE -n.name < 0 RETURN n.name AS a"
      cypher: "MATCH (n:P) WHERE -n.name < 0 RETURN n.name AS a"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (n:P) WHERE -n.name < 0 COLUMNS (n.name AS a))"
    expect:
      gql_status: "22G03"

  - name: a_sign_in_a_write_on_a_string_is_a_type_error
    setup:
      - "INSERT (:P {name: 'Alix'})"
    variants:
      gql: "MATCH (n:P) SET n.x = -n.name RETURN n.x AS x"
      cypher: "MATCH (n:P) SET n.x = -n.name RETURN n.x AS x"
    expect:
      gql_status: "22G03"

  - name: a_sign_on_a_duration_negates_it_or_keeps_it
    variants:
      gql: "RETURN toString(-DURATION 'P1DT2H') AS minus, toString(+DURATION 'PT5M') AS plus, -(-DURATION 'P1D') = DURATION 'P1D' AS twice"
      cypher: "RETURN toString(-duration('P1DT2H')) AS minus, toString(+duration('PT5M')) AS plus, -(-duration('P1D')) = duration('P1D') AS twice"
    expect:
      rows:
        - ["-P1DT2H", "PT5M", true]

  - name: minus_of_the_smallest_integer_is_out_of_range
    variants:
      gql: "RETURN -(-9223372036854775807 - 1) AS a"
      cypher: "RETURN -(-9223372036854775807 - 1) AS a"
    expect:
      gql_status: "22003"

  - name: a_sign_on_a_null_property_is_null
    setup:
      - "INSERT (:P {age: 30})"
    variants:
      gql: "MATCH (n:P) RETURN -n.missing AS a, +n.missing AS b"
      cypher: "MATCH (n:P) RETURN -n.missing AS a, +n.missing AS b"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (n:P) COLUMNS (-n.missing AS a, +n.missing AS b))"
    expect:
      rows:
        - [null, null]

  - name: plus_of_null_is_null
    variants:
      gql: "RETURN +null AS a"
      cypher: "RETURN +null AS a"
    expect:
      rows:
        - [null]

  - name: plus_around_an_aggregate
    setup:
      - "INSERT (:P {age: 30}), (:P {age: 2})"
    variants:
      gql: "MATCH (n:P) RETURN +count(n) AS c, +sum(n.age) AS s"
      cypher: "MATCH (n:P) RETURN +count(n) AS c, +sum(n.age) AS s"
    expect:
      rows:
        - [2, 32]

  - name: plus_in_an_order_by
    setup:
      - "INSERT (:P {age: 30}), (:P {age: 2}), (:P {age: 19})"
    variants:
      gql: "MATCH (n:P) RETURN n.age AS a ORDER BY +n.age DESC"
      cypher: "MATCH (n:P) RETURN n.age AS a ORDER BY +n.age DESC"
    expect:
      ordered: true
      rows:
        - [30]
        - [19]
        - [2]
