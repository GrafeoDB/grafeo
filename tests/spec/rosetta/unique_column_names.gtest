# Rosetta: every column of a clause has one name
#
# ISO/IEC 39075:2024 14.11 <return statement> and 14.12 <with>: the items of
# a RETURN or a WITH have distinct names, and the branches of a set operation
# (14.2) return the same columns. A WITH with two items named x was accepted
# and kept one of them (#371); set operations over different columns are
# rejected in every language (#365).
#
# Setup: Alix KNOWS Gus.

meta:
  model: lpg
  section: rosetta
  title: Unique column names in WITH, RETURN and set operations
  dataset: empty
  requires: [cypher, sql-pgq]

tests:

  # ---------------------------------------------------------------------------
  # WITH (#371)
  # ---------------------------------------------------------------------------

  - name: with_two_items_named_alike_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) WITH a.name AS x, a.name AS x RETURN x"
      cypher: "MATCH (a:Person) WITH a.name AS x, a.name AS x RETURN x"
    expect:
      error: "duplicate column name 'x' in WITH"
      gql_status: "42000"

  - name: with_a_variable_and_an_alias_named_alike_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person)-[:KNOWS]->(b:Person) WITH a, b.name AS a RETURN a"
      cypher: "MATCH (a:Person)-[:KNOWS]->(b:Person) WITH a, b.name AS a RETURN a"
    expect:
      error: "duplicate column name 'a' in WITH"
      gql_status: "42000"

  - name: with_two_aliases_of_one_value_keeps_both
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) WITH a.name AS x, a.name AS y RETURN x, y ORDER BY x"
      cypher: "MATCH (a:Person) WITH a.name AS x, a.name AS y RETURN x, y ORDER BY x"
    expect:
      ordered: true
      rows:
        - [Alix, Alix]
        - [Gus, Gus]

  - name: with_renaming_a_column_to_its_own_name_is_allowed
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) WITH a.name AS x WITH x AS x, x AS y RETURN x, y ORDER BY x"
      cypher: "MATCH (a:Person) WITH a.name AS x WITH x AS x, x AS y RETURN x, y ORDER BY x"
    expect:
      ordered: true
      rows:
        - [Alix, Alix]
        - [Gus, Gus]

  - name: a_later_with_may_reuse_a_name_an_earlier_one_dropped
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person)-[:KNOWS]->(b:Person) WITH a.name AS x, b.name AS y WITH y AS x RETURN x"
      cypher: "MATCH (a:Person)-[:KNOWS]->(b:Person) WITH a.name AS x, b.name AS y WITH y AS x RETURN x"
    expect:
      rows:
        - [Gus]

  # ---------------------------------------------------------------------------
  # RETURN and COLUMNS (#371)
  # ---------------------------------------------------------------------------

  - name: return_two_items_named_alike_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) RETURN a.name AS x, a.name AS x"
      cypher: "MATCH (a:Person) RETURN a.name AS x, a.name AS x"
    expect:
      error: "duplicate column name 'x' in query result"
      gql_status: "42000"

  - name: return_one_property_twice_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) RETURN a.name, a.name"
      cypher: "MATCH (a:Person) RETURN a.name, a.name"
    expect:
      error: "duplicate column name 'a.name' in query result"
      gql_status: "42000"

  - name: columns_two_items_named_alike_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (a:Person) COLUMNS (a.name AS n, a.name AS n))"
    expect:
      error: "duplicate column name 'n'"
      gql_status: "42000"

  - name: ids_of_three_elements_are_three_columns
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (s)-[r]->(t) RETURN id(s) <> id(t) AS nodes_differ, id(r) IS NOT NULL AS has_edge, s.name, t.name"
      cypher: "MATCH (s)-[r]->(t) RETURN id(s) <> id(t) AS nodes_differ, id(r) IS NOT NULL AS has_edge, s.name, t.name"
    expect:
      columns: [nodes_differ, has_edge, s.name, t.name]
      rows:
        - [true, true, Alix, Gus]

  # ---------------------------------------------------------------------------
  # Set operations (#365)
  # ---------------------------------------------------------------------------

  - name: union_over_differently_named_columns_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) RETURN a.name AS n UNION MATCH (a:Person) RETURN a.name AS m"
      cypher: "MATCH (a:Person) RETURN a.name AS n UNION MATCH (a:Person) RETURN a.name AS m"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (a:Person) COLUMNS (a.name AS n)) UNION SELECT * FROM GRAPH_TABLE (MATCH (a:Person) COLUMNS (a.name AS m))"
    expect:
      error: "All UNION branches must return the same columns in the same order: [n] vs [m]"
      gql_status: "42000"

  - name: union_over_a_different_number_of_columns_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) RETURN a.name AS n UNION MATCH (a:Person) RETURN a.name AS n, a.name AS o"
      cypher: "MATCH (a:Person) RETURN a.name AS n UNION MATCH (a:Person) RETURN a.name AS n, a.name AS o"
    expect:
      error: "All UNION branches must return the same columns in the same order: [n] vs [n, o]"
      gql_status: "42000"

  - name: intersect_over_differently_named_columns_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) RETURN a.name AS n INTERSECT MATCH (a:Person) RETURN a.name AS m"
    expect:
      error: "branches must return the same columns in the same order: [n] vs [m]"
      gql_status: "42000"

  - name: except_over_differently_named_columns_is_an_error
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person) RETURN a.name AS n EXCEPT MATCH (a:Person) RETURN a.name AS m"
    expect:
      error: "branches must return the same columns in the same order: [n] vs [m]"
      gql_status: "42000"

  - name: union_over_the_same_columns_merges_the_rows
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person {name: 'Alix'}) RETURN a.name AS n UNION MATCH (a:Person) RETURN a.name AS n"
      cypher: "MATCH (a:Person {name: 'Alix'}) RETURN a.name AS n UNION MATCH (a:Person) RETURN a.name AS n"
      sql-pgq: "SELECT * FROM GRAPH_TABLE (MATCH (a:Person {name: 'Alix'}) COLUMNS (a.name AS n)) UNION SELECT * FROM GRAPH_TABLE (MATCH (a:Person) COLUMNS (a.name AS n))"
    expect:
      rows:
        - [Alix]
        - [Gus]

  - name: intersect_over_the_same_columns_keeps_the_shared_rows
    setup:
      - "INSERT (:Person {name: 'Alix'})-[:KNOWS]->(:Person {name: 'Gus'})"
    variants:
      gql: "MATCH (a:Person)-[:KNOWS]->() RETURN a.name AS n INTERSECT MATCH (a:Person) RETURN a.name AS n"
    expect:
      rows:
        - [Alix]
